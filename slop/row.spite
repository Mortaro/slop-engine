singleton

generic $row_type

var columns = Columns()
var keys = List<String>()
var headers = List<ColumnIndex>()
var rows = List<Integer>()
var relation = -1
var kinds = List<Integer>()
var since = -1
var related = -1
var prepared = false
var current: $row_type = $row_type()
var cursor = 0
var every_rows = List<$row_type>()
var pooled_rows = List<$row_type>()
var every_entities = List<Integer>()
var holds_copies = false
var filled_entity = -1
var stream_driver = ColumnIndex()
var stream_position = 0
var stream_total = 0
var waiting_rows = List<$row_type>()
var stream_list = List<Integer>()
var pinned = false
var changes = Changes()

func prepare() {
    assert not prepared
    prepared = true
    describe_attributes(current)
}

func describe_attribute(attribute: Symbol<$row_type>, row: $row_type) {
    if attribute.class.fits_vector() and attribute.class != Entity {
        holds_copies = true
    }
    var key = columns.key(attribute.class)
    var slot = Slot<attribute.class>()
    var kind = slot.tracking_kind(row.attributes[attribute])
    var fields = FieldCount<attribute.class>()
    var marker = fields.is_marker(row.attributes[attribute])
    if slot.pinned(row.attributes[attribute]) {
        pinned = true
    }
    if kind == 0 and key != "Entity" and marker {
        kind = 3
    }
    kinds.append(kind)
    if kind == 1 or kind == 2 or kind == 4 or kind == 5 {
        key = slot.tracked_key(row.attributes[attribute])
    } else if key == "Entity" {
        var a_row_field_of_class_entity_is_named_entity = attribute.name == "entity"
        crash a_row_field_of_class_entity_is_named_entity
        key = ""
    } else if kind == 0 and relation < 0 {
        note_link(attribute, row)
    }
    keys.append(key)
    var header = ColumnIndex()
    if key != "" and kind != 2 {
        header = columns.header(key)
    }
    headers.append(header)
    rows.append(-1)
}

func note_link(attribute: Symbol<$row_type>, row: $row_type) {
    if attribute.class == Entity or attribute.class.has_function("fill_from") {
        return
    }
    var links = LinkCount<attribute.class>()
    if links.count_in(row.attributes[attribute]) > 0 {
        relation = keys.count()
    }
}

func component_keys(): List<String> {
    var found = List<String>()
    var index = 0
    while index < keys.count() {
        if keys[index] != "" {
            found.append(keys[index])
        }
        index = index + 1
    }
    return found
}

func candidates(): List<Integer> {
    var found = List<Integer>()
    var driver = smallest_header()
    if not driver.stored {
        return removal_candidates()
    }
    var total = driver.count()
    var row = 0
    while total > row {
        var entity = driver.entity_at(row)
        if matches(entity) {
            found.append(entity)
        }
        row = row + 1
    }
    return found
}

func removal_candidates(): List<Integer> {
    var found = List<Integer>()
    var index = 0
    while index < kinds.count() {
        crash keys[index]
        if kinds[index] == 2 {
            found = columns.removed_entities(keys[index], since)
        }
        index = index + 1
    }
    return found.filter(matches)
}

func estimate(): Integer {
    var driver = smallest_header()
    if not driver.stored {
        return removal_candidates().count()
    }
    return driver.count()
}

func present_in(header: ColumnIndex, entity: Integer): Boolean {
    if not header.stored {
        return false
    }
    return header.has(entity)
}

func smallest_header(): ColumnIndex {
    var smallest = ColumnIndex()
    var index = 0
    while index < headers.count() {
        crash kinds[index]
        if kinds[index] != 4 {
            smallest = smaller(smallest, headers[index])
        }
        index = index + 1
    }
    return smallest
}

func smaller(current_smallest: ColumnIndex, candidate: ColumnIndex): ColumnIndex {
    if not candidate.stored {
        return current_smallest
    }
    if not current_smallest.stored {
        return candidate
    }
    if candidate.count() < current_smallest.count() {
        return candidate
    }
    return current_smallest
}

func is_plain(): Boolean {
    var index = 0
    while index < kinds.count() {
        if kinds[index] == 1 or kinds[index] == 2 or kinds[index] == 4 or kinds[index] == 5 {
            return false
        }
        index = index + 1
    }
    return true
}

func matches(entity: Integer): Boolean {
    return match_into(entity, rows)
}

func match_into(entity: Integer, found: List<Integer>): Boolean {
    var index = 0
    var all = true
    while all and index < headers.count() {
        all = find_row(index, entity, found)
        index = index + 1
    }
    return all
}

func find_row(index: Integer, entity: Integer, found: List<Integer>): Boolean {
    crash headers[index]
    crash kinds[index]
    crash keys[index]
    var header = headers[index]
    if kinds[index] == 2 {
        found[index] = -1
        return columns.removed_since(keys[index], entity, since)
    }
    if kinds[index] == 4 {
        found[index] = -1
        return not present_in(header, entity)
    }
    if not header.stored {
        found[index] = -1
        return true
    }
    if entity >= header.rows.count() {
        return false
    }
    var row = header.row_of(entity)
    found[index] = row
    if row < 0 {
        return false
    }
    return passes_tracking(kinds[index], header, row, entity)
}

func passes_tracking(kind: Integer, header: ColumnIndex, row: Integer, entity: Integer): Boolean {
    if kind == 1 {
        return header.added_tick(row) >= since
    }
    if kind == 5 {
        return changes.changed_since(header, entity, since)
    }
    return true
}

func begin_stream() {
    stream_position = 0
    filled_entity = -1
    stream_driver = smallest_header()
    if not stream_driver.stored {
        stream_list = removal_candidates()
        stream_total = stream_list.count()
    } else {
        stream_total = stream_driver.count()
    }
}

func next_match(): Integer {
    while stream_position < stream_total {
        var entity = stream_entity(stream_position)
        stream_position = stream_position + 1
        if matches(entity) {
            return entity
        }
    }
    return -1
}

func advance(writing: Boolean): Integer {
    if filled_entity >= 0 and writing {
        store(filled_entity)
    }
    filled_entity = -1
    var entity = next_match()
    if entity >= 0 {
        fill_matched(entity)
    }
    return entity
}

func stream_entity(position: Integer): Integer {
    if not stream_driver.stored {
        crash stream_list[position]
        return stream_list[position]
    }
    return stream_driver.entity_at(position)
}

func fill_matched(entity: Integer) {
    filled_entity = entity
    cursor = 0
    related = -1
    fill_attributes(current, entity)
}

func fill(entity: Integer) {
    fill_into(current, entity)
}

func enqueue(entity: Integer) {
    var fresh: $row_type = $row_type()
    fill_into(fresh, entity)
    waiting_rows.append(fresh)
}

func dequeue(): $row_type {
    var next = waiting_rows.remove_first()
    crash next
    return next
}

func fill_into(row: $row_type, entity: Integer) {
    var found = matches(entity)
    crash found
    filled_entity = entity
    cursor = 0
    related = -1
    fill_attributes(row, entity)
}

func fill_attribute(attribute: Symbol<$row_type>, row: $row_type, entity: Integer) {
    var position = cursor
    cursor = cursor + 1
    var slot = Slot<attribute.class>()
    crash headers[position]
    crash kinds[position]
    var header = headers[position]
    crash rows[position]
    var found = rows[position]
    assert kinds[position] != 3
    row.attributes[attribute] = slot.fetch(entity, row.attributes[attribute], header, found)
    if position == relation {
        related = slot.link_target(row.attributes[attribute])
    }
}

func store(entity: Integer) {
    if entity != filled_entity {
        var found = matches(entity)
        crash found
    }
    cursor = 0
    store_attributes(current, entity)
    stamp_written(entity)
}

func stamp_written(entity: Integer) {
    var index = 0
    while index < headers.count() {
        crash kinds[index]
        if kinds[index] == 0 and headers[index].stored {
            changes.stamp_written(headers[index], entity)
        }
        index = index + 1
    }
}

func store_attribute(attribute: Symbol<$row_type>, row: $row_type, _entity: Integer) {
    var position = cursor
    cursor = cursor + 1
    var slot = Slot<attribute.class>()
    crash headers[position]
    var header = headers[position]
    crash rows[position]
    var found = rows[position]
    crash kinds[position]
    assert header.stored and kinds[position] == 0
    slot.store(row.attributes[attribute], header, found)
}

func every(): List<$row_type> {
    var every_row = List<$row_type>()
    every_rows.clear()
    every_entities.clear()
    begin_stream()
    var index = 0
    var entity = next_match()
    while entity >= 0 {
        while pooled_rows.count() <= index {
            var fresh: $row_type = $row_type()
            pooled_rows.append(fresh)
        }
        var row = pooled_rows[index]
        crash row
        filled_entity = entity
        cursor = 0
        related = -1
        fill_attributes(row, entity)
        every_row.append(row)
        every_entities.append(entity)
        if holds_copies {
            every_rows.append(row)
        }
        index = index + 1
        entity = next_match()
    }
    filled_entity = -1
    return every_row
}

func has_any(): Boolean {
    begin_stream()
    return next_match() >= 0
}

func store_every(writing: Boolean) {
    var index = 0
    while writing and index < every_rows.count() {
        store_listed(index)
        index = index + 1
    }
    index = 0
    while writing and not holds_copies and index < every_entities.count() {
        stamp_written(every_entities[index])
        index = index + 1
    }
    every_rows.clear()
    every_entities.clear()
}

func store_listed(index: Integer) {
    crash every_entities[index]
    var entity = every_entities[index]
    assert matches(entity)
    cursor = 0
    crash every_rows[index]
    store_attributes(every_rows[index], entity)
    stamp_written(entity)
}
