singleton

generic $component_type

var values = Items<$component_type>()
var references = List<$component_type>()
var relations = Dictionary<List<$component_type>>()
var buried = List<$component_type>()
var raw = Raw()
var heap = Memory.Heap()
var sample: $component_type = null
var columns = Columns()
var own_key = ""
var own_header: Long = 0
var own_recorded = false

func prepare_column() {
    var name = columns.key(sample.class)
    columns.header(name)
    record_column(name)
}

func insert_object(entity: Integer, value: Anything) {
    if value == $component_type {
        insert(entity, value)
    }
}

func header_now(): Long {
    if own_header == 0 {
        own_key = columns.key(sample.class)
        own_header = columns.header(own_key)
    }
    return own_header
}

func row_of_entity(entity: Integer): Integer {
    var column_header = header_now()
    var capacity = raw.read_long(column_header, 40)
    if entity >= capacity {
        return -1
    }
    var rows = raw.read_long(column_header, 32)
    var stored = raw.read_long(rows, entity * 8)
    return stored - 1
}

func insert_own(entity: Integer, value: $component_type) {
    if not own_recorded {
        own_recorded = true
        var name = columns.key(sample.class)
        insert_keyed(entity, value, name)
        return
    }
    header_now()
    grow_rows(own_header, entity)
    var rows = raw.read_long(own_header, 32)
    var existing = raw.read_long(rows, entity * 8) - 1
    if existing >= 0 {
        write_at(own_key, existing, value)
    } else {
        append(own_header, entity, value, own_key)
    }
}

func insert(entity: Integer, value: $component_type) {
    var name = columns.key(value.class)
    insert_keyed(entity, value, name)
}

func inline(): Boolean {
    if $component_type.has_function("stored_inline") and $component_type.fits_vector() {
        return true
    }
    return false
}

func references_of(name: String): List<$component_type> {
    if $component_type == Entity {
        if relations.has(name) {
            crash relations[name]
            return relations[name]
        }
        var made = List<$component_type>()
        relations.set(name, made)
        return made
    }
    return references
}

func insert_keyed(entity: Integer, value: $component_type, name: String) {
    var column_header = columns.header(name)
    record_column(name)
    grow_rows(column_header, entity)
    var fields = FieldCount<$component_type>()
    if fields.is_marker(value) {
        raw.write_long(column_header, 56, 1)
    }
    var existing = columns.row_of(column_header, entity)
    if existing >= 0 {
        write_at(name, existing, value)
    } else {
        append(column_header, entity, value, name)
    }
}

func record_column(name: String) {
    assert not columns.releasers.has(name)
    columns.record_releaser(name, this)
}

func append(column_header: Long, entity: Integer, value: $component_type, name: String) {
    var count = raw.read_long(column_header, 0)
    grow_values(column_header, count + 1)
    var entities = raw.read_long(column_header, 24)
    var rows = raw.read_long(column_header, 32)
    var ticks = raw.read_long(column_header, 48)
    if inline() {
        values.append(value)
    } else {
        var stored = references_of(name)
        stored.append(value)
    }
    raw.write_long(ticks, count * 8, columns.stage_counter)
    raw.write_long(entities, count * 8, entity)
    raw.write_long(rows, entity * 8, count + 1)
    raw.write_long(column_header, 0, count + 1)
}

func grow_values(column_header: Long, wanted: Integer) {
    var capacity = raw.read_long(column_header, 8)
    assert wanted > capacity
    var grown = capacity * 2
    if grown < 16 {
        grown = 16
    }
    var entities = raw.read_long(column_header, 24)
    var resized_entities = resized(entities, grown * 8)
    var ticks = raw.read_long(column_header, 48)
    var resized_ticks = resized(ticks, grown * 8)
    raw.write_long(column_header, 48, resized_ticks)
    raw.write_long(column_header, 24, resized_entities)
    raw.write_long(column_header, 8, grown)
}

func grow_rows(column_header: Long, entity: Integer) {
    var capacity = raw.read_long(column_header, 40)
    assert entity >= capacity
    var grown = capacity * 2
    if grown <= entity {
        grown = entity + 64
    }
    var rows = raw.read_long(column_header, 32)
    var resized_rows = resized(rows, grown * 8)
    var slot = capacity
    while slot < grown {
        raw.write_long(resized_rows, slot * 8, 0)
        slot = slot + 1
    }
    raw.write_long(column_header, 32, resized_rows)
    raw.write_long(column_header, 40, grown)
}

func resized(address: Long, bytes: Long): Long {
    if address == 0 {
        return heap.allocate(bytes)
    }
    return heap.resize(address, bytes)
}

func value_at(name: String, row: Integer): $component_type {
    if inline() {
        return values[row].copy()
    }
    var stored = references_of(name)
    crash stored[row]
    return stored[row]
}

func at(row: Integer): $component_type {
    crash references[row]
    return references[row]
}

func write_at(name: String, row: Integer, value: $component_type) {
    if inline() {
        values.set_at(row, value)
        return
    }
    var stored = references_of(name)
    crash row < stored.count()
    stored.set_at(row, value)
}

func get(entity: Integer, name: String): $component_type {
    var column_header = columns.header(name)
    var row = columns.row_of(column_header, entity)
    crash row >= 0
    return value_at(name, row)
}

func store(entity: Integer, value: $component_type) {
    var name = columns.key(value.class)
    var column_header = columns.header(name)
    var row = columns.row_of(column_header, entity)
    crash row >= 0
    write_at(name, row, value)
}

func remove_all(column_header: Long, entities: List<Integer>, records: Removals, tick: Integer) {
    var name = ""
    if $component_type == Entity {
        name = columns.name_of_header(column_header)
    }
    var capacity = raw.read_long(column_header, 40)
    var index = 0
    while index < entities.count() {
        var entity = entities[index]
        var row = row_below(column_header, capacity, entity)
        if row >= 0 {
            records.note(entity, tick)
            remove_row(column_header, entity, row, name)
        }
        index = index + 1
    }
}

func row_below(column_header: Long, capacity: Long, entity: Integer): Integer {
    if entity >= capacity {
        return -1
    }
    var rows = raw.read_long(column_header, 32)
    var stored = raw.read_long(rows, entity * 8)
    return stored - 1
}

func remove_entity(column_header: Long, entity: Integer) {
    var row = columns.row_of(column_header, entity)
    assert row >= 0
    var name = ""
    if $component_type == Entity {
        name = columns.name_of_header(column_header)
    }
    remove_row(column_header, entity, row, name)
}

func remove_row(column_header: Long, entity: Integer, row: Integer, name: String) {
    var count = raw.read_long(column_header, 0)
    var last = count - 1
    var entities = raw.read_long(column_header, 24)
    var rows = raw.read_long(column_header, 32)
    if inline() {
        values.remove_swapping(row)
    } else {
        remove_reference(name, row, last)
    }
    if row != last {
        var moved_entity = raw.read_long(entities, last * 8)
        var ticks = raw.read_long(column_header, 48)
        var moved_tick = raw.read_long(ticks, last * 8)
        raw.write_long(ticks, row * 8, moved_tick)
        raw.write_long(entities, row * 8, moved_entity)
        raw.write_long(rows, moved_entity * 8, row + 1)
    }
    raw.write_long(rows, entity * 8, 0)
    raw.write_long(column_header, 0, last)
}

func remove_reference(name: String, row: Integer, last: Integer) {
    var stored = references_of(name)
    crash stored[row]
    buried.append(stored[row])
    if row != last {
        crash stored[last]
        stored.set_at(row, stored[last])
    }
    stored.remove_last()
}

func release_buried(budget: Integer): Integer {
    var released = 0
    while released < budget and buried.count() > 0 {
        buried.remove_last()
        released = released + 1
    }
    return released
}
