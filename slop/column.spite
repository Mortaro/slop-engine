singleton

generic $component_type

var values = Items<$component_type>()
var references = List<$component_type>()
var columns = Columns()
var own_key = ""
var own_index = ColumnIndex()
var own_found = false
var own_recorded = false
var changes = Changes()

func prepare_column() {
    header_now()
    if not own_recorded {
        own_recorded = true
        record_column(own_key)
    }
}

func insert_object(entity: Integer, value: Anything, copying: Boolean) {
    if value == $component_type {
        if copying {
            var copied = value.deep_copy()
            insert(entity, copied)
        } else {
            insert(entity, value)
        }
    }
}

func header_now(): ColumnIndex {
    if not own_found {
        own_found = true
        own_key = columns.key($component_type)
        own_index = columns.header(own_key)
    }
    return own_index
}

func row_of_entity(entity: Integer): Integer {
    var looked_up_a_real_entity_not_a_negative_id = entity >= 0
    crash looked_up_a_real_entity_not_a_negative_id
    var index = header_now()
    return index.row_of(entity)
}

func insert_own(entity: Integer, value: $component_type) {
    insert(entity, value)
}

func insert(entity: Integer, value: $component_type) {
    var link = Link<$component_type>()
    link.refuse_dead(value)
    var index = header_now()
    if not own_recorded {
        own_recorded = true
        record_column(own_key)
    }
    var fields = FieldCount<$component_type>()
    if fields.is_marker(value) {
        index.marker = true
    }
    var existing = index.row_of(entity)
    if existing >= 0 {
        write_at(existing, value)
    } else {
        append(index, entity, value)
    }
    changes.stamp_flushed(index, entity)
}

func inline(): Boolean {
    if $component_type == Entity {
        return false
    }
    return $component_type.fits_vector()
}

func record_column(name: String) {
    assert not columns.releasers.has(name)
    columns.record_releaser(name, this)
}

func append(index: ColumnIndex, entity: Integer, value: $component_type) {
    if inline() {
        values.append(value)
    } else {
        references.append(value)
    }
    index.add_row(entity, columns.stage_counter)
}

func value_at(row: Integer): $component_type {
    if inline() {
        crash values[row]
        return values[row].copy()
    }
    crash references[row]
    return references[row]
}

func at(row: Integer): $component_type {
    crash references[row]
    return references[row]
}

func write_at(row: Integer, value: $component_type) {
    if inline() {
        values[row] = value
        return
    }
    crash row < references.count()
    references[row] = value
}

func get(entity: Integer): $component_type {
    var index = header_now()
    var row = index.row_of(entity)
    crash row >= 0
    return value_at(row)
}

func remove_all(index: ColumnIndex, entities: List<Integer>, records: Removals, tick: Integer) {
    var position = 0
    while position < entities.count() {
        var entity = entities[position]
        var row = index.row_of(entity)
        if row >= 0 {
            records.note(entity, tick)
            remove_row(index, entity, row)
        }
        position = position + 1
    }
}

func remove_entity(index: ColumnIndex, entity: Integer) {
    var row = index.row_of(entity)
    assert row >= 0
    remove_row(index, entity, row)
}

func remove_row(index: ColumnIndex, entity: Integer, row: Integer) {
    if inline() {
        values.remove_swapping(row)
    } else {
        references.remove_swapping(row)
    }
    index.remove_row(entity, row)
}
