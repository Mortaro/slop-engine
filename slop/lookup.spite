generic $component_type

var column = Column<$component_type>()

func of(entity: Integer): $component_type? {
    var row = column.row_of_entity(entity)
    assert row >= 0
    if $component_type.fits_vector() and $component_type != Entity {
        return column.values[row]
    }
    return column.value_at(column.own_key, row)
}

func has(entity: Integer): Boolean {
    return column.row_of_entity(entity) >= 0
}
