generic $component_type

var column = Column<$component_type>()
var sample: $component_type = null
var columns = Columns()

func of(entity: Integer): $component_type? {
    var name = columns.key(sample.class)
    var column_header = columns.header(name)
    var row = columns.row_of(column_header, entity)
    assert row >= 0
    return column.value_at(name, row)
}

func has(entity: Integer): Boolean {
    var name = columns.key(sample.class)
    var column_header = columns.header(name)
    return columns.row_of(column_header, entity) >= 0
}
