singleton

var sources = Recipes.Sources()
var fingerprints = Dictionary<String>()
var store: Recipes.Store? = null
var loaded = false
var schemas = Dictionary<Long>()

func folder(): String {
    return sources.cache_folder()
}

func index_path(): String {
    return sources.index_path()
}

func key(id: String, input_fingerprint: String): String {
    return "{id}#{input_fingerprint}"
}

func is_current(id: String, input_fingerprint: String): Boolean {
    load_index()
    assert fingerprints[id]
    var parts = fingerprints[id].split("#")
    assert parts.count() == 3
    var kind = parts[1]
    var schema = schema_of(kind)
    var expected = "{input_fingerprint}#{kind}#{schema}"
    var entry = key(id, expected)
    var cooked = opened_store().has(entry)
    if cooked {
        point_index(id, expected)
    }
    return cooked
}

func schema_of(kind: String): Long {
    assert schemas[kind]
    return schemas[kind]
}

func put(id: String, input_fingerprint: String, bytes: Asset.Bytes) {
    load_index()
    var kind = ""
    var schema: Long = 0
    if is_packed(bytes) {
        var read_from = bytes.position
        bytes.position = 0
        bytes.read_text()
        kind = bytes.read_text()
        schema = bytes.read_long()
        bytes.position = read_from
    }
    var stamped = "{input_fingerprint}#{kind}#{schema}"
    var entry = key(id, stamped)
    var cooked = opened_store()
    if not cooked.has(entry) {
        cooked.write(entry, bytes)
    }
    point_index(id, stamped)
}

func is_packed(bytes: Asset.Bytes): Boolean {
    assert bytes.length >= 8
    var sized = bytes.byte_at(0) == 4 and bytes.byte_at(1) == 0 and bytes.byte_at(2) == 0 and bytes.byte_at(3) == 0
    var magic = bytes.byte_at(4) == 83 and bytes.byte_at(5) == 76 and bytes.byte_at(6) == 79 and bytes.byte_at(7) == 80
    return sized and magic
}

func register_asset(asset: Symbol<Asset>) {
    var pack = Pack<asset.class>()
    var kind = pack.kind()
    var schema = pack.schema()
    schemas.set(kind, schema)
}

func point_index(id: String, input_fingerprint: String) {
    assert fingerprints[id] != input_fingerprint
    fingerprints.set(id, input_fingerprint)
    var json = JsonWriter(fingerprints)
    var text = json.write()
    var path = index_path()
    var index = File(path)
    index.write(text)
}

func read(id: String): Asset.Bytes? {
    load_index()
    assert fingerprints[id]
    var entry = key(id, fingerprints[id])
    return opened_store().read(entry)
}

func locate(id: String): Recipes.Record? {
    load_index()
    assert fingerprints[id]
    var entry = key(id, fingerprints[id])
    return opened_store().locate(entry)
}

func scratch_path(id: String): String {
    load_index()
    return "{folder()}/scratch-{id}"
}

func opened_store(): Recipes.Store {
    if store {
        return store
    }
    var created = Recipes.Store("{folder()}/store.bin")
    store = created
    return created
}

func load_index() {
    assert not loaded
    loaded = true
    register_assets()
    var cache_folder = folder()
    var directory = Directory(cache_folder)
    directory.create()
    var path = index_path()
    var index = File(path)
    var text = index.read()
    assert text
    var json = JsonReader<Dictionary<String>>(text)
    var parsed = json.read()
    assert parsed
    fingerprints = parsed
}

func fingerprint_bytes(bytes: Asset.Bytes): String {
    var hash: Long = 1469598103
    var index = 0
    while index < bytes.length {
        var code = bytes.byte_at(index)
        hash = (hash * 31 + code) % 4294967291
        index = index + 1
    }
    return "{hash}-{bytes.length}"
}

func fingerprint(text: String): String {
    var hash: Long = 1469598103
    var index = 0
    while index < text.length() {
        var code = text.code_at(index)
        hash = (hash * 31 + code) % 4294967291
        index = index + 1
    }
    return "{hash}-{text.length()}"
}
