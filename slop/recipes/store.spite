var path = ""
var index_path = ""
var offsets = Dictionary<String, Long>()
var lengths = Dictionary<String, Long>()
var end: Long = 0
var scanned = false
var raw = Raw()
var heap = Memory.Heap()
var lock = Recipes.StoreLock()

func Store(store_path: String) {
    path = store_path
    index_path = "{store_path}.index"
}

func has(key: String): Boolean {
    scan()
    return offsets.has(key)
}

func locate(key: String): Recipes.Record? {
    scan()
    return find(key)
}

func find(key: String): Recipes.Record? {
    var offset = offsets[key]
    var length = lengths[key]
    assert offset
    assert length
    var record = Recipes.Record()
    record.path = path
    record.offset = offset
    record.length = length
    record.key = key
    return record
}

func read(key: String): Asset.Bytes? {
    var record = locate(key)
    assert record
    return record.read()
}

func write(key: String, data: Asset.Bytes) {
    scan()
    lock.hold("{path}.lock")
    var record = Asset.Bytes()
    record.write_text(key)
    var data_length: Long = data.length
    record.write_long(data_length)
    record.write_bytes(data.address, data.length)
    var start = append_bytes(path, record)
    var header_length: Long = 4 + key.length() + 8
    var data_offset = start + header_length
    note(key, data_offset, data_length)
    var entry = Asset.Bytes()
    write_entry(entry, key)
    append_bytes(index_path, entry)
    lock.release()
}

func note(key: String, data_offset: Long, data_length: Long) {
    offsets[key] = data_offset
    lengths[key] = data_length
    var record_end = data_offset + data_length
    if record_end > end {
        end = record_end
    }
}

func write_entry(entry: Asset.Bytes, key: String) {
    var offset = offsets[key]
    var length = lengths[key]
    assert offset
    assert length
    entry.write_text(key)
    entry.write_long(offset)
    entry.write_long(length)
}

func append_bytes(file_path: String, bytes: Asset.Bytes): Long {
    var file = File(file_path)
    var count: Long = bytes.length
    var listed = ForeignBytes(bytes.address, count).read_bytes(0, bytes.length)
    crash listed
    var start = file.append_bytes(listed)
    crash start
    return start
}

func scan() {
    assert not scanned
    scanned = true
    lock.hold("{path}.lock")
    var size = store_size()
    var indexed = false
    if size > 0 {
        indexed = load_index()
    }
    var index_disagrees = not indexed or end != size
    if size > 0 and index_disagrees {
        rescan()
    }
    lock.release()
}

func rescan() {
    offsets = Dictionary<String, Long>()
    lengths = Dictionary<String, Long>()
    end = 0
    scan_records()
    rewrite_index()
}

func store_size(): Long {
    var file = File(path)
    var size = file.size()
    if size {
        return size
    }
    return 0
}

func load_index(): Boolean {
    var index = Asset.Bytes()
    var existing = File(index_path)
    if not existing.exists() {
        return false
    }
    if not index.read_file(index_path) {
        return false
    }
    while index.remaining() > 0 {
        var key = index.read_text()
        var data_offset = index.read_long()
        var data_length = index.read_long()
        note(key, data_offset, data_length)
    }
    return true
}

func rewrite_index() {
    var index = Asset.Bytes()
    var keys = offsets.keys()
    var position = 0
    while position < keys.count() {
        write_entry(index, keys[position])
        position = position + 1
    }
    var saved = index.save(index_path)
    crash saved
}

func scan_records() {
    var file = File(path)
    var header = heap.allocate(8)
    var position: Long = 0
    while position >= 0 {
        position = read_record(file, header, position)
    }
    heap.free(header)
}

func read_record(file: File, header: Long, position: Long): Long {
    var four: Long = 4
    var eight: Long = 8
    var got_key_length = read_at(file, position, four, header)
    if got_key_length != four {
        return -1
    }
    var key_length = raw.read_integer(header, 0)
    var key_size: Long = key_length
    var key_bytes = heap.allocate(key_length + 1)
    var key_position = position + four
    var got_key = read_at(file, key_position, key_size, key_bytes)
    var key = raw.text(key_bytes, key_length)
    heap.free(key_bytes)
    var length_position = key_position + key_size
    var got_data_length = read_at(file, length_position, eight, header)
    if got_key != key_size or got_data_length != eight {
        return -1
    }
    var data_length = raw.read_long(header, 0)
    var data_offset = length_position + eight
    note(key, data_offset, data_length)
    return data_offset + data_length
}

func read_at(file: File, position: Long, count: Long, address: Long): Long? {
    var wanted: Integer = count
    var got = file.read_bytes_at(position, wanted)
    assert got
    var got_count: Long = got.count()
    ForeignBytes(address, got_count).write_bytes(0, got)
    return got_count
}
