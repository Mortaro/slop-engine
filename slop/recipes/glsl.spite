var cache = Recipes.Cache()
var sources = Recipes.Sources()
var cookbook = Recipes.Cookbook()
var console = Console()
var program = Program()
var c_runtime = DynamicLibrary("ucrtbase.dll", 'identity', "")

func compile(root: String, id: String, stage: String) {
    var source_path = sources.path_in(root, id, "glsl")
    cookbook.note_source(source_path)
    var source_file = File(source_path)
    var text = source_file.read()
    crash text
    var included = included_text(source_path, id, text)
    var fingerprint = cache.fingerprint("{stage}\n{text}\n{included}")
    assert not cache.is_current(id, fingerprint)
    var output_path = cache.scratch_path(id)
    var arguments = List<String>()
    arguments.append("-V")
    arguments.append("--target-env")
    arguments.append("vulkan1.3")
    arguments.append("-S")
    arguments.append(stage)
    arguments.append("-o")
    arguments.append(output_path)
    arguments.append(source_path)
    var compiler_file = compiler_path()
    var compiler = Process(compiler_file, arguments)
    var status = compiler.run()
    crash status == 0
    var compiled = Asset.Bytes()
    var loaded = compiled.read_file(output_path)
    crash loaded
    cache.put(id, fingerprint, compiled)
    c_runtime.remove(output_path)
    console.print("recipe: compiled {id} ({stage})")
}

func included_text(source_path: String, id: String, text: String): String {
    var parts = id.split(".")
    var file_name = parts.last()
    crash file_name
    var path_length = source_path.length()
    var folder_length = path_length - file_name.length() - 6
    var folder = source_path.slice(0, folder_length)
    var joined = ""
    var lines = text.split("\n")
    var index = 0
    while index < lines.count() {
        var line = lines[index].trim()
        if line.starts_with("#include \"") {
            var line_length = line.length()
            var name = line.slice(10, line_length - 1)
            var include_path = "{folder}/{name}"
            cookbook.note_source(include_path)
            var include_file = File(include_path)
            var include = include_file.read()
            crash include
            joined = "{joined}{name}\n{include}\n"
        }
        index = index + 1
    }
    return joined
}

func compiler_path(): String {
    var sdk = program.environment("VULKAN_SDK")
    crash sdk
    return "{sdk}/Bin/glslangValidator.exe"
}
