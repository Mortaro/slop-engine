var folder = ""
var index_file = ""
var fingerprints = Dictionary<String>()
var store: Recipes.Store? = null

func CacheReader(cache_folder: String, index_path: String) {
    folder = cache_folder
    index_file = index_path
}

func read_index() {
    var created = Recipes.Store("{folder}/store.bin")
    created.scan()
    store = created
    var index = File(index_file)
    var text = index.read()
    assert text
    var json = JsonReader<Dictionary<String>>()
    var parsed = json.read(text)
    assert parsed
    fingerprints = parsed
}

func fingerprint_of(id: String): String {
    var fingerprint = fingerprints[id]
    if fingerprint {
        return fingerprint
    }
    return ""
}

func locate(id: String): Recipes.Record? {
    var fingerprint = fingerprints[id]
    assert fingerprint
    assert store
    var key = "{id}#{fingerprint}"
    return store.find(key)
}
