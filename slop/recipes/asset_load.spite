generic $asset_type

var path = ""
var offset: Long = 0
var length: Long = 0
var key = ""

func AssetLoad(found: Recipes.Record) {
    path = found.path
    offset = found.offset
    length = found.length
    key = found.key
}

func run(): $asset_type {
    var record = Recipes.Record()
    record.path = path
    record.offset = offset
    record.length = length
    record.key = key
    var bytes = record.read()
    var pack = Pack<$asset_type>()
    var value = pack.decode(bytes)
    crash value
    return value
}
