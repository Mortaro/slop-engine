var cookbook = Recipes.Cookbook()
var stale = ""

func CookTask(stale_recipes: List<Integer>) {
    stale_recipes.each(note)
}

func note(recipe: Integer) {
    stale = "{stale}{recipe},"
}

func run() {
    var recipes = stale.split(",")
    recipes.each(rebuild)
}

func rebuild(recipe: String) {
    assert not recipe.is_empty()
    var index = recipe.to_integer()
    cookbook.rebuild(index)
}
