var build = Build()

var kernel = DynamicLibrary("kernel32.dll", 'identity', "")
var heap = Memory.Heap()
var raw = Raw()

func relative_path(id: String, extension: String): String {
    var folders = id.replace(".", "/")
    return "assets/{folders}.{extension}"
}

func base(): String {
    var folder = base_folder()
    if folder == "" {
        return build.program
    }
    return "{build.program}/{folder}"
}

func base_folder(): String {
    var setting = Recipes.Setting<Build>()
    return setting.base_folder(build)
}

func cache_folder(): String {
    return "{base()}/.slop-cache"
}

func index_path(): String {
    var name = executable_name()
    return "{build.program}/.slop-index-{name}.json"
}

func executable_name(): String {
    var buffer = heap.allocate(1024)
    var no_module: Long = 0
    var size = kernel.GetModuleFileNameA(no_module, buffer, 1024)
    var named = size > 0 and size < 1024
    crash named
    var full = raw.text(buffer, size)
    heap.free(buffer)
    var normalized = full.replace("\\", "/")
    var start = normalized.length()
    while start > 0 and normalized.code_at(start - 1) != 47 {
        start = start - 1
    }
    var stop = normalized.length()
    if normalized.ends_with(".exe") {
        stop = stop - 4
    }
    return normalized.slice(start, stop)
}

func path_of(id: String, extension: String): String {
    var relative = relative_path(id, extension)
    var own = "{build.program}/{relative}"
    var own_file = File(own)
    if own_file.exists() {
        return own
    }
    var based = "{base()}/{relative}"
    var based_file = File(based)
    crash based_file.exists()
    return based
}

func path_in(root: String, id: String, extension: String): String {
    var relative = relative_path(id, extension)
    var rooted_folder = rooted(root)
    var path = "{rooted_folder}/{relative}"
    var file = File(path)
    crash file.exists()
    return path
}

func rooted(root: String): String {
    var absolute = root.starts_with("/") or root.length() > 1 and root.code_at(1) == 58
    if absolute {
        return root
    }
    return "{build.program}/{root}"
}
