var build = Build()
var raw = Raw()
var heap = Memory.Heap()
var clock = Clock()
var handles: Long = 0
var count = 0
var pending = false
var last_signal: Long = 0
var settle: Long = 100

func Watcher() {
    if build.target_operating_system == "windows" {
        load "../../os/windows"
    } else {
        load "../../os/linux"
    }
}

func start(watched: List<String>) {
    assert watched.count() > 0 and handles == 0
    count = watched.count()
    start_watching(watched)
}

func take_change(): Boolean {
    if handles == 0 {
        return false
    }
    if take_signals() {
        pending = true
        last_signal = clock.elapsed_milliseconds()
    }
    var quiet = clock.elapsed_milliseconds() - last_signal
    var settled = pending and quiet >= settle
    if settled {
        pending = false
    }
    return settled
}

func drop() {
    assert handles != 0
    stop_watching()
}
