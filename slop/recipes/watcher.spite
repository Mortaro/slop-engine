var raw = Raw()
var heap = Memory.Heap()
var clock = Clock()
var handles: Long = 0
var count = 0
var pending = false
var last_signal: Long = 0
var settle: Long = 100

func start(watched: List<String>) {
    assert watched.count() > 0 and handles == 0
    var kernel = DynamicLibrary("kernel32.dll", 'identity', "")
    count = watched.count()
    handles = heap.allocate(count * 8)
    var index = 0
    while index < count {
        crash watched[index]
        var file_names_and_writes = 17
        var handle = kernel.FindFirstChangeNotificationA_as_long(watched[index], 0, file_names_and_writes)
        raw.write_long(handles, index * 8, handle)
        index = index + 1
    }
}

func take_change(): Boolean {
    assert handles != 0
    var kernel = DynamicLibrary("kernel32.dll", 'identity', "")
    var no_wait = 0
    var signalled = kernel.WaitForMultipleObjects(count, handles, 0, no_wait)
    while signalled >= 0 and signalled < count {
        var handle = raw.read_long(handles, signalled * 8)
        kernel.FindNextChangeNotification(handle)
        pending = true
        last_signal = clock.elapsed_milliseconds()
        signalled = kernel.WaitForMultipleObjects(count, handles, 0, no_wait)
    }
    var quiet = clock.elapsed_milliseconds() - last_signal
    var settled = pending and quiet >= settle
    if settled {
        pending = false
    }
    return settled
}

func drop() {
    assert handles != 0
    var kernel = DynamicLibrary("kernel32.dll", 'identity', "")
    var index = 0
    while index < count {
        var handle = raw.read_long(handles, index * 8)
        kernel.FindCloseChangeNotification(handle)
        index = index + 1
    }
    heap.free(handles)
}
