var path = ""
var offset: Long = 0
var length: Long = 0

func read(): Asset.Bytes {
    var file = File(path)
    var bytes = Asset.Bytes()
    var wanted: Integer = length
    bytes.reserve(wanted + 1)
    var got = file.read_bytes(offset, length, bytes.address)
    crash got
    crash got == length
    bytes.length = wanted
    return bytes
}
