var build = Build()
var handle: Long = -1

func StoreLock() {
    if build.target_operating_system == "windows" {
        load "../../os/windows"
    } else {
        load "../../os/linux"
    }
}

func hold(lock_path: String) {
    if handle == -1 {
        handle = open_lock_file(lock_path)
    }
    lock_file()
}

func release() {
    unlock_file()
}

func drop() {
    assert handle != -1
    close_lock_file()
}
