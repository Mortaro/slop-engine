var parents = Column<Entity>()
var columns = Columns()
var marks = Vector<Integer>()

func add_children(despawned: List<Integer>, dead: Vector<Long>) {
    despawned.each(mark)
    var grown = true
    while grown {
        grown = false
        var count = columns.count_of("Entity.parent")
        var row = 0
        while row < count {
            var child = columns.entity_at("Entity.parent", row)
            var parent = parents.value_at("Entity.parent", row)
            var parent_gone = marked(parent.id) or buried(dead, parent.id)
            if parent_gone and not marked(child) and not buried(dead, child) {
                mark(child)
                despawned.append(child)
                grown = true
            }
            row = row + 1
        }
    }
}

func mark(entity: Integer) {
    while marks.count() <= entity {
        marks.append(0)
    }
    marks.set_at(entity, 1)
}

func marked(entity: Integer): Boolean {
    return entity < marks.count() and marks[entity] == 1
}

func buried(dead: Vector<Long>, entity: Integer): Boolean {
    var word = entity / 64
    if word >= dead.count() {
        return false
    }
    var bit: Long = 1
    var shifted = bit.shifted_left(entity % 64)
    return dead[word].bits_and(shifted) != 0
}
