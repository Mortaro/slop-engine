singleton

var known = Dictionary<Integer>()
var remotes = Dictionary<Integer>()
var world_field = -10
var receivers_own_first = -100
var created = Vector<Integer>()
var created_remotes = Vector<Integer>()
var world = World()

func local_of(remote: Integer): Integer {
    if remote == -1 {
        return world.entity
    }
    var found = known.get(remote)
    if found {
        return found
    }
    var made = world.create_entity()
    known.set(remote, made.id)
    remotes.set(made.id, remote)
    created.append(made.id)
    created_remotes.append(remote)
    return made.id
}

func forget(remote: Integer) {
    var found = known.get(remote)
    assert found
    known.remove(remote)
    remotes.remove(found)
    world.despawn(found)
}

func field_to_wire(local: Integer): Integer {
    if local < 0 {
        return local
    }
    if local == world.entity {
        return world_field
    }
    var remote = remotes.get(local)
    if remote {
        return receivers_own_first - remote
    }
    return local
}

func field_from_wire(wire: Integer): Integer {
    if wire == world_field {
        return world.entity
    }
    if wire <= receivers_own_first {
        return receivers_own_first - wire
    }
    if wire < 0 {
        return wire
    }
    return local_of(wire)
}
