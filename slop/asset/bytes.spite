var data = List<Byte>()
var length = 0
var position = 0
var untrusted = false
var failed = false

func resize(count: Integer) {
    assert count >= 0
    if count < data.count() {
        data.truncate(count)
    }
    while data.count() < count {
        var zero: Byte = 0
        data.append(zero)
    }
    length = count
}

func write_byte(value: Integer) {
    var narrow: Byte = value
    data.append(narrow)
    length = data.count()
}

func write_integer(value: Integer) {
    data.append_integer(value)
    length = data.count()
}

func write_long(value: Long) {
    data.append_long(value)
    length = data.count()
}

func write_float(value: Float) {
    data.append_float(value)
    length = data.count()
}

func write_double(value: Double) {
    data.append_double(value)
    length = data.count()
}

func write_text(text: String) {
    var text_bytes = text.to_bytes()
    var text_count = text_bytes.count()
    write_integer(text_count)
    append_list(text_bytes)
}

func append_text_bytes(text: String) {
    var text_bytes = text.to_bytes()
    append_list(text_bytes)
}

func append_list(other: List<Byte>) {
    var other_count = other.count()
    data.append_bytes(other, 0, other_count)
    length = data.count()
}

func write_bytes(source: Asset.Bytes, start: Integer, count: Integer) {
    data.append_bytes(source.data, start, count)
    length = data.count()
}

func write_block(block: Asset.Bytes) {
    write_integer(block.length)
    write_bytes(block, 0, block.length)
}

func repeat_byte(value: Integer, count: Integer) {
    var index = 0
    while index < count {
        write_byte(value)
        index = index + 1
    }
}

func zeroes(count: Integer) {
    repeat_byte(0, count)
}

func fits(count: Integer): Boolean {
    if not failed and position + count <= length {
        return true
    }
    crash untrusted
    failed = true
    position = length
    return false
}

func count_fits(count: Integer): Boolean {
    if count >= 0 and count <= remaining() {
        return true
    }
    crash untrusted
    failed = true
    position = length
    return false
}

func clear() {
    data.clear()
    length = 0
    position = 0
    failed = false
}

func remaining(): Integer {
    return length - position
}

func read_byte(): Integer {
    if not fits(1) {
        return 0
    }
    var value = byte_at(position)
    position = position + 1
    return value
}

func read_integer(): Integer {
    if not fits(4) {
        return 0
    }
    var value = integer_at(position)
    position = position + 4
    return value
}

func read_long(): Long {
    if not fits(8) {
        return 0
    }
    var value = long_at(position)
    position = position + 8
    return value
}

func read_float(): Float {
    if not fits(4) {
        return 0.0
    }
    var value = data.read_float(position)
    crash value
    position = position + 4
    return value
}

func read_double(): Double {
    if not fits(8) {
        return 0.0
    }
    var value = data.read_double(position)
    crash value
    position = position + 8
    return value
}

func read_text(): String {
    var text_length = read_integer()
    if text_length < 0 or not fits(text_length) {
        return ""
    }
    var text = text_at(position, text_length)
    crash text
    position = position + text_length
    return text
}

func read_block(): Asset.Bytes {
    var block = Asset.Bytes()
    var count = read_integer()
    if not count_fits(count) or count == 0 {
        return block
    }
    block.data.append_bytes(data, position, count)
    block.length = count
    position = position + count
    return block
}

func list_from(start: Integer, count: Integer): List<Byte> {
    var part = List<Byte>()
    part.append_bytes(data, start, count)
    return part
}

func store_at(address: Long, start: Integer, count: Integer) {
    var foreign = ForeignBytes(address, count)
    var part = list_from(start, count)
    foreign.write_bytes(0, part)
}

func text_at(offset: Integer, count: Integer): String? {
    var part = List<Byte>()
    part.append_bytes(data, offset, count)
    return part.to_utf8_text()
}

func lossy_text_at(offset: Integer, count: Integer): String {
    var text = text_at(offset, count)
    if text {
        return text
    }
    var letters = Asset.Bytes()
    var index = 0
    while index < count {
        var code = byte_at(offset + index)
        if code > 127 {
            code = 63
        }
        letters.write_byte(code)
        index = index + 1
    }
    var plain = letters.text_at(0, count)
    crash plain
    return plain
}

func byte_at(offset: Integer): Integer {
    var value = data[offset]
    crash value
    return value
}

func integer_at(offset: Integer): Integer {
    var value = data.read_integer(offset)
    crash value
    return value
}

func long_at(offset: Integer): Long {
    var value = data.read_long(offset)
    crash value
    return value
}

func float_at(offset: Integer): Float {
    var value = data.read_float(offset)
    crash value
    return value
}

func set_byte(offset: Integer, value: Integer) {
    var narrow: Byte = value
    data[offset] = narrow
}

func set_integer(offset: Integer, value: Integer) {
    data.write_integer(offset, value)
}

func set_long(offset: Integer, value: Long) {
    data.write_long(offset, value)
}

func big_endian_short(offset: Integer): Integer {
    var value = data.read_unsigned_short_big_endian(offset)
    crash value
    return value
}

func big_endian_integer(offset: Integer): Integer {
    var value = data.read_integer_big_endian(offset)
    crash value
    return value
}

func read_file(path: String): Boolean {
    var file = File(path)
    var read = file.read_bytes()
    if not read {
        return false
    }
    data = read
    length = data.count()
    position = 0
    return true
}

func save(path: String): Boolean {
    var file = File(path)
    return file.write_bytes(data)
}
