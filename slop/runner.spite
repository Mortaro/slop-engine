generic $system_type

enum Phase {
    'input'
    'after_input'
    'update'
    'prepare'
    'layout'
    'render'
    'after_render'
    'present'
    'last'
}

var system: $system_type = null
var name = ""
var placed_in = ""
var accesses = List<String>()
var columns = Columns()
var candidates = List<List<Integer>>()
var chosen = List<Integer>()
var position = 0
var related = -1
var skipping = false
var last_run = -1
var buffer = 0
var argument_count = 0
var streamed = -1
var plain_rows = false
var leading_relation = false
var streaming_phase = ""
var pending = 0
var workers: List<Concurrent<Nothing>>? = null
var worker_limit = 8
var world = World()
var timing = Profile.Timing()
var clock = Clock()

func Runner() {
    name = columns.key(system.class)
    buffer = world.register_runner()
    classify_attributes(system)
    place_phases_each()
    place_phases_all()
    crash placed_in != ""
}

func classify_attribute(attribute: Symbol<$system_type>, _system: $system_type) {
    var key = columns.key(attribute.class)
    var is_singleton = attribute.class.is_singleton()
    assert is_singleton and key != "World"
    accesses.append(key)
}

func place_phase_each(phase: Symbol<$system_type.phase_each>) {
    crash placed_in == ""
    placed_in = phase.name
    prepare_arguments()
}

func prepare_argument(argument: Symbol<$system_type.phase_each>) {
    var row = Row<argument.class>()
    row.prepare()
    plain_rows = row.is_plain()
    if argument_count == 0 {
        leading_relation = row.relation >= 0
    }
    var keys = row.component_keys()
    note_accesses(keys)
    argument_count = argument_count + 1
}

func place_phase_all(phase: Symbol<$system_type.phase_all>) {
    crash placed_in == ""
    placed_in = phase.name
    prepare_every_arguments()
}

func prepare_every_argument(argument: Symbol<$system_type.phase_all>) {
    var row = Row<argument.class.element_type>()
    row.prepare()
    var keys = row.component_keys()
    note_accesses(keys)
}

func note_accesses(keys: List<String>) {
    var index = 0
    while index < keys.count() {
        accesses.append(keys[index])
        index = index + 1
    }
}

func run_once() {
    var started = clock.elapsed_nanoseconds()
    world.enter(buffer)
    run_phases_each()
    run_phases_all()
    last_run = columns.stage_counter
    world.enter(0)
    var finished = clock.elapsed_nanoseconds()
    timing.record(finished - started)
}

func run_phase_each(phase: Symbol<$system_type.phase_each>) {
    if $system_type.function_waits("<phase>_each") {
        if argument_count == 0 {
            assert pending == 0
            pending = 1
        } else if argument_count == 1 {
            begin_stream_arguments()
            advance_stream_arguments()
            while streamed >= 0 {
                enqueue_arguments()
                pending = pending + 1
                advance_stream_arguments()
            }
        } else {
            candidates.clear()
            gather_arguments()
            var total = combinations()
            var combination = 0
            while combination < total {
                choose(combination)
                position = 0
                enqueue_chosen_arguments()
                pending = pending + 1
                combination = combination + 1
            }
        }
        return
    }
    if phase.argument_count() == 1 {
        if plain_rows {
            streaming_phase = phase.name
            stream_arguments()
            return
        }
    }
    if argument_count == 1 {
        begin_stream_arguments()
        advance_stream_arguments()
        while streamed >= 0 {
            system.phase_each(row_arguments())
            advance_stream_arguments()
        }
        return
    }
    if argument_count == 2 and leading_relation {
        run_related(phase)
        return
    }
    candidates.clear()
    gather_arguments()
    var total = combinations()
    var combination = 0
    while combination < total {
        choose(combination)
        skipping = false
        related = -1
        position = 0
        fill_arguments()
        if not skipping {
            position = 0
            system.phase_each(row_arguments())
            position = 0
            store_arguments()
        }
        combination = combination + 1
    }
}

func stream_argument(argument: Symbol<$system_type.phase_each>) {
    var stream = Stream<$system_type, argument.class>(system, last_run, streaming_phase)
    stream.run_phases_each()
}

func enqueue_chosen_argument(argument: Symbol<$system_type.phase_each>) {
    var row = Row<argument.class>()
    crash chosen[position]
    row.enqueue(chosen[position])
    position = position + 1
}

func enqueue_argument(argument: Symbol<$system_type.phase_each>) {
    var row = Row<argument.class>()
    row.enqueue(streamed)
}

func start_waiting() {
    assert pending > 0
    if not workers {
        var made = List<Concurrent<Nothing>>()
        workers = made
    }
    var running = workers
    crash running
    var index = running.count() - 1
    while index >= 0 {
        crash running[index]
        if running[index].finished {
            running.remove_at(index)
        }
        index = index - 1
    }
    if $system_type.function_waits("<phase>_each") {
        while running.count() < worker_limit and running.count() < pending {
            var worker = Concurrent(drain)
            running.append(worker)
        }
    }
}

func drain() {
    while pending > 0 {
        pending = pending - 1
        drain_phases_each()
    }
}

func drain_phase_each(phase: Symbol<$system_type.phase_each>) {
    system.phase_each(dequeued_arguments())
}

func dequeued_argument(argument: Symbol<$system_type.phase_each>): argument.class {
    var row = Row<argument.class>()
    return row.dequeue()
}

func gather_argument(argument: Symbol<$system_type.phase_each>) {
    var row = Row<argument.class>()
    row.since = last_run
    var found = row.candidates()
    candidates.append(found)
}

func run_related(phase: Symbol<$system_type.phase_each>) {
    candidates.clear()
    gather_arguments()
    crash candidates[0]
    var firsts = candidates[0]
    var index = 0
    while index < firsts.count() {
        chosen.clear()
        chosen.append(firsts[index])
        skipping = false
        related = -1
        position = 0
        relate_arguments()
        if not skipping {
            position = 0
            system.phase_each(row_arguments())
            position = 0
            store_arguments()
        }
        index = index + 1
    }
}

func relate_argument(argument: Symbol<$system_type.phase_each>) {
    var row = Row<argument.class>()
    if position == 0 {
        crash chosen[0]
        row.fill(chosen[0])
        related = row.related
    } else if not skipping and related >= 0 and row.matches(related) {
        row.fill(related)
        chosen.append(related)
    } else {
        skipping = true
    }
    position = position + 1
}

func fill_argument(argument: Symbol<$system_type.phase_each>) {
    var row = Row<argument.class>()
    crash chosen[position]
    var entity = chosen[position]
    if related >= 0 and related != entity {
        skipping = true
    }
    row.fill(entity)
    related = row.related
    position = position + 1
}

func row_argument(argument: Symbol<$system_type.phase_each>): argument.class {
    var row = Row<argument.class>()
    return row.current
}

func store_argument(argument: Symbol<$system_type.phase_each>) {
    var row = Row<argument.class>()
    crash chosen[position]
    var entity = chosen[position]
    row.store(entity)
    position = position + 1
}

func run_phase_all(phase: Symbol<$system_type.phase_all>) {
    system.phase_all(every_arguments())
    store_every_arguments()
}

func store_every_argument(argument: Symbol<$system_type.phase_all>) {
    var row = Row<argument.class.element_type>()
    row.store_every()
}

func every_argument(argument: Symbol<$system_type.phase_all>): argument.class {
    var row = Row<argument.class.element_type>()
    row.since = last_run
    return row.every()
}

func combinations(): Integer {
    var total = 1
    var index = 0
    while index < candidates.count() {
        total = total * candidates[index].count()
        index = index + 1
    }
    return total
}

func choose(combination: Integer) {
    chosen.clear()
    var remaining = combination
    var index = 0
    while index < candidates.count() {
        var count = candidates[index].count()
        var picked = remaining % count
        var entity = candidates[index][picked]
        crash entity
        chosen.append(entity)
        remaining = remaining / count
        index = index + 1
    }
}

func begin_stream_argument(argument: Symbol<$system_type.phase_each>) {
    var row = Row<argument.class>()
    row.since = last_run
    row.begin_stream()
}

func advance_stream_argument(argument: Symbol<$system_type.phase_each>) {
    var row = Row<argument.class>()
    streamed = row.advance()
}
