generic $system_type

enum Phase {
    'input'
    'after_input'
    'update'
    'prepare'
    'layout'
    'render'
    'after_render'
    'present'
    'last'
}

var system: $system_type = $system_type()
var name = ""
var placed_in = ""
var reads = List<String>()
var writes = List<String>()
var written_names = List<String>()
var writing = List<Boolean>()
var pinned = false
var columns = Columns()
var candidates = List<List<Integer>>()
var chosen = List<Integer>()
var position = 0
var related = -1
var skipping = false
var last_run = -1
var argument_count = 0
var streamed = -1
var plain_rows = false
var plain_count = 0
var clocked = false
var clock_row = Row<GameClock>()
var leading_relation = false
var pair_sizes = List<Integer>()
var pair_outer = 0
var pair_entity = -1
var pair_candidates = List<Integer>()
var gate_open = true
var streaming_phase = ""
var pending = 0
var world = World()
var timing = Profile.Timing()
var clock = Clock()

func Runner() {
    name = columns.key(system.class)
    note_written_names()
    classify_attributes(system)
    place_phases_each()
    place_phases_all()
    crash placed_in != ""
}

func note_written_names() {
    var phases = $system_type.functions.filter_name_ends_with("_each")
    phases.each(note_function)
    var lists = $system_type.functions.filter_name_ends_with("_all")
    lists.each(note_function)
}

func note_function(function: Spite.Function) {
    function.accesses.each(note_access)
}

func note_access(access: Spite.Access) {
    if access.is_written {
        written_names.append(access.target.name)
    }
}

func classify_attribute(attribute: Symbol<$system_type>, owner: $system_type) {
    var looked_up = LookedUp<attribute.class>()
    var looked_up_key = looked_up.key(owner.attributes[attribute])
    if looked_up_key != "" {
        writes.append(looked_up_key)
        if looked_up.pinned(owner.attributes[attribute]) {
            pinned = true
        }
        return
    }
    var key = columns.key(attribute.class)
    var is_singleton = attribute.class.is_singleton()
    assert is_singleton and key != "World"
    writes.append(key)
}

func note_access_to(key: String, written: Boolean) {
    if written {
        writes.append(key)
    } else {
        reads.append(key)
    }
}

func place_phase_each(phase: Symbol<$system_type.phase_each>) {
    crash placed_in == ""
    placed_in = phase.name
    prepare_arguments()
}

func prepare_argument(argument: Symbol<$system_type.phase_each>) {
    var row = Row<argument.class>()
    row.prepare()
    plain_rows = row.is_plain()
    if plain_rows {
        plain_count = plain_count + 1
    }
    if argument_count == 0 {
        leading_relation = row.relation >= 0
    }
    var written = written_names.contains(argument.name)
    writing.append(written)
    if argument.class == GameClock {
        writes.append("GameClock")
    }
    note_row(row.keys, row.kinds, written)
    if row.pinned {
        pinned = true
    }
    argument_count = argument_count + 1
}

func place_phase_all(phase: Symbol<$system_type.phase_all>) {
    crash placed_in == ""
    placed_in = phase.name
    prepare_every_arguments()
}

func prepare_every_argument(argument: Symbol<$system_type.phase_all>) {
    var row = Row<argument.class.element_type>()
    row.prepare()
    var written = written_names.contains(argument.name)
    writing.append(written)
    note_row(row.keys, row.kinds, written)
    if row.pinned {
        pinned = true
    }
}

func note_row(keys: List<String>, kinds: List<Integer>, written: Boolean) {
    var index = 0
    while index < keys.count() {
        crash kinds[index]
        var kind = kinds[index]
        if keys[index] != "" {
            note_access_to(keys[index], written and (kind == 0 or kind == 1))
        }
        index = index + 1
    }
}

func writes_argument(index: Integer): Boolean {
    crash index < writing.count()
    return writing[index]
}

func run_once() {
    var started = clock.elapsed_nanoseconds()
    run_phases_each()
    run_phases_all()
    last_run = columns.stage_counter
    var finished = clock.elapsed_nanoseconds()
    timing.record(finished - started)
}

func run_phase_each(phase: Symbol<$system_type.phase_each>) {
    if $system_type.function_waits("<phase>_each") {
        refuse_snapshot_arguments()
        if argument_count == 0 {
            assert pending == 0
            pending = 1
        } else if argument_count == 1 {
            begin_stream_arguments()
            advance_stream_arguments()
            while streamed >= 0 {
                enqueue_arguments()
                pending = pending + 1
                advance_stream_arguments()
            }
        } else {
            candidates.clear()
            gather_arguments()
            var total = combinations()
            var combination = 0
            while combination < total {
                choose(combination)
                position = 0
                enqueue_chosen_arguments()
                pending = pending + 1
                combination = combination + 1
            }
        }
        return
    }
    if phase.argument_count() == 1 {
        if plain_rows {
            streaming_phase = phase.name
            stream_arguments()
            return
        }
    }
    if argument_count == 1 {
        begin_stream_arguments()
        advance_stream_arguments()
        while streamed >= 0 {
            system.phase_each(row_arguments())
            advance_stream_arguments()
        }
        return
    }
    if argument_count == 2 and leading_relation {
        run_related(phase)
        return
    }
    if phase.argument_count() == 2 {
        streaming_phase = phase.name
        clocked = false
        if plain_count == 2 {
            run_clocked_arguments()
        }
        assert not clocked
    }
    if argument_count == 2 {
        run_pair(phase)
        return
    }
    candidates.clear()
    gather_arguments()
    var total = combinations()
    var combination = 0
    while combination < total {
        choose(combination)
        skipping = false
        related = -1
        position = 0
        fill_arguments()
        if not skipping {
            position = 0
            system.phase_each(row_arguments())
            position = 0
            store_arguments()
        }
        combination = combination + 1
    }
}

func stream_argument(argument: Symbol<$system_type.phase_each>) {
    var stream = Stream<$system_type, argument.class>(system, last_run, streaming_phase)
    stream.writing = writes_argument(argument.index)
    stream.run_phases_each()
}

func enqueue_chosen_argument(argument: Symbol<$system_type.phase_each>) {
    var row = Row<argument.class>()
    crash chosen[position]
    row.enqueue(chosen[position])
    position = position + 1
}

func refuse_snapshot_argument(argument: Symbol<$system_type.phase_each>) {
    crash not $system_type.function_writes_parameter("<phase>_each", argument.index) or not argument.class.any_attribute_fits_vector(Entity)
}

func enqueue_argument(argument: Symbol<$system_type.phase_each>) {
    var row = Row<argument.class>()
    row.enqueue(streamed)
}

func start_waiting() {
    assert pending > 0
    if $system_type.function_waits("<phase>_each") {
        drain()
    }
}

func drain() {
    while pending > 0 {
        pending = pending - 1
        drain_phases_each()
    }
}

func drain_phase_each(phase: Symbol<$system_type.phase_each>) {
    system.phase_each(dequeued_arguments())
}

func dequeued_argument(argument: Symbol<$system_type.phase_each>): argument.class {
    var row = Row<argument.class>()
    return row.dequeue()
}

func gather_argument(argument: Symbol<$system_type.phase_each>) {
    var row = Row<argument.class>()
    row.since = last_run
    var found = row.candidates()
    candidates.append(found)
}

func run_pair(phase: Symbol<$system_type.phase_each>) {
    pair_sizes.clear()
    size_arguments()
    pair_outer = 0
    crash pair_sizes[1]
    crash pair_sizes[0]
    if pair_sizes[1] < pair_sizes[0] {
        pair_outer = 1
    }
    pair_candidates.clear()
    outer_candidates_arguments()
    var index = 0
    while index < pair_candidates.count() {
        pair_entity = pair_candidates[index]
        fill_outer_arguments()
        begin_inner_arguments()
        advance_inner_arguments()
        while streamed >= 0 {
            system.phase_each(row_arguments())
            advance_inner_arguments()
        }
        store_outer_arguments()
        index = index + 1
    }
}

func size_argument(argument: Symbol<$system_type.phase_each>) {
    var row = Row<argument.class>()
    row.since = last_run
    var size = row.estimate()
    pair_sizes.append(size)
}

func outer_candidates_argument(argument: Symbol<$system_type.phase_each>) {
    assert argument.index == pair_outer
    var row = Row<argument.class>()
    row.since = last_run
    pair_candidates = row.candidates()
}

func fill_outer_argument(argument: Symbol<$system_type.phase_each>) {
    assert argument.index == pair_outer
    var row = Row<argument.class>()
    row.fill(pair_entity)
}

func store_outer_argument(argument: Symbol<$system_type.phase_each>) {
    assert argument.index == pair_outer and writes_argument(argument.index)
    var row = Row<argument.class>()
    row.store(pair_entity)
}

func begin_inner_argument(argument: Symbol<$system_type.phase_each>) {
    assert argument.index != pair_outer
    var row = Row<argument.class>()
    row.since = last_run
    row.begin_stream()
}

func advance_inner_argument(argument: Symbol<$system_type.phase_each>) {
    assert argument.index != pair_outer
    var row = Row<argument.class>()
    var written = writes_argument(argument.index)
    streamed = row.advance(written)
}

func run_related(phase: Symbol<$system_type.phase_each>) {
    candidates.clear()
    gather_arguments()
    crash candidates[0]
    var firsts = candidates[0]
    var index = 0
    while index < firsts.count() {
        chosen.clear()
        chosen.append(firsts[index])
        skipping = false
        related = -1
        position = 0
        relate_arguments()
        if not skipping {
            position = 0
            system.phase_each(row_arguments())
            position = 0
            store_arguments()
        }
        index = index + 1
    }
}

func relate_argument(argument: Symbol<$system_type.phase_each>) {
    var row = Row<argument.class>()
    if position == 0 {
        crash chosen[0]
        row.fill(chosen[0])
        related = row.related
    } else if not skipping and related >= 0 and row.matches(related) {
        row.fill(related)
        chosen.append(related)
    } else {
        skipping = true
    }
    position = position + 1
}

func fill_argument(argument: Symbol<$system_type.phase_each>) {
    var row = Row<argument.class>()
    crash chosen[position]
    var entity = chosen[position]
    if related >= 0 and related != entity {
        skipping = true
    }
    row.fill(entity)
    related = row.related
    position = position + 1
}

func row_argument(argument: Symbol<$system_type.phase_each>): argument.class {
    var row = Row<argument.class>()
    return row.current
}

func store_argument(argument: Symbol<$system_type.phase_each>) {
    var row = Row<argument.class>()
    crash chosen[position]
    var entity = chosen[position]
    position = position + 1
    if writes_argument(argument.index) {
        row.store(entity)
    }
}

func run_phase_all(phase: Symbol<$system_type.phase_all>) {
    gate_open = true
    position = 0
    gate_arguments()
    assert gate_open
    system.phase_all(every_arguments())
    store_every_arguments()
}

func gate_argument(argument: Symbol<$system_type.phase_all>) {
    if position == 0 {
        var row = Row<argument.class.element_type>()
        row.since = last_run
        gate_open = row.has_any()
    }
    position = position + 1
}

func store_every_argument(argument: Symbol<$system_type.phase_all>) {
    var row = Row<argument.class.element_type>()
    var written = writes_argument(argument.index)
    row.store_every(written)
}

func every_argument(argument: Symbol<$system_type.phase_all>): argument.class {
    var row = Row<argument.class.element_type>()
    row.since = last_run
    return row.every()
}

func combinations(): Integer {
    var total = 1
    var index = 0
    while index < candidates.count() {
        total = total * candidates[index].count()
        index = index + 1
    }
    return total
}

func choose(combination: Integer) {
    chosen.clear()
    var remaining = combination
    var index = 0
    while index < candidates.count() {
        var count = candidates[index].count()
        var picked = remaining % count
        var entity = candidates[index][picked]
        crash entity
        chosen.append(entity)
        remaining = remaining / count
        index = index + 1
    }
}

func begin_stream_argument(argument: Symbol<$system_type.phase_each>) {
    var row = Row<argument.class>()
    row.since = last_run
    row.begin_stream()
}

func advance_stream_argument(argument: Symbol<$system_type.phase_each>) {
    var row = Row<argument.class>()
    var written = writes_argument(argument.index)
    streamed = row.advance(written)
}

func run_clocked_argument(argument: Symbol<$system_type.phase_each>) {
    if argument.class == GameClock {
        clock_row.fill(world.entity)
        stream_clocked_arguments()
        if writes_argument(argument.index) {
            clock_row.store(world.entity)
        }
        clocked = true
    }
}

func stream_clocked_argument(argument: Symbol<$system_type.phase_each>) {
    if argument.class != GameClock {
        var stream = Stream<$system_type, argument.class>(system, last_run, streaming_phase)
        stream.writing = writes_argument(argument.index)
        stream.run_phases_each()
    }
}
