generic $tracked_type

var value: $tracked_type = $tracked_type()
var column = Column<$tracked_type>()
var columns = Columns()

func tracking_kind(): Integer {
    return 1
}

func tracked_key(): String {
    return columns.key(value.class)
}

func tracked_pinned(): Boolean {
    var slot = Slot<$tracked_type>()
    return slot.pinned(value)
}

func fill_from(column_header: Long, row: Integer) {
    assert column_header != 0 and row >= 0
    value = column.value_at(row)
}
