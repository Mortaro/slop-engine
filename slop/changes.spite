var columns = Columns()

func stamp_written(index: ColumnIndex, entity: Integer) {
    var stamp: Long = columns.stage_counter * 2 + 2
    index.stamp(entity, stamp)
}

func stamp_flushed(index: ColumnIndex, entity: Integer) {
    var stamp: Long = columns.stage_counter * 2 + 3
    index.stamp(entity, stamp)
}

func changed_since(index: ColumnIndex, entity: Integer, since: Integer): Boolean {
    return index.changed_since(entity, since)
}
