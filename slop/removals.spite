var log = List<Removal>()
var last_removed = List<Integer>()

func note(entity: Integer, tick: Integer) {
    var removal = Removal(entity, tick)
    log.append(removal)
    while last_removed.count() <= entity {
        last_removed.append(0)
    }
    last_removed[entity] = tick + 1
}

func removed_since(entity: Integer, since: Integer): Boolean {
    if entity >= last_removed.count() {
        return false
    }
    var stamp = last_removed[entity]
    return stamp > 0 and stamp - 1 >= since
}

func removed_entities(since: Integer): List<Integer> {
    var found = List<Integer>()
    var index = log.count() - 1
    while index >= 0 and newer(index, since) {
        var removal = log[index]
        crash removal
        found.append(removal.entity)
        index = index - 1
    }
    return found
}

func newer(index: Integer, since: Integer): Boolean {
    var removal = log[index]
    crash removal
    return removal.tick >= since
}

func trim(older_than: Integer) {
    var first = 0
    while first < log.count() and log[first].tick < older_than {
        first = first + 1
    }
    assert first > 0
    var kept = List<Removal>()
    var index = first
    while index < log.count() {
        kept.append(log[index])
        index = index + 1
    }
    log = kept
}
