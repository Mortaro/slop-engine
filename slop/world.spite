singleton

type Command {
    apply()
}

var next_entity = 1
var entity = 0
var buffers = List<List<Command>>()
var despawn_buffers = List<List<Integer>>()
var runner_buffer = ThreadLocal<Integer>()
var id_lock = Lock()
var columns = Columns()

var spawned_typed = false
var parents_linked = false
var dead = List<Long>()

func prepare() {
    assert buffers.count() == 0
    add_buffer()
}

func add_buffer(): Integer {
    var buffer = List<Command>()
    buffers.append(buffer)
    var despawn_buffer = List<Integer>()
    despawn_buffers.append(despawn_buffer)
    return buffers.count() - 1
}

func register_runner(): Integer {
    prepare()
    return add_buffer()
}

func enter(buffer: Integer) {
    prepare()
    runner_buffer.set(buffer)
}

func current(): Integer {
    prepare()
    var buffer = runner_buffer.get()
    if buffer {
        return buffer
    }
    return 0
}

func as_entity(): Entity {
    return Entity(entity)
}

func create_entity(): Entity {
    var spawned = spawn()
    return Entity(spawned)
}

func create_entity_from_bundle(bundle: Anything): Entity {
    var made = create_entity()
    spawned_typed = false
    queue_bundles(bundle, made.id)
    if spawned_typed {
        return made
    }
    var attributes = bundle.attributes
    var index = 0
    while index < attributes.count() {
        add_bundle_attribute(made, attributes[index])
        index = index + 1
    }
    return made
}

func queue_bundle(bundle: Symbol<Bundle>, given: Anything, entity: Integer) {
    var kind = BundleKind<bundle.class>()
    if kind.is_kind(given) {
        var command = SpawnBundle<bundle.class>(entity, given)
        queue(command)
        spawned_typed = true
    }
}

func add_bundle_attribute(made: Entity, attribute: Spite.Attribute) {
    assert attribute.value
    var command = AddComponent(made.id, attribute.value, attribute.name)
    command.copying = true
    queue(command)
}

func spawn(): Integer {
    prepare()
    id_lock.lock()
    var spawned = next_entity
    next_entity = next_entity + 1
    id_lock.unlock()
    return spawned
}

func queue(command: Command) {
    var buffer = current()
    crash buffers[buffer]
    buffers[buffer].append(command)
}

func despawn(despawned: Integer) {
    var buffer = current()
    crash despawn_buffers[buffer]
    despawn_buffers[buffer].append(despawned)
}

func flush() {
    prepare()
    buffers.each(apply_buffer)
    var despawned = List<Integer>()
    var index = 0
    while index < despawn_buffers.count() {
        take_despawns(despawn_buffers[index], despawned)
        index = index + 1
    }
    assert despawned.count() > 0 or parents_linked
    parents_linked = false
    add_children(despawned)
    despawned.each(bury)
    assert despawned.count() > 0
    columns.remove_entities(despawned)
}

func bury(despawned: Integer) {
    var word = despawned / 64
    while dead.count() <= word {
        dead.append(0)
    }
    var bit: Long = 1
    var shifted = bit.shifted_left(despawned % 64)
    crash dead[word]
    var buried = dead[word].bits_or(shifted)
    dead.set_at(word, buried)
}

func parent_linked() {
    parents_linked = true
}

func add_children(despawned: List<Integer>) {
    assert columns.headers.has("Entity.parent")
    var finder = ChildFinder()
    finder.add_children(despawned, dead)
}

func apply_buffer(commands: List<Command>) {
    var index = 0
    while index < commands.count() {
        commands[index].apply()
        index = index + 1
    }
    commands.clear()
}

func take_despawns(pending: List<Integer>, despawned: List<Integer>) {
    var index = 0
    while index < pending.count() {
        despawned.append(pending[index])
        index = index + 1
    }
    pending.clear()
}
