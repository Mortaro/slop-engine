singleton

type Command {
    apply()
}

var next_entity = 1
var entity = 0
var commands = List<Command>()
var despawns = List<Integer>()
var columns = Columns()

var spawned_typed = false
var parents = Link<Component.Parent>()
var frames = Lookup<Component.Frame>()

func as_entity(): Entity {
    return entity_of(entity)
}

func entity_of(id: Integer): Entity {
    var made = Entity()
    made.id = id
    return made
}

func create_entity(): Entity {
    var spawned = spawn()
    return entity_of(spawned)
}

func create_entity_from_bundle(bundle: Anything): Entity {
    var made = create_entity()
    spawned_typed = false
    queue_bundles(bundle, made.id)
    if spawned_typed {
        return made
    }
    var attributes = bundle.attributes
    var index = 0
    while index < attributes.count() {
        add_bundle_attribute(made, attributes[index])
        index = index + 1
    }
    return made
}

func queue_bundle(bundle: Symbol<Bundle>, given: Anything, entity: Integer) {
    var kind = BundleKind<bundle.class>()
    if kind.is_kind(given) {
        var command = SpawnBundle<bundle.class>(entity, given)
        queue(command)
        spawned_typed = true
    }
}

func add_bundle_attribute(made: Entity, attribute: Spite.Attribute) {
    assert attribute.value
    var command = AddComponent(made.id, attribute.value)
    command.copying = true
    queue(command)
}

func spawn(): Integer {
    var spawned = next_entity
    next_entity = next_entity + 1
    return spawned
}

func queue(command: Command) {
    commands.append(command)
}

func despawn(despawned: Integer) {
    despawns.append(despawned)
}

func flush() {
    var index = 0
    while index < commands.count() {
        commands[index].apply()
        index = index + 1
    }
    commands.clear()
    var despawned = List<Integer>()
    index = 0
    while index < despawns.count() {
        despawned.append(despawns[index])
        index = index + 1
    }
    despawns.clear()
    assert despawned.count() > 0
    despawned.each(columns.bury)
    var grown = true
    while grown {
        grown = parents.cascade(despawned)
    }
    columns.unlink_dead()
    columns.remove_entities(despawned)
}

func now(): Long {
    var frame = frames.of(entity)
    crash frame
    return frame.elapsed_milliseconds
}
