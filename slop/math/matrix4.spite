var m0: Float = 1.0
var m1: Float = 0.0
var m2: Float = 0.0
var m3: Float = 0.0
var m4: Float = 0.0
var m5: Float = 1.0
var m6: Float = 0.0
var m7: Float = 0.0
var m8: Float = 0.0
var m9: Float = 0.0
var m10: Float = 1.0
var m11: Float = 0.0
var m12: Float = 0.0
var m13: Float = 0.0
var m14: Float = 0.0
var m15: Float = 1.0
var floats = TypedMemory<Float>()
var scalar = Math.Scalar()

func multiplied(other: Math.Matrix4): Math.Matrix4 {
    var product = Math.Matrix4()
    product.m0 = m0 * other.m0 + m4 * other.m1 + m8 * other.m2 + m12 * other.m3
    product.m1 = m1 * other.m0 + m5 * other.m1 + m9 * other.m2 + m13 * other.m3
    product.m2 = m2 * other.m0 + m6 * other.m1 + m10 * other.m2 + m14 * other.m3
    product.m3 = m3 * other.m0 + m7 * other.m1 + m11 * other.m2 + m15 * other.m3
    product.m4 = m0 * other.m4 + m4 * other.m5 + m8 * other.m6 + m12 * other.m7
    product.m5 = m1 * other.m4 + m5 * other.m5 + m9 * other.m6 + m13 * other.m7
    product.m6 = m2 * other.m4 + m6 * other.m5 + m10 * other.m6 + m14 * other.m7
    product.m7 = m3 * other.m4 + m7 * other.m5 + m11 * other.m6 + m15 * other.m7
    product.m8 = m0 * other.m8 + m4 * other.m9 + m8 * other.m10 + m12 * other.m11
    product.m9 = m1 * other.m8 + m5 * other.m9 + m9 * other.m10 + m13 * other.m11
    product.m10 = m2 * other.m8 + m6 * other.m9 + m10 * other.m10 + m14 * other.m11
    product.m11 = m3 * other.m8 + m7 * other.m9 + m11 * other.m10 + m15 * other.m11
    product.m12 = m0 * other.m12 + m4 * other.m13 + m8 * other.m14 + m12 * other.m15
    product.m13 = m1 * other.m12 + m5 * other.m13 + m9 * other.m14 + m13 * other.m15
    product.m14 = m2 * other.m12 + m6 * other.m13 + m10 * other.m14 + m14 * other.m15
    product.m15 = m3 * other.m12 + m7 * other.m13 + m11 * other.m14 + m15 * other.m15
    return product
}

func set_product(left: Math.Matrix4, right: Math.Matrix4) {
    var product_0 = left.m0 * right.m0 + left.m4 * right.m1 + left.m8 * right.m2 + left.m12 * right.m3
    var product_1 = left.m1 * right.m0 + left.m5 * right.m1 + left.m9 * right.m2 + left.m13 * right.m3
    var product_2 = left.m2 * right.m0 + left.m6 * right.m1 + left.m10 * right.m2 + left.m14 * right.m3
    var product_3 = left.m3 * right.m0 + left.m7 * right.m1 + left.m11 * right.m2 + left.m15 * right.m3
    var product_4 = left.m0 * right.m4 + left.m4 * right.m5 + left.m8 * right.m6 + left.m12 * right.m7
    var product_5 = left.m1 * right.m4 + left.m5 * right.m5 + left.m9 * right.m6 + left.m13 * right.m7
    var product_6 = left.m2 * right.m4 + left.m6 * right.m5 + left.m10 * right.m6 + left.m14 * right.m7
    var product_7 = left.m3 * right.m4 + left.m7 * right.m5 + left.m11 * right.m6 + left.m15 * right.m7
    var product_8 = left.m0 * right.m8 + left.m4 * right.m9 + left.m8 * right.m10 + left.m12 * right.m11
    var product_9 = left.m1 * right.m8 + left.m5 * right.m9 + left.m9 * right.m10 + left.m13 * right.m11
    var product_10 = left.m2 * right.m8 + left.m6 * right.m9 + left.m10 * right.m10 + left.m14 * right.m11
    var product_11 = left.m3 * right.m8 + left.m7 * right.m9 + left.m11 * right.m10 + left.m15 * right.m11
    var product_12 = left.m0 * right.m12 + left.m4 * right.m13 + left.m8 * right.m14 + left.m12 * right.m15
    var product_13 = left.m1 * right.m12 + left.m5 * right.m13 + left.m9 * right.m14 + left.m13 * right.m15
    var product_14 = left.m2 * right.m12 + left.m6 * right.m13 + left.m10 * right.m14 + left.m14 * right.m15
    var product_15 = left.m3 * right.m12 + left.m7 * right.m13 + left.m11 * right.m14 + left.m15 * right.m15
    m0 = product_0
    m1 = product_1
    m2 = product_2
    m3 = product_3
    m4 = product_4
    m5 = product_5
    m6 = product_6
    m7 = product_7
    m8 = product_8
    m9 = product_9
    m10 = product_10
    m11 = product_11
    m12 = product_12
    m13 = product_13
    m14 = product_14
    m15 = product_15
}

func set_product_with_values(left: Math.Matrix4, right: List<Float>, start: Integer) {
    var fits = start >= 0 and start + 16 <= right.count()
    crash fits
    var product_0 = left.m0 * right.get_at(start + 0) + left.m4 * right.get_at(start + 1) + left.m8 * right.get_at(start + 2) + left.m12 * right.get_at(start + 3)
    var product_1 = left.m1 * right.get_at(start + 0) + left.m5 * right.get_at(start + 1) + left.m9 * right.get_at(start + 2) + left.m13 * right.get_at(start + 3)
    var product_2 = left.m2 * right.get_at(start + 0) + left.m6 * right.get_at(start + 1) + left.m10 * right.get_at(start + 2) + left.m14 * right.get_at(start + 3)
    var product_3 = left.m3 * right.get_at(start + 0) + left.m7 * right.get_at(start + 1) + left.m11 * right.get_at(start + 2) + left.m15 * right.get_at(start + 3)
    var product_4 = left.m0 * right.get_at(start + 4) + left.m4 * right.get_at(start + 5) + left.m8 * right.get_at(start + 6) + left.m12 * right.get_at(start + 7)
    var product_5 = left.m1 * right.get_at(start + 4) + left.m5 * right.get_at(start + 5) + left.m9 * right.get_at(start + 6) + left.m13 * right.get_at(start + 7)
    var product_6 = left.m2 * right.get_at(start + 4) + left.m6 * right.get_at(start + 5) + left.m10 * right.get_at(start + 6) + left.m14 * right.get_at(start + 7)
    var product_7 = left.m3 * right.get_at(start + 4) + left.m7 * right.get_at(start + 5) + left.m11 * right.get_at(start + 6) + left.m15 * right.get_at(start + 7)
    var product_8 = left.m0 * right.get_at(start + 8) + left.m4 * right.get_at(start + 9) + left.m8 * right.get_at(start + 10) + left.m12 * right.get_at(start + 11)
    var product_9 = left.m1 * right.get_at(start + 8) + left.m5 * right.get_at(start + 9) + left.m9 * right.get_at(start + 10) + left.m13 * right.get_at(start + 11)
    var product_10 = left.m2 * right.get_at(start + 8) + left.m6 * right.get_at(start + 9) + left.m10 * right.get_at(start + 10) + left.m14 * right.get_at(start + 11)
    var product_11 = left.m3 * right.get_at(start + 8) + left.m7 * right.get_at(start + 9) + left.m11 * right.get_at(start + 10) + left.m15 * right.get_at(start + 11)
    var product_12 = left.m0 * right.get_at(start + 12) + left.m4 * right.get_at(start + 13) + left.m8 * right.get_at(start + 14) + left.m12 * right.get_at(start + 15)
    var product_13 = left.m1 * right.get_at(start + 12) + left.m5 * right.get_at(start + 13) + left.m9 * right.get_at(start + 14) + left.m13 * right.get_at(start + 15)
    var product_14 = left.m2 * right.get_at(start + 12) + left.m6 * right.get_at(start + 13) + left.m10 * right.get_at(start + 14) + left.m14 * right.get_at(start + 15)
    var product_15 = left.m3 * right.get_at(start + 12) + left.m7 * right.get_at(start + 13) + left.m11 * right.get_at(start + 14) + left.m15 * right.get_at(start + 15)
    m0 = product_0
    m1 = product_1
    m2 = product_2
    m3 = product_3
    m4 = product_4
    m5 = product_5
    m6 = product_6
    m7 = product_7
    m8 = product_8
    m9 = product_9
    m10 = product_10
    m11 = product_11
    m12 = product_12
    m13 = product_13
    m14 = product_14
    m15 = product_15
}

func copy_from(other: Math.Matrix4) {
    m0 = other.m0
    m1 = other.m1
    m2 = other.m2
    m3 = other.m3
    m4 = other.m4
    m5 = other.m5
    m6 = other.m6
    m7 = other.m7
    m8 = other.m8
    m9 = other.m9
    m10 = other.m10
    m11 = other.m11
    m12 = other.m12
    m13 = other.m13
    m14 = other.m14
    m15 = other.m15
}

func set_perspective(field_of_view: Float, aspect: Float, near: Float, far: Float) {
    var focal = 1.0 / scalar.tangent(field_of_view * 0.5)
    clear()
    m0 = focal / aspect
    m5 = 0.0 - focal
    m10 = far / (near - far)
    m11 = -1.0
    m14 = near * far / (near - far)
    m15 = 0.0
}

func set_reversed_perspective(field_of_view: Float, aspect: Float, near: Float, far: Float) {
    var focal = 1.0 / scalar.tangent(field_of_view * 0.5)
    clear()
    m0 = focal / aspect
    m5 = 0.0 - focal
    m10 = near / (far - near)
    m11 = -1.0
    m14 = near * far / (far - near)
    m15 = 0.0
}

func set_orthographic(half_width: Float, half_height: Float, near: Float, far: Float) {
    clear()
    m0 = 1.0 / half_width
    m5 = 1.0 / half_height
    m10 = -1.0 / (far - near)
    m14 = 0.0 - near / (far - near)
    m15 = 1.0
}

func set_look_at(eye_x: Float, eye_y: Float, eye_z: Float, target_x: Float, target_y: Float, target_z: Float) {
    var forward_x = target_x - eye_x
    var forward_y = target_y - eye_y
    var forward_z = target_z - eye_z
    var forward_length = scalar.square_root(forward_x * forward_x + forward_y * forward_y + forward_z * forward_z)
    forward_x = forward_x / forward_length
    forward_y = forward_y / forward_length
    forward_z = forward_z / forward_length
    var side_x = 0.0 - forward_z
    var side_z = forward_x
    var side_length = scalar.square_root(side_x * side_x + side_z * side_z)
    side_x = side_x / side_length
    side_z = side_z / side_length
    var up_x = 0.0 - side_z * forward_y
    var up_y = side_z * forward_x - side_x * forward_z
    var up_z = side_x * forward_y
    clear()
    m0 = side_x
    m4 = 0.0
    m8 = side_z
    m12 = 0.0 - (side_x * eye_x + side_z * eye_z)
    m1 = up_x
    m5 = up_y
    m9 = up_z
    m13 = 0.0 - (up_x * eye_x + up_y * eye_y + up_z * eye_z)
    m2 = 0.0 - forward_x
    m6 = 0.0 - forward_y
    m10 = 0.0 - forward_z
    m14 = forward_x * eye_x + forward_y * eye_y + forward_z * eye_z
    m15 = 1.0
}

func set_transform(
    position_x: Float,
    position_y: Float,
    position_z: Float,
    rotation_x: Float,
    rotation_y: Float,
    rotation_z: Float,
    rotation_w: Float,
    scale_x: Float,
    scale_y: Float,
    scale_z: Float,
) {
    var xx = rotation_x * rotation_x
    var yy = rotation_y * rotation_y
    var zz = rotation_z * rotation_z
    var xy = rotation_x * rotation_y
    var xz = rotation_x * rotation_z
    var yz = rotation_y * rotation_z
    var wx = rotation_w * rotation_x
    var wy = rotation_w * rotation_y
    var wz = rotation_w * rotation_z
    m0 = (1.0 - 2.0 * (yy + zz)) * scale_x
    m1 = 2.0 * (xy + wz) * scale_x
    m2 = 2.0 * (xz - wy) * scale_x
    m3 = 0.0
    m4 = 2.0 * (xy - wz) * scale_y
    m5 = (1.0 - 2.0 * (xx + zz)) * scale_y
    m6 = 2.0 * (yz + wx) * scale_y
    m7 = 0.0
    m8 = 2.0 * (xz + wy) * scale_z
    m9 = 2.0 * (yz - wx) * scale_z
    m10 = (1.0 - 2.0 * (xx + yy)) * scale_z
    m11 = 0.0
    m12 = position_x
    m13 = position_y
    m14 = position_z
    m15 = 1.0
}

func inverted(): Math.Matrix4 {
    var result = Math.Matrix4()
    result.m0 = m5 * m10 * m15 - m5 * m11 * m14 - m9 * m6 * m15 + m9 * m7 * m14 + m13 * m6 * m11 - m13 * m7 * m10
    result.m4 = 0.0 - m4 * m10 * m15 + m4 * m11 * m14 + m8 * m6 * m15 - m8 * m7 * m14 - m12 * m6 * m11 + m12 * m7 * m10
    result.m8 = m4 * m9 * m15 - m4 * m11 * m13 - m8 * m5 * m15 + m8 * m7 * m13 + m12 * m5 * m11 - m12 * m7 * m9
    result.m12 = 0.0 - m4 * m9 * m14 + m4 * m10 * m13 + m8 * m5 * m14 - m8 * m6 * m13 - m12 * m5 * m10 + m12 * m6 * m9
    result.m1 = 0.0 - m1 * m10 * m15 + m1 * m11 * m14 + m9 * m2 * m15 - m9 * m3 * m14 - m13 * m2 * m11 + m13 * m3 * m10
    result.m5 = m0 * m10 * m15 - m0 * m11 * m14 - m8 * m2 * m15 + m8 * m3 * m14 + m12 * m2 * m11 - m12 * m3 * m10
    result.m9 = 0.0 - m0 * m9 * m15 + m0 * m11 * m13 + m8 * m1 * m15 - m8 * m3 * m13 - m12 * m1 * m11 + m12 * m3 * m9
    result.m13 = m0 * m9 * m14 - m0 * m10 * m13 - m8 * m1 * m14 + m8 * m2 * m13 + m12 * m1 * m10 - m12 * m2 * m9
    result.m2 = m1 * m6 * m15 - m1 * m7 * m14 - m5 * m2 * m15 + m5 * m3 * m14 + m13 * m2 * m7 - m13 * m3 * m6
    result.m6 = 0.0 - m0 * m6 * m15 + m0 * m7 * m14 + m4 * m2 * m15 - m4 * m3 * m14 - m12 * m2 * m7 + m12 * m3 * m6
    result.m10 = m0 * m5 * m15 - m0 * m7 * m13 - m4 * m1 * m15 + m4 * m3 * m13 + m12 * m1 * m7 - m12 * m3 * m5
    result.m14 = 0.0 - m0 * m5 * m14 + m0 * m6 * m13 + m4 * m1 * m14 - m4 * m2 * m13 - m12 * m1 * m6 + m12 * m2 * m5
    result.m3 = 0.0 - m1 * m6 * m11 + m1 * m7 * m10 + m5 * m2 * m11 - m5 * m3 * m10 - m9 * m2 * m7 + m9 * m3 * m6
    result.m7 = m0 * m6 * m11 - m0 * m7 * m10 - m4 * m2 * m11 + m4 * m3 * m10 + m8 * m2 * m7 - m8 * m3 * m6
    result.m11 = 0.0 - m0 * m5 * m11 + m0 * m7 * m9 + m4 * m1 * m11 - m4 * m3 * m9 - m8 * m1 * m7 + m8 * m3 * m5
    result.m15 = m0 * m5 * m10 - m0 * m6 * m9 - m4 * m1 * m10 + m4 * m2 * m9 + m8 * m1 * m6 - m8 * m2 * m5
    var determinant = m0 * result.m0 + m1 * result.m4 + m2 * result.m8 + m3 * result.m12
    crash determinant != 0.0
    result.scale_all(1.0 / determinant)
    return result
}

func scale_all(factor: Float) {
    m0 = m0 * factor
    m1 = m1 * factor
    m2 = m2 * factor
    m3 = m3 * factor
    m4 = m4 * factor
    m5 = m5 * factor
    m6 = m6 * factor
    m7 = m7 * factor
    m8 = m8 * factor
    m9 = m9 * factor
    m10 = m10 * factor
    m11 = m11 * factor
    m12 = m12 * factor
    m13 = m13 * factor
    m14 = m14 * factor
    m15 = m15 * factor
}

func value_at(index: Integer): Float {
    switch index {
        0: return m0
        1: return m1
        2: return m2
        3: return m3
        4: return m4
        5: return m5
        6: return m6
        7: return m7
        8: return m8
        9: return m9
        10: return m10
        11: return m11
        12: return m12
        13: return m13
        14: return m14
        _: return m15
    }
}

func set_value(index: Integer, value: Float) {
    if index == 0 {
        m0 = value
    }
    if index == 1 {
        m1 = value
    }
    if index == 2 {
        m2 = value
    }
    if index == 3 {
        m3 = value
    }
    if index == 4 {
        m4 = value
    }
    if index == 5 {
        m5 = value
    }
    if index == 6 {
        m6 = value
    }
    if index == 7 {
        m7 = value
    }
    if index == 8 {
        m8 = value
    }
    if index == 9 {
        m9 = value
    }
    if index == 10 {
        m10 = value
    }
    if index == 11 {
        m11 = value
    }
    if index == 12 {
        m12 = value
    }
    if index == 13 {
        m13 = value
    }
    if index == 14 {
        m14 = value
    }
    if index == 15 {
        m15 = value
    }
}

func divisor_of(scale: Float): Float {
    var divisor = scale
    if divisor < 0.000001 {
        divisor = 1.0
    }
    return divisor
}

func is_finite(): Boolean {
    var sum = m0 + m1 + m2 + m3 + m4 + m5 + m6 + m7 + m8 + m9 + m10 + m11 + m12 + m13 + m14 + m15
    return sum == sum and sum < 1000000000000.0 and sum > -1000000000000.0
}

func decompose(pose: Math.Pose) {
    pose.position_x = m12
    pose.position_y = m13
    pose.position_z = m14
    pose.scale_x = scalar.square_root(m0 * m0 + m1 * m1 + m2 * m2)
    pose.scale_y = scalar.square_root(m4 * m4 + m5 * m5 + m6 * m6)
    pose.scale_z = scalar.square_root(m8 * m8 + m9 * m9 + m10 * m10)
    var across = divisor_of(pose.scale_x)
    var up = divisor_of(pose.scale_y)
    var forward = divisor_of(pose.scale_z)
    var r00 = m0 / across
    var r10 = m1 / across
    var r20 = m2 / across
    var r01 = m4 / up
    var r11 = m5 / up
    var r21 = m6 / up
    var r02 = m8 / forward
    var r12 = m9 / forward
    var r22 = m10 / forward
    var trace = r00 + r11 + r22
    if trace > 0.0 {
        var root = scalar.square_root(trace + 1.0) * 2.0
        pose.rotation_w = 0.25 * root
        pose.rotation_x = (r21 - r12) / root
        pose.rotation_y = (r02 - r20) / root
        pose.rotation_z = (r10 - r01) / root
    } else if r00 > r11 and r00 > r22 {
        var root = scalar.square_root(1.0 + r00 - r11 - r22) * 2.0
        pose.rotation_w = (r21 - r12) / root
        pose.rotation_x = 0.25 * root
        pose.rotation_y = (r01 + r10) / root
        pose.rotation_z = (r02 + r20) / root
    } else if r11 > r22 {
        var root = scalar.square_root(1.0 + r11 - r00 - r22) * 2.0
        pose.rotation_w = (r02 - r20) / root
        pose.rotation_x = (r01 + r10) / root
        pose.rotation_y = 0.25 * root
        pose.rotation_z = (r12 + r21) / root
    } else {
        var root = scalar.square_root(1.0 + r22 - r00 - r11) * 2.0
        pose.rotation_w = (r10 - r01) / root
        pose.rotation_x = (r02 + r20) / root
        pose.rotation_y = (r12 + r21) / root
        pose.rotation_z = 0.25 * root
    }
}

func set_pose(pose: Math.Pose) {
    set_transform(
        pose.position_x,
        pose.position_y,
        pose.position_z,
        pose.rotation_x,
        pose.rotation_y,
        pose.rotation_z,
        pose.rotation_w,
        pose.scale_x,
        pose.scale_y,
        pose.scale_z,
    )
}

func transform_point(target: Math.Vector3, x_value: Float, y_value: Float, z_value: Float) {
    target.x_value = m0 * x_value + m4 * y_value + m8 * z_value + m12
    target.y_value = m1 * x_value + m5 * y_value + m9 * z_value + m13
    target.z_value = m2 * x_value + m6 * y_value + m10 * z_value + m14
}

func transform_direction(target: Math.Vector3, x_value: Float, y_value: Float, z_value: Float) {
    var along_x = m0 * x_value + m4 * y_value + m8 * z_value
    var along_y = m1 * x_value + m5 * y_value + m9 * z_value
    var along_z = m2 * x_value + m6 * y_value + m10 * z_value
    var length = scalar.square_root(along_x * along_x + along_y * along_y + along_z * along_z)
    target.x_value = along_x / length
    target.y_value = along_y / length
    target.z_value = along_z / length
}

func clear() {
    m0 = 0.0
    m1 = 0.0
    m2 = 0.0
    m3 = 0.0
    m4 = 0.0
    m5 = 0.0
    m6 = 0.0
    m7 = 0.0
    m8 = 0.0
    m9 = 0.0
    m10 = 0.0
    m11 = 0.0
    m12 = 0.0
    m13 = 0.0
    m14 = 0.0
    m15 = 0.0
}

func write_to(address: Long) {
    floats.write_value(address, 0, m0)
    floats.write_value(address, 1, m1)
    floats.write_value(address, 2, m2)
    floats.write_value(address, 3, m3)
    floats.write_value(address, 4, m4)
    floats.write_value(address, 5, m5)
    floats.write_value(address, 6, m6)
    floats.write_value(address, 7, m7)
    floats.write_value(address, 8, m8)
    floats.write_value(address, 9, m9)
    floats.write_value(address, 10, m10)
    floats.write_value(address, 11, m11)
    floats.write_value(address, 12, m12)
    floats.write_value(address, 13, m13)
    floats.write_value(address, 14, m14)
    floats.write_value(address, 15, m15)
}
