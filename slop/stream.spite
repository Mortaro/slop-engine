generic $system_type
generic $row_type

enum Phase {
    'input'
    'after_input'
    'update'
    'prepare'
    'layout'
    'render'
    'after_render'
    'present'
    'last'
}

var system: $system_type = null
var matcher = Row<$row_type>()
var since = -1
var found = List<Integer>()
var wanted = ""

func Stream(streamed_system: $system_type, last_run: Integer, wanted_phase: String) {
    system = streamed_system
    since = last_run
    wanted = wanted_phase
}

func run_phase_each(phase: Symbol<$system_type.phase_each>) {
    assert phase.name == wanted
    matcher.since = since
    matcher.begin_stream()
    while found.count() < matcher.rows.count() {
        found.append(-1)
    }
    run_positions(phase, 0, matcher.stream_total, found)
}

func run_positions(phase: Symbol<$system_type.phase_each>, first: Integer, end: Integer, rows: List<Integer>) {
    var position = first
    while position < end {
        var entity = matcher.stream_entity(position)
        if matcher.match_into(entity, rows) {
            var row: $row_type = null
            fill_attributes(row, rows, entity)
            system.phase_each(row)
        }
        position = position + 1
    }
}

func fill_attribute(attribute: Symbol<$row_type>, row: $row_type, rows: List<Integer>, entity: Integer) {
    if attribute.class == Entity {
        var own = Entity()
        own.id = entity
        row.attributes[attribute] = own
    } else if attribute.class.fits_vector() and attribute.class != Entity {
        crash rows[attribute.index]
        var stored_row = rows[attribute.index]
        crash Column<attribute.class>().values[stored_row]
        row.attributes[attribute] = Column<attribute.class>().values[stored_row]
    } else {
        crash rows[attribute.index]
        var stored_row = rows[attribute.index]
        row.attributes[attribute] = Column<attribute.class>().at(stored_row)
    }
}
