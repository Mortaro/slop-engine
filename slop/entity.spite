var id = 0
var world = World()

func Entity(new_id: Integer) {
    id = new_id
}

func add_component(component: Anything) {
    var command = AddComponent(id, component, "")
    world.queue(command)
}

func remove_component(component_class: Spite.Class) {
    var command = RemoveComponent(id, component_class)
    world.queue(command)
}

func remove() {
    world.despawn(id)
}

func add_parent_entity(parent: Entity) {
    relate("parent", parent)
    world.parent_linked()
}

func add_child_entity(child: Entity) {
    var parent = Entity(id)
    child.add_parent_entity(parent)
}

func remove_parent_entity() {
    unrelate("parent")
}

func relate(name: String, target: Entity) {
    var kept = Entity(target.id)
    var command = AddComponent(id, kept, name)
    world.queue(command)
}

func unrelate(name: String) {
    var command = RemoveRelation(id, name)
    world.queue(command)
}
