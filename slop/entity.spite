var id = -1
var world = World()

func set_id(value: Integer) {
    var an_entity_id_is_zero_or_more = value >= 0
    crash an_entity_id_is_zero_or_more
    id = value
}

func add_component(component: Anything) {
    var an_entity_is_set_before_it_is_used = id >= 0
    crash an_entity_is_set_before_it_is_used
    var command = AddComponent(id, component)
    world.queue(command)
}

func remove_component(component_class: Spite.Class) {
    var an_entity_is_set_before_it_is_used = id >= 0
    crash an_entity_is_set_before_it_is_used
    var command = RemoveComponent(id, component_class)
    world.queue(command)
}

func remove() {
    var an_entity_is_set_before_it_is_used = id >= 0
    crash an_entity_is_set_before_it_is_used
    world.despawn(id)
}

func spawn_entity(): Entity {
    var an_entity_is_set_before_it_is_used = id >= 0
    crash an_entity_is_set_before_it_is_used
    var child = world.spawn_entity()
    var parent = Component.Parent()
    parent.entity = world.entity_of(id)
    child.add_component(parent)
    return child
}
