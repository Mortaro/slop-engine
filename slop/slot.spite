singleton

generic $slot_type

var column = Column<$slot_type>()
var world = World()

func tracking_kind(current: $slot_type): Integer {
    if $slot_type.has_function("tracking_kind") {
        return current.tracking_kind()
    }
    return 0
}

func tracked_key(current: $slot_type): String {
    if $slot_type.has_function("tracked_key") {
        return current.tracked_key()
    }
    return ""
}

func pinned(current: $slot_type): Boolean {
    if $slot_type.has_function("tracked_pinned") {
        return current.tracked_pinned()
    }
    if $slot_type.has_function("pinned_to_creating_thread") {
        return current.pinned_to_creating_thread()
    }
    return false
}

func fetch(entity: Integer, current: $slot_type, index: ColumnIndex, row: Integer): $slot_type {
    if $slot_type.has_function("fill_from") {
        current.fill_from(index, row)
        return current
    }
    if $slot_type == Entity {
        return world.entity_of(entity)
    }
    crash index.stored
    crash index.entity_at(row) == entity
    return column.value_at(row)
}

func store(current: $slot_type, index: ColumnIndex, row: Integer) {
    if $slot_type.has_function("fill_from") {
        crash row >= -1
    } else if $slot_type == Entity {
        crash row >= 0
    } else {
        store_component(current, index, row)
    }
}

func store_component(current: $slot_type, index: ColumnIndex, row: Integer) {
    assert index.stored
    column.write_at(row, current)
}

func link_target(value: $slot_type): Integer {
    if $slot_type == Entity or $slot_type.has_function("fill_from") {
        return -1
    }
    var link = Link<$slot_type>()
    return link.target_of(value)
}
