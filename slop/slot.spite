singleton

generic $slot_type

var raw = Raw()
var column = Column<$slot_type>()
var columns = Columns()

func tracking_kind(current: $slot_type): Integer {
    if $slot_type.has_function("tracking_kind") {
        return current.tracking_kind()
    }
    return 0
}

func tracked_key(current: $slot_type): String {
    if $slot_type.has_function("tracked_key") {
        return current.tracked_key()
    }
    return ""
}

func fetch(entity: Integer, current: $slot_type, column_header: Long, row: Integer): $slot_type {
    if $slot_type.has_function("fill_from") {
        current.fill_from(column_header, row)
        return current
    }
    if $slot_type == Entity {
        if column_header == 0 {
            current.id = entity
            return current
        }
    }
    crash column_header != 0
    var entities = raw.read_long(column_header, 24)
    crash raw.read_long(entities, row * 8) == entity
    var name = relation_name(column_header)
    return column.value_at(name, row)
}

func store(current: $slot_type, column_header: Long, row: Integer) {
    if $slot_type.has_function("fill_from") {
        crash row >= -1
    } else if $slot_type == Entity {
        crash row >= 0
    } else {
        store_component(current, column_header, row)
    }
}

func store_component(current: $slot_type, column_header: Long, row: Integer) {
    assert column_header != 0
    var name = relation_name(column_header)
    column.write_at(name, row, current)
}

func relation_name(column_header: Long): String {
    var name = ""
    if $slot_type == Entity {
        name = columns.name_of_header(column_header)
    }
    return name
}

func entity_of(value: $slot_type): Integer {
    if $slot_type == Entity {
        return value.id
    }
    return -1
}

func insert(entity: Integer, value: $slot_type, name: String) {
    var key = columns.key(value.class)
    if $slot_type == Entity {
        key = "Entity.{name}"
    }
    column.insert_keyed(entity, value, key)
}
