type Runnable {
    name: String
    placed_in: String
    accesses: List<String>
    timing: Profile.Timing
    run_once()
    start_waiting()
}

var phases = ["input", "after_input", "update", "prepare", "layout", "render", "after_render", "present", "last"]
var runners = List<Runnable>()
var stages = List<List<Runnable>>()
var stage_phases = List<String>()
var stage_timings = List<Profile.Timing>()
var frame_timing = Profile.Timing()
var clock = Clock()
var next_tick: Long = 0
var world = World()
var program = Program()
var scheduler = Scheduler()
var frame_milliseconds = 16
var longest_step: Long = 100
var measuring = false
var last_tick_at: Long = 0
var unspent_nanoseconds: Long = 0
var parallel = true
var release_budget = 4096
var columns = Columns()
var frame_column = Column<Component.Frame>()
var rule_breaks = 0

func App() {
    var frame = Component.Frame()
    frame_column.insert(world.entity, frame)
    scheduler.resume_only_when_asked()
    register_components()
    var components_follow_the_ecs_rules = rule_breaks == 0
    crash components_follow_the_ecs_rules
    add_systems()
    phases.each(build_phase)
}

func register_component(component: Symbol<Component>) {
    var column = Column<component.class>()
    column.prepare_column()
    var rule = ComponentRule<component.class>()
    rule_breaks = rule_breaks + rule.check()
}

func add_system(system: Symbol<System>) {
    var runner = Runner<system.class>()
    crash phases.contains(runner.placed_in)
    runners.append(runner)
}

func build_phase(phase: String) {
    var opened = false
    var index = 0
    while index < runners.count() {
        if runners[index].placed_in == phase {
            place(runners[index], phase, opened)
            opened = true
        }
        index = index + 1
    }
}

func place(runner: Runnable, phase: String, opened: Boolean) {
    var stage = stages.last()
    if opened and stage {
        if not conflicts(stage, runner) {
            stage.append(runner)
            return
        }
    }
    var fresh = List<Runnable>()
    fresh.append(runner)
    stages.append(fresh)
    stage_phases.append(phase)
    var stage_timing = Profile.Timing()
    stage_timings.append(stage_timing)
}

func conflicts(stage: List<Runnable>, candidate: Runnable): Boolean {
    var found = false
    var index = 0
    while not found and index < stage.count() {
        found = shares_access(stage[index], candidate)
        index = index + 1
    }
    return found
}

func shares_access(member: Runnable, candidate: Runnable): Boolean {
    var shared = false
    var index = 0
    while not shared and index < candidate.accesses.count() {
        shared = member.accesses.contains(candidate.accesses[index])
        index = index + 1
    }
    return shared
}

func quit_requested(): Boolean {
    var quits = Lookup<Component.Quit>()
    return quits.has(world.entity)
}

func run() {
    measuring = true
    last_tick_at = clock.elapsed_nanoseconds()
    begin_pacing()
    while not quit_requested() {
        tick()
        wait_for_next_tick()
    }
    tick()
}

func begin_pacing() {
    next_tick = clock.elapsed_nanoseconds()
}

func wait_for_next_tick() {
    var period: Long = frame_milliseconds * 1000000
    next_tick = next_tick + period
    var now = clock.elapsed_nanoseconds()
    if now < next_tick {
        var left = (next_tick - now) / 1000000
        program.sleep(left)
    } else {
        next_tick = now
    }
}

func step_now(): Integer {
    if not measuring {
        return frame_milliseconds
    }
    var now = clock.elapsed_nanoseconds()
    unspent_nanoseconds = unspent_nanoseconds + now - last_tick_at
    last_tick_at = now
    var step: Long = unspent_nanoseconds / 1000000
    unspent_nanoseconds = unspent_nanoseconds - step * 1000000
    if step > longest_step {
        step = longest_step
        unspent_nanoseconds = 0
    }
    var whole: Integer = step
    return whole
}

func tick() {
    var frame_started = clock.elapsed_nanoseconds()
    var frames = Lookup<Component.Frame>()
    var frame = frames.of(world.entity)
    crash frame
    frame.step_milliseconds = step_now()
    var index = 0
    while index < stages.count() {
        var stage_started = clock.elapsed_nanoseconds()
        run_stage(stages[index])
        var stage_finished = clock.elapsed_nanoseconds()
        crash stage_timings[index]
        stage_timings[index].record(stage_finished - stage_started)
        world.flush()
        columns.stage_counter = columns.stage_counter + 1
        var older_than = columns.stage_counter - stages.count() * 2
        columns.trim_removals(older_than)
        index = index + 1
    }
    columns.release_buried(release_budget)
    start_waiting_runners()
    scheduler.run_ready()
    var frame_finished = clock.elapsed_nanoseconds()
    frame_timing.record(frame_finished - frame_started)
}

func profile(): Profile.Report {
    var report = Profile.Report()
    report.frame = Profile.Entry("frame", "", -1, frame_timing)
    var index = 0
    while index < stages.count() {
        report_stage(report, index)
        index = index + 1
    }
    return report
}

func report_stage(report: Profile.Report, index: Integer) {
    crash stages[index]
    crash stage_phases[index]
    crash stage_timings[index]
    var phase = stage_phases[index]
    var stage_entry = Profile.Entry("stage {index}", phase, index, stage_timings[index])
    report.stages.append(stage_entry)
    var members = stages[index]
    var member = 0
    while member < members.count() {
        var runner = members[member]
        var system_entry = Profile.Entry(runner.name, phase, index, runner.timing)
        report.systems.append(system_entry)
        member = member + 1
    }
}

func profile_json(): String {
    var report = profile()
    var json = JsonWriter(report)
    return json.write()
}

func run_stage(stage: List<Runnable>) {
    var threaded = parallel and stage.count() > 1
    var running = List<Parallel<Nothing>>()
    var last = stage.count() - 1
    var index = 0
    while threaded and index < last {
        start_threaded(stage[index], running)
        index = index + 1
    }
    while index < stage.count() {
        stage[index].run_once()
        index = index + 1
    }
    running.clear()
}

func start_threaded(runner: Runnable, running: List<Parallel<Nothing>>) {
    var thread = Parallel(runner.run_once)
    running.append(thread)
}

func start_waiting_runners() {
    var index = 0
    while index < runners.count() {
        runners[index].start_waiting()
        index = index + 1
    }
}

func describe(): String {
    var lines = List<String>()
    var index = 0
    while index < stages.count() {
        describe_stage(lines, index)
        index = index + 1
    }
    return lines.join("\n")
}

func describe_stage(lines: List<String>, index: Integer) {
    crash stages[index]
    crash stage_phases[index]
    var phase = stage_phases[index]
    var names = stages[index].map_name()
    var joined = names.join(", ")
    lines.append("stage {index} ({phase}): {joined}")
}
