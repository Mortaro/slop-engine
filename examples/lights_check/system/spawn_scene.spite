type Started {
    frame: Added<Component.Frame>
}

var world = World()
var environment = Environment()

func update_each(_started: Started) {
    var window_bundle = Window.Bundle.Window()
    window_bundle.window.title = "Lights check"
    var window_entity = world.create_entity_from_bundle(window_bundle)
    if not environment.show_window {
        var hidden = Window.Component.Hidden()
        window_entity.add_component(hidden)
    }
    var night = Lighting.Bundle.Daylight()
    night.sun.illuminance = 0.0
    night.sky.luminance = 0.05
    night.sky.ground_luminance = 0.05
    night.exposure.value = 0.0
    world.create_entity_from_bundle(night)
    var camera_entity = world.create_entity()
    var camera = Camera.Component.Camera()
    camera.eye_x = 0.0
    camera.eye_y = 6.0
    camera.eye_z = 6.0
    camera.target_y = 0.0
    camera_entity.add_component(camera)
    add_floor()
    add_point(0.0, 1.0, 0.0)
    add_spot(3.0, 3.0, 0.0)
    add_extra_lights()
}

func add_floor() {
    var floor = world.create_entity()
    var model = Scene.Component.Model()
    model.mesh = "mesh.lights.cube"
    floor.add_component(model)
    var transform = Transform.Component.Transform()
    transform.position_y = -0.1
    transform.scale_x = 40.0
    transform.scale_y = 0.2
    transform.scale_z = 40.0
    floor.add_component(transform)
}

func add_point(at_x: Float, at_y: Float, at_z: Float) {
    var entity = world.create_entity()
    var light = Lighting.Component.PointLight()
    light.red = 1.0
    light.green = 0.1
    light.blue = 0.05
    light.intensity = 3.0
    light.range = 6.0
    entity.add_component(light)
    var transform = Transform.Component.Transform()
    transform.position_x = at_x
    transform.position_y = at_y
    transform.position_z = at_z
    entity.add_component(transform)
}

func add_spot(at_x: Float, at_y: Float, at_z: Float) {
    var entity = world.create_entity()
    var light = Lighting.Component.SpotLight()
    light.red = 0.2
    light.green = 0.4
    light.blue = 1.0
    light.intensity = 30.0
    light.range = 8.0
    light.inner_angle = 0.2
    light.outer_angle = 0.3
    entity.add_component(light)
    var transform = Transform.Component.Transform()
    transform.position_x = at_x
    transform.position_y = at_y
    transform.position_z = at_z
    transform.rotation_x = -0.7071068
    transform.rotation_w = 0.7071068
    entity.add_component(transform)
}

func add_extra_lights() {
    var index = 0
    while index < environment.extra_lights {
        var entity = world.create_entity()
        var light = Lighting.Component.PointLight()
        light.intensity = 0.001
        light.range = 4.0
        entity.add_component(light)
        var transform = Transform.Component.Transform()
        var column: Float = index % 60
        var row: Float = index / 60
        transform.position_x = column * 3.0 - 90.0
        transform.position_y = 0.5
        transform.position_z = 0.0 - row * 3.0 + 10.0
        entity.add_component(transform)
        index = index + 1
    }
}
