type Hunting {
    transform: Transform.Component.Transform
    monster: Component.Monster
}

var grid = Spatial.Grid()
var found = List<Integer>()

func update_each(hunting: Hunting) {
    found.clear()
    grid.within(0, hunting.transform.position_x, hunting.transform.position_z, 20.0, found)
    hunting.monster.nearby = found.count()
}
