type Checked {
    view: Scene.Component.View
}

type Quitting {
    frame: Component.Frame
    running: Without<Component.Quit>
}

var console = Console()
var rendered = 0

var world = World()

func last_each(checked: Checked, quitting: Quitting) {
    assert checked.view.draws.count() > 0
    rendered = rendered + 1
    assert rendered == 300
    var drawn = checked.view.draws.count()
    console.print("drawn", drawn)
    var quit = Component.Quit()
    var shelf = world.as_entity()
    shelf.add_component(quit)
}
