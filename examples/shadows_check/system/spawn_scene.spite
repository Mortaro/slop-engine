type Started {
    frame: Added<Component.Frame>
}

var world = World()
var environment = Environment()
var stage = Stage()

func update_each(_started: Started) {
    var window_bundle = Window.Bundle.Window()
    window_bundle.window.title = "Shadows check"
    window_bundle.window.width = 1280
    window_bundle.window.height = 720
    var window_entity = world.create_entity_from_bundle(window_bundle)
    if not environment.show_window {
        var hidden = Window.Component.Hidden()
        window_entity.add_component(hidden)
    }
    var daylight = Lighting.Bundle.Daylight()
    daylight.sun.direction_x = stage.sun_x
    daylight.sun.direction_y = stage.sun_y
    daylight.sun.direction_z = stage.sun_z
    var sun = world.create_entity_from_bundle(daylight)
    var no_bloom = PostProcess.Component.Bloom()
    no_bloom.intensity = 0.0
    sun.add_component(no_bloom)
    stage.sun = sun.id
    var camera_entity = world.create_entity()
    var camera = Camera.Component.Camera()
    camera.far = 1000.0
    camera_entity.add_component(camera)
    stage.camera = camera_entity.id
    add_block(0.0, -0.1, 60.0, 300.0, 0.2, 300.0)
    add_block(-1.5, 1.0, 6.0, 1.0, 2.0, 1.0)
    add_block(-4.0, 2.5, 32.0, 2.0, 5.0, 2.0)
    add_block(-10.0, 6.0, 100.0, 5.0, 12.0, 5.0)
    add_block(57.5, 0.25, -30.0, 0.5, 0.5, 0.5)
    add_block(65.0, 0.5, -30.0, 0.6, 1.0, 0.6)
    add_point(56.0, 1.0, -30.0)
    add_spot(64.0, 4.0, -30.0)
}

func add_block(at_x: Float, at_y: Float, at_z: Float, size_x: Float, size_y: Float, size_z: Float) {
    var block = world.create_entity()
    var model = Scene.Component.Model()
    model.mesh = "mesh.shadows.cube"
    block.add_component(model)
    var transform = Transform.Component.Transform()
    transform.position_x = at_x
    transform.position_y = at_y
    transform.position_z = at_z
    transform.scale_x = size_x
    transform.scale_y = size_y
    transform.scale_z = size_z
    block.add_component(transform)
}

func add_point(at_x: Float, at_y: Float, at_z: Float) {
    var entity = world.create_entity()
    var light = Lighting.Component.PointLight()
    light.intensity = 10.0
    light.range = 6.0
    entity.add_component(light)
    var shadowing = Lighting.Component.CastsShadows()
    entity.add_component(shadowing)
    var transform = Transform.Component.Transform()
    transform.position_x = at_x
    transform.position_y = at_y
    transform.position_z = at_z
    entity.add_component(transform)
}

func add_spot(at_x: Float, at_y: Float, at_z: Float) {
    var entity = world.create_entity()
    var light = Lighting.Component.SpotLight()
    light.intensity = 30.0
    light.range = 8.0
    light.inner_angle = 0.5
    light.outer_angle = 0.6
    entity.add_component(light)
    var shadowing = Lighting.Component.CastsShadows()
    entity.add_component(shadowing)
    var transform = Transform.Component.Transform()
    transform.position_x = at_x
    transform.position_y = at_y
    transform.position_z = at_z
    transform.rotation_x = -0.7071068
    transform.rotation_w = 0.7071068
    entity.add_component(transform)
}
