type Checked {
    entity: Entity
    draw_list: Render.Component.DrawList
    camera: Scene.Component.ViewCamera
}

type Quitting {
    frame: Component.Frame
    running: Without<Component.Quit>
}

var renderer = RenderVulkan.Renderer()
var textures = Render.Textures()
var draws = Scene.Draws()
var console = Console()
var world = World()
var environment = Environment()
var stage = Stage()
var scalar = Math.Scalar()
var captured_frames = Lookup<RenderVulkan.Component.Captured>()
var cameras = Lookup<Camera.Component.Camera>()
var suns = Lookup<Lighting.Component.Sun>()
var skies = Lookup<Lighting.Component.Sky>()
var exposures = Lookup<Lighting.Component.Exposure>()
var last_draws = -1
var steady_ticks = 0
var waiting = false
var aimed = false
var reference: Float = 0.0
var edge: Float = 0.0
var edge_x: Float = 0.0
var edge_z: Float = 0.0
var failures = 0
var last_level: Float = -1.0
var steady_captures = 0

func last_each(checked: Checked, _quitting: Quitting) {
    if not aimed {
        aim(0.0, 8.0, -14.0, 0.0, 0.0, 30.0)
        aimed = true
        return
    }
    var drawn = draws.of(checked.entity.id).draws.count()
    if not waiting {
        assert settled(drawn)
        var request = RenderVulkan.Component.CaptureRequested()
        checked.entity.add_component(request)
        waiting = true
        return
    }
    assert captured_frames.has(checked.entity.id)
    checked.entity.remove_component(RenderVulkan.Component.Captured)
    waiting = false
    var level = frame_level(checked.draw_list.width, checked.draw_list.height)
    assert pixels_steady(level)
    steady_ticks = 0
    last_draws = -1
    last_level = -1.0
    steady_captures = 0
    check_step(checked)
}

func frame_level(width: Integer, height: Integer): Float {
    var total = 0
    var down = 1
    while down < 8 {
        var across = 1
        while across < 8 {
            var pixel = renderer.pixel_at(width * across / 8, height * down / 8)
            total = total + pixel.bits_and(255) + pixel.shifted_right(8).bits_and(255)
            across = across + 1
        }
        down = down + 1
    }
    var level: Float = total
    return level / 98.0
}

func pixels_steady(level: Float): Boolean {
    var change = scalar.absolute(level - last_level)
    last_level = level
    if change <= 0.25 {
        steady_captures = steady_captures + 1
    } else {
        steady_captures = 0
    }
    return steady_captures >= 4
}

func settled(drawn: Integer): Boolean {
    var resident = not renderer.uploads_pending(textures)
    if drawn > 0 and drawn == last_draws and resident {
        steady_ticks = steady_ticks + 1
    } else {
        steady_ticks = 0
    }
    last_draws = drawn
    return steady_ticks >= 3
}

func aim(eye_x: Float, eye_y: Float, eye_z: Float, target_x: Float, target_y: Float, target_z: Float) {
    var camera = cameras.of(stage.camera)
    crash camera
    camera.eye_x = eye_x
    camera.eye_y = eye_y
    camera.eye_z = eye_z
    camera.target_x = target_x
    camera.target_y = target_y
    camera.target_z = target_z
}

func check_step(checked: Checked) {
    var width = checked.draw_list.width
    var height = checked.draw_list.height
    if stage.step == 0 {
        check_sun(checked.camera, width, height, "close")
        edge = edge_brightness(checked.camera, width, height)
        var step_x = (edge_x - 0.0) * 0.03
        var step_y = (0.0 - 8.0) * 0.03
        var step_z = (edge_z + 14.0) * 0.03
        aim(step_x, 8.0 + step_y, step_z - 14.0, step_x, step_y, 30.0 + step_z)
        stage.step = 1
        save(width, height, "shadows_close.bmp")
        return
    }
    if stage.step == 1 {
        var moved = edge_brightness(checked.camera, width, height)
        console.print("shadow edge", edge, "after the camera moved", moved)
        var difference = scalar.absolute(moved - edge)
        expect(difference <= 1.5, "the shadow edge holds still while the camera moves")
        aim(-60.0, 70.0, -50.0, -5.0, 0.0, 50.0)
        stage.step = 2
        return
    }
    if stage.step == 2 {
        check_sun(checked.camera, width, height, "far")
        fall_night()
        aim(60.0, 11.0, -42.0, 60.0, 0.0, -30.0)
        stage.step = 3
        save(width, height, "shadows_far.bmp")
        return
    }
    check_lights(checked.camera, width, height)
    console.print("shadows check failures", failures, "passed", failures == 0)
    var quit = Component.Quit()
    world.as_entity().add_component(quit)
    save(width, height, "shadows_lights.bmp")
    crash failures == 0
}

func edge_brightness(camera: Scene.Component.ViewCamera, width: Integer, height: Integer): Float {
    var flat = scalar.square_root(stage.sun_x * stage.sun_x + stage.sun_z * stage.sun_z)
    var across_x = stage.sun_x / flat
    var across_z = stage.sun_z / flat
    var side = 0.5 * (scalar.absolute(across_x) + scalar.absolute(across_z))
    edge_x = -1.5 + across_x * 1.5 - across_z * side
    edge_z = 6.0 + across_z * 1.5 + across_x * side
    return brightness_at(camera, width, height, edge_x, 0.0, edge_z)
}

func check_sun(camera: Scene.Component.ViewCamera, width: Integer, height: Integer, name: String) {
    var open_near = brightness_at(camera, width, height, 3.0, 0.0, 4.0)
    var open_middle = brightness_at(camera, width, height, 4.0, 0.0, 15.0)
    var open_far = brightness_at(camera, width, height, -20.0, 0.0, 60.0)
    reference = (open_near + open_middle + open_far) / 3.0
    console.print(name, "open floor", open_near, open_middle, open_far)
    var even = open_near > reference * 0.95 and open_middle > reference * 0.95 and open_far > reference * 0.95
    expect(even, "the open floor is evenly lit")
    var close = name == "close"
    if close {
        check_box(camera, width, height, name, -1.5, 6.0, 0.5, 2.0, close)
    }
    check_box(camera, width, height, name, -4.0, 32.0, 1.0, 5.0, close)
    check_box(camera, width, height, name, -10.0, 100.0, 2.5, 12.0, close)
}

func check_box(
    camera: Scene.Component.ViewCamera,
    width: Integer,
    height: Integer,
    name: String,
    center_x: Float,
    center_z: Float,
    half: Float,
    tall: Float,
    touching: Boolean,
) {
    var flat = scalar.square_root(stage.sun_x * stage.sun_x + stage.sun_z * stage.sun_z)
    var across_x = stage.sun_x / flat
    var across_z = stage.sun_z / flat
    var reach = tall * flat / (0.0 - stage.sun_y)
    var size_x = scalar.absolute(across_x)
    var size_z = scalar.absolute(across_z)
    var leave = half / scalar.maximum(size_x, size_z)
    var shaded_at = reach * 0.5
    var contact_at = leave + 0.12
    var lit_at = 0.0 - leave - 2.0
    var shaded_x = center_x + across_x * shaded_at
    var shaded_z = center_z + across_z * shaded_at
    var shaded = brightness_at(camera, width, height, shaded_x, 0.0, shaded_z)
    var contact_x = center_x + across_x * contact_at
    var contact_z = center_z + across_z * contact_at
    var contact = brightness_at(camera, width, height, contact_x, 0.0, contact_z)
    var lit_x = center_x + across_x * lit_at
    var lit_z = center_z + across_z * lit_at
    var lit = brightness_at(camera, width, height, lit_x, 0.0, lit_z)
    console.print(name, "box at", center_z, "shaded", shaded, "contact", contact, "lit", lit)
    expect(shaded < reference * 0.6, "the shadow lands behind the box")
    expect(not touching or contact < reference * 0.6, "the shadow reaches the box")
    expect(lit > reference * 0.95, "the sunny side stays lit")
}

func check_lights(camera: Scene.Component.ViewCamera, width: Integer, height: Integer) {
    var point_shaded = brightness_at(camera, width, height, 59.0, 0.0, -30.0)
    var point_lit = brightness_at(camera, width, height, 53.0, 0.0, -30.0)
    var spot_shaded = brightness_at(camera, width, height, 65.6, 0.0, -30.0)
    var spot_lit = brightness_at(camera, width, height, 62.4, 0.0, -30.0)
    console.print("point shaded", point_shaded, "lit", point_lit, "spot shaded", spot_shaded, "lit", spot_lit)
    expect(point_lit > 20.0 and point_shaded < point_lit * 0.35, "the point light casts a shadow")
    expect(spot_lit > 20.0 and spot_shaded < spot_lit * 0.35, "the spot light casts a shadow")
}

func expect(holds: Boolean, what: String) {
    if not holds {
        console.print("failed:", what)
        failures = failures + 1
    }
}

func fall_night() {
    var sun = suns.of(stage.sun)
    crash sun
    sun.illuminance = 0.0
    var sky = skies.of(stage.sun)
    crash sky
    sky.luminance = 0.05
    sky.ground_luminance = 0.05
    var exposure = exposures.of(stage.sun)
    crash exposure
    exposure.value = 0.0
}

func brightness_at(
    camera: Scene.Component.ViewCamera,
    width: Integer,
    height: Integer,
    at_x: Float,
    at_y: Float,
    at_z: Float,
): Float {
    var projection = camera.projection(camera.aspect)
    var both = projection.multiplied(camera.view)
    var clip_x = both.m0 * at_x + both.m4 * at_y + both.m8 * at_z + both.m12
    var clip_y = both.m1 * at_x + both.m5 * at_y + both.m9 * at_z + both.m13
    var clip_w = both.m3 * at_x + both.m7 * at_y + both.m11 * at_z + both.m15
    var wide: Float = width
    var high: Float = height
    var column_at = scalar.floor((clip_x / clip_w * 0.5 + 0.5) * wide)
    var row_at = scalar.floor((clip_y / clip_w * 0.5 + 0.5) * high)
    var column = column_at.to_integer()
    var row = row_at.to_integer()
    var inside = column > 1 and row > 1 and column < width - 2 and row < height - 2 and clip_w > 0.0
    crash inside
    var sum = 0
    var down = -1
    while down <= 1 {
        var beside = -1
        while beside <= 1 {
            var pixel = renderer.pixel_at(column + beside, row + down)
            var red = pixel.shifted_right(16).bits_and(255)
            var green = pixel.shifted_right(8).bits_and(255)
            var blue = pixel.bits_and(255)
            sum = sum + red + green + blue
            beside = beside + 1
        }
        down = down + 1
    }
    var total: Float = sum
    return total / 27.0
}

func save(width: Integer, height: Integer, name: String) {
    assert environment.save_folder != ""
    var row_bytes = width * 3
    var padding = (4 - row_bytes % 4) % 4
    var data_bytes = (row_bytes + padding) * height
    var image = Asset.Bytes()
    image.write_byte(66)
    image.write_byte(77)
    image.write_integer(54 + data_bytes)
    image.write_integer(0)
    image.write_integer(54)
    image.write_integer(40)
    image.write_integer(width)
    image.write_integer(height)
    image.write_byte(1)
    image.write_byte(0)
    image.write_byte(24)
    image.write_byte(0)
    image.write_integer(0)
    image.write_integer(data_bytes)
    image.write_integer(2835)
    image.write_integer(2835)
    image.write_integer(0)
    image.write_integer(0)
    var row = height - 1
    while row >= 0 {
        var column = 0
        while column < width {
            var texel = renderer.pixel_at(column, row)
            var blue = texel.bits_and(255)
            var green = texel.shifted_right(8).bits_and(255)
            var red = texel.shifted_right(16).bits_and(255)
            image.write_byte(blue)
            image.write_byte(green)
            image.write_byte(red)
            column = column + 1
        }
        var pad = 0
        while pad < padding {
            image.write_byte(0)
            pad = pad + 1
        }
        row = row - 1
    }
    image.save("{environment.save_folder}/{name}")
}
