type Started {
    ringing: Added<Component.Ringing>
}

type Stopped {
    ringing: Removed<Component.Ringing>
}

type Tallied {
    tally: Component.Tally
}

func render_all(started: List<Started>, stopped: List<Stopped>, tallies: List<Tallied>) {
    assert tallies.count() > 0
    var tally = tallies[0].tally
    tally.started_late = tally.started_late + started.count()
    tally.stopped_late = tally.stopped_late + stopped.count()
}
