type Playing {
    frame: Component.Frame
    count: Component.ClickCount
    running: Without<Component.Quit>
}

var world = World()
var environment = Environment()
var console = Console()
var first_seen = -1

func update_each(playing: Playing) {
    var clicks = playing.count.clicks
    if first_seen < 0 {
        first_seen = clicks
        console.print("bot joined and sees", clicks)
        if environment.expect >= 0 {
            crash clicks == environment.expect
        }
        send_clicks()
    }
    if clicks >= first_seen + environment.clicks {
        console.print("bot clicked", environment.clicks, "and sees", clicks)
        var quit = Component.Quit()
        var shelf = world.as_entity()
        shelf.add_component(quit)
    }
}

func send_clicks() {
    assert environment.clicks > 0
    var request = world.create_entity()
    var click = Component.ClickRequest()
    click.clicks = environment.clicks
    request.add_component(click)
}
