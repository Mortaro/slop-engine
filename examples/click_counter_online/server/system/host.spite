type Started {
    frame: Added<Component.Frame>
}

var world = World()
var environment = Environment()
var console = Console()

func update_each(_started: Started) {
    var listen = Network.Component.Listen()
    listen.port = environment.port
    var counter = world.as_entity()
    counter.add_component(listen)
    var count = Component.ClickCount()
    counter.add_component(count)
    console.print("server listening on port", environment.port)
}
