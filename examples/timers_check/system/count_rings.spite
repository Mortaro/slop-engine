type Counted {
    entity: Entity
    rang: Component.Rang
    timer: Component.Timer
    rings: Component.Rings
}

var repeating = Lookup<Component.Repeating>()

func update_each(counted: Counted) {
    if repeating.has(counted.entity.id) {
        counted.rings.repeating = counted.rings.repeating + 1
    } else if counted.timer.fraction() == 1.0 {
        counted.rings.once = counted.rings.once + 1
    }
}
