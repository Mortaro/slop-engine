type Scripted {
    script: Component.Script
}

type Counted {
    entity: Entity
    tally: Component.Tally
}

var console = Console()
var world = World()
var echoes = Lookup<Component.Echo>()
var gauges = Lookup<Component.Gauge>()
var streamed = Lookup<Component.Streamed>()
var untouched = Lookup<Component.Untouched>()
var looked = Lookup<Component.Looked>()
var replaced = Lookup<Component.Replaced>()
var listed = Lookup<Component.Listed>()
var seen = List<String>()
var passed = true
var current_step = 0

func last_all(scripts: List<Scripted>, counted: List<Counted>) {
    var scripted = scripts.first()
    crash scripted
    var script = scripted.script
    script.step = script.step + 1
    current_step = script.step
    counted.each(make_due)
    assert script.step == 6
    seen.clear()
    counted.each(check)
    var echo = echoes.of(world.entity)
    crash echo
    var a_writer_never_sees_its_own_write = echo.heard == 102
    var report = seen.join(" ")
    console.print("changed seen early/late:", report, "echo heard", echo.heard)
    crash a_writer_never_sees_its_own_write
    crash passed
    console.print("passed true")
    var quit = Component.Quit()
    world.as_entity().add_component(quit)
}

func step_of(entity: Integer): Integer {
    if streamed.has(entity) {
        return 1
    } else if looked.has(entity) {
        return 2
    } else if replaced.has(entity) {
        return 3
    } else if listed.has(entity) {
        return 4
    }
    return 0
}

func make_due(row: Counted) {
    var step = step_of(row.entity.id)
    if step == current_step {
        var due = Component.Due()
        row.entity.add_component(due)
    } else if step == current_step - 1 {
        row.entity.remove_component(Component.Due)
    }
}

func check(row: Counted) {
    var tally = row.tally
    seen.append("{tally.early}/{tally.late}")
    var expected = 2
    if untouched.has(row.entity.id) {
        expected = 1
    }
    var right = tally.early == expected and tally.late == expected
    if not right {
        passed = false
    }
    if replaced.has(row.entity.id) {
        var gauge = gauges.of(row.entity.id)
        crash gauge
        passed = passed and gauge.amount == 5
    }
}
