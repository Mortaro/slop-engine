var console = Console()
var tree = Cases.Tree()

func FlexLayout() {
    load "../../slop"
    load "../../plugins/slop_window_plugin"
    load "../../plugins/slop_platform_plugin"
    load "../../plugins/slop_input_plugin"
    load "../../plugins/slop_ui_plugin"
    var app = App()
    var justify = Cases.Justify()
    var growing = Cases.Growing()
    var alignment = Cases.Alignment()
    var positioning = Cases.Positioning()
    var scrolling = Cases.Scrolling()
    var grid = Cases.Grid()
    var stacking = Cases.Stacking()
    justify.build()
    growing.build()
    alignment.build()
    positioning.build()
    scrolling.build()
    grid.build()
    stacking.build()
    app.tick()
    app.tick()
    justify.check()
    growing.check()
    scrolling.check()
    stacking.check()
    tree.check_all()
    var passed = tree.checks - tree.failures
    console.print("layout checks", tree.checks, "passed", passed, "failed", tree.failures)
    crash tree.failures == 0
}
