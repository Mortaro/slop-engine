var cookbook = Recipes.Cookbook()
var console = Console()

func PropsBench() {
    load "../../slop"
    load "../../plugins/slop_window_plugin"
    load "../../plugins/slop_platform_plugin"
    load "../../plugins/slop_input_plugin"
    load "../../plugins/slop_ui_plugin"
    load "../../plugins/slop_render_plugin"
    load "../../plugins/slop_render_vulkan_plugin"
    load "../../plugins/slop_transform_plugin"
    load "../../plugins/slop_camera_plugin"
    load "../../plugins/slop_scene_plugin"
    load "../../plugins/slop_scene_vulkan_plugin"
    cookbook.cook()
    var app = App()
    app.frame_milliseconds = 1
    app.run()
    var report = app.profile()
    crash report.frame
    console.print("frame microseconds", report.frame.average_microseconds)
    var index = 0
    while index < report.systems.count() {
        var entry = report.systems[index]
        if entry.average_microseconds > 200 {
            console.print(entry.name, entry.average_microseconds)
        }
        index = index + 1
    }
}
