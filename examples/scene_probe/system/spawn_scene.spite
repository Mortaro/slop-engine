type Started {
    frame: Added<Component.Frame>
}

var world = World()
var environment = Environment()

func update_each(_started: Started) {
    var window_bundle = Window.Bundle.Window()
    window_bundle.window.title = "Scene probe"
    var window_entity = world.spawn_entity_from_bundle(window_bundle)
    if not environment.show_window {
        var hidden = Window.Component.Hidden()
        window_entity.add_component(hidden)
    }
    var camera_entity = world.spawn_entity()
    var camera = Camera.Component.Camera()
    camera.eye_x = 2.0
    camera.eye_y = 1.5
    camera.eye_z = 2.5
    camera.target_y = 0.0
    camera_entity.add_component(camera)
    var cube = world.spawn_entity()
    var model = Scene.Component.Model()
    model.mesh = "mesh.probe.cube"
    cube.add_component(model)
    var transform = Transform.Component.Transform()
    cube.add_component(transform)
    var behind = world.spawn_entity()
    var behind_model = Scene.Component.Model()
    behind_model.mesh = "mesh.probe.cube"
    behind.add_component(behind_model)
    var behind_transform = Transform.Component.Transform()
    behind_transform.position_x = 8.0
    behind_transform.position_y = 6.0
    behind_transform.position_z = 10.0
    behind.add_component(behind_transform)
}
