type Started {
    frame: Added<Component.Frame>
}

var world = World()
var environment = Environment()

func update_each(_started: Started) {
    var window_bundle = Window.Bundle.Window()
    window_bundle.window.title = "Post check"
    var window_entity = world.create_entity_from_bundle(window_bundle)
    if not environment.show_window {
        var hidden = Window.Component.Hidden()
        window_entity.add_component(hidden)
    }
    var night = Lighting.Bundle.Daylight()
    night.sun.illuminance = 0.0
    night.sky.luminance = 0.0
    night.sky.ground_luminance = 0.0
    night.exposure.value = 0.0
    world.create_entity_from_bundle(night)
    var camera_entity = world.create_entity()
    var camera = Camera.Component.Camera()
    camera.eye_x = 0.0
    camera.eye_y = 1.0
    camera.eye_z = 8.0
    camera.target_x = 0.0
    camera.target_y = 1.0
    camera.target_z = 0.0
    camera_entity.add_component(camera)
    var cube = world.create_entity()
    var model = Scene.Component.Model()
    model.mesh = "mesh.post.cube"
    cube.add_component(model)
    var placed = Transform.Component.Transform()
    placed.position_y = 1.0
    cube.add_component(placed)
    var lamp = world.create_entity()
    var light = Lighting.Component.PointLight()
    light.intensity = 2000.0
    light.range = 1.5
    lamp.add_component(light)
    var lamp_at = Transform.Component.Transform()
    lamp_at.position_y = 1.0
    lamp_at.position_z = 1.2
    lamp.add_component(lamp_at)
}
