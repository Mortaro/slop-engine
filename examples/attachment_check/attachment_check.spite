var cookbook = Recipes.Cookbook()
var world = World()
var console = Console()
var program = Program()

func AttachmentCheck() {
    load "../../slop"
    load "../../plugins/slop_transform_plugin"
    load "../../plugins/slop_camera_plugin"
    load "../../plugins/slop_animation_plugin"
    cookbook.cook()
    var app = App()
    var carrier = world.create_entity()
    var animator = Animation.Component.Animator()
    animator.skeleton = "attach.skeleton"
    animator.clip = "attach.clip"
    animator.speed = 0.0
    carrier.add_component(animator)
    var standing = Transform.Component.Transform()
    standing.position_x = 5.0
    carrier.add_component(standing)
    var sword = attach(carrier, "hand", -1, 1.0)
    var spark = attach(carrier, "", 1, 0.0)
    var ticks = 0
    while ticks < 300 and not placed(sword) {
        app.tick()
        program.sleep(5)
        ticks = ticks + 1
    }
    app.tick()
    var sword_right = near(sword, 5.0, 0.0, -2.0)
    var spark_right = near(spark, 5.0, 0.0, -1.0)
    var turned = turned_quarter(sword)
    var passed = sword_right and spark_right and turned
    console.print("ticks", ticks, "sword", sword_right, "spark", spark_right, "turned", turned, "passed", passed)
    crash passed
}

func attach(carrier: Entity, bone: String, bone_index: Integer, reach: Float): Integer {
    var held = carrier.create_entity()
    var attachment = Animation.Component.BoneAttachment()
    attachment.bone = bone
    attachment.bone_index = bone_index
    attachment.position_x = reach
    held.add_component(attachment)
    var transform = Transform.Component.Transform()
    held.add_component(transform)
    return held.id
}

func placed(entity: Integer): Boolean {
    var transforms = Lookup<Transform.Component.Transform>()
    var transform = transforms.of(entity)
    if not transform {
        return false
    }
    return transform.position_x != 0.0
}

func near(entity: Integer, want_x: Float, want_y: Float, want_z: Float): Boolean {
    var transforms = Lookup<Transform.Component.Transform>()
    var transform = transforms.of(entity)
    crash transform
    var off = (transform.position_x - want_x).absolute() + (transform.position_y - want_y).absolute()
    off = off + (transform.position_z - want_z).absolute()
    console.print("entity", entity, "at", transform.position_x, transform.position_y, transform.position_z)
    return off < 0.001
}

func turned_quarter(entity: Integer): Boolean {
    var transforms = Lookup<Transform.Component.Transform>()
    var transform = transforms.of(entity)
    crash transform
    var turn = transform.rotation_y.absolute() - 0.7071068
    return turn.absolute() < 0.001 and transform.rotation_x.absolute() < 0.001
}
