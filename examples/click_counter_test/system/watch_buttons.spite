type Watched {
    entity: Entity
    mouse: Input.Component.Mouse
}

type Tested {
    progress: Component.Progress
}

var right_presses = Lookup<Input.Component.RightPressed>()
var middle_presses = Lookup<Input.Component.MiddlePressed>()
var double_clicks = Lookup<Input.Component.DoubleClicked>()

func update_each(watched: Watched, tested: Tested) {
    var progress = tested.progress
    var owner = watched.entity.id
    var right = right_presses.has(owner)
    var middle = middle_presses.has(owner)
    var doubled = double_clicks.has(owner)
    progress.saw_right = progress.saw_right or right
    progress.saw_middle = progress.saw_middle or middle
    progress.saw_double = progress.saw_double or doubled
}
