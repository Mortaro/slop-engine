type Watched {
    entity: Entity
    mouse: Input.Component.Mouse
}

type Tested {
    entity: Entity
    progress: Component.Progress
}

var right_presses = Lookup<Input.Component.RightPressed>()
var middle_presses = Lookup<Input.Component.MiddlePressed>()
var double_clicks = Lookup<Input.Component.DoubleClicked>()
var saw_rights = Lookup<Component.SawRight>()
var saw_middles = Lookup<Component.SawMiddle>()
var saw_doubles = Lookup<Component.SawDouble>()

func update_each(watched: Watched, tested: Tested) {
    var owner = watched.entity.id
    var tester = tested.entity
    if right_presses.has(owner) and not saw_rights.has(tester.id) {
        var right = Component.SawRight()
        tester.add_component(right)
    }
    if middle_presses.has(owner) and not saw_middles.has(tester.id) {
        var middle = Component.SawMiddle()
        tester.add_component(middle)
    }
    if double_clicks.has(owner) and not saw_doubles.has(tester.id) {
        var doubled = Component.SawDouble()
        tester.add_component(doubled)
    }
}
