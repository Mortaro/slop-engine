type Counted {
    click_count: Component.ClickCount
    image: Ui.Component.BackgroundImage
    layout: Ui.Component.ComputedLayout
}

type Shown {
    label: Component.CountLabel
    text: Ui.Component.Text
}

type Tested {
    progress: Component.Progress
}

type Quitting {
    frame: Component.Frame
    running: Without<Component.Quit>
}

var console = Console()

var world = World()

func last_each(counted: Counted, shown: Shown, tested: Tested, _quitting: Quitting) {
    var progress = tested.progress
    assert progress.done
    var clicks = counted.click_count.clicks
    var text = shown.text.text
    var texture = counted.image.texture
    var layout = counted.layout
    var expected_text = progress.wanted.to_string()
    var counted_right = clicks == progress.wanted and text == expected_text
    var placed_right = layout.left == 232.0 and layout.width == 176.0 and layout.height == 40.0
    var buttons_seen = progress.saw_right and progress.saw_middle and progress.saw_double
    var passed = counted_right and placed_right and texture == "ui.button.primary.hover" and buttons_seen
    console.print(
        "clicks",
        clicks,
        "label",
        text,
        "texture",
        texture,
        "button at",
        layout.left,
        layout.top,
        "right, middle, double",
        progress.saw_right,
        progress.saw_middle,
        progress.saw_double,
        "passed",
        passed,
    )
    crash passed
    var quit = Component.Quit()
    var shelf = world.as_entity()
    shelf.add_component(quit)
}
