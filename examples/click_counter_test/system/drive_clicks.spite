type DrivenWindow {
    entity: Entity
    window: Window.Component.Window
    handle: Window.Component.Handle
    progress: Component.Progress
}

var user = DynamicLibrary("user32.dll", 'identity', "")
var dones = Lookup<Component.Done>()

func update_each(driven: DrivenWindow) {
    var handle = driven.handle.value
    var progress = driven.progress
    progress.frame = progress.frame + 1
    var first_frame = 5
    var frames_per_click = 4
    var since_first = progress.frame - first_frame
    assert since_first >= 0 and driven.handle.value != 0
    var phase = since_first % frames_per_click
    if progress.sent < progress.wanted and phase == 0 {
        post(handle, 512, 0)
        post(handle, 513, 1)
    } else if progress.sent < progress.wanted and phase == 2 {
        post(handle, 514, 0)
        progress.sent = progress.sent + 1
    }
    var extra = since_first - progress.wanted * frames_per_click
    send_other_buttons(handle, extra)
    var settled = since_first >= progress.wanted * frames_per_click + 12
    var owner = driven.entity
    if progress.sent == progress.wanted and settled and not dones.has(owner.id) {
        var done = Component.Done()
        owner.add_component(done)
    }
}

func send_other_buttons(handle: Long, extra: Integer) {
    var corner: Long = 10 * 65536 + 10
    if extra == 1 {
        user.PostMessageA(handle, 516, 2, corner)
    } else if extra == 2 {
        user.PostMessageA(handle, 517, 0, corner)
    } else if extra == 3 {
        user.PostMessageA(handle, 519, 16, corner)
    } else if extra == 4 {
        user.PostMessageA(handle, 520, 0, corner)
    } else if extra == 5 {
        user.PostMessageA(handle, 515, 1, corner)
    } else if extra == 6 {
        user.PostMessageA(handle, 514, 0, corner)
    } else if extra == 7 {
        post(handle, 512, 0)
    }
}

func post(handle: Long, message: Integer, buttons: Integer) {
    var button_center: Long = 220 * 65536 + 320
    user.PostMessageA(handle, message, buttons, button_center)
}
