type Tested {
    progress: Component.Progress
}

type Quitting {
    frame: Component.Frame
    running: Without<Component.Quit>
}

var console = Console()
var displays = Lookup<Ui.Component.Display>()

var world = World()
func last_each(tested: Tested, quitting: Quitting) {
    var progress = tested.progress
    assert progress.step == 8
    var popup_display = displays.of(progress.popup)
    crash popup_display
    var hidden = popup_display.value == 'none'
    var picked_third = progress.selected == 2 and progress.shown == "Third"
    var passed = picked_third and progress.closed_by_pick and hidden
    console.print(
        "selected",
        progress.selected,
        "shown",
        progress.shown,
        "closed by the pick",
        progress.closed_by_pick,
        "passed",
        passed,
    )
    crash passed
    var quit = Component.Quit()
    var shelf = world.as_entity()
    shelf.add_component(quit)
}
