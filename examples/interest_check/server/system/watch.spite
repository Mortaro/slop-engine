type Joined {
    entity: Entity
    joined: Added<Network.Component.Connection>
}

type Eyed {
    entity: Entity
    eye: Component.Eye
}

type Lit {
    entity: Entity
    beacon: Component.Beacon
    indexed: Spatial.Component.Indexed
}

var world = World()

func update_each(joined: Joined, eyed: Eyed, lit: Lit) {
    assert lit.beacon.number == 52 and lit.indexed.space == 0
    var viewer = Interest.Component.Viewer()
    viewer.radius = 55.0
    var peer = joined.entity
    peer.add_component(viewer)
    var viewpoint = Interest.Component.Viewpoint()
    viewpoint.entity = eyed.entity
    peer.add_component(viewpoint)
    var timer = Component.Timer()
    timer.start(1000)
    peer.add_component(timer)
    var now = world.now()
    var ticking = timer.resume(now)
    peer.add_component(ticking)
    var again = Component.Repeating()
    peer.add_component(again)
    var script = Component.Script()
    peer.add_component(script)
    var index = 0
    while index < 5 {
        place_stash(joined.entity, index, lit.entity)
        index = index + 1
    }
}

func place_stash(connection: Entity, index: Integer, pointed: Entity) {
    var stash = world.create_entity()
    var value = Component.Stash()
    value.amount = index
    stash.add_component(value)
    var near = Component.Near()
    near.entity = pointed
    stash.add_component(near)
    var observed = Network.Component.Observed()
    stash.add_component(observed)
    if index == 0 {
        var sealed = Component.Sealed()
        stash.add_component(sealed)
    }
    assert index < 3
    var observation = stash.create_entity()
    var observer = Network.Component.Observer()
    observer.entity = connection
    observation.add_component(observer)
}
