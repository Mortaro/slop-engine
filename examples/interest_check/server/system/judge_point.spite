type Pointed {
    entity: Entity
    point: Component.Point
    arrived: Network.Component.Arrived
}

var beacons = Lookup<Component.Beacon>()
var world = World()

func update_each(pointed: Pointed) {
    pointed.entity.remove_component(Component.Point)
    var named = beacons.of(pointed.point.target.id)
    crash named
    var verdict = Component.Verdict()
    verdict.number = named.number
    world.as_entity().add_component(verdict)
}
