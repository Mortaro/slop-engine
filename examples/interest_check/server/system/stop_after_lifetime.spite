type Running {
    frame: Component.Frame
    running: Without<Component.Quit>
}

var environment = Environment()
var clock = Clock()
var started = -1

var world = World()
func last_each(running: Running) {
    assert environment.lifetime_seconds > 0
    var now = clock.elapsed_milliseconds()
    if started < 0 {
        started = now
    }
    if now - started >= environment.lifetime_seconds * 1000 {
        var quit = Component.Quit()
        var shelf = world.as_entity()
        shelf.add_component(quit)
    }
}
