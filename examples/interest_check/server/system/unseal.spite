type Staged {
    script: Component.Script
}

type Sealed {
    entity: Entity
    sealed: Component.Sealed
}

func update_each(staged: Staged, sealed: Sealed) {
    assert staged.script.step == 2 and not staged.script.unsealed
    staged.script.unsealed = true
    var target = Entity(sealed.entity.id)
    target.remove_component(Component.Sealed)
}
