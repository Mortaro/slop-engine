type Seen {
    entity: Entity
    beacon: Component.Beacon
    mirrored: Network.Component.Mirrored
}

type Stashed {
    stash: Component.Stash
    mirrored: Network.Component.Mirrored
}

type Seal {
    sealed: Component.Sealed
    mirrored: Network.Component.Mirrored
}

type Running {
    frame: Component.Frame
    quit: Component.Quit
}

var console = Console()
var counts = List<Integer>()
var saw_seal = false

func update_all(runs: List<Running>, beacons: List<Seen>, stashes: List<Stashed>, seals: List<Seal>) {
    var running = runs.first()
    crash running
    assert not running.quit.requested
    var seen = beacons.count()
    var last = counts.last()
    var changed = seen > 0 and last != seen
    if changed {
        counts.append(seen)
        console.print("bot sees", seen, "beacons")
    }
    var stashed = stashes.count()
    var pointed_right = points_at_beacon(beacons, stashes)
    var sealed = seals.count()
    if sealed > 0 and not saw_seal {
        saw_seal = true
        console.print("bot sees a sealed stash")
    }
    var expected = counts.count() == 3 and counts[0] == 6 and counts[1] == 11 and counts[2] == 10 and stashed == 3 and saw_seal and sealed == 0 and pointed_right
    if expected {
        console.print("bot sees", stashed, "stashes of its own, and the seal is gone")
        console.print("passed true")
        running.quit.requested = true
    }
    if running.frame.count > 1200 {
        console.print("passed false")
        running.quit.requested = true
    }
}

func points_at_beacon(beacons: List<Seen>, stashes: List<Stashed>): Boolean {
    var target = -1
    var index = 0
    while index < beacons.count() {
        if beacons[index].beacon.number == 52 {
            target = beacons[index].entity.id
        }
        index = index + 1
    }
    var found = false
    index = 0
    while index < stashes.count() {
        found = found or target >= 0 and stashes[index].stash.near.id == target
        index = index + 1
    }
    return found
}
