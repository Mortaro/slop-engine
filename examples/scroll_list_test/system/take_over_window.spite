type NewWindow {
    entity: Entity
    window: Added<Window.Component.Window>
}

var environment = Environment()

func prepare_each(created: NewWindow) {
    if not environment.show_window {
        var hidden = Window.Component.Hidden()
        created.entity.add_component(hidden)
    }
    var progress = Component.Progress()
    created.entity.add_component(progress)
}
