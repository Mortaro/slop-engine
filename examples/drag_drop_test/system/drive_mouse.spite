type Driven {
    handle: Window.Component.Handle
    progress: Component.Progress
}

var user = DynamicLibrary("user32.dll", 'identity', "")
var layouts = Lookup<Ui.Component.ComputedLayout>()
var presses = Lookup<Ui.Component.DragPress>()
var drags = Lookup<Ui.Component.Dragging>()
var overs = Lookup<Ui.Component.DragOver>()
var drops = Lookup<Ui.Component.Dropped>()
var misses = Lookup<Ui.Component.DropMissed>()
var clicks = Lookup<Ui.Component.Clicked>()
var right_presses = Lookup<Ui.Component.RightPressed>()
var right_clicks = Lookup<Ui.Component.RightClicked>()
var double_clicks = Lookup<Ui.Component.DoubleClicked>()
var mouse_move = 512
var button_down = 513
var button_up = 514
var left_held = 1

func update_each(driven: Driven) {
    var progress = driven.progress
    var handle = driven.handle.value
    assert handle != 0
    if clicks.has(progress.source) {
        progress.clicks_seen = progress.clicks_seen + 1
    }
    var source = layouts.of(progress.source)
    var target = layouts.of(progress.target)
    assert source and target and source.width > 0.0 and target.width > 0.0
    var source_x: Integer = source.left + source.width / 2.0
    var source_y: Integer = source.top + source.height / 2.0
    var target_x: Integer = target.left + target.width / 2.0
    var target_y: Integer = target.top + target.height / 2.0
    var step = progress.step
    if step == 0 {
        post(handle, mouse_move, 0, source_x, source_y)
        post(handle, button_down, left_held, source_x, source_y)
        progress.step = 1
    } else if step == 1 and presses.has(progress.source) {
        post(handle, mouse_move, left_held, source_x + 20, source_y)
        progress.step = 2
    } else if step == 2 and drags.has(progress.source) {
        post(handle, mouse_move, left_held, target_x, target_y)
        progress.step = 3
    } else if step == 3 and overs.has(progress.target) {
        post(handle, button_up, 0, target_x, target_y)
        progress.step = 4
    } else if step == 4 {
        take_drop(progress, handle, source_x, source_y)
    } else if step == 5 and presses.has(progress.source) {
        post(handle, mouse_move, left_held, source_x, source_y + 20)
        progress.step = 6
    } else if step == 6 and drags.has(progress.source) {
        post(handle, mouse_move, left_held, 10, 10)
        post(handle, button_up, 0, 10, 10)
        progress.step = 7
    } else if step == 7 and misses.has(progress.source) {
        progress.missed = true
        post(handle, mouse_move, 0, source_x, source_y)
        post(handle, button_down, left_held, source_x, source_y)
        progress.step = 8
    } else if step == 8 and presses.has(progress.source) {
        post(handle, button_up, 0, source_x, source_y)
        progress.step = 9
    } else if step == 9 and progress.clicks_seen > 0 {
        post(handle, mouse_move, 0, source_x, source_y)
        post(handle, button_down, left_held, source_x, source_y)
        progress.step = 10
    } else if step >= 10 {
        later_steps(progress, handle, source_x, source_y)
    }
}

func later_steps(progress: Component.Progress, handle: Long, source_x: Integer, source_y: Integer) {
    var step = progress.step
    if step >= 10 and step <= 13 and clicks.has(progress.holder) {
        progress.holder_clicks_in_drag = progress.holder_clicks_in_drag + 1
    }
    if step == 10 and presses.has(progress.source) {
        post(handle, mouse_move, left_held, source_x + 20, source_y)
        progress.step = 11
    } else if step == 11 and drags.has(progress.source) {
        post(handle, button_up, 0, source_x + 20, source_y)
        progress.step = 12
    } else if step == 12 and misses.has(progress.source) {
        progress.step = 13
    } else if step == 13 {
        post(handle, mouse_move, 0, source_x, source_y)
        post(handle, 516, 2, source_x, source_y)
        progress.step = 14
    } else if step == 14 and right_presses.has(progress.source) {
        post(handle, 517, 0, source_x, source_y)
        progress.step = 15
    } else if step == 15 and right_clicks.has(progress.source) {
        progress.right_clicked = true
        post(handle, button_down, left_held, source_x, source_y)
        post(handle, button_up, 0, source_x, source_y)
        post(handle, 515, left_held, source_x, source_y)
        post(handle, button_up, 0, source_x, source_y)
        progress.step = 16
    } else if step == 16 and double_clicks.has(progress.source) {
        progress.double_clicked = true
        progress.step = 17
    }
}

func take_drop(progress: Component.Progress, handle: Long, source_x: Integer, source_y: Integer) {
    var dropped = drops.of(progress.target)
    assert dropped
    progress.dropped_source = dropped.source
    post(handle, mouse_move, 0, source_x, source_y)
    post(handle, button_down, left_held, source_x, source_y)
    progress.step = 5
}

func post(handle: Long, message: Integer, buttons: Integer, left: Integer, top: Integer) {
    var place: Long = top * 65536 + left
    user.PostMessageA(handle, message, buttons, place)
}
