var console = Console()
var world = World()
var mirrors = Mirrors()

func WireProbe() {
    load "../../slop"
    var app = App()
    var local = mirrors.local_of(5000)
    world.flush()
    var target = Entity(local)
    var bytes = Asset.Bytes()
    var field = Field<Entity>()
    field.write(target, bytes)
    var wire = bytes.read_integer()
    var sent = Asset.Bytes()
    sent.write_integer(wire)
    var back = field.read(sent)
    var passed = wire == -5100 and back.id == 5000
    console.print("local", local, "wire", wire, "read back on the other side", back.id, "passed", passed)
    app.tick()
}
