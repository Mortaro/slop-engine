var cookbook = Recipes.Cookbook()
var console = Console()
var world = World()

func RenderParity() {
    load "../../slop"
    load "../../plugins/slop_window_plugin"
    load "../../plugins/slop_platform_plugin"
    load "../../plugins/slop_input_plugin"
    load "../../plugins/slop_ui_plugin"
    load "../../plugins/slop_render_plugin"
    load "../../plugins/slop_render_software_plugin"
    load "../../plugins/slop_render_vulkan_plugin"
    load "../../plugins/slop_psd_plugin"
    cookbook.cook()
    var app = App()
    var target = spawn_target()
    var screen_bundle = Bundle.Screen()
    var screen = world.spawn_entity_from_bundle(screen_bundle)
    var title = Bundle.Title(screen)
    world.spawn_entity_from_bundle(title)
    var font_label = Bundle.FontLabel(screen)
    world.spawn_entity_from_bundle(font_label)
    var counter_button_bundle = Bundle.CounterButton(screen)
    var button = world.spawn_entity_from_bundle(counter_button_bundle)
    var count_label = Bundle.CountLabel(button)
    world.spawn_entity_from_bundle(count_label)
    var clipped_panel_bundle = Bundle.ClippedPanel(screen)
    var panel = world.spawn_entity_from_bundle(clipped_panel_bundle)
    var panel_image = Bundle.PanelImage(panel)
    world.spawn_entity_from_bundle(panel_image)
    var panel_text = Bundle.PanelText(panel)
    world.spawn_entity_from_bundle(panel_text)
    add_wall_of_text(screen.id)
    world.flush()
    var textures = Lookup<Render.Component.Textures>().of(target)
    crash textures
    var settled = false
    while not settled {
        var drawn_before = rectangles_of(target)
        var ready_before = textures.all_ready() and fonts_settled()
        app.tick()
        var drawn_after = rectangles_of(target)
        settled = ready_before and drawn_before == drawn_after
    }
    var draw_list = Lookup<Render.Component.DrawList>().of(target)
    var canvas = Lookup<RenderSoftware.Component.Canvas>().of(target)
    crash draw_list
    crash canvas
    var renderer = RenderVulkan.Component.Renderer()
    var device = RenderVulkan.Component.Device()
    renderer.ensure(device)
    renderer.draw_offscreen(draw_list, textures)
    compare(draw_list, canvas, renderer)
    check_clipping(panel.id, canvas, draw_list.clear_color)
    renderer.release_device()
}

func fonts_settled(): Boolean {
    var fonts = Lookup<Ui.Component.Fonts>().of(world.entity)
    if not fonts {
        return false
    }
    return fonts.settled()
}

func rectangles_of(target: Integer): Integer {
    var draw_list = Lookup<Render.Component.DrawList>().of(target)
    crash draw_list
    return draw_list.count
}

func add_wall_of_text(screen: Integer) {
    var wall = world.entity_of(screen).spawn_entity()
    var text = Ui.Component.Text()
    var line = "the quick brown fox (100%) jumps, over the lazy dog: a/b+c=d 'e' \"f\" g_h *[#] "
    var repeated = ""
    var index = 0
    while index < 16 {
        repeated = repeated + line
        index = index + 1
    }
    text.text = repeated
    wall.add_component(text)
}

func check_clipping(panel: Integer, canvas: RenderSoftware.Component.Canvas, clear_color: Integer) {
    var layout = Lookup<Ui.Component.ComputedLayout>().of(panel)
    crash layout
    var row: Integer = layout.top + 13.0
    var outside: Integer = layout.left + layout.width + 5.0
    var inside: Integer = layout.left + 23.0
    var beyond = canvas.pixel_at(outside, row)
    var within = canvas.pixel_at(inside, row)
    console.print("clipping: beside the panel", beyond, "inside it", within)
    crash beyond == clear_color
    crash within != clear_color and within != 3355443
}

func spawn_target(): Integer {
    var target = world.spawn_entity().id
    var offscreen = Component.Offscreen()
    world.entity_of(target).add_component(offscreen)
    var draw_list = Render.Component.DrawList()
    world.entity_of(target).add_component(draw_list)
    var clear_color = Render.Component.ClearColor()
    world.entity_of(target).add_component(clear_color)
    var textures = Render.Component.Textures()
    world.entity_of(target).add_component(textures)
    return target
}

func compare(
    draw_list: Render.Component.DrawList,
    canvas: RenderSoftware.Component.Canvas,
    renderer: RenderVulkan.Component.Renderer,
) {
    var different = 0
    var top = 0
    while top < draw_list.height {
        different = different + different_in_row(canvas, renderer, draw_list.width, top)
        top = top + 1
    }
    var total = draw_list.width * draw_list.height
    console.print("rectangles", draw_list.count, "pixels", total, "different", different)
    crash different == 0
}

func different_in_row(
    canvas: RenderSoftware.Component.Canvas,
    renderer: RenderVulkan.Component.Renderer,
    width: Integer,
    top: Integer,
): Integer {
    var different = 0
    var left = 0
    while left < width {
        var software = canvas.pixel_at(left, top)
        var vulkan = renderer.pixel_at(left, top)
        if software != vulkan {
            different = different + 1
        }
        left = left + 1
    }
    return different
}
