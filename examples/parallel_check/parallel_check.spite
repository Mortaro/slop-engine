var world = World()
var environment = Environment()
var console = Console()
var positions = Lookup<Component.Position>()
var armors = Lookup<Component.Armor>()
var ages = Lookup<Component.Age>()
var tallies = Lookup<Component.Tally>()
var spreads = Lookup<Component.Spread>()
var weights = Lookup<Component.Weight>()
var witnesses = Lookup<Component.Witnessed>()
var last_seed = 0

func ParallelCheck() {
    load "../../slop"
    var app = App()
    var described = app.describe()
    console.print(described)
    var accessed = app.describe_accesses()
    console.print(accessed)
    var readers_share_a_stage = described.contains("(update): System.Average, System.Census\n")
    crash readers_share_a_stage
    var a_writer_stands_alone = described.contains("(update): System.Wear\n")
    crash a_writer_stands_alone
    var a_reader_after_a_writer_starts_a_stage = described.contains("(update): System.Weigh")
    crash a_reader_after_a_writer_starts_a_stage
    var tally = Component.Tally()
    world.as_entity().add_component(tally)
    var spread = Component.Spread()
    world.as_entity().add_component(spread)
    var weight = Component.Weight()
    world.as_entity().add_component(weight)
    var witnessed = Component.Witnessed()
    world.as_entity().add_component(witnessed)
    var seed = 0
    while seed < environment.movers {
        var mover = Bundle.Mover(seed)
        world.create_entity_from_bundle(mover)
        seed = seed + 1
    }
    world.flush()
    var tick = 0
    while tick < environment.ticks {
        app.tick()
        tick = tick + 1
    }
    var spawned = world.create_entity()
    last_seed = spawned.id
    report()
}

func report() {
    var sum: Long = 0
    var alive = 0
    var id = 1
    while id < last_seed {
        if positions.has(id) {
            sum = sum + mixed(id)
            alive = alive + 1
        }
        id = id + 1
    }
    var tally = tallies.of(world.entity)
    var spread = spreads.of(world.entity)
    var weight = weights.of(world.entity)
    var seen = witnesses.of(world.entity)
    crash tally
    crash spread
    crash weight
    crash seen
    console.print(
        "alive",
        alive,
        "tally",
        tally.total,
        "spread",
        spread.total,
        "weight",
        weight.total,
        "witnessed",
        seen.total,
        "checksum",
        sum,
    )
}

func mixed(id: Integer): Long {
    var position = positions.of(id)
    var armor = armors.of(id)
    var age = ages.of(id)
    crash position
    crash armor
    crash age
    var value: Long = id * 31 + position.left * 7 + position.top * 13 + armor.value * 17 + age.ticks * 19
    return value % 1000003
}
