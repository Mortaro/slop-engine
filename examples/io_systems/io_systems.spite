var world = World()
var build = Build()
var names = ["first", "third"]

func IoSystems() {
    load "../../slop"
    var folder = "{build.program}/.test"
    var made = Directory(folder).create()
    crash made
    names.each(write_record)
    var app = App()
    var records = Component.Records()
    records.folder = folder
    world.as_entity().add_component(records)
    app.run()
}

func write_record(name: String) {
    var written = File("{build.program}/.test/{name}.txt").write(name)
    crash written
}
