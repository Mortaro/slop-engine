type Opened {
    records: Added<Component.Records>
}

var world = World()
var names = ["first", "second", "third"]

func update_each(_opened: Opened) {
    names.each(ask)
}

func ask(name: String) {
    var entity = world.create_entity()
    var request = Component.LookupRequest()
    request.name = name
    entity.add_component(request)
}
