var parent = Ui.Component.Parent()
var button = Ui.Component.Button()
var height = Ui.Component.Height()
var shrink = Ui.Component.FlexShrink()
var background = Ui.Component.BackgroundColor()
var text = Ui.Component.Text()
var row = Component.Row()

func ListRow(panel: Integer, index: Integer) {
    parent.entity = panel
    height.length.pixels(30.0)
    shrink.value = 0.0
    background.color = 3355443
    if index % 2 == 1 {
        background.color = 4473924
    }
    text.text = "ROW {index}"
    text.scale = 2
    row.index = index
}
