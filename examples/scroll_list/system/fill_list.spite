type NewWindow {
    window: Added<Window.Component.Window>
}

var world = World()

func update_each(_window: NewWindow) {
    var screen_bundle = Bundle.Screen()
    var screen = world.create_entity_from_bundle(screen_bundle)
    var title = Bundle.Title(screen)
    world.create_entity_from_bundle(title)
    var list_panel_bundle = Bundle.ListPanel(screen)
    var panel = world.create_entity_from_bundle(list_panel_bundle)
    var index = 0
    while index < 20 {
        var row = Bundle.ListRow(panel, index)
        world.create_entity_from_bundle(row)
        index = index + 1
    }
}
