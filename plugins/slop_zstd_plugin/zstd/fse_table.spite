var powers = Zstd.Powers()
var accuracy = 0
var size = 0
var symbols = List<Integer>()
var bits = List<Integer>()
var baselines = List<Integer>()

func allocate_table(new_accuracy: Integer) {
    release_table()
    accuracy = new_accuracy
    size = powers.of(accuracy)
    var slot = 0
    while slot < size {
        symbols.append(0)
        bits.append(0)
        baselines.append(0)
        slot = slot + 1
    }
}

func release_table() {
    symbols.clear()
    bits.clear()
    baselines.clear()
}

func symbol_at(state: Integer): Integer {
    var value = symbols[state]
    crash value
    return value
}

func bits_at(state: Integer): Integer {
    var value = bits[state]
    crash value
    return value
}

func baseline_at(state: Integer): Integer {
    var value = baselines[state]
    crash value
    return value
}

func build_rle(symbol: Integer) {
    allocate_table(0)
    symbols[0] = symbol
    bits[0] = 0
    baselines[0] = 0
}

func build(normalized: List<Integer>, new_accuracy: Integer) {
    allocate_table(new_accuracy)
    var next_state = List<Integer>()
    var high_threshold = size - 1
    var symbol = 0
    while symbol < normalized.count() {
        var probability = normalized[symbol]
        if probability == -1 {
            symbols[high_threshold] = symbol
            high_threshold = high_threshold - 1
            next_state.append(1)
        } else {
            next_state.append(probability)
        }
        symbol = symbol + 1
    }
    spread(normalized, high_threshold)
    var state = 0
    while state < size {
        finish_state(state, next_state)
        state = state + 1
    }
}

func spread(normalized: List<Integer>, high_threshold: Integer) {
    var step = size / 2 + size / 8 + 3
    var position = 0
    var symbol = 0
    while symbol < normalized.count() {
        var count = normalized[symbol]
        var placed = 0
        while placed < count {
            symbols[position] = symbol
            position = (position + step) % size
            while position > high_threshold {
                position = (position + step) % size
            }
            placed = placed + 1
        }
        symbol = symbol + 1
    }
}

func finish_state(state: Integer, next_state: List<Integer>) {
    var symbol = symbol_at(state)
    crash next_state[symbol]
    var next = next_state[symbol]
    next_state[symbol] = next + 1
    var number_of_bits = accuracy - powers.highest_bit(next)
    var baseline = powers.of(number_of_bits) * next - size
    bits[state] = number_of_bits
    baselines[state] = baseline
}

func read_description(reader: Zstd.BitReader, maximum_symbol: Integer): Integer {
    var new_accuracy = reader.read_forward(4) + 5
    var remaining = powers.of(new_accuracy) + 1
    var threshold = powers.of(new_accuracy)
    var number_of_bits = new_accuracy + 1
    var normalized = List<Integer>()
    while remaining > 1 and normalized.count() <= maximum_symbol {
        var maximum = threshold * 2 - 1 - remaining
        var low = reader.peek_forward(number_of_bits - 1)
        var count: Long = 0
        if low < maximum {
            count = low
            reader.bit_position = reader.bit_position + number_of_bits - 1
        } else {
            count = reader.read_forward(number_of_bits)
            if count >= threshold {
                count = count - maximum
            }
        }
        var probability = count - 1
        normalized.append(probability)
        if probability < 0 {
            remaining = remaining + probability
        } else {
            remaining = remaining - probability
        }
        if probability == 0 {
            read_zero_repeats(reader, normalized)
        }
        while remaining < threshold {
            number_of_bits = number_of_bits - 1
            threshold = threshold / 2
        }
    }
    crash remaining == 1
    build(normalized, new_accuracy)
    return reader.forward_bytes_used()
}

func read_zero_repeats(reader: Zstd.BitReader, normalized: List<Integer>) {
    var repeat = reader.read_forward(2)
    append_zeros(normalized, repeat)
    while repeat == 3 {
        repeat = reader.read_forward(2)
        append_zeros(normalized, repeat)
    }
}

func append_zeros(normalized: List<Integer>, count: Long) {
    var index = 0
    while count > index {
        normalized.append(0)
        index = index + 1
    }
}

func drop() {
    release_table()
}
