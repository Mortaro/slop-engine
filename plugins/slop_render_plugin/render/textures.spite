singleton

var report_console = Console()
var world = World()
var known_slots = Dictionary<Integer>()
var entities = List<Integer>()
var loads = List<Parallel<Render.LoadedTexture>>()
var load_slots = List<Integer>()
var load_revisions = List<Integer>()
var catalog = Recipes.Catalog()
var unstarted = List<String>()
var seen_revision = 0

func request(id: String): Integer {
    var found = known_slots.get(id)
    if found {
        return found
    }
    var slot = entities.count()
    known_slots.set(id, slot)
    var created = Render.Component.Texture()
    created.id = id
    created.slot = slot
    var owner = world.create_entity()
    owner.add_component(created)
    entities.append(owner.id)
    unstarted.append(id)
    start_waiting_loads()
    return slot
}

func count(): Integer {
    return entities.count()
}

func slot_of(id: String): Integer {
    var found = known_slots.get(id)
    if found {
        return found
    }
    return -1
}

func entity_of(slot: Integer): Integer {
    crash entities[slot]
    return entities[slot]
}

func start_waiting_loads() {
    assert unstarted.count() > 0 and catalog.ready()
    var reader = catalog.current()
    var index = 0
    while index < unstarted.count() {
        start_load(reader, unstarted[index])
        index = index + 1
    }
    unstarted.clear()
}

func start_load(reader: Recipes.CacheReader, id: String) {
    var slot = known_slots.get(id)
    crash slot
    var record = reader.locate(id)
    if not record {
        report_console.print("asset never cooked:", id)
    }
    crash record
    var job = Render.TextureLoad(record)
    var loading = Parallel(job.run)
    loads.append(loading)
    load_slots.append(slot)
    load_revisions.append(catalog.revision)
    var marker = Component.Loading()
    var owner = entity_of(slot)
    world.entity_of(owner).add_component(marker)
}

func publish(id: String, image: Asset.Texture, raw_texels: Asset.Bytes): Integer {
    var found = known_slots.get(id)
    if found {
        var owner = entity_of(found)
        var record = Lookup<Render.Component.Texture>().of(owner)
        crash record
        record.image = image
        record.raw = raw_texels
        record.generation = record.generation + 1
        return found
    }
    var slot = entities.count()
    known_slots.set(id, slot)
    var created = Render.Component.Texture()
    created.id = id
    created.slot = slot
    created.image = image
    created.raw = raw_texels
    created.generation = 1
    var entity = world.create_entity()
    entity.add_component(created)
    var ready = Render.Component.TextureReady()
    entity.add_component(ready)
    entities.append(entity.id)
    return slot
}

func finish_loads() {
    start_waiting_loads()
    reload_changed()
    var index = loads.count() - 1
    while index >= 0 {
        finish_if_done(index)
        index = index - 1
    }
}

func finish_if_done(index: Integer) {
    crash loads[index]
    crash load_slots[index]
    crash load_revisions[index]
    var loaded = loads[index].finished_value()
    assert loaded
    var owner = entity_of(load_slots[index])
    var record = Lookup<Render.Component.Texture>().of(owner)
    assert record
    record.image = loaded.texture
    record.raw = loaded.raw
    record.generation = record.generation + 1
    record.loaded_revision = load_revisions[index]
    world.entity_of(owner).remove_component(Component.Loading)
    if not Lookup<Render.Component.TextureReady>().has(owner) {
        var ready = Render.Component.TextureReady()
        world.entity_of(owner).add_component(ready)
    }
    loads.remove_at(index)
    load_slots.remove_at(index)
    load_revisions.remove_at(index)
}

func reload_changed() {
    assert catalog.revision != seen_revision
    var reader = catalog.current()
    var deferred = false
    var slot = 0
    while slot < entities.count() {
        deferred = reload_if_changed(reader, slot) or deferred
        slot = slot + 1
    }
    if not deferred {
        seen_revision = catalog.revision
    }
}

func reload_if_changed(reader: Recipes.CacheReader, slot: Integer): Boolean {
    var owner = entity_of(slot)
    var record = Lookup<Render.Component.Texture>().of(owner)
    if not record {
        return true
    }
    var changed = catalog.revision_of(record.id) > record.loaded_revision
    if not changed {
        return false
    }
    if load_slots.contains(slot) {
        return true
    }
    start_load(reader, record.id)
    return false
}

func is_ready(slot: Integer): Boolean {
    var owner = entity_of(slot)
    return Lookup<Render.Component.TextureReady>().has(owner)
}

func all_ready(): Boolean {
    var ready = Lookup<Render.Component.TextureReady>()
    var slot = 0
    while slot < entities.count() {
        var owner = entity_of(slot)
        if not ready.has(owner) {
            return false
        }
        slot = slot + 1
    }
    return true
}

func generation(slot: Integer): Integer {
    var owner = entity_of(slot)
    var record = Lookup<Render.Component.Texture>().of(owner)
    if record {
        return record.generation
    }
    return 0
}
