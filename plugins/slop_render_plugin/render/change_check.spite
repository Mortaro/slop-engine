var folder = ""
var index_file = ""
var ids = ""
var known = ""

func ChangeCheck(cache_folder: String, index_path: String, loaded: List<String>, fingerprints: List<String>) {
    folder = cache_folder
    index_file = index_path
    ids = loaded.join("\n")
    known = fingerprints.join("\n")
}

func run(): Render.ChangedTextures {
    var fresh = Recipes.CacheReader(folder, index_file)
    fresh.read_index()
    var found = Render.ChangedTextures()
    found.reader = fresh
    var id_list = ids.split("\n")
    var known_list = known.split("\n")
    var index = 0
    while index < id_list.count() {
        compare(found, fresh, id_list, known_list, index)
        index = index + 1
    }
    return found
}

func compare(
    found: Render.ChangedTextures,
    fresh: Recipes.CacheReader,
    id_list: List<String>,
    known_list: List<String>,
    index: Integer,
) {
    crash id_list[index]
    crash known_list[index]
    var fingerprint = fresh.fingerprint_of(id_list[index])
    assert fingerprint != "" and fingerprint != known_list[index]
    var record = fresh.locate(id_list[index])
    assert record
    found.slots.append(index)
    found.records.append(record)
}
