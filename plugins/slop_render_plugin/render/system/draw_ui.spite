type Element {
    entity: Entity
    layout: Ui.Component.ComputedLayout
    clip: Ui.Component.ComputedClip
}

type Bars {
    entity: Entity
    bars: Ui.Component.ComputedScrollbars
    clip: Ui.Component.ComputedClip
}

type Target {
    draw_list: Component.DrawList
}

var textures = Render.Textures()
var fonts = Ui.Fonts()

func render_all(targets: List<Target>, elements: List<Element>, bars: List<Bars>) {
    var painted = paint_slots(elements, bars)
    var index = 0
    while index < targets.count() {
        paint_target(targets[index], elements, bars, painted)
        index = index + 1
    }
}

func paint_slots(elements: List<Element>, bars: List<Bars>): List<Integer> {
    var slots = List<Integer>()
    var count = elements.count() + bars.count()
    while slots.count() < count {
        slots.append(-1)
    }
    var index = 0
    while index < elements.count() {
        var order = elements[index].layout.order
        if order >= 0 and order < count {
            slots[order] = index
        }
        index = index + 1
    }
    index = 0
    while index < bars.count() {
        var order = bars[index].bars.order
        if order >= 0 and order < count {
            var slot = elements.count() + index
            slots[order] = slot
        }
        index = index + 1
    }
    return slots
}

func paint_target(target: Target, elements: List<Element>, bars: List<Bars>, painted: List<Integer>) {
    var index = 0
    while index < painted.count() {
        var slot = painted[index]
        var bar_index = slot - elements.count()
        if slot >= elements.count() {
            crash bars[bar_index]
            paint_bars(target, bars[bar_index])
        } else if slot >= 0 {
            crash elements[slot]
            paint_element(target, elements[slot])
        }
        index = index + 1
    }
}

func paint_element(target: Target, element: Element) {
    var draw_list = target.draw_list
    var layout = element.layout
    var clip = element.clip
    var entity = element.entity.id
    draw_list.clip_to(clip.left, clip.top, clip.right, clip.bottom)
    var color = Lookup<Ui.Component.BackgroundColor>().of(entity)
    if color {
        draw_list.append_rectangle(layout.left, layout.top, layout.width, layout.height, color.color)
    }
    var image = Lookup<Ui.Component.BackgroundImage>().of(entity)
    if image {
        paint_image(target, layout, image.texture)
    }
    var stored_text = Lookup<Ui.Component.Text>().of(entity)
    assert stored_text
    var text = stored_text.copy()
    var font = Lookup<Ui.Component.Font>().of(entity)
    if font {
        var font_copy = font.copy()
        paint_font_text(target, font_copy, text, layout, entity)
        return
    }
    draw_list.append_text(text.text, layout.content_left, layout.content_top, text.scale, text.color)
    var focused = Lookup<Ui.Component.Focused>().has(entity)
    var caret = Lookup<Ui.Component.Caret>().of(entity)
    assert focused
    assert caret
    var caret_left = layout.content_left + caret.index * 6 * text.scale
    draw_list.append_rectangle(caret_left, layout.content_top, text.scale, 7 * text.scale, text.color)
}

func paint_font_text(
    target: Target,
    font: Ui.Component.Font,
    text: Ui.Component.Text,
    layout: Ui.Component.ComputedLayout,
    entity: Integer,
) {
    var atlas = fonts.atlas_of(font.name, font.face, font.size)
    assert atlas
    var face = fonts.face_of(atlas)
    var atlas_name = fonts.atlas_id(atlas)
    var texture = textures.slot_of(atlas_name)
    var codes = List<Integer>()
    fonts.codepoints(text.text, codes)
    var pen: Float = layout.content_left
    var baseline = layout.content_top + atlas.ascent
    var index = 0
    while index < codes.count() {
        var code = codes[index]
        var glyph = fonts.glyph_of(atlas, code)
        if glyph >= 0 and texture >= 0 {
            place_glyph(target, atlas, glyph, texture, pen, baseline, text.color)
        }
        pen = pen + fonts.advance_of(face, atlas, code)
        index = index + 1
    }
    paint_font_caret(target, atlas, text, layout, entity)
}

func paint_font_caret(
    target: Target,
    atlas: Ui.Component.GlyphAtlas,
    text: Ui.Component.Text,
    layout: Ui.Component.ComputedLayout,
    entity: Integer,
) {
    var focused = Lookup<Ui.Component.Focused>().has(entity)
    var caret = Lookup<Ui.Component.Caret>().of(entity)
    assert focused
    assert caret
    var before = text.text.slice(0, caret.index)
    var offset = fonts.text_width(atlas, before)
    var caret_left: Integer = layout.content_left + offset
    var line: Integer = atlas.line_height
    target.draw_list.append_rectangle(caret_left, layout.content_top, 1, line, text.color)
}

func place_glyph(
    target: Target,
    atlas: Ui.Component.GlyphAtlas,
    glyph: Integer,
    texture: Integer,
    pen: Float,
    baseline: Float,
    color: Integer,
) {
    var width = fonts.glyph_width(atlas, glyph)
    var height = fonts.glyph_height(atlas, glyph)
    assert width > 0 and height > 0
    var pen_pixel: Integer = pen + 0.5
    var baseline_pixel: Integer = baseline
    var left = pen_pixel + fonts.glyph_bearing(atlas, glyph)
    var top = baseline_pixel - fonts.glyph_riser(atlas, glyph)
    var source_left = fonts.glyph_left(atlas, glyph)
    var source_top = fonts.glyph_top(atlas, glyph)
    target.draw_list.append_image_part(left, top, width, height, texture, source_left, source_top, width, height, color)
}

func paint_image(target: Target, layout: Ui.Component.ComputedLayout, texture_name: String) {
    assert texture_name != ""
    var texture = textures.request(texture_name)
    assert textures.is_ready(texture)
    target.draw_list.append_image(layout.left, layout.top, layout.width, layout.height, texture)
}

func paint_bars(target: Target, painted: Bars) {
    var draw_list = target.draw_list
    var bars = painted.bars
    var clip = painted.clip
    draw_list.clip_to(clip.left, clip.top, clip.right, clip.bottom)
    var thumb = 8947848
    var track = 2763306
    var colors = Lookup<Ui.Component.ScrollbarColor>().of(painted.entity.id)
    if colors {
        thumb = colors.thumb
        track = colors.track
    }
    var thickness = bars.thickness
    var vertical = Lookup<Ui.Component.VerticalScrollbar>().of(painted.entity.id)
    if vertical {
        draw_list.append_rectangle(vertical.track_left, vertical.track_top, thickness, vertical.track_height, track)
        draw_list.append_rectangle(vertical.track_left, vertical.thumb_top, thickness, vertical.thumb_height, thumb)
    }
    var horizontal = Lookup<Ui.Component.HorizontalScrollbar>().of(painted.entity.id)
    assert horizontal
    draw_list.append_rectangle(horizontal.track_left, horizontal.track_top, horizontal.track_width, thickness, track)
    draw_list.append_rectangle(horizontal.thumb_left, horizontal.track_top, horizontal.thumb_width, thickness, thumb)
}
