type Changed {
    entity: Entity
    atlas: Ui.Component.GlyphAtlas
    changed: Ui.Component.AtlasChanged
}

var textures = Render.Textures()
var fonts = Ui.Fonts()

func render_each(changed: Changed) {
    var atlas = changed.atlas
    var id = fonts.atlas_id(atlas)
    textures.publish(id, atlas.texture, atlas.texels)
    atlas.published = atlas.generation
    changed.entity.remove_component(Ui.Component.AtlasChanged)
}
