var path = ""
var offset: Long = 0
var length: Long = 0
var key = ""

func TextureLoad(found: Recipes.Record) {
    path = found.path
    offset = found.offset
    length = found.length
    key = found.key
}

func run(): Render.LoadedTexture {
    var record = Recipes.Record()
    record.path = path
    record.offset = offset
    record.length = length
    record.key = key
    var bytes = record.read()
    var pack = Pack<Asset.Texture>()
    var texture = pack.decode(bytes)
    crash texture
    var loaded = Render.LoadedTexture()
    loaded.texture = texture
    var pixels = texture.pixels
    var count = pixels.count()
    loaded.raw.reserve(count * 4 + 1)
    pixels.each(loaded.raw.write_integer)
    return loaded
}
