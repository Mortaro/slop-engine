var path = ""
var offset: Long = 0
var length: Long = 0
var key = ""

func TextureLoad(found: Recipes.Record) {
    path = found.path
    offset = found.offset
    length = found.length
    key = found.key
}

func run(): Render.LoadedTexture {
    var record = Recipes.Record()
    record.path = path
    record.offset = offset
    record.length = length
    record.key = key
    var bytes = record.read()
    var pack = Pack<Asset.Texture>()
    var texture = pack.decode(bytes)
    crash texture
    var complete = texture.texels.length == texture.expected_bytes()
    crash complete
    var loaded = Render.LoadedTexture()
    loaded.texture = texture
    return loaded
}
