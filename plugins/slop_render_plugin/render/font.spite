var glyphs = Dictionary<String>()
var missing = "#####...##...##...##...##...######"

func Font() {
    glyphs.set("0", ".###.#...##..###.#.###..##...#.###.")
    glyphs.set("1", "..#...##....#....#....#....#...###.")
    glyphs.set("2", ".###.#...#....#...#...#...#...#####")
    glyphs.set("3", "####.....#....#.###.....#....#####.")
    glyphs.set("4", "...#...##..#.#.#..#.#####...#....#.")
    glyphs.set("5", "######....####.....#....##...#.###.")
    glyphs.set("6", "..##..#...#....####.#...##...#.###.")
    glyphs.set("7", "#####....#...#...#...#....#....#...")
    glyphs.set("8", ".###.#...##...#.###.#...##...#.###.")
    glyphs.set("9", ".###.#...##...#.####....#...#..##..")
    glyphs.set("A", ".###.#...##...#######...##...##...#")
    glyphs.set("B", "####.#...##...#####.#...##...#####.")
    glyphs.set("C", ".###.#...##....#....#....#...#.###.")
    glyphs.set("D", "####.#...##...##...##...##...#####.")
    glyphs.set("E", "######....#....####.#....#....#####")
    glyphs.set("F", "######....#....####.#....#....#....")
    glyphs.set("G", ".###.#...##....#.####...##...#.####")
    glyphs.set("H", "#...##...##...#######...##...##...#")
    glyphs.set("I", ".###...#....#....#....#....#...###.")
    glyphs.set("J", "..###...#....#....#....#.#..#..##..")
    glyphs.set("K", "#...##..#.#.#..##...#.#..#..#.#...#")
    glyphs.set("L", "#....#....#....#....#....#....#####")
    glyphs.set("M", "#...###.###.#.##.#.##...##...##...#")
    glyphs.set("N", "#...##...###..##.#.##..###...##...#")
    glyphs.set("O", ".###.#...##...##...##...##...#.###.")
    glyphs.set("P", "####.#...##...#####.#....#....#....")
    glyphs.set("Q", ".###.#...##...##...##.#.##..#..##.#")
    glyphs.set("R", "####.#...##...#####.#.#..#..#.#...#")
    glyphs.set("S", ".#####....#.....###.....#....#####.")
    glyphs.set("T", "#####..#....#....#....#....#....#..")
    glyphs.set("U", "#...##...##...##...##...##...#.###.")
    glyphs.set("V", "#...##...##...##...##...#.#.#...#..")
    glyphs.set("W", "#...##...##...##.#.##.#.##.#.#.#.#.")
    glyphs.set("X", "#...##...#.#.#...#...#.#.#...##...#")
    glyphs.set("Y", "#...##...#.#.#...#....#....#....#..")
    glyphs.set("Z", "#####....#...#...#...#...#....#####")
    glyphs.set(":", ".......#....#.........#....#.......")
    glyphs.set("!", "..#....#....#....#....#.........#..")
    glyphs.set(".", "..........................##...##..")
    glyphs.set("-", "...............#####...............")
    glyphs.set("?", ".###.#...#....#...#...#.........#..")
    glyphs.set(" ", "...................................")
}

func glyph(character: String): String {
    var upper = character.upper_case()
    if glyphs[upper] {
        return glyphs[upper]
    }
    return missing
}
