type FontText {
    entity: Entity
    text: Component.Text
    font: Component.Font
}

var fonts = Ui.Fonts()
var sizes = Lookup<Component.ContentSize>()

func prepare_each(measured: FontText) {
    var font = measured.font
    var atlas = fonts.atlas_of(font.name, font.face, font.size)
    assert atlas
    var width = fonts.text_width(atlas, measured.text.text)
    var height: Float = atlas.line_height
    var content = sizes.of(measured.entity.id)
    if content {
        content.width = width
        content.height = height
        return
    }
    var created = Component.ContentSize()
    created.width = width
    created.height = height
    measured.entity.add_component(created)
}
