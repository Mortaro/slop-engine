type Cache {
    fonts: Component.Fonts
}

type FontText {
    entity: Entity
    text: Component.Text
    font: Component.Font
}

func prepare_each(cache: Cache, measured: FontText) {
    var font = measured.font
    var size = cache.fonts.size_slot(font.name, font.face, font.size)
    assert size >= 0
    var width = cache.fonts.text_width(size, measured.text.text)
    var height: Float = cache.fonts.line_height_of(size)
    var sizes = Lookup<Component.ContentSize>()
    var content = sizes.of(measured.entity.id)
    if content {
        content.width = width
        content.height = height
        return
    }
    var created = Component.ContentSize()
    created.width = width
    created.height = height
    measured.entity.add_component(created)
}
