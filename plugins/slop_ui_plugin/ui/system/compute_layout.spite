type Child {
    entity: Entity
    parent: Component.Parent
}

type Root {
    entity: Entity
    screen: Component.Screen
}

var world = World()

func layout_all(roots: List<Root>, children: List<Child>) {
    var flex = Ui.Layout.Flex()
    var index = 0
    while index < children.count() {
        add_child(flex, children[index])
        ensure_layout(flex, children[index].entity.id)
        index = index + 1
    }
    index = 0
    while index < roots.count() {
        var root = roots[index]
        ensure_layout(flex, root.entity.id)
        lay_out_shown(flex, root)
        index = index + 1
    }
}

func lay_out_shown(flex: Ui.Layout.Flex, root: Root) {
    var display = Lookup<Component.Display>().of(root.entity.id)
    var hidden = false
    if display {
        hidden = display.value == 'none'
    }
    assert not hidden
    flex.viewport_width = root.screen.width
    flex.viewport_height = root.screen.height
    flex.layout_screen(root.entity.id)
    flex.paint(root.entity.id, 0)
}

func ensure_layout(flex: Ui.Layout.Flex, entity: Integer) {
    ensure_clip(flex, entity)
    ensure_scrolling(flex, entity)
    var layouts = Lookup<Component.ComputedLayout>()
    var existing = layouts.of(entity)
    if existing {
        existing.order = -1
    }
    assert not layouts.has(entity)
    var created = Component.ComputedLayout()
    flex.created_layouts[entity] = created
    world.entity_of(entity).add_component(created)
}

func ensure_clip(flex: Ui.Layout.Flex, entity: Integer) {
    var clips = Lookup<Component.ComputedClip>()
    assert not clips.has(entity)
    var created = Component.ComputedClip()
    flex.created_clips[entity] = created
    world.entity_of(entity).add_component(created)
}

func ensure_scrolling(flex: Ui.Layout.Flex, entity: Integer) {
    var scrolls = flex.clips_horizontally(entity) or flex.clips_vertically(entity)
    assert scrolls
    var scrollbars = Lookup<Component.ComputedScrollbars>()
    var stale = scrollbars.of(entity)
    if stale {
        stale.order = -1
    }
    if not scrollbars.has(entity) {
        var created_bars = Component.ComputedScrollbars()
        flex.created_scrollbars[entity] = created_bars
        world.entity_of(entity).add_component(created_bars)
    }
    var ranges = Lookup<Component.ScrollRange>()
    if not ranges.has(entity) {
        var created = Component.ScrollRange()
        flex.created_ranges[entity] = created
        world.entity_of(entity).add_component(created)
    }
    var positions = Lookup<Component.ScrollPosition>()
    if not positions.has(entity) {
        var position = Component.ScrollPosition()
        world.entity_of(entity).add_component(position)
    }
}

func add_child(flex: Ui.Layout.Flex, child: Child) {
    var key = child.parent.entity.id
    if not flex.children.has(key) {
        var children = List<Integer>()
        flex.children[key] = children
    }
    crash flex.children[key]
    flex.children[key].append(child.entity.id)
}
