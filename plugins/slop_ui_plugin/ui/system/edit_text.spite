type Editing {
    focused: Component.Focused
    input: Component.TextInput
    caret: Component.Caret
    text: Component.Text
}

type Stroke {
    entity: Entity
    event: Input.Component.Event
}

var keys = Input.Key()
var order = List<Integer>()

func after_input_all(editing: List<Editing>, strokes: List<Stroke>) {
    order_strokes(strokes)
    var index = 0
    while index < editing.count() {
        edit(editing[index], strokes)
        index = index + 1
    }
}

func order_strokes(strokes: List<Stroke>) {
    order.clear()
    var index = 0
    while index < strokes.count() {
        insert_in_order(strokes, index)
        index = index + 1
    }
}

func insert_in_order(strokes: List<Stroke>, index: Integer) {
    crash strokes[index]
    var entity = strokes[index].entity.id
    order.append(index)
    var at = order.count() - 1
    while at > 0 and earlier(strokes, entity, at - 1) {
        crash order[at - 1]
        order[at] = order[at - 1]
        at = at - 1
    }
    order[at] = index
}

func earlier(strokes: List<Stroke>, entity: Integer, at: Integer): Boolean {
    crash order[at]
    var listed = order[at]
    crash strokes[listed]
    return entity < strokes[listed].entity.id
}

func edit(editing: Editing, strokes: List<Stroke>) {
    var index = 0
    while index < order.count() {
        var listed = order[index]
        crash strokes[listed]
        apply_stroke(editing, strokes[listed].event)
        index = index + 1
    }
    editing.text.text = editing.input.value
}

func apply_stroke(editing: Editing, stroke: Input.Component.Event) {
    if stroke.kind == 'character_typed' {
        insert_typed(editing, stroke.character)
    } else if stroke.kind == 'key_pressed' {
        apply_key(editing, stroke.key)
    }
}

func apply_key(editing: Editing, key: Integer) {
    var value = editing.input.value
    var caret = editing.caret
    var length = value.length()
    if key == keys.backspace and caret.index > 0 {
        var before = value.slice(0, caret.index - 1)
        var after = value.slice(caret.index, length)
        editing.input.value = before + after
        caret.index = caret.index - 1
    } else if key == keys.delete and caret.index < length {
        var before = value.slice(0, caret.index)
        var after = value.slice(caret.index + 1, length)
        editing.input.value = before + after
    } else if key == keys.left and caret.index > 0 {
        caret.index = caret.index - 1
    } else if key == keys.right and caret.index < length {
        caret.index = caret.index + 1
    } else if key == keys.home {
        caret.index = 0
    } else if key == keys.end {
        caret.index = length
    }
}

func insert_typed(editing: Editing, typed: String) {
    assert typed != ""
    var value = editing.input.value
    var caret = editing.caret
    var before = value.slice(0, caret.index)
    var length = value.length()
    var after = value.slice(caret.index, length)
    editing.input.value = before + typed + after
    caret.index = caret.index + typed.length()
}
