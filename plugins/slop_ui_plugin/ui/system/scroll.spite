type Scrollable {
    entity: Entity
    layout: Component.ComputedLayout
    clip: Component.ComputedClip
    range: Component.ScrollRange
    position: Component.ScrollPosition
    bars: Component.ComputedScrollbars
}

type Dragging {
    entity: Entity
    drag: Component.ScrollDrag
    range: Component.ScrollRange
    position: Component.ScrollPosition
}

type Pointer {
    entity: Entity
    mouse: Input.Component.Mouse
}

var step: Float = 40.0

var left_down = false
var left_pressed = false
var vertical_drags = Lookup<Component.DraggingVertical>()
var vertical_bars = Lookup<Component.VerticalScrollbar>()
var horizontal_bars = Lookup<Component.HorizontalScrollbar>()

func after_input_all(scrollables: List<Scrollable>, draggings: List<Dragging>, pointers: List<Pointer>) {
    var index = 0
    while index < pointers.count() {
        var pointer = pointers[index]
        read_buttons(pointer.entity.id)
        var mouse = pointer.mouse
        scroll_under(scrollables, mouse)
        drag_every(draggings, mouse)
        start_drag(scrollables, mouse)
        index = index + 1
    }
}

func scroll_under(scrollables: List<Scrollable>, mouse: Input.Component.Mouse) {
    assert mouse.wheel != 0
    var chosen = under_pointer(scrollables, mouse)
    assert chosen >= 0
    crash scrollables[chosen]
    var target = scrollables[chosen]
    var distance: Float = step * mouse.wheel
    if target.range.vertical > 0.0 {
        target.position.top = limited(target.position.top - distance, target.range.vertical)
    } else {
        target.position.left = limited(target.position.left - distance, target.range.horizontal)
    }
}

func under_pointer(scrollables: List<Scrollable>, mouse: Input.Component.Mouse): Integer {
    var mouse_left: Float = mouse.left
    var mouse_top: Float = mouse.top
    var chosen = -1
    var chosen_area: Float = 0.0
    var index = 0
    while index < scrollables.count() {
        var candidate = scrollables[index]
        var layout = candidate.layout
        var inside_x = mouse_left >= layout.left and mouse_left < layout.left + layout.width
        var inside_y = mouse_top >= layout.top and mouse_top < layout.top + layout.height
        var visible = candidate.clip.contains(mouse_left, mouse_top)
        var can_move = candidate.range.vertical > 0.0 or candidate.range.horizontal > 0.0
        var area = layout.width * layout.height
        var smaller = chosen < 0 or area < chosen_area
        if inside_x and inside_y and visible and can_move and smaller {
            chosen = index
            chosen_area = area
        }
        index = index + 1
    }
    return chosen
}

func start_drag(scrollables: List<Scrollable>, mouse: Input.Component.Mouse) {
    assert left_pressed
    var mouse_left: Float = mouse.left
    var mouse_top: Float = mouse.top
    var index = 0
    while index < scrollables.count() {
        var candidate = scrollables[index]
        if candidate.clip.contains(mouse_left, mouse_top) {
            grab_thumb(candidate, mouse_left, mouse_top)
        }
        index = index + 1
    }
}

func grab_thumb(candidate: Scrollable, mouse_left: Float, mouse_top: Float) {
    var entity = candidate.entity.id
    var thickness = candidate.bars.thickness
    var vertical = vertical_bars.of(entity)
    if vertical {
        if vertical.on_thumb(mouse_left, mouse_top, thickness) {
            begin_drag(entity, true, mouse_top - vertical.thumb_top)
            return
        }
    }
    var horizontal = horizontal_bars.of(entity)
    assert horizontal
    assert horizontal.on_thumb(mouse_left, mouse_top, thickness)
    begin_drag(entity, false, mouse_left - horizontal.thumb_left)
}

func begin_drag(entity: Integer, vertical: Boolean, grab: Float) {
    var started = Component.ScrollDrag()
    started.grab = grab
    var owner = Entity(entity)
    owner.add_component(started)
    if vertical {
        var marker = Component.DraggingVertical()
        owner.add_component(marker)
    }
}

func drag_every(draggings: List<Dragging>, mouse: Input.Component.Mouse) {
    var index = 0
    while index < draggings.count() {
        drag(draggings[index], mouse)
        index = index + 1
    }
}

func drag(dragging: Dragging, mouse: Input.Component.Mouse) {
    var owner = dragging.entity
    var vertical = vertical_drags.has(owner.id)
    if not left_down {
        owner.remove_component(Component.ScrollDrag)
        if vertical {
            owner.remove_component(Component.DraggingVertical)
        }
        return
    }
    var mouse_left: Float = mouse.left
    var mouse_top: Float = mouse.top
    if vertical {
        var bar = vertical_bars.of(owner.id)
        assert bar
        var travel = bar.track_height - bar.thumb_height
        assert travel > 0.0
        var thumb_offset = mouse_top - dragging.drag.grab - bar.track_top
        dragging.position.top = limited(thumb_offset / travel * dragging.range.vertical, dragging.range.vertical)
        return
    }
    var bar = horizontal_bars.of(owner.id)
    assert bar
    var travel = bar.track_width - bar.thumb_width
    assert travel > 0.0
    var thumb_offset = mouse_left - dragging.drag.grab - bar.track_left
    dragging.position.left = limited(thumb_offset / travel * dragging.range.horizontal, dragging.range.horizontal)
}

func limited(value: Float, maximum: Float): Float {
    if value < 0.0 {
        return 0.0
    } else if value > maximum {
        return maximum
    }
    return value
}

func read_buttons(entity: Integer) {
    left_down = Lookup<Input.Component.LeftDown>().has(entity)
    left_pressed = Lookup<Input.Component.LeftPressed>().has(entity)
}
