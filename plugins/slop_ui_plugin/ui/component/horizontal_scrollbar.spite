var track_left: Float = 0.0
var track_top: Float = 0.0
var track_width: Float = 0.0
var thumb_left: Float = 0.0
var thumb_width: Float = 0.0

func on_track(across: Float, down: Float, thickness: Float): Boolean {
    var inside_x = across >= track_left and across < track_left + track_width
    return inside_x and down >= track_top and down < track_top + thickness
}

func on_thumb(across: Float, down: Float, thickness: Float): Boolean {
    return on_track(across, down, thickness) and across >= thumb_left and across < thumb_left + thumb_width
}
