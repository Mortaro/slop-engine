var blobs = Recipes.Blobs()
var world = World()
var face_names = List<String>()
var faces = List<TrueType.Face>()
var size_names = List<String>()
var size_faces = List<Integer>()
var pixel_sizes = List<Integer>()
var ascents = List<Integer>()
var line_heights = List<Integer>()
var atlases = List<Asset.Texture>()
var atlas_texels = List<Asset.Bytes>()
var raw = Raw()
var atlas_changed = List<Boolean>()
var shelf_lefts = List<Integer>()
var shelf_tops = List<Integer>()
var shelf_heights = List<Integer>()
var glyph_tables = List<Dictionary<Integer>>()
var glyph_lefts = List<Integer>()
var glyph_tops = List<Integer>()
var glyph_widths = List<Integer>()
var glyph_heights = List<Integer>()
var glyph_bearings = List<Integer>()
var glyph_risers = List<Integer>()
var pending_sizes = List<Integer>()
var pending_codes = List<Integer>()
var waiting_faces = List<String>()
var first_atlas_side = 256
var largest_atlas_side = 4096
var atlas_sides = List<Integer>()
var glyphs_per_frame = 32
var outline = TrueType.Outline()
var rasterizer = TrueType.Rasterizer()
var bitmap = TrueType.GlyphBitmap()

func size_slot(font: String, face_index: Integer, pixels: Integer): Integer {
    var name = "{font}#{face_index}@{pixels}"
    var index = 0
    while index < size_names.count() {
        if size_names.get_at(index) == name {
            return index
        }
        index = index + 1
    }
    var face_slot = face_slot_of(font, face_index)
    if face_slot < 0 {
        return -1
    }
    var pixels_fit = pixels > 0 and pixels < 512
    crash pixels_fit
    var face = faces.get_at(face_slot)
    var units: Float = face.units_per_em
    var scale_of_size: Float = pixels
    var per_unit = scale_of_size / units
    var ascent_units: Float = face.ascender
    var descent_units: Float = face.descender
    var gap_units: Float = face.line_gap
    var ascent: Integer = ascent_units * per_unit + 0.5
    var line_height: Integer = (ascent_units - descent_units + gap_units) * per_unit + 0.5
    size_names.append(name)
    size_faces.append(face_slot)
    pixel_sizes.append(pixels)
    ascents.append(ascent)
    line_heights.append(line_height)
    var atlas = Asset.Texture()
    var texels = Asset.Bytes()
    fill_blank(atlas, texels, first_atlas_side)
    atlases.append(atlas)
    atlas_texels.append(texels)
    atlas_sides.append(first_atlas_side)
    atlas_changed.append(false)
    shelf_lefts.append(1)
    shelf_tops.append(1)
    shelf_heights.append(0)
    var table = Dictionary<Integer>()
    glyph_tables.append(table)
    return size_names.count() - 1
}

func face_slot_of(font: String, face_index: Integer): Integer {
    var name = "{font}#{face_index}"
    var index = 0
    while index < face_names.count() {
        if face_names.get_at(index) == name {
            return index
        }
        index = index + 1
    }
    var cooked = blobs.bytes_of(font)
    if not cooked {
        if not waiting_faces.contains(name) {
            waiting_faces.append(name)
        }
        return -1
    }
    var waiting = waiting_faces.count() - 1
    while waiting >= 0 {
        if waiting_faces.get_at(waiting) == name {
            waiting_faces.remove_at(waiting)
        }
        waiting = waiting - 1
    }
    var data = TrueType.FontData()
    data.copy_bytes(cooked.address, cooked.length)
    var face = TrueType.Face(data, face_index)
    face_names.append(name)
    faces.append(face)
    return face_names.count() - 1
}

func ascent_of(size: Integer): Integer {
    return ascents.get_at(size)
}

func line_height_of(size: Integer): Integer {
    return line_heights.get_at(size)
}

func advance_of(size: Integer, codepoint: Integer): Float {
    var face_slot = size_faces.get_at(size)
    var face = faces.get_at(face_slot)
    var glyph = face.glyph_index(codepoint)
    var units: Float = face.units_per_em
    var advance_units: Float = face.advance(glyph)
    var pixels: Float = pixel_sizes.get_at(size)
    return advance_units * pixels / units
}

func text_width(size: Integer, text: String): Float {
    var codes = List<Integer>()
    codepoints(text, codes)
    var width: Float = 0.0
    var index = 0
    while index < codes.count() {
        var code = codes.get_at(index)
        width = width + advance_of(size, code)
        index = index + 1
    }
    return width
}

func glyph_of(size: Integer, codepoint: Integer): Integer {
    var table = glyph_tables.get_at(size)
    var found = table.get(codepoint)
    if found {
        return found
    }
    queue(size, codepoint)
    return -1
}

func queue(size: Integer, codepoint: Integer) {
    var index = 0
    var queued = false
    while not queued and index < pending_codes.count() {
        queued = pending_codes.get_at(index) == codepoint and pending_sizes.get_at(index) == size
        index = index + 1
    }
    assert not queued
    if pending_codes.count() == 0 {
        var marker = Ui.Component.PendingGlyphs()
        var shelf = world.as_entity()
        shelf.add_component(marker)
    }
    pending_sizes.append(size)
    pending_codes.append(codepoint)
}

func rasterize_pending() {
    var done = 0
    while done < glyphs_per_frame and pending_codes.count() > 0 {
        var size = pending_sizes.get_at(0)
        var codepoint = pending_codes.get_at(0)
        pending_sizes.remove_at(0)
        pending_codes.remove_at(0)
        add_glyph(size, codepoint)
        done = done + 1
    }
    if pending_codes.count() == 0 {
        var shelf = world.as_entity()
        shelf.remove_component(Ui.Component.PendingGlyphs)
    }
}

func add_glyph(size: Integer, codepoint: Integer) {
    var face_slot = size_faces.get_at(size)
    var face = faces.get_at(face_slot)
    var glyph = face.glyph_index(codepoint)
    face.outline_of(glyph, outline)
    var units: Float = face.units_per_em
    var pixels: Float = pixel_sizes.get_at(size)
    var per_unit = pixels / units
    var advance_units: Float = face.advance(glyph)
    bitmap.clear()
    if outline.xs.count() > 0 {
        rasterizer.raster(outline, per_unit, advance_units * per_unit, bitmap)
    }
    var place = glyph_lefts.count()
    var packed = pack(size, bitmap.width, bitmap.height)
    while packed < 0 {
        grow(size)
        packed = pack(size, bitmap.width, bitmap.height)
    }
    var side = atlas_sides.get_at(size)
    var left = packed % side
    var top = packed / side
    copy_into_atlas(size, left, top)
    glyph_lefts.append(left)
    glyph_tops.append(top)
    glyph_widths.append(bitmap.width)
    glyph_heights.append(bitmap.height)
    glyph_bearings.append(bitmap.left)
    glyph_risers.append(bitmap.top)
    var table = glyph_tables.get_at(size)
    table.set(codepoint, place)
    if not atlas_changed.contains(true) {
        var marker = Ui.Component.AtlasChanged()
        var shelf = world.as_entity()
        shelf.add_component(marker)
    }
    atlas_changed.set_at(size, true)
}

func pack(size: Integer, width: Integer, height: Integer): Integer {
    var left = shelf_lefts.get_at(size)
    var top = shelf_tops.get_at(size)
    var shelf = shelf_heights.get_at(size)
    var atlas_side = atlas_sides.get_at(size)
    if left + width + 1 > atlas_side {
        top = top + shelf + 1
        left = 1
        shelf = 0
    }
    if top + height + 1 > atlas_side {
        return -1
    }
    if height > shelf {
        shelf = height
    }
    shelf_lefts.set_at(size, left + width + 1)
    shelf_tops.set_at(size, top)
    shelf_heights.set_at(size, shelf)
    return top * atlas_side + left
}

func copy_into_atlas(size: Integer, left: Integer, top: Integer) {
    var atlas = atlases.get_at(size)
    var texels = atlas_texels.get_at(size)
    var atlas_side = atlas_sides.get_at(size)
    var row = 0
    while row < bitmap.height {
        var column = 0
        while column < bitmap.width {
            var coverage = bitmap.coverage_at(column, row)
            var alpha = coverage.shifted_left(24)
            var texel = alpha.bits_or(16777215)
            var at = (top + row) * atlas_side + left + column
            atlas.pixels.set_at(at, texel)
            raw.write_integer(texels.address, at * 4, texel)
            column = column + 1
        }
        row = row + 1
    }
}

func fill_blank(atlas: Asset.Texture, texels: Asset.Bytes, side: Integer) {
    atlas.width = side
    atlas.height = side
    while atlas.pixels.count() < side * side {
        atlas.pixels.append(16777215)
    }
    texels.reserve(side * side * 4 + 4)
    var blank = 0
    while blank < side * side {
        texels.write_integer(16777215)
        blank = blank + 1
    }
}

func grow(size: Integer) {
    var old_side = atlas_sides.get_at(size)
    var side = old_side * 2
    var atlas_fits_the_largest_side = side <= largest_atlas_side
    crash atlas_fits_the_largest_side
    var old_atlas = atlases.get_at(size)
    var old_texels = atlas_texels.get_at(size)
    var atlas = Asset.Texture()
    var texels = Asset.Bytes()
    fill_blank(atlas, texels, side)
    var row = 0
    while row < old_side {
        copy_row(old_atlas, old_texels, old_side, atlas, texels, side, row)
        row = row + 1
    }
    atlases.set_at(size, atlas)
    atlas_texels.set_at(size, texels)
    atlas_sides.set_at(size, side)
    if not atlas_changed.contains(true) {
        var marker = Ui.Component.AtlasChanged()
        var shelf = world.as_entity()
        shelf.add_component(marker)
    }
    atlas_changed.set_at(size, true)
}

func copy_row(
    old_atlas: Asset.Texture,
    old_texels: Asset.Bytes,
    old_side: Integer,
    atlas: Asset.Texture,
    texels: Asset.Bytes,
    side: Integer,
    row: Integer,
) {
    var source = old_texels.address + row * old_side * 4
    var target = texels.address + row * side * 4
    raw.copy(source, target, old_side * 4)
    var column = 0
    while column < old_side {
        var texel = old_atlas.pixels.get_at(row * old_side + column)
        atlas.pixels.set_at(row * side + column, texel)
        column = column + 1
    }
}

func glyph_left(glyph: Integer): Integer {
    return glyph_lefts.get_at(glyph)
}

func glyph_top(glyph: Integer): Integer {
    return glyph_tops.get_at(glyph)
}

func glyph_width(glyph: Integer): Integer {
    return glyph_widths.get_at(glyph)
}

func glyph_height(glyph: Integer): Integer {
    return glyph_heights.get_at(glyph)
}

func glyph_bearing(glyph: Integer): Integer {
    return glyph_bearings.get_at(glyph)
}

func glyph_riser(glyph: Integer): Integer {
    return glyph_risers.get_at(glyph)
}

func atlas_id(size: Integer): String {
    var name = size_names.get_at(size)
    return "font-atlas:{name}"
}

func codepoints(text: String, codes: List<Integer>) {
    var index = 0
    var length = text.length()
    while index < length {
        var lead = text.code_at(index).bits_and(255)
        var count = 1
        var code = lead
        if lead >= 240 {
            count = 4
            code = lead.bits_and(7)
        } else if lead >= 224 {
            count = 3
            code = lead.bits_and(15)
        } else if lead >= 192 {
            count = 2
            code = lead.bits_and(31)
        }
        var follow = 1
        while follow < count and index + follow < length {
            var next = text.code_at(index + follow).bits_and(63)
            code = code * 64 + next
            follow = follow + 1
        }
        codes.append(code)
        index = index + count
    }
}

func settled(): Boolean {
    return waiting_faces.count() == 0 and pending_codes.count() == 0 and not atlas_changed.contains(true)
}
