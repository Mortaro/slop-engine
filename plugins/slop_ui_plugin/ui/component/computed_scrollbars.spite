var order = -1
var thickness: Float = 0.0
var vertical_shown = false
var vertical_track_left: Float = 0.0
var vertical_track_top: Float = 0.0
var vertical_track_height: Float = 0.0
var vertical_thumb_top: Float = 0.0
var vertical_thumb_height: Float = 0.0
var horizontal_shown = false
var horizontal_track_left: Float = 0.0
var horizontal_track_top: Float = 0.0
var horizontal_track_width: Float = 0.0
var horizontal_thumb_left: Float = 0.0
var horizontal_thumb_width: Float = 0.0

func on_vertical_track(across: Float, down: Float): Boolean {
    var inside_x = across >= vertical_track_left and across < vertical_track_left + thickness
    var inside_y = down >= vertical_track_top and down < vertical_track_top + vertical_track_height
    return vertical_shown and inside_x and inside_y
}

func on_horizontal_track(across: Float, down: Float): Boolean {
    var inside_x = across >= horizontal_track_left and across < horizontal_track_left + horizontal_track_width
    var inside_y = down >= horizontal_track_top and down < horizontal_track_top + thickness
    return horizontal_shown and inside_x and inside_y
}

func covers(across: Float, down: Float): Boolean {
    return on_vertical_track(across, down) or on_horizontal_track(across, down)
}
