type Target {
    entity: Entity
    view: Component.View
}

type Viewing {
    camera: Camera.Component.Camera
}

var cameras = Lookup<Component.ViewCamera>()
var occlusion_cullings = Lookup<Component.OcclusionCulling>()
var forced_levels = Lookup<Component.ForcedDetailLevel>()
var draws = Scene.Draws()

func prepare_each(target: Target, viewing: Viewing) {
    var view = target.view
    var owner = target.entity
    var drawn = draws.of(owner.id)
    drawn.begin()
    switch_culling(drawn, owner)
    var existing = cameras.of(owner.id)
    if existing {
        existing.look_through(viewing.camera)
        view.cone.prepare(existing)
        return
    }
    var camera = Component.ViewCamera()
    camera.look_through(viewing.camera)
    view.cone.prepare(camera)
    owner.add_component(camera)
}

func switch_culling(drawn: Scene.DrawSet, owner: Entity) {
    var occlusion = occlusion_cullings.of(owner.id)
    drawn.culls_occluded = false
    if occlusion {
        drawn.culls_occluded = true
        drawn.camera_cut = occlusion.camera_cut
    }
    var forced = forced_levels.of(owner.id)
    drawn.forced_detail_level = -1
    assert forced
    drawn.forced_detail_level = forced.level
}
