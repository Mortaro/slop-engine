type Target {
    entity: Entity
    view: Component.View
    camera: Component.ViewCamera
}

type Modeled {
    entity: Entity
    model: Component.Model
    transform: Transform.Component.Transform
}

var textures = Render.Textures()
var meshes = Scene.Meshes()

var off_views = Lookup<Component.OffView>()
var skins = Lookup<Component.Skin>()
var draws = Scene.Draws()
var lights = Scene.Lights()
var no_palette = List<Math.Matrix4>()

func render_each(target: Target, modeled: Modeled) {
    add_draw(target, modeled)
}

func add_draw(target: Target, modeled: Modeled) {
    var slot = meshes.request(modeled.model.mesh)
    var loaded = meshes.loaded_of(slot)
    assert loaded
    var model = modeled.transform.matrix()
    var drawn = draws.of(target.entity.id)
    var palette = no_palette
    var skin = skins.of(modeled.entity.id)
    if skin {
        palette = skin.pose.palette
    }
    var skinned = palette.count() > 0
    if skinned {
        var mesh_name = modeled.model.mesh
        var palette_covers_the_mesh_joints = loaded.joint_limit <= palette.count()
        crash palette_covers_the_mesh_joints or mesh_name == ""
        target.view.cone.place_posed(model, loaded, palette)
    } else {
        target.view.cone.place(model, loaded)
    }
    var radius = target.view.cone.radius_of(loaded, modeled.transform)
    var in_view = target.view.cone.contains(radius)
    var casting = in_view or casts_into_view(target.view, radius)
    if skinned {
        mark_view(modeled.entity, casting)
    }
    assert casting
    var palette_first = 0
    if skinned {
        palette_first = drawn.palettes.count()
        var index = 0
        while index < palette.count() {
            drawn.palettes.append(palette[index])
            index = index + 1
        }
    }
    var section = 0
    while section * 3 + 2 < loaded.sections.count() {
        var draw = Scene.Draw()
        draw.mesh_slot = slot
        draw.model = model
        draw.palette_first = palette_first
        draw.center_x = target.view.cone.placed.x_value
        draw.center_y = target.view.cone.placed.y_value
        draw.center_z = target.view.cone.placed.z_value
        draw.radius = radius
        add_section(drawn, loaded, draw, section, in_view)
        section = section + 1
    }
}

func add_section(drawn: Scene.DrawSet, loaded: Scene.LoadedMesh, draw: Scene.Draw, section: Integer, in_view: Boolean) {
    var at = section * 3
    crash loaded.sections[at]
    crash loaded.sections[at + 1]
    crash loaded.sections[at + 2]
    draw.section = section
    draw.first_index = loaded.sections[at]
    draw.index_count = loaded.sections[at + 1]
    var material = loaded.sections[at + 2]
    draw.masked = loaded.masked_materials.contains(material)
    if material < loaded.textures.count() {
        var texture = loaded.textures[material]
        if not texture.is_empty() {
            draw.texture_slot = textures.request(texture)
        }
    }
    if in_view {
        drawn.draws.append(draw)
    } else {
        drawn.casters.append(draw)
    }
}

func casts_into_view(view: Component.View, radius: Float): Boolean {
    var sun_reach = view.cascade_count > 0 and view.cone.shades_view(radius, view.sun_toward_x, view.sun_toward_y, view.sun_toward_z)
    var light_reach = lights.last_shadow_reach * 2.0
    return sun_reach or light_reach > 0.0 and view.cone.contains(radius + light_reach)
}

func mark_view(entity: Entity, seen: Boolean) {
    var marked = off_views.has(entity.id)
    if seen and marked {
        entity.remove_component(Component.OffView)
    }
    if not seen and not marked {
        var marker = Component.OffView()
        entity.add_component(marker)
    }
}
