type Modeled {
    model: Component.Model
    transform: Transform.Component.Transform
}

type Cell {
    cell: Component.TerrainCell
    transform: Transform.Component.Transform
}

type Viewing {
    camera: Camera.Component.Camera
}

type Target {
    view: Component.View
    meshes: Component.Meshes
    textures: Render.Component.Textures
    terrain_materials: Component.TerrainMaterials
}

var cone = Scene.ViewCone()

func render_all(targets: List<Target>, models: List<Modeled>, cameras: List<Viewing>, cells: List<Cell>) {
    var index = 0
    while index < targets.count() {
        var target = targets.get_at(index)
        gather(target, models, cameras)
        gather_cells(target, cells)
        index = index + 1
    }
}

func gather_cells(target: Target, cells: List<Cell>) {
    assert target.view.has_camera
    var index = 0
    while index < cells.count() {
        add_cell(target, cells[index])
        index = index + 1
    }
}

func add_cell(target: Target, placed: Cell) {
    var cell = placed.cell
    var slot = target.meshes.request(cell.mesh)
    var material_slot = target.terrain_materials.request(cell.material)
    assert target.meshes.is_ready(slot) and target.terrain_materials.is_ready(material_slot)
    target.terrain_materials.request_textures(material_slot, target.textures)
    var loaded = target.meshes.mesh_at(slot)
    var model = placed.transform.matrix()
    cone.place(model, loaded)
    var radius = cone.radius_of(loaded, placed.transform)
    assert cone.contains(radius)
    if cell.far_mesh != "" and cone.distance_to_eye() - radius > cell.far_distance {
        var far_slot = target.meshes.request(cell.far_mesh)
        if target.meshes.is_ready(far_slot) {
            slot = far_slot
        }
    }
    var drawn = target.meshes.mesh_at(slot)
    var section = 0
    while section * 3 + 2 < drawn.sections.count() {
        var draw = Scene.TerrainDraw()
        draw.mesh_slot = slot
        draw.model = model
        draw.first_index = drawn.sections.get_at(section * 3)
        draw.index_count = drawn.sections.get_at(section * 3 + 1)
        draw.material_slot = material_slot
        target.view.terrain_draws.append(draw)
        section = section + 1
    }
}

func gather(target: Target, models: List<Modeled>, cameras: List<Viewing>) {
    var view = target.view
    view.begin()
    var camera = cameras.first()
    assert camera
    view.has_camera = true
    view.field_of_view = camera.camera.field_of_view
    view.near = camera.camera.near
    view.far = camera.camera.far
    var lens = camera.camera
    view.eye_x = lens.eye_x
    view.eye_y = lens.eye_y
    view.eye_z = lens.eye_z
    view.shadow_center_x = lens.target_x
    view.shadow_center_y = lens.target_y
    view.shadow_center_z = lens.target_z
    view.view.set_look_at(lens.eye_x, lens.eye_y, lens.eye_z, lens.target_x, lens.target_y, lens.target_z)
    cone.prepare(view)
    var index = 0
    while index < models.count() {
        add_draw(target, models[index])
        index = index + 1
    }
}

func add_draw(target: Target, modeled: Modeled) {
    var slot = target.meshes.request(modeled.model.mesh)
    assert target.meshes.is_ready(slot)
    var loaded = target.meshes.mesh_at(slot)
    var model = modeled.transform.matrix()
    var skinned = modeled.model.palette.count() > 0
    cone.place(model, loaded)
    var radius = cone.radius_of(loaded, modeled.transform)
    var in_view = cone.contains(radius)
    assert skinned or in_view
    var palette_first = 0
    var palette = modeled.model.palette
    if palette.count() > 0 {
        var mesh_name = modeled.model.mesh
        var palette_covers_the_mesh_joints = loaded.joint_limit <= palette.count()
        crash palette_covers_the_mesh_joints or mesh_name == ""
        palette_first = target.view.palettes.count()
        var index = 0
        while index < palette.count() {
            target.view.palettes.append(palette[index])
            index = index + 1
        }
    }
    var section = 0
    while section * 3 + 2 < loaded.sections.count() {
        var draw = Scene.Draw()
        draw.mesh_slot = slot
        draw.model = model
        draw.palette_first = palette_first
        add_section(target, loaded, draw, section)
        section = section + 1
    }
}

func add_section(target: Target, loaded: Scene.LoadedMesh, draw: Scene.Draw, section: Integer) {
    var at = section * 3
    crash loaded.sections[at]
    crash loaded.sections[at + 1]
    crash loaded.sections[at + 2]
    draw.first_index = loaded.sections[at]
    draw.index_count = loaded.sections[at + 1]
    var material = loaded.sections[at + 2]
    if material < loaded.textures.count() {
        var texture = loaded.textures[material]
        if not texture.is_empty() {
            draw.texture_slot = target.textures.request(texture)
        }
    }
    target.view.draws.append(draw)
}
