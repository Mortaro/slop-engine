type Target {
    entity: Entity
    view: Component.View
    camera: Component.ViewCamera
}

type Cell {
    cell: Component.TerrainCell
    transform: Transform.Component.Transform
}

var textures = Render.Textures()
var draws = Scene.Draws()
var meshes = Scene.Meshes()
var terrain_materials = Scene.TerrainMaterials()

func render_each(target: Target, placed: Cell) {
    add_cell(target, placed)
}

func add_cell(target: Target, placed: Cell) {
    var cell = placed.cell
    var slot = meshes.request(cell.mesh)
    var material_slot = terrain_materials.request(cell.material)
    assert meshes.is_ready(slot) and terrain_materials.is_ready(material_slot)
    terrain_materials.request_textures(material_slot, textures)
    var loaded = meshes.mesh_at(slot)
    var model = placed.transform.matrix()
    target.view.cone.place(model, loaded)
    var radius = target.view.cone.radius_of(loaded, placed.transform)
    assert target.view.cone.contains(radius)
    if cell.far_mesh != "" and target.view.cone.distance_to_eye() - radius > cell.far_distance {
        var far_slot = meshes.request(cell.far_mesh)
        if meshes.is_ready(far_slot) {
            slot = far_slot
        }
    }
    var drawn = meshes.mesh_at(slot)
    var section = 0
    while section * 3 + 2 < drawn.sections.count() {
        var draw = Scene.TerrainDraw()
        draw.mesh_slot = slot
        draw.model = model
        draw.first_index = drawn.sections[section * 3]
        draw.index_count = drawn.sections[section * 3 + 1]
        draw.material_slot = material_slot
        draw.center_x = target.view.cone.placed.x
        draw.center_y = target.view.cone.placed.y
        draw.center_z = target.view.cone.placed.z
        draw.radius = radius
        draws.of(target.entity.id).terrain_draws.append(draw)
        section = section + 1
    }
}
