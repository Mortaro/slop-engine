var has_camera = false
var view = Math.Matrix4()
var field_of_view: Float = 0.785398
var near: Float = 0.1
var far: Float = 500.0
var draws = List<Scene.Draw>()
var palettes = List<Math.Matrix4>()
var eye_x: Float = 0.0
var eye_y: Float = 0.0
var eye_z: Float = 0.0
var sun_toward_x: Float = -0.5792
var sun_toward_y: Float = 0.7071
var sun_toward_z: Float = -0.4056
var sun_red: Float = 1.0
var sun_green: Float = 0.96
var sun_blue: Float = 0.9
var sun_illuminance: Float = 120000.0
var sky_red: Float = 0.45
var sky_green: Float = 0.6
var sky_blue: Float = 0.9
var sky_luminance: Float = 9000.0
var ground_red: Float = 0.35
var ground_green: Float = 0.3
var ground_blue: Float = 0.25
var ground_luminance: Float = 2500.0
var fog_density: Float = 0.00015
var fog_falloff: Float = 0.004
var fog_base_height: Float = 150.0
var exposure_value: Float = 15.0
var roughness: Float = 0.7
var shadow_center_x: Float = 0.0
var shadow_center_y: Float = 1.0
var shadow_center_z: Float = 0.0
var shadow_radius: Float = 6.0
var specular: Float = 0.5
var metallic: Float = 0.0

func begin() {
    has_camera = false
    draws.clear()
    palettes.clear()
    var identity = Math.Matrix4()
    palettes.append(identity)
}

func projection(aspect: Float): Math.Matrix4 {
    var result = Math.Matrix4()
    result.set_perspective(field_of_view, aspect, near, far)
    return result
}
