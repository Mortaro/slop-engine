var view = Matrix4<Float>()
var field_of_view: Float = 0.785398
var near: Float = 0.1
var far: Float = 500.0
var aspect: Float = 1.7777778
var eye_x: Float = 0.0
var eye_y: Float = 0.0
var eye_z: Float = 0.0

func look_through(lens: Camera.Component.Camera) {
    field_of_view = lens.field_of_view
    near = lens.near
    far = lens.far
    eye_x = lens.eye_x
    eye_y = lens.eye_y
    eye_z = lens.eye_z
    var eye = Vector3(lens.eye_x, lens.eye_y, lens.eye_z)
    var target = Vector3(lens.target_x, lens.target_y, lens.target_z)
    var up = Vector3(0.0, 1.0, 0.0)
    view.set_look_at(eye, target, up)
}

func projection(aspect_ratio: Float): Matrix4<Float> {
    var result = Matrix4<Float>()
    result.set_reversed_perspective(field_of_view, aspect_ratio, near, far)
    return result
}
