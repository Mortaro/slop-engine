var view = Math.Matrix4()
var field_of_view: Float = 0.785398
var near: Float = 0.1
var far: Float = 500.0
var aspect: Float = 1.7777778
var eye_x: Float = 0.0
var eye_y: Float = 0.0
var eye_z: Float = 0.0
var shadow_center_x: Float = 0.0
var shadow_center_y: Float = 1.0
var shadow_center_z: Float = 0.0

func look_through(lens: Camera.Component.Camera) {
    field_of_view = lens.field_of_view
    near = lens.near
    far = lens.far
    eye_x = lens.eye_x
    eye_y = lens.eye_y
    eye_z = lens.eye_z
    shadow_center_x = lens.target_x
    shadow_center_y = lens.target_y
    shadow_center_z = lens.target_z
    view.set_look_at(lens.eye_x, lens.eye_y, lens.eye_z, lens.target_x, lens.target_y, lens.target_z)
}

func projection(aspect_ratio: Float): Math.Matrix4 {
    var result = Math.Matrix4()
    result.set_reversed_perspective(field_of_view, aspect_ratio, near, far)
    return result
}
