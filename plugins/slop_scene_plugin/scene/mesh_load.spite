var path = ""
var offset: Long = 0
var length: Long = 0
var key = ""
var vertex_floats = 8
var joint_limit = 0
var scalar = Math.Scalar()

func MeshLoad(found: Recipes.Record) {
    path = found.path
    offset = found.offset
    length = found.length
    key = found.key
}

func run(): Scene.LoadedMesh {
    var record = Recipes.Record()
    record.path = path
    record.offset = offset
    record.length = length
    record.key = key
    var bytes = record.read()
    var pack = Pack<Asset.Mesh>()
    var mesh = pack.decode(bytes)
    crash mesh
    var loaded = Scene.LoadedMesh()
    loaded.sections = mesh.sections
    loaded.textures = mesh.textures
    loaded.masked_materials = mesh.masked_materials
    var count = mesh.vertices.count() / vertex_floats
    var skinned = mesh.joints.count() == count
    var vertex = 0
    while vertex < count {
        write_vertex(loaded.vertices, mesh, vertex, skinned)
        vertex = vertex + 1
    }
    measure_bounds(loaded, mesh, count)
    loaded.joint_limit = joint_limit
    note_used_joints(loaded, mesh, skinned)
    loaded.index_count = mesh.indices.count()
    mesh.indices.each(loaded.indices.write_integer)
    return loaded
}

func write_vertex(target: Asset.Bytes, mesh: Asset.Mesh, vertex: Integer, skinned: Boolean) {
    var first = vertex * vertex_floats
    var index = 0
    while index < vertex_floats {
        crash mesh.vertices[first + index]
        target.write_float(mesh.vertices[first + index])
        index = index + 1
    }
    if skinned {
        crash mesh.joints[vertex]
        var packed = mesh.joints[vertex]
        target.write_integer(packed)
        note_joints(packed)
        var weight = 0
        var total: Float = 0.0
        while weight < 4 {
            crash mesh.weights[vertex * 4 + weight]
            total = total + mesh.weights[vertex * 4 + weight]
            target.write_float(mesh.weights[vertex * 4 + weight])
            weight = weight + 1
        }
        var skinned_vertex_is_weighted = total > 0.0
        crash skinned_vertex_is_weighted
    } else {
        target.write_integer(0)
        target.write_float(1.0)
        target.write_float(0.0)
        target.write_float(0.0)
        target.write_float(0.0)
    }
}

func note_joints(packed: Integer) {
    var shift = 0
    while shift < 32 {
        var joint = packed.shifted_right(shift).bits_and(255)
        if joint + 1 > joint_limit {
            joint_limit = joint + 1
        }
        shift = shift + 8
    }
}

func measure_bounds(loaded: Scene.LoadedMesh, mesh: Asset.Mesh, count: Integer) {
    assert count > 0
    var low_x = mesh.vertices.get_at(0)
    var low_y = mesh.vertices.get_at(1)
    var low_z = mesh.vertices.get_at(2)
    var high_x = low_x
    var high_y = low_y
    var high_z = low_z
    var vertex = 1
    while vertex < count {
        var first = vertex * vertex_floats
        var along_x = mesh.vertices.get_at(first)
        var along_y = mesh.vertices.get_at(first + 1)
        var along_z = mesh.vertices.get_at(first + 2)
        low_x = smaller(low_x, along_x)
        low_y = smaller(low_y, along_y)
        low_z = smaller(low_z, along_z)
        high_x = larger(high_x, along_x)
        high_y = larger(high_y, along_y)
        high_z = larger(high_z, along_z)
        vertex = vertex + 1
    }
    loaded.bound_x = (low_x + high_x) * 0.5
    loaded.bound_y = (low_y + high_y) * 0.5
    loaded.bound_z = (low_z + high_z) * 0.5
    var half_x = (high_x - low_x) * 0.5
    var half_y = (high_y - low_y) * 0.5
    var half_z = (high_z - low_z) * 0.5
    var radius = scalar.square_root(half_x * half_x + half_y * half_y + half_z * half_z)
    loaded.bound_radius = radius
}

func smaller(first: Float, second: Float): Float {
    if second < first {
        return second
    }
    return first
}

func larger(first: Float, second: Float): Float {
    if second > first {
        return second
    }
    return first
}

func note_used_joints(loaded: Scene.LoadedMesh, mesh: Asset.Mesh, skinned: Boolean) {
    assert skinned
    var vertex = 0
    while vertex < mesh.joints.count() {
        var packed = mesh.joints.get_at(vertex)
        var slot = 0
        while slot < 4 {
            add_used_joint(loaded, mesh, packed, vertex, slot)
            slot = slot + 1
        }
        vertex = vertex + 1
    }
}

func add_used_joint(loaded: Scene.LoadedMesh, mesh: Asset.Mesh, packed: Integer, vertex: Integer, slot: Integer) {
    var weight = mesh.weights.get_at(vertex * 4 + slot)
    var joint = packed.shifted_right(slot * 8).bits_and(255)
    assert weight > 0.0 and not loaded.used_joints.contains(joint)
    loaded.used_joints.append(joint)
}
