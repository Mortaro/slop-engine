var path = ""
var offset: Long = 0
var length: Long = 0
var key = ""
var vertex_floats = 8
var joint_limit = 0

func MeshLoad(found: Recipes.Record) {
    path = found.path
    offset = found.offset
    length = found.length
    key = found.key
}

func run(): Scene.LoadedMesh {
    var record = Recipes.Record()
    record.path = path
    record.offset = offset
    record.length = length
    record.key = key
    var bytes = record.read()
    var pack = Pack<Asset.Mesh>()
    var mesh = pack.decode(bytes)
    crash mesh
    var loaded = Scene.LoadedMesh()
    loaded.sections = mesh.sections
    loaded.textures = mesh.textures
    loaded.masked_materials = mesh.masked_materials
    loaded.detail_sections = mesh.detail_sections
    loaded.detail_screen_sizes = mesh.detail_screen_sizes
    loaded.materials = mesh.materials
    var count = mesh.vertices.count() / vertex_floats
    var skinned = mesh.joints.count() == count
    var tangent_space = mesh.tangents.count() == count * 4
    var vertex = 0
    while vertex < count {
        write_vertex(loaded.vertices, mesh, vertex, skinned)
        write_tangent(loaded.vertices, mesh, vertex, tangent_space)
        vertex = vertex + 1
    }
    measure_bounds(loaded, mesh, count)
    loaded.joint_limit = joint_limit
    note_used_joints(loaded, mesh, skinned)
    loaded.index_count = mesh.indices.count()
    mesh.indices.each(loaded.indices.write_integer)
    return loaded
}

func write_vertex(target: Asset.Bytes, mesh: Asset.Mesh, vertex: Integer, skinned: Boolean) {
    var first = vertex * vertex_floats
    var index = 0
    while index < vertex_floats {
        crash mesh.vertices[first + index]
        target.write_float(mesh.vertices[first + index])
        index = index + 1
    }
    if skinned {
        crash mesh.joints[vertex]
        var packed = mesh.joints[vertex]
        target.write_integer(packed)
        note_joints(packed)
        var weight = 0
        var total: Float = 0.0
        while weight < 4 {
            crash mesh.weights[vertex * 4 + weight]
            total = total + mesh.weights[vertex * 4 + weight]
            target.write_float(mesh.weights[vertex * 4 + weight])
            weight = weight + 1
        }
        var skinned_vertex_is_weighted = total > 0.0
        crash skinned_vertex_is_weighted
    } else {
        target.write_integer(0)
        target.write_float(1.0)
        target.write_float(0.0)
        target.write_float(0.0)
        target.write_float(0.0)
    }
}

func write_tangent(target: Asset.Bytes, mesh: Asset.Mesh, vertex: Integer, tangent_space: Boolean) {
    if tangent_space {
        crash mesh.tangents[vertex * 4]
        crash mesh.tangents[vertex * 4 + 1]
        crash mesh.tangents[vertex * 4 + 2]
        crash mesh.tangents[vertex * 4 + 3]
        var along_x = mesh.tangents[vertex * 4]
        var along_y = mesh.tangents[vertex * 4 + 1]
        var along_z = mesh.tangents[vertex * 4 + 2]
        var handedness = mesh.tangents[vertex * 4 + 3]
        write_packed_tangent(target, along_x, along_y, along_z, handedness)
        return
    }
    crash mesh.vertices[vertex * vertex_floats + 3]
    var normal_x = mesh.vertices[vertex * vertex_floats + 3]
    crash mesh.vertices[vertex * vertex_floats + 4]
    var normal_y = mesh.vertices[vertex * vertex_floats + 4]
    crash mesh.vertices[vertex * vertex_floats + 5]
    var normal_z = mesh.vertices[vertex * vertex_floats + 5]
    var tangent_x = 1.0 - normal_x * normal_x
    var tangent_y = 0.0 - normal_x * normal_y
    var tangent_z = 0.0 - normal_x * normal_z
    if normal_x.absolute() > 0.9 {
        tangent_x = 0.0 - normal_y * normal_x
        tangent_y = 1.0 - normal_y * normal_y
        tangent_z = 0.0 - normal_y * normal_z
    }
    var length = (tangent_x * tangent_x + tangent_y * tangent_y + tangent_z * tangent_z).square_root()
    write_packed_tangent(target, tangent_x / length, tangent_y / length, tangent_z / length, 1.0)
}

func write_packed_tangent(target: Asset.Bytes, along_x: Float, along_y: Float, along_z: Float, handedness: Float) {
    var packed: Long = snorm_ten(along_x)
    var green: Long = snorm_ten(along_y)
    var blue: Long = snorm_ten(along_z)
    var sign: Long = 1
    if handedness < 0.0 {
        sign = 3
    }
    packed = packed + green * 1024 + blue * 1048576 + sign * 1073741824
    if packed >= 2147483648 {
        packed = packed - 4294967296
    }
    var word: Integer = packed
    target.write_integer(word)
}

func snorm_ten(value: Float): Integer {
    var scaled = value * 511.0
    if scaled > 511.0 {
        scaled = 511.0
    }
    if scaled < -511.0 {
        scaled = -511.0
    }
    var rounded = scaled + 0.5
    if scaled < 0.0 {
        rounded = scaled - 0.5
    }
    var whole: Integer = rounded
    if whole < 0 {
        whole = whole + 1024
    }
    return whole
}

func note_joints(packed: Integer) {
    var shift = 0
    while shift < 32 {
        var joint = packed.shifted_right(shift).bits_and(255)
        if joint + 1 > joint_limit {
            joint_limit = joint + 1
        }
        shift = shift + 8
    }
}

func measure_bounds(loaded: Scene.LoadedMesh, mesh: Asset.Mesh, count: Integer) {
    assert count > 0
    crash mesh.vertices[0]
    var low_x = mesh.vertices[0]
    crash mesh.vertices[1]
    var low_y = mesh.vertices[1]
    crash mesh.vertices[2]
    var low_z = mesh.vertices[2]
    var high_x = low_x
    var high_y = low_y
    var high_z = low_z
    var vertex = 1
    while vertex < count {
        var first = vertex * vertex_floats
        crash mesh.vertices[first]
        var along_x = mesh.vertices[first]
        crash mesh.vertices[first + 1]
        var along_y = mesh.vertices[first + 1]
        crash mesh.vertices[first + 2]
        var along_z = mesh.vertices[first + 2]
        low_x = smaller(low_x, along_x)
        low_y = smaller(low_y, along_y)
        low_z = smaller(low_z, along_z)
        high_x = larger(high_x, along_x)
        high_y = larger(high_y, along_y)
        high_z = larger(high_z, along_z)
        vertex = vertex + 1
    }
    loaded.bound_x = (low_x + high_x) * 0.5
    loaded.bound_y = (low_y + high_y) * 0.5
    loaded.bound_z = (low_z + high_z) * 0.5
    var half_x = (high_x - low_x) * 0.5
    var half_y = (high_y - low_y) * 0.5
    var half_z = (high_z - low_z) * 0.5
    loaded.half_x = half_x
    loaded.half_y = half_y
    loaded.half_z = half_z
    var radius = (half_x * half_x + half_y * half_y + half_z * half_z).square_root()
    loaded.bound_radius = radius
}

func smaller(first: Float, second: Float): Float {
    if second < first {
        return second
    }
    return first
}

func larger(first: Float, second: Float): Float {
    if second > first {
        return second
    }
    return first
}

func note_used_joints(loaded: Scene.LoadedMesh, mesh: Asset.Mesh, skinned: Boolean) {
    assert skinned
    var vertex = 0
    while vertex < mesh.joints.count() {
        var packed = mesh.joints[vertex]
        var slot = 0
        while slot < 4 {
            add_used_joint(loaded, mesh, packed, vertex, slot)
            slot = slot + 1
        }
        vertex = vertex + 1
    }
}

func add_used_joint(loaded: Scene.LoadedMesh, mesh: Asset.Mesh, packed: Integer, vertex: Integer, slot: Integer) {
    crash mesh.weights[vertex * 4 + slot]
    var weight = mesh.weights[vertex * 4 + slot]
    var joint = packed.shifted_right(slot * 8).bits_and(255)
    assert weight > 0.0 and not loaded.used_joints.contains(joint)
    loaded.used_joints.append(joint)
}
