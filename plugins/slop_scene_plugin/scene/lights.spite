singleton

var floats = List<Float>()
var light_floats = 16
var owners = List<Integer>()
var shadowed = List<Boolean>()
var shadow_reach: Float = 0.0
var last_shadow_reach: Float = 0.0

func count(): Integer {
    return floats.count() / light_floats
}

func clear() {
    floats.clear()
    owners.clear()
    shadowed.clear()
    last_shadow_reach = shadow_reach
    shadow_reach = 0.0
}

func add(light: Scene.Light) {
    floats.append(light.position_x)
    floats.append(light.position_y)
    floats.append(light.position_z)
    floats.append(light.range)
    floats.append(light.toward_x)
    floats.append(light.toward_y)
    floats.append(light.toward_z)
    floats.append(0.0)
    floats.append(light.red)
    floats.append(light.green)
    floats.append(light.blue)
    floats.append(light.intensity)
    floats.append(light.cone_scale)
    floats.append(light.cone_offset)
    floats.append(0.0)
    floats.append(0.0)
    owners.append(light.owner)
    shadowed.append(light.casts_shadows)
    if light.casts_shadows and light.range > shadow_reach {
        shadow_reach = light.range
    }
}
