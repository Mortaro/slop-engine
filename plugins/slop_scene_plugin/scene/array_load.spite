var path = ""
var offset: Long = 0
var length: Long = 0
var key = ""
var id = ""

func ArrayLoad(found: Recipes.Record, cooked_id: String) {
    id = cooked_id
    path = found.path
    offset = found.offset
    length = found.length
    key = found.key
}

func run(): Scene.LoadedArray {
    var record = Recipes.Record()
    record.path = path
    record.offset = offset
    record.length = length
    record.key = key
    var bytes = record.read()
    var magic = bytes.read_text()
    var stored_kind = bytes.read_text()
    bytes.position = 0
    var array_id = id
    var cooked_as_a_texture_array = magic == "SLOP" and stored_kind == "TextureArray"
    crash cooked_as_a_texture_array or array_id == ""
    var pack = Pack<Asset.TextureArray>()
    var array = pack.decode(bytes)
    crash array
    var texels_fit_the_shape = array.texels.length == array.layer_bytes() * array.layers
    crash texels_fit_the_shape and array.layers > 0
    var loaded = Scene.LoadedArray()
    loaded.width = array.width
    loaded.height = array.height
    loaded.layers = array.layers
    loaded.format = array.format
    loaded.levels = array.levels
    loaded.raw = array.texels
    return loaded
}
