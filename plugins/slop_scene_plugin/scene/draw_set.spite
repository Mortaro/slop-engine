var draws = List<Scene.Draw>()
var casters = List<Scene.Draw>()
var translucent_draws = List<Scene.Draw>()
var terrain_draws = List<Scene.TerrainDraw>()
var decals = List<Scene.DecalDraw>()
var palettes = List<Matrix4>()
var occlusion = Scene.OcclusionMap()
var culls_occluded = false
var camera_cut: Float = 1.0
var forced_detail_level = -1
var seconds: Double = 0.0

func begin() {
    draws.clear()
    casters.clear()
    translucent_draws.clear()
    terrain_draws.clear()
    decals.clear()
    palettes.clear()
    var identity = Matrix4()
    palettes.append(identity)
}
