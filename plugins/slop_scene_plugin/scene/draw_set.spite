var draws = List<Scene.Draw>()
var casters = List<Scene.Draw>()
var terrain_draws = List<Scene.TerrainDraw>()
var palettes = List<Math.Matrix4>()

func begin() {
    draws.clear()
    casters.clear()
    terrain_draws.clear()
    palettes.clear()
    var identity = Math.Matrix4()
    palettes.append(identity)
}
