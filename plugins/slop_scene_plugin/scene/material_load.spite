var path = ""
var offset: Long = 0
var length: Long = 0

func MaterialLoad(found: Recipes.Record) {
    path = found.path
    offset = found.offset
    length = found.length
}

func run(): Asset.TerrainMaterial {
    var record = Recipes.Record()
    record.path = path
    record.offset = offset
    record.length = length
    var bytes = record.read()
    var pack = Pack<Asset.TerrainMaterial>()
    var material = pack.decode(bytes)
    crash material
    return material
}
