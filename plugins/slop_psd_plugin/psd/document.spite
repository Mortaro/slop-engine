var bytes = Asset.Bytes()
var layers = List<Psd.Layer>()
var depth = 8
var canvas_width = 0
var canvas_height = 0
var canvas_channels = 0
var merged: Asset.Bytes? = null
var inflate = Png.Inflate()

func open(path: String) {
    var loaded = bytes.read_file(path)
    crash loaded
    read_header()
}

func read_header() {
    var signature = read_tag()
    crash signature == "8BPS"
    var version = read_short()
    crash version == 1
    skip(6)
    var channel_count = read_short()
    canvas_channels = channel_count
    canvas_height = read_unsigned()
    canvas_width = read_unsigned()
    depth = read_short()
    var colour_mode = read_short()
    crash depth == 8 or depth == 16
    crash colour_mode == 3
    crash channel_count >= 3
    var colour_mode_length = read_unsigned()
    skip(colour_mode_length)
    var resources_length = read_unsigned()
    skip(resources_length)
    var layer_and_mask_length = read_unsigned()
    var layer_and_mask_end = bytes.position + layer_and_mask_length
    if layer_and_mask_length >= 4 {
        var layer_information_length = read_unsigned()
        var layer_information_end = bytes.position + layer_information_length
        read_layers(layer_information_end)
    }
    bytes.position = layer_and_mask_end
    if layers.count() == 0 {
        read_merged()
    }
}

func read_merged() {
    var compression = read_short()
    crash compression >= 0 and compression <= 3
    var start = bytes.position
    var background = Psd.Layer()
    background.name = "Background"
    background.path = "Background"
    background.right = canvas_width
    background.bottom = canvas_height
    var used = canvas_channels
    if used > 4 {
        used = 4
    }
    var sample_bytes = depth / 8
    var plane_bytes = canvas_width * canvas_height * sample_bytes
    var data_offset = start + canvas_channels * canvas_height * 2
    var index = 0
    while index < used {
        var channel = Psd.Channel()
        channel.identifier = index
        if index == 3 {
            channel.identifier = -1
        }
        channel.compression = compression
        if compression == 0 {
            channel.offset = start + index * plane_bytes
            channel.length = plane_bytes
        } else if compression == 1 {
            channel.row_counts = start + index * canvas_height * 2
            channel.offset = data_offset
            channel.length = packed_length(channel.row_counts)
            data_offset = data_offset + channel.length
        } else {
            channel.offset = start
            channel.length = bytes.length - start
            channel.plane = index
            channel.planes = canvas_channels
        }
        background.channels.append(channel)
        index = index + 1
    }
    layers.append(background)
}

func packed_length(row_counts: Integer): Integer {
    var total = 0
    var row = 0
    while row < canvas_height {
        total = total + bytes.big_endian_short(row_counts + row * 2)
        row = row + 1
    }
    return total
}

func read_layers(end: Integer) {
    assert bytes.position + 2 <= end
    var count = read_signed_short()
    if count < 0 {
        count = 0 - count
    }
    var records = List<Psd.Layer>()
    var index = 0
    while index < count {
        var record = read_record()
        records.append(record)
        index = index + 1
    }
    index = 0
    while index < count {
        locate_channels(records, index)
        index = index + 1
    }
    build_tree(records)
}

func locate_channels(records: List<Psd.Layer>, index: Integer) {
    crash records[index]
    var channel = 0
    while channel < records[index].channels.count() {
        locate_channel(records[index], channel)
        channel = channel + 1
    }
}

func locate_channel(record: Psd.Layer, index: Integer) {
    crash record.channels[index]
    var stored_length = record.channels[index].length
    var start = bytes.position
    if stored_length >= 2 {
        var compression = read_short()
        crash compression >= 0 and compression <= 3
        record.channels[index].compression = compression
    }
    record.channels[index].offset = start + 2
    record.channels[index].length = stored_length - 2
    bytes.position = start + stored_length
}

func read_record(): Psd.Layer {
    var record = Psd.Layer()
    record.top = read_signed()
    record.left = read_signed()
    record.bottom = read_signed()
    record.right = read_signed()
    var channel_count = read_short()
    var index = 0
    while index < channel_count {
        var channel = Psd.Channel()
        channel.identifier = read_signed_short()
        channel.length = read_unsigned()
        record.channels.append(channel)
        index = index + 1
    }
    var signature = read_tag()
    crash signature == "8BIM"
    skip(4)
    skip(4)
    var extra_length = read_unsigned()
    var extra_end = bytes.position + extra_length
    var mask_length = read_unsigned()
    var mask_end = bytes.position + mask_length
    read_mask(record, mask_length)
    bytes.position = mask_end
    var ranges_length = read_unsigned()
    skip(ranges_length)
    var pascal_length = bytes.read_byte()
    record.name = bytes.lossy_text_at(bytes.position, pascal_length)
    var padding = (4 - (pascal_length + 1) % 4) % 4
    skip(pascal_length + padding)
    read_extra_blocks(record, extra_end)
    bytes.position = extra_end
    return record
}

func read_mask(record: Psd.Layer, length: Integer) {
    assert length >= 20
    record.mask_top = read_signed()
    record.mask_left = read_signed()
    record.mask_bottom = read_signed()
    record.mask_right = read_signed()
    record.mask_default = bytes.read_byte()
    var flags = bytes.read_byte()
    record.mask_enabled = flags / 2 % 2 == 0
    record.mask_channel = -2
    if flags / 16 % 2 == 1 {
        skip_mask_parameters()
    }
    assert length > 20 and bytes.remaining() >= 18
    var real_flags = bytes.read_byte()
    record.mask_default = bytes.read_byte()
    record.mask_top = read_signed()
    record.mask_left = read_signed()
    record.mask_bottom = read_signed()
    record.mask_right = read_signed()
    record.mask_enabled = real_flags / 2 % 2 == 0
    record.mask_channel = -3
}

func skip_mask_parameters() {
    var parameters = bytes.read_byte()
    if parameters % 2 == 1 {
        var density = bytes.read_byte()
        crash density == 255
    }
    if parameters / 2 % 2 == 1 {
        var feather = bytes.read_long()
        crash feather == 0
    }
    if parameters / 4 % 2 == 1 {
        skip(1)
    }
    if parameters / 8 % 2 == 1 {
        skip(8)
    }
}

func read_extra_blocks(record: Psd.Layer, end: Integer) {
    var reading = true
    while reading and bytes.position + 12 <= end {
        reading = read_extra_block(record)
    }
}

func read_extra_block(record: Psd.Layer): Boolean {
    var signature = read_tag()
    if signature != "8BIM" and signature != "8B64" {
        return false
    }
    var key = read_tag()
    var length = read_unsigned()
    var start = bytes.position
    if key == "luni" {
        record.name = read_unicode_name()
    } else if key == "lsct" or key == "lsdk" {
        record.divider = read_unsigned()
    }
    bytes.position = start + length + length % 2
    return true
}

func read_unicode_name(): String {
    var count = read_unsigned()
    var letters = Asset.Bytes()
    var index = 0
    while index < count {
        var code = read_short()
        if code > 127 {
            code = 63
        }
        letters.write_byte(code)
        index = index + 1
    }
    var name = letters.text_at(0, count)
    crash name
    return name
}

func build_tree(records: List<Psd.Layer>) {
    var groups = List<String>()
    var index = records.count() - 1
    while index >= 0 {
        place_record(records, index, groups)
        index = index - 1
    }
    crash groups.is_empty()
}

func place_record(records: List<Psd.Layer>, index: Integer, groups: List<String>) {
    crash records[index]
    var divider = records[index].divider
    if divider == 1 or divider == 2 {
        records[index].group = true
        records[index].path = joined_path(groups, records[index].name)
        layers.append(records[index])
        groups.append(records[index].name)
    } else if divider == 3 {
        crash not groups.is_empty()
        groups.remove_last()
    } else {
        records[index].path = joined_path(groups, records[index].name)
        layers.append(records[index])
    }
}

func joined_path(groups: List<String>, name: String): String {
    if groups.is_empty() {
        return name
    }
    var prefix = groups.join("/")
    return "{prefix}/{name}"
}

func pixels_of(layer: Psd.Layer): Asset.Texture {
    var texture = Asset.Texture()
    texture.width = layer.width()
    texture.height = layer.height()
    var red = channel_plane(layer, 0)
    var green = channel_plane(layer, 1)
    var blue = channel_plane(layer, 2)
    var alpha = channel_plane(layer, -1)
    var mask = mask_plane(layer)
    var count = texture.width * texture.height
    var texels = texture.texels
    texels.clear()
    var pixel = 0
    while pixel < count {
        var value = pack_pixel(red, green, blue, alpha, mask, pixel)
        texels.write_integer(value)
        pixel = pixel + 1
    }
    return texture
}

func pack_pixel(
    red: Asset.Bytes,
    green: Asset.Bytes,
    blue: Asset.Bytes,
    alpha: Asset.Bytes,
    mask: Asset.Bytes,
    pixel: Integer,
): Integer {
    var red_value = red.byte_at(pixel)
    var green_value = green.byte_at(pixel)
    var blue_value = blue.byte_at(pixel)
    var masked = 255
    if alpha.length > 0 {
        masked = alpha.byte_at(pixel)
    }
    if mask.length > 0 {
        var cover = mask.byte_at(pixel)
        masked = (masked * cover + 127) / 255
    }
    var green_bits = green_value.shifted_left(8)
    var blue_bits = blue_value.shifted_left(16)
    var alpha_bits = masked.shifted_left(24)
    var low = red_value.bits_or(green_bits)
    var high = blue_bits.bits_or(alpha_bits)
    return low.bits_or(high)
}

func channel_plane(layer: Psd.Layer, identifier: Integer): Asset.Bytes {
    var plane_width = layer.width()
    var plane_height = layer.height()
    var channel = layer.channels.find_by_identifier(identifier)
    if channel {
        return decode_channel(channel, plane_width, plane_height)
    }
    crash identifier == -1
    return Asset.Bytes()
}

func mask_plane(layer: Psd.Layer): Asset.Bytes {
    var channel = layer.channels.find_by_identifier(layer.mask_channel)
    var usable = layer.mask_enabled and layer.mask_channel != 0
    if channel {
        if usable {
            return masked_plane(layer, channel)
        }
    }
    return Asset.Bytes()
}

func masked_plane(layer: Psd.Layer, channel: Psd.Channel): Asset.Bytes {
    var mask_width = layer.mask_right - layer.mask_left
    var mask_height = layer.mask_bottom - layer.mask_top
    var stored = decode_channel(channel, mask_width, mask_height)
    var plane = Asset.Bytes()
    var row = 0
    while row < layer.height() {
        append_mask_row(layer, stored, plane, row)
        row = row + 1
    }
    return plane
}

func append_mask_row(layer: Psd.Layer, stored: Asset.Bytes, plane: Asset.Bytes, row: Integer) {
    var canvas_top = layer.top + row
    var mask_width = layer.mask_right - layer.mask_left
    var inside_rows = canvas_top >= layer.mask_top and canvas_top < layer.mask_bottom
    var column = 0
    while column < layer.width() {
        var canvas_left = layer.left + column
        var inside = inside_rows and canvas_left >= layer.mask_left and canvas_left < layer.mask_right
        var value = layer.mask_default
        if inside {
            var at = (canvas_top - layer.mask_top) * mask_width + canvas_left - layer.mask_left
            value = stored.byte_at(at)
        }
        plane.write_byte(value)
        column = column + 1
    }
}

func decode_channel(channel: Psd.Channel, plane_width: Integer, plane_height: Integer): Asset.Bytes {
    var sample_bytes = depth / 8
    var row_bytes = plane_width * sample_bytes
    var stored = Asset.Bytes()
    if channel.compression == 1 {
        decode_run_length(channel, row_bytes, plane_height, stored)
    } else if channel.compression >= 2 {
        decode_zip(channel, row_bytes, plane_height, stored)
    } else {
        copy_bytes(channel.offset, row_bytes * plane_height, stored)
    }
    crash stored.length == row_bytes * plane_height
    if sample_bytes == 1 {
        return stored
    }
    return high_bytes(stored)
}

func high_bytes(stored: Asset.Bytes): Asset.Bytes {
    var plane = Asset.Bytes()
    var count = stored.length / 2
    var index = 0
    while index < count {
        var high = stored.byte_at(index * 2)
        plane.write_byte(high)
        index = index + 1
    }
    return plane
}

func decode_zip(channel: Psd.Channel, row_bytes: Integer, plane_height: Integer, stored: Asset.Bytes) {
    var wanted = row_bytes * plane_height
    var unpacked = inflated(channel, row_bytes, plane_height)
    var first = 0
    if channel.plane >= 0 {
        first = channel.plane * wanted
    }
    crash first + wanted <= unpacked.length
    stored.write_bytes(unpacked, first, wanted)
}

func inflated(channel: Psd.Channel, row_bytes: Integer, plane_height: Integer): Asset.Bytes {
    if channel.plane >= 0 {
        if merged {
            return merged
        }
    }
    var rows = plane_height * channel.planes
    var packed = Asset.Bytes()
    packed.write_bytes(bytes, channel.offset, channel.length)
    var wanted = row_bytes * rows
    var unpacked = inflate.decompress(packed, wanted)
    crash not inflate.failed
    crash unpacked.length == wanted
    if channel.compression == 3 {
        undo_prediction(unpacked, row_bytes, rows)
    }
    if channel.plane >= 0 {
        merged = unpacked
    }
    return unpacked
}

func undo_prediction(unpacked: Asset.Bytes, row_bytes: Integer, plane_height: Integer) {
    var row = 0
    while row < plane_height {
        if depth == 16 {
            undo_wide_row(unpacked, row * row_bytes, row_bytes)
        } else {
            undo_narrow_row(unpacked, row * row_bytes, row_bytes)
        }
        row = row + 1
    }
}

func undo_narrow_row(unpacked: Asset.Bytes, start: Integer, row_bytes: Integer) {
    crash start + row_bytes <= unpacked.length
    var previous = unpacked.byte_at(start)
    var column = 1
    while column < row_bytes {
        var current = unpacked.byte_at(start + column)
        var sum_bits = previous + current
        var sum = sum_bits.bits_and(255)
        unpacked.set_byte(start + column, sum)
        previous = sum
        column = column + 1
    }
}

func undo_wide_row(unpacked: Asset.Bytes, start: Integer, row_bytes: Integer) {
    var column = 2
    while column + 1 < row_bytes {
        var previous = unpacked.byte_at(start + column - 2) * 256 + unpacked.byte_at(start + column - 1)
        var current = unpacked.byte_at(start + column) * 256 + unpacked.byte_at(start + column + 1)
        var sum = (previous + current) % 65536
        unpacked.set_byte(start + column, sum / 256)
        unpacked.set_byte(start + column + 1, sum % 256)
        column = column + 2
    }
}

func decode_run_length(channel: Psd.Channel, row_bytes: Integer, plane_height: Integer, plane: Asset.Bytes) {
    var counts = channel.offset
    var offset = channel.offset + plane_height * 2
    if channel.row_counts >= 0 {
        counts = channel.row_counts
        offset = channel.offset
    }
    var row = 0
    while row < plane_height {
        var row_length = bytes.big_endian_short(counts + row * 2)
        decode_pack_bits(offset, row_length, row_bytes, plane)
        offset = offset + row_length
        row = row + 1
    }
}

func decode_pack_bits(start: Integer, length: Integer, wanted: Integer, plane: Asset.Bytes) {
    var read = start
    var end = start + length
    crash end <= bytes.length
    var written = 0
    while written < wanted {
        crash read < end
        var header = bytes.byte_at(read)
        read = read + 1
        if header < 128 {
            var copy = header + 1
            crash read + copy <= end
            crash written + copy <= wanted
            plane.write_bytes(bytes, read, copy)
            read = read + copy
            written = written + copy
        } else if header > 128 {
            var repeat = 257 - header
            crash read < end
            crash written + repeat <= wanted
            var value = bytes.byte_at(read)
            plane.repeat_byte(value, repeat)
            read = read + 1
            written = written + repeat
        }
    }
    crash read == end
}

func copy_bytes(from: Integer, count: Integer, plane: Asset.Bytes) {
    crash from + count <= bytes.length
    plane.write_bytes(bytes, from, count)
}

func read_tag(): String {
    var text = bytes.lossy_text_at(bytes.position, 4)
    skip(4)
    return text
}

func read_short(): Integer {
    var value = bytes.big_endian_short(bytes.position)
    skip(2)
    return value
}

func read_signed_short(): Integer {
    var value = read_short()
    if value >= 32768 {
        value = value - 65536
    }
    return value
}

func read_unsigned(): Integer {
    var value = bytes.big_endian_integer(bytes.position)
    skip(4)
    return value
}

func read_signed(): Integer {
    return read_unsigned()
}

func skip(count: Integer) {
    bytes.position = bytes.position + count
    crash bytes.position <= bytes.length
}
