singleton

var spaces = Dictionary<Spatial.Space>()
var space_list = List<Spatial.Space>()
var next = List<Integer>()
var xs = List<Float>()
var zs = List<Float>()
var indexed = 0

func configure(space: Integer, left: Float, top: Float, width: Float, depth: Float, size: Float) {
    var found = space_of(space)
    found.configure(left, top, width, depth, size)
}

func space_of(space: Integer): Spatial.Space {
    var found = spaces[space]
    if found {
        return found
    }
    var made = Spatial.Space()
    spaces[space] = made
    space_list.append(made)
    return made
}

func clear() {
    space_list.each_clear()
    indexed = 0
}

func insert(space: Integer, entity: Integer, position_x: Float, position_z: Float) {
    var target = space_of(space)
    target.ensure_heads()
    ensure_entity(entity)
    var cell = target.cell_at(position_x, position_z)
    xs[entity] = position_x
    zs[entity] = position_z
    crash target.heads[cell]
    var head = target.heads[cell]
    if head < 0 {
        target.touched.append(cell)
    }
    next[entity] = head
    target.heads[cell] = entity
    indexed = indexed + 1
}

func within(space: Integer, position_x: Float, position_z: Float, radius: Float, found: List<Integer>) {
    var target = spaces[space]
    assert target
    target.ensure_heads()
    var first_column = target.column_of(position_x - radius)
    var last_column = target.column_of(position_x + radius)
    var first_row = target.row_of(position_z - radius)
    var last_row = target.row_of(position_z + radius)
    var reach = radius * radius
    var row = first_row
    while row <= last_row {
        var column = first_column
        while column <= last_column {
            crash target.heads[row * target.columns + column]
            collect(target.heads[row * target.columns + column], position_x, position_z, reach, found)
            column = column + 1
        }
        row = row + 1
    }
}

func collect(head: Integer, position_x: Float, position_z: Float, reach: Float, found: List<Integer>) {
    var entity = head
    while entity >= 0 {
        crash xs[entity]
        var across = xs[entity] - position_x
        crash zs[entity]
        var down = zs[entity] - position_z
        if across * across + down * down <= reach {
            found.append(entity)
        }
        crash next[entity]
        entity = next[entity]
    }
}

func ensure_entity(entity: Integer) {
    while next.count() <= entity {
        next.append(-1)
        xs.append(0.0)
        zs.append(0.0)
    }
}
