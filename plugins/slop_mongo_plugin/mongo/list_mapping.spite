generic $list_type

func to_document(value: $list_type): Mongo.Document {
    var document = Mongo.Document()
    var mapping = Mongo.Mapping<$list_type.element_type>()
    var index = 0
    while index < value.count() {
        var element = Mongo.Element("{index}", 10)
        mapping.write(value[index], element)
        document.elements.append(element)
        index = index + 1
    }
    return document
}

func from_document(document: Mongo.Document): $list_type {
    var list: $list_type = null
    var mapping = Mongo.Mapping<$list_type.element_type>()
    var index = 0
    while index < document.elements.count() {
        var element = document.elements[index]
        if mapping.accepts(element) {
            var item = mapping.read(element)
            list.append(item)
        }
        index = index + 1
    }
    return list
}
