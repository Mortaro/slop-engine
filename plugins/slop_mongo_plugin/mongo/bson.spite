var raw = Raw()
var hex = Mongo.Hex()
var depth_limit = 100

func encode(document: Mongo.Document, bytes: Asset.Bytes) {
    var start = bytes.length
    bytes.write_integer(0)
    var index = 0
    while index < document.elements.count() {
        write_element(document.elements[index], bytes)
        index = index + 1
    }
    bytes.write_byte(0)
    var size = bytes.length - start
    raw.write_integer(bytes.address, start, size)
}

func write_element(element: Mongo.Element, bytes: Asset.Bytes) {
    bytes.write_byte(element.kind)
    bytes.append_text_bytes(element.key)
    bytes.write_byte(0)
    var kind = element.kind
    if kind == 1 {
        bytes.write_double(element.decimal)
    } else if kind == 2 {
        write_string(element.text, bytes)
    } else if kind == 3 or kind == 4 {
        write_embedded(element, bytes)
    } else if kind == 7 {
        write_object_id(element.text, bytes)
    } else if kind == 8 {
        write_boolean(element.boolean, bytes)
    } else if kind == 9 or kind == 18 {
        bytes.write_long(element.whole)
    } else if kind == 16 {
        var narrow: Integer = element.whole
        bytes.write_integer(narrow)
    } else if kind != 10 {
        bytes.append_text_bytes(element.text)
    }
}

func write_string(text: String, bytes: Asset.Bytes) {
    var size = text.length() + 1
    bytes.write_integer(size)
    bytes.append_text_bytes(text)
    bytes.write_byte(0)
}

func write_embedded(element: Mongo.Element, bytes: Asset.Bytes) {
    if element.document {
        encode(element.document, bytes)
    } else {
        var empty = Mongo.Document()
        encode(empty, bytes)
    }
}

func write_boolean(value: Boolean, bytes: Asset.Bytes) {
    var flag = 0
    if value {
        flag = 1
    }
    bytes.write_byte(flag)
}

func write_object_id(hexadecimal: String, bytes: Asset.Bytes) {
    var valid = hex.is_object_id(hexadecimal)
    var index = 0
    while index < 12 {
        var high_code = hexadecimal.code_at(index * 2)
        var low_code = hexadecimal.code_at(index * 2 + 1)
        var high = hex.digit_value(high_code)
        var low = hex.digit_value(low_code)
        var value = 0
        if valid {
            value = high * 16 + low
        }
        bytes.write_byte(value)
        index = index + 1
    }
}

func decode(bytes: Asset.Bytes): Mongo.Document? {
    bytes.untrusted = true
    var document = Mongo.Document()
    read_document(bytes, document, 0)
    assert not bytes.failed
    return document
}

func read_document(bytes: Asset.Bytes, document: Mongo.Document, depth: Integer) {
    var start = bytes.position
    var size = bytes.read_integer()
    var bounded = depth < depth_limit and size >= 5 and bytes.fits(size - 4)
    if not bounded {
        bytes.failed = true
    }
    assert bounded
    var end = start + size - 1
    while bytes.position < end and not bytes.failed {
        read_element(bytes, document, depth, end)
    }
    finish_document(bytes, end)
}

func finish_document(bytes: Asset.Bytes, end: Integer) {
    if bytes.position != end {
        bytes.failed = true
    }
    assert not bytes.failed
    var terminator = bytes.read_byte()
    if terminator != 0 {
        bytes.failed = true
    }
}

func read_element(bytes: Asset.Bytes, document: Mongo.Document, depth: Integer, end: Integer) {
    var kind = bytes.read_byte()
    var key = read_key(bytes, end)
    assert not bytes.failed
    var element = Mongo.Element(key, kind)
    read_payload(bytes, element, depth, end)
    if bytes.position > end {
        bytes.failed = true
    }
    document.elements.append(element)
}

func read_payload(bytes: Asset.Bytes, element: Mongo.Element, depth: Integer, end: Integer) {
    var kind = element.kind
    if kind == 1 {
        element.decimal = bytes.read_double()
    } else if kind == 2 {
        element.text = read_string(bytes)
    } else if kind == 3 or kind == 4 {
        read_embedded(bytes, element, depth)
    } else if kind == 7 {
        element.text = read_object_id(bytes)
    } else if kind == 8 {
        element.boolean = bytes.read_byte() != 0
    } else if kind == 9 or kind == 18 {
        element.whole = bytes.read_long()
    } else if kind == 16 {
        element.whole = bytes.read_integer()
    } else if kind != 10 {
        read_opaque(bytes, element, end)
    }
}

func read_key(bytes: Asset.Bytes, end: Integer): String {
    var start = bytes.position
    var index = start
    while index < end and bytes.byte_at(index) != 0 {
        index = index + 1
    }
    if index >= end {
        bytes.failed = true
    }
    assert index < end
    var text = raw.text(bytes.address + start, index - start)
    bytes.position = index + 1
    return text
}

func read_string(bytes: Asset.Bytes): String {
    var size = bytes.read_integer()
    var valid = size >= 1 and bytes.fits(size)
    if not valid {
        bytes.failed = true
    }
    assert valid
    var text = raw.text(bytes.address + bytes.position, size - 1)
    var terminator_at = bytes.position + size - 1
    bytes.position = bytes.position + size
    if bytes.byte_at(terminator_at) != 0 {
        bytes.failed = true
    }
    return text
}

func read_embedded(bytes: Asset.Bytes, element: Mongo.Element, depth: Integer) {
    var inner = Mongo.Document()
    read_document(bytes, inner, depth + 1)
    element.document = inner
}

func read_object_id(bytes: Asset.Bytes): String {
    assert bytes.fits(12)
    var pieces = List<String>()
    var index = 0
    while index < 12 {
        var value = bytes.read_byte()
        var piece = hex.long_text(value, 2)
        pieces.append(piece)
        index = index + 1
    }
    return pieces.join("")
}

func read_opaque(bytes: Asset.Bytes, element: Mongo.Element, end: Integer) {
    var size = opaque_size(bytes, element.kind, end)
    var valid = size >= 0 and bytes.fits(size)
    if not valid {
        bytes.failed = true
    }
    assert valid
    element.text = raw.text(bytes.address + bytes.position, size)
    bytes.position = bytes.position + size
}

func opaque_size(bytes: Asset.Bytes, kind: Integer, end: Integer): Integer {
    var size = -1
    if kind == 6 or kind == 127 or kind == 255 {
        size = 0
    } else if kind == 17 {
        size = 8
    } else if kind == 19 {
        size = 16
    } else if kind == 11 {
        size = pattern_size(bytes, end)
    } else {
        size = prefixed_size(bytes, kind)
    }
    return size
}

func prefixed_size(bytes: Asset.Bytes, kind: Integer): Integer {
    var prefix = peek_integer(bytes)
    if prefix < 0 {
        return -1
    }
    if kind == 5 {
        return prefix + 5
    }
    if kind == 12 {
        return prefix + 16
    }
    if kind == 13 or kind == 14 {
        return prefix + 4
    }
    if kind == 15 {
        return prefix
    }
    return -1
}

func peek_integer(bytes: Asset.Bytes): Integer {
    assert bytes.fits(4)
    return raw.read_integer(bytes.address, bytes.position)
}

func pattern_size(bytes: Asset.Bytes, end: Integer): Integer {
    var index = bytes.position
    var zeros = 0
    while index < end and zeros < 2 {
        if bytes.byte_at(index) == 0 {
            zeros = zeros + 1
        }
        index = index + 1
    }
    if zeros < 2 {
        return -1
    }
    return index - bytes.position
}
