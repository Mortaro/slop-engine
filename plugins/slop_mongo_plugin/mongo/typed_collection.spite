generic $value_type

var object_ids = Mongo.ObjectIds()
var collection = Mongo.Collection()
var codec = Mongo.Codec<$value_type>()

func TypedCollection(source: Mongo.Collection) {
    collection = source
}

func insert_one(value: $value_type): Boolean {
    var generated = object_ids.next()
    codec.identify_attributes(value, generated)
    var document = codec.to_document(value)
    return collection.insert_one(document)
}

func find_one(filter: Mongo.Document): $value_type? {
    var found = collection.find_one(filter)
    assert found
    return codec.from_document(found)
}

func find(filter: Mongo.Document): List<$value_type> {
    var documents = collection.find(filter)
    return documents.map(codec.from_document)
}

func update_one(filter: Mongo.Document, update: Mongo.Document): Integer {
    return collection.update_one(filter, update)
}

func delete_one(filter: Mongo.Document): Integer {
    return collection.delete_one(filter)
}

func delete_many(filter: Mongo.Document): Integer {
    return collection.delete_many(filter)
}

func count_matching(filter: Mongo.Document): Integer {
    return collection.count(filter)
}
