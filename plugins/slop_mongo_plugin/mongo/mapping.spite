generic $field_type

func write(value: $field_type, element: Mongo.Element) {
    if $field_type == Integer or $field_type == Short or $field_type == Tiny or $field_type == Byte or $field_type == UnsignedShort {
        element.kind = 16
        element.whole = value
    } else if $field_type == Long or $field_type == UnsignedInteger {
        element.kind = 18
        element.whole = value
    } else if $field_type == Float or $field_type == Double {
        element.kind = 1
        element.decimal = value
    } else if $field_type == Boolean {
        element.kind = 8
        element.boolean = value
    } else if $field_type == String {
        element.kind = 2
        element.text = value
    } else if $field_type == Null {
        write_optional(value, element)
    } else if $field_type == List {
        var list_mapping = Mongo.ListMapping<$field_type>()
        element.kind = 4
        element.document = list_mapping.to_document(value)
    } else {
        var codec = Mongo.Codec<$field_type>()
        element.kind = 3
        element.document = codec.to_document(value)
    }
}

func write_optional(value: $field_type, element: Mongo.Element) {
    if value {
        var inner = Mongo.Mapping<$field_type.value_type>()
        inner.write(value, element)
    } else {
        element.kind = 10
    }
}

func read(element: Mongo.Element): $field_type {
    if $field_type == Integer or $field_type == Short or $field_type == Tiny or $field_type == Byte or $field_type == UnsignedShort or $field_type == Long or $field_type == UnsignedInteger {
        var whole: $field_type = element.as_long()
        return whole
    } else if $field_type == Float or $field_type == Double {
        var decimal: $field_type = element.as_double()
        return decimal
    } else if $field_type == Boolean {
        return element.boolean
    } else if $field_type == String {
        return element.text
    } else if $field_type == Null {
        return read_optional(element)
    } else if $field_type == List {
        return read_list(element)
    }
    return read_class(element)
}

func read_optional(element: Mongo.Element): $field_type {
    assert element.kind != 10
    var inner = Mongo.Mapping<$field_type.value_type>()
    return inner.read(element)
}

func read_list(element: Mongo.Element): $field_type {
    assert element.document
    var list_mapping = Mongo.ListMapping<$field_type>()
    return list_mapping.from_document(element.document)
}

func read_class(element: Mongo.Element): $field_type {
    assert element.document
    var codec = Mongo.Codec<$field_type>()
    return codec.from_document(element.document)
}

func accepts(element: Mongo.Element): Boolean {
    if $field_type == Integer or $field_type == Short or $field_type == Tiny or $field_type == Byte or $field_type == UnsignedShort or $field_type == Long or $field_type == UnsignedInteger or $field_type == Float or $field_type == Double {
        return element.is_number()
    } else if $field_type == Boolean {
        return element.kind == 8
    } else if $field_type == String {
        return element.kind == 2 or element.kind == 7
    } else if $field_type == Null {
        return accepts_optional(element)
    } else if $field_type == List {
        return element.kind == 4
    }
    return element.kind == 3
}

func accepts_optional(element: Mongo.Element): Boolean {
    var inner = Mongo.Mapping<$field_type.value_type>()
    return element.kind == 10 or inner.accepts(element)
}
