var raw = Raw()
var bson = Mongo.Bson()
var socket = Socket()
var host = "127.0.0.1"
var port = 27017
var connected = false
var request_id = 0
var error = ""
var reply_limit = 50331648

func Client(new_host: String, new_port: Integer) {
    host = new_host
    port = new_port
}

func connect(): Boolean {
    socket.close()
    connected = socket.connect(host, port)
    if not connected {
        error = "could not connect to {host}:{port}"
    }
    return connected
}

func close() {
    socket.close()
    connected = false
}

func collection(database: String, name: String): Mongo.Collection {
    var found = Mongo.Collection()
    found.client = this
    found.database = database
    found.name = name
    return found
}

func drop_database(database: String): Boolean {
    var command = Mongo.Document()
    command.set_integer("dropDatabase", 1)
    var reply = run_command(database, command)
    assert reply
    return true
}

func run_command(database: String, command: Mongo.Document): Mongo.Document? {
    error = ""
    var reply = exchange(database, command)
    assert reply
    error = failure_of(reply)
    assert error.is_empty()
    return reply
}

func failure_of(reply: Mongo.Document): String {
    var ok = reply.double_of("ok")
    if ok != 1.0 {
        return reply_error(reply)
    }
    return write_error(reply)
}

func reply_error(reply: Mongo.Document): String {
    var message = reply.text_of("errmsg")
    if message.is_empty() {
        return "the command failed"
    }
    return message
}

func write_error(reply: Mongo.Document): String {
    var write_errors = reply.document_of("writeErrors")
    assert write_errors
    var first = write_errors.elements.first()
    assert first
    assert first.document
    return first.document.text_of("errmsg")
}

func exchange(database: String, command: Mongo.Document): Mongo.Document? {
    if not connected {
        connect()
    }
    assert connected
    var message = request(database, command)
    var sent = socket.write_bytes(message.address, message.length)
    if not sent {
        lose("could not send the command to {host}:{port}")
    }
    assert sent
    return receive()
}

func request(database: String, command: Mongo.Document): Asset.Bytes {
    var body = Mongo.Document()
    body.elements = command.elements.copy()
    body.set_text("$db", database)
    var message = Asset.Bytes()
    request_id = request_id + 1
    message.write_integer(0)
    message.write_integer(request_id)
    message.write_integer(0)
    message.write_integer(2013)
    message.write_integer(0)
    message.write_byte(0)
    bson.encode(body, message)
    raw.write_integer(message.address, 0, message.length)
    return message
}

func receive(): Mongo.Document? {
    var reply = Asset.Bytes()
    reply.reserve(16)
    var header_read = read_exactly(reply.address, 16)
    if not header_read {
        lose("the server closed the connection")
    }
    assert header_read
    var size = raw.read_integer(reply.address, 0)
    var response_to = raw.read_integer(reply.address, 8)
    var operation = raw.read_integer(reply.address, 12)
    var expected = size >= 26 and size <= reply_limit and response_to == request_id and operation == 2013
    if not expected {
        lose("the server sent an unexpected reply")
    }
    assert expected
    reply.reserve(size)
    var body_at = reply.address + 16
    var body_read = read_exactly(body_at, size - 16)
    if not body_read {
        lose("the server closed the connection")
    }
    assert body_read
    reply.length = size
    reply.position = 16
    return reply_body(reply)
}

func reply_body(reply: Asset.Bytes): Mongo.Document? {
    reply.untrusted = true
    reply.read_integer()
    var kind = reply.read_byte()
    if kind != 0 {
        lose("the reply has no body section")
    }
    assert kind == 0
    var document = bson.decode(reply)
    if not document {
        lose("the reply is not valid BSON")
    }
    return document
}

func read_exactly(address: Long, count: Integer): Boolean {
    var done = 0
    while done < count and not socket.closed {
        var at = address + done
        var received = socket.read_bytes(at, count - done)
        done = done + received
    }
    return done == count
}

func lose(reason: String) {
    error = reason
    connected = false
    socket.close()
}

func drop() {
    socket.close()
}
