var scalar = Math.Scalar()
var first = Math.Pose()
var second = Math.Pose()
var local = Math.Matrix4()
var from_frame = 0
var to_frame = 0
var frame_blend: Float = 0.0

func length_of(clip: Asset.Animation): Float {
    var last: Float = clip.frame_count - 1
    if last <= 0.0 {
        return 0.0
    }
    return last / clip.frames_per_second
}

func clip_time(clip: Asset.Animation, time: Float, loop_start: Float, looping: Boolean): Float {
    var end = length_of(clip)
    if not looping {
        return scalar.clamp(time, 0.0, end)
    }
    if time >= 0.0 and time < end {
        return time
    }
    var start = scalar.clamp(loop_start, 0.0, end)
    var period = end - start
    if period <= 0.0 {
        return start
    }
    var into = time - start
    var wrapped = start + into - scalar.floor(into / period) * period
    if wrapped >= end {
        return start
    }
    return scalar.clamp(wrapped, start, end)
}

func sample(
    skeleton: Asset.Skeleton,
    clip: Asset.Animation,
    time: Float,
    palette: List<Math.Matrix4>,
    globals: List<Math.Matrix4>,
) {
    check(skeleton, clip)
    locate(clip, time)
    var bone_count = skeleton.names.count()
    fit(palette, bone_count)
    fit(globals, bone_count)
    var bone = 0
    while bone < bone_count {
        read_key(clip, from_frame, bone, first)
        read_key(clip, to_frame, bone, second)
        interpolate(frame_blend)
        local.pose = first
        place_bone(skeleton, bone, palette, globals)
        bone = bone + 1
    }
}

func accumulate(
    skeleton: Asset.Skeleton,
    clip: Asset.Animation,
    time: Float,
    weight: Float,
    locals: List<Float>,
    first_source: Boolean,
) {
    check(skeleton, clip)
    locate(clip, time)
    var bone_count = skeleton.names.count()
    fit_floats(locals, bone_count * 10)
    var bone = 0
    while bone < bone_count {
        read_key(clip, from_frame, bone, first)
        read_key(clip, to_frame, bone, second)
        interpolate(frame_blend)
        add_weighted(locals, bone * 10, weight, first_source)
        bone = bone + 1
    }
}

func compose(
    skeleton: Asset.Skeleton,
    locals: List<Float>,
    total_weight: Float,
    palette: List<Math.Matrix4>,
    globals: List<Math.Matrix4>,
) {
    var weights_add_up_to_more_than_zero = total_weight > 0.0
    crash weights_add_up_to_more_than_zero
    var bone_count = skeleton.names.count()
    var locals_cover_the_skeleton = locals.count() >= bone_count * 10
    crash locals_cover_the_skeleton
    fit(palette, bone_count)
    fit(globals, bone_count)
    var bone = 0
    while bone < bone_count {
        var start = bone * 10
        first.position_x = local_at(locals, start) / total_weight
        first.position_y = local_at(locals, start + 1) / total_weight
        first.position_z = local_at(locals, start + 2) / total_weight
        first.rotation_x = local_at(locals, start + 3)
        first.rotation_y = local_at(locals, start + 4)
        first.rotation_z = local_at(locals, start + 5)
        first.rotation_w = local_at(locals, start + 6)
        first.scale_x = local_at(locals, start + 7) / total_weight
        first.scale_y = local_at(locals, start + 8) / total_weight
        first.scale_z = local_at(locals, start + 9) / total_weight
        normalize_rotation()
        local.pose = first
        place_bone(skeleton, bone, palette, globals)
        bone = bone + 1
    }
}

func check(skeleton: Asset.Skeleton, clip: Asset.Animation) {
    assert clip.frame_count > 0
    var clip_made_for_this_skeleton = clip.bone_count == skeleton.names.count()
    crash clip_made_for_this_skeleton
    var clip_holds_every_key = clip.keys.count() == clip.frame_count * clip.bone_count * 10
    crash clip_holds_every_key
}

func locate(clip: Asset.Animation, time: Float) {
    var last: Float = clip.frame_count - 1
    var position = scalar.clamp(time * clip.frames_per_second, 0.0, last)
    var whole = scalar.floor(position)
    frame_blend = position - whole
    from_frame = whole
    to_frame = from_frame + 1
    if to_frame >= clip.frame_count {
        to_frame = from_frame
        frame_blend = 0.0
    }
}

func place_bone(skeleton: Asset.Skeleton, bone: Integer, palette: List<Math.Matrix4>, globals: List<Math.Matrix4>) {
    crash skeleton.parents[bone]
    var parent = skeleton.parents[bone]
    crash globals[bone]
    var global = globals[bone]
    if parent >= 0 {
        var parent_comes_first = parent < bone
        crash parent_comes_first
        crash globals[parent]
        var parent_global = globals[parent]
        global.set_product(parent_global, local)
    } else {
        global.copy_from(local)
    }
    crash palette[bone]
    var skinning = palette[bone]
    skinning.set_product_with_values(global, skeleton.inverse_binds, bone * 16)
    var bone_matrix_is_finite = skinning.is_finite()
    crash skeleton.names[bone]
    var bone_name = skeleton.names[bone]
    crash bone_matrix_is_finite or bone_name == ""
}

func fit(matrices: List<Math.Matrix4>, count: Integer) {
    while matrices.count() > count {
        matrices.remove_last()
    }
    while matrices.count() < count {
        var added = Math.Matrix4()
        matrices.append(added)
    }
}

func fit_floats(values: List<Float>, count: Integer) {
    while values.count() > count {
        values.remove_last()
    }
    while values.count() < count {
        values.append(0.0)
    }
}

func local_at(locals: List<Float>, index: Integer): Float {
    crash locals[index]
    return locals[index]
}

func add_weighted(locals: List<Float>, start: Integer, weight: Float, first_source: Boolean) {
    var sign: Float = 1.0
    if not first_source {
        var dot = local_at(locals, start + 3) * first.rotation_x + local_at(locals, start + 4) * first.rotation_y
        dot = dot + local_at(locals, start + 5) * first.rotation_z + local_at(locals, start + 6) * first.rotation_w
        if dot < 0.0 {
            sign = -1.0
        }
    }
    var keep: Float = 1.0
    if first_source {
        keep = 0.0
    }
    var turned = weight * sign
    locals[start] = local_at(locals, start) * keep + first.position_x * weight
    locals[start + 1] = local_at(locals, start + 1) * keep + first.position_y * weight
    locals[start + 2] = local_at(locals, start + 2) * keep + first.position_z * weight
    locals[start + 3] = local_at(locals, start + 3) * keep + first.rotation_x * turned
    locals[start + 4] = local_at(locals, start + 4) * keep + first.rotation_y * turned
    locals[start + 5] = local_at(locals, start + 5) * keep + first.rotation_z * turned
    locals[start + 6] = local_at(locals, start + 6) * keep + first.rotation_w * turned
    locals[start + 7] = local_at(locals, start + 7) * keep + first.scale_x * weight
    locals[start + 8] = local_at(locals, start + 8) * keep + first.scale_y * weight
    locals[start + 9] = local_at(locals, start + 9) * keep + first.scale_z * weight
}

func read_key(clip: Asset.Animation, frame: Integer, bone: Integer, pose: Math.Pose) {
    var start = (frame * clip.bone_count + bone) * 10
    crash clip.keys[start + 9]
    pose.position_x = key(clip, start)
    pose.position_y = key(clip, start + 1)
    pose.position_z = key(clip, start + 2)
    pose.rotation_x = key(clip, start + 3)
    pose.rotation_y = key(clip, start + 4)
    pose.rotation_z = key(clip, start + 5)
    pose.rotation_w = key(clip, start + 6)
    pose.scale_x = key(clip, start + 7)
    pose.scale_y = key(clip, start + 8)
    pose.scale_z = key(clip, start + 9)
}

func key(clip: Asset.Animation, index: Integer): Float {
    crash clip.keys[index]
    return clip.keys[index]
}

func interpolate(blend: Float) {
    var keep = 1.0 - blend
    first.position_x = first.position_x * keep + second.position_x * blend
    first.position_y = first.position_y * keep + second.position_y * blend
    first.position_z = first.position_z * keep + second.position_z * blend
    first.scale_x = first.scale_x * keep + second.scale_x * blend
    first.scale_y = first.scale_y * keep + second.scale_y * blend
    first.scale_z = first.scale_z * keep + second.scale_z * blend
    var dot = first.rotation_x * second.rotation_x + first.rotation_y * second.rotation_y + first.rotation_z * second.rotation_z + first.rotation_w * second.rotation_w
    var sign: Float = 1.0
    if dot < 0.0 {
        sign = -1.0
        dot = 0.0 - dot
    }
    var from_weight = keep
    var to_weight = blend * sign
    if dot < 0.9995 {
        var root = scalar.square_root(1.0 - dot * dot)
        var angle = scalar.arc_tangent2(root, dot)
        var angle_sine = scalar.sine(angle)
        from_weight = scalar.sine(keep * angle) / angle_sine
        to_weight = scalar.sine(blend * angle) / angle_sine * sign
    }
    first.rotation_x = first.rotation_x * from_weight + second.rotation_x * to_weight
    first.rotation_y = first.rotation_y * from_weight + second.rotation_y * to_weight
    first.rotation_z = first.rotation_z * from_weight + second.rotation_z * to_weight
    first.rotation_w = first.rotation_w * from_weight + second.rotation_w * to_weight
    normalize_rotation()
}

func normalize_rotation() {
    var length = scalar.square_root(
        first.rotation_x * first.rotation_x + first.rotation_y * first.rotation_y + first.rotation_z * first.rotation_z + first.rotation_w * first.rotation_w,
    )
    if length < 0.000001 {
        first.rotation_x = 0.0
        first.rotation_y = 0.0
        first.rotation_z = 0.0
        first.rotation_w = 1.0
        return
    }
    first.rotation_x = first.rotation_x / length
    first.rotation_y = first.rotation_y / length
    first.rotation_z = first.rotation_z / length
    first.rotation_w = first.rotation_w / length
}
