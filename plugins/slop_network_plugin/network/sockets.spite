singleton

var library = DynamicLibrary("ws2_32.dll", 'identity', "")
var heap = Memory.Heap()
var raw = Raw()

func make_nonblocking(handle: Long) {
    var mode = heap.allocate(4)
    raw.write_integer(mode, 0, 1)
    library.ioctlsocket(handle, -2147195266, mode)
    heap.free(mode)
}

func receive(handle: Long, buffer: Long, bytes: Integer): Integer {
    return library.recv(handle, buffer, bytes, 0)
}

func send(handle: Long, buffer: Long, bytes: Integer): Integer {
    return library.send(handle, buffer, bytes, 0)
}

func would_block(): Boolean {
    return library.WSAGetLastError() == 10035
}
