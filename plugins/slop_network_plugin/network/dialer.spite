var task = Network.DialTask("", 0)
var running: Parallel<Socket?>? = null

func idle(): Boolean {
    if running {
        return false
    }
    return true
}

func ready(): Boolean {
    if not running {
        return false
    }
    return running.finished
}

func start(host: String, port: Integer) {
    task = Network.DialTask(host, port)
    running = Parallel(task.run)
}

func take(): Socket? {
    var handle = running
    crash handle
    running = null
    var connected = handle.finished_value()
    assert connected
    return connected
}
