generic $component_type

var column = Column<$component_type>()
var columns = Columns()
var world = World()
var build = Build()
var changes = Changes()

func key(): String {
    return columns.key($component_type)
}

func id(): Integer {
    var name = key()
    var hash: Long = 7
    var index = 0
    while index < name.length() {
        var code = name.code_at(index)
        hash = (hash * 31 + code) % 2147483647
        index = index + 1
    }
    return hash
}

func mirror(frames: Network.Frames, since: Integer) {
    if $component_type.has_function("mirrored_from") {
        mirror_column(frames, since)
    }
}

func mirrored_here(): Boolean {
    var probe: $component_type = $component_type()
    if $component_type.has_function("mirrored_from") {
        return probe.mirrored_from(build.environment)
    }
    return false
}

func unreliable(): Boolean {
    if $component_type.has_function("sent_unreliably") {
        var probe: $component_type = $component_type()
        return probe.sent_unreliably()
    }
    return false
}

func mirror_column(frames: Network.Frames, since: Integer) {
    assert mirrored_here()
    var message = id()
    var hurried = unreliable()
    var index = column.header_now()
    var count = index.count()
    var row = 0
    while row < count {
        var entity = index.entity_at(row)
        var fresh = frames.touch(entity)
        if fresh or changes.changed_since(index, entity, since) {
            var value = column.value_at(row)
            frames.scratch.clear()
            var remote = remote_of(entity)
            write_frame(frames.scratch, message, remote, value)
            frames.put(entity, message, hurried)
        }
        row = row + 1
    }
}

func strip(frames: Network.Frames, since: Integer) {
    if $component_type.has_function("mirrored_from") {
        strip_column(frames, since)
    }
}

func strip_column(frames: Network.Frames, since: Integer) {
    assert mirrored_here()
    var name = key()
    var message = id()
    var removed = columns.removed_entities(name, since)
    var index = 0
    while index < removed.count() {
        var entity = removed[index]
        if column.row_of_entity(entity) < 0 {
            frames.strip(entity, message)
        }
        index = index + 1
    }
}

func send(letters: Network.Letters) {
    if $component_type.has_function("sent_from") {
        send_column(letters)
    }
}

func send_column(letters: Network.Letters) {
    var name = key()
    var message = id()
    var link = Link<$component_type>()
    var tail = link.holds_entity()
    var count = columns.count_of(name)
    var row = 0
    while row < count {
        var entity = columns.entity_at(name, row)
        var value = column.get(entity)
        if value.sent_from(build.environment) {
            var buffer = letters.buffer_for(entity, tail)
            write_frame(buffer, message, -2 - entity, value)
        }
        row = row + 1
    }
}

func replicated(): Boolean {
    if $component_type.has_function("mirrored_from") or $component_type.has_function("sent_from") {
        return true
    }
    return false
}

func schema(): Long {
    var text = ""
    if $component_type.has_function("mirrored_from") or $component_type.has_function("sent_from") {
        var shape = Network.Shape<$component_type>()
        text = shape.text()
    }
    var mode = "mirrored"
    if $component_type.has_function("sent_from") {
        mode = "sent"
    }
    if unreliable() {
        mode = "unreliable"
    }
    var described = "{key()} {mode} {text}"
    var hash: Long = 7
    var index = 0
    while index < described.length() {
        var code = described.code_at(index)
        hash = (hash * 31 + code) % 288230376151711717
        index = index + 1
    }
    return hash
}

func read(frame: Asset.Bytes): $component_type? {
    var value: $component_type = $component_type()
    if $component_type.has_function("mirrored_from") or $component_type.has_function("sent_from") {
        var pack = Pack<$component_type>()
        pack.read_into(value, frame)
    }
    assert not frame.failed and frame.remaining() == 0
    return value
}

func write_frame(frames: Asset.Bytes, message: Integer, entity: Integer, value: $component_type) {
    var start = frames.length
    frames.write_integer(0)
    frames.write_integer(message)
    frames.write_integer(entity)
    if $component_type.has_function("mirrored_from") or $component_type.has_function("sent_from") {
        var pack = Pack<$component_type>()
        pack.write(value, frames)
    }
    var size = frames.length - start - 4
    frames.set_integer(start, size)
}

func remote_of(entity: Integer): Integer {
    if entity == world.entity {
        return -1
    }
    return entity
}
