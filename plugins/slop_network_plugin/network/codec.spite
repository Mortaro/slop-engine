generic $component_type

var column = Column<$component_type>()
var columns = Columns()
var world = World()
var build = Build()
var raw = Raw()
var scratch = Asset.Bytes()

func key(): String {
    return columns.key($component_type)
}

func id(): Integer {
    var name = key()
    var hash: Long = 7
    var index = 0
    while index < name.length() {
        var code = name.code_at(index)
        hash = (hash * 31 + code) % 2147483647
        index = index + 1
    }
    var narrow: Integer = hash
    return narrow
}

func mirror(frames: Network.Frames) {
    if $component_type.has_function("mirrored_from") {
        mirror_column(frames)
    }
}

func mirror_column(frames: Network.Frames) {
    var name = key()
    var message = id()
    var count = columns.count_of(name)
    var row = 0
    while row < count {
        var entity = columns.entity_at(name, row)
        var value = column.get(entity)
        if value.mirrored_from(build.environment) {
            var remote = remote_of(entity)
            var buffer = frames.buffer_for(entity)
            write_frame(buffer, message, remote, value)
        }
        row = row + 1
    }
}

func send(letters: Network.Letters) {
    if $component_type.has_function("sent_from") {
        send_column(letters)
    }
}

func send_column(letters: Network.Letters) {
    var name = key()
    var message = id()
    var link = Link<$component_type>()
    var tail = link.holds_entity()
    var count = columns.count_of(name)
    var row = 0
    while row < count {
        var entity = columns.entity_at(name, row)
        var value = column.get(entity)
        if value.sent_from(build.environment) {
            var buffer = letters.buffer_for(entity, tail)
            write_frame(buffer, message, -2 - entity, value)
        }
        row = row + 1
    }
}

func replicated(): Boolean {
    if $component_type.has_function("mirrored_from") or $component_type.has_function("sent_from") {
        return true
    }
    return false
}

func read(frame: Asset.Bytes): $component_type? {
    var value: $component_type = $component_type()
    if $component_type.has_function("mirrored_from") or $component_type.has_function("sent_from") {
        var pack = Pack<$component_type>()
        pack.read_into(value, frame)
    }
    assert not frame.failed and frame.remaining() == 0
    return value
}

func write_frame(frames: Asset.Bytes, message: Integer, entity: Integer, value: $component_type) {
    var start = frames.length
    frames.write_integer(0)
    frames.write_integer(message)
    frames.write_integer(entity)
    if $component_type.has_function("mirrored_from") or $component_type.has_function("sent_from") {
        var pack = Pack<$component_type>()
        pack.write(value, frames)
    }
    var size = frames.length - start - 4
    raw.write_integer(frames.address, start, size)
}

func remote_of(entity: Integer): Integer {
    if entity == world.entity {
        return -1
    }
    return entity
}
