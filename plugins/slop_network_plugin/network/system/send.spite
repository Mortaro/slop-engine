type Peer {
    entity: Entity
    connection: Network.Component.Connection
}

var world = World()
var frames = Network.Frames()
var messages = Asset.Bytes()
var removals = Asset.Bytes()
var everyone = Vector<Integer>()
var still = Vector<Integer>()

func last_all(peers: List<Peer>) {
    messages.clear()
    frames.begin()
    encode_components()
    frames.finish()
    find_everyone()
    peers.each(deliver)
}

func encode_component(component: Symbol<Component>) {
    var codec = Network.Codec<component.class>()
    codec.mirror(frames)
    codec.send(messages)
}

func find_everyone() {
    everyone.clear()
    var observed = Lookup<Network.Component.Observed>()
    var index = 0
    while index < frames.touched.count() {
        var entity = frames.touched[index]
        if not observed.has(entity) {
            everyone.append(entity)
        }
        index = index + 1
    }
}

func deliver(peer: Peer) {
    var connection = peer.connection
    var stream = connection.stream
    connection.fresh = false
    removals.clear()
    send_all(connection, everyone)
    send_all(connection, connection.visible)
    connection.visible.clear()
    forget_hidden(connection)
    stream.queue(removals)
    stream.queue(messages)
    stream.flush()
    if stream.closed {
        stream.close()
        world.despawn(peer.entity.id)
    }
}

func send_all(connection: Network.Component.Connection, entities: Vector<Integer>) {
    var index = 0
    while index < entities.count() {
        send_entity(connection, entities[index])
        index = index + 1
    }
}

func send_entity(connection: Network.Component.Connection, entity: Integer) {
    assert frames.encoded(entity)
    var known = connection.known
    while known.count() <= entity {
        known.append(0)
    }
    assert known[entity] != frames.tick
    var stream = connection.stream
    if known[entity] == frames.tick - 1 {
        var changed = frames.changed(entity)
        stream.queue(changed)
    } else {
        var full = frames.full(entity)
        stream.queue(full)
        connection.known_list.append(entity)
    }
    known.set_at(entity, frames.tick)
}

func forget_hidden(connection: Network.Component.Connection) {
    var known = connection.known
    var kept = connection.known_list
    still.clear()
    var index = 0
    while index < kept.count() {
        var entity = kept[index]
        if known[entity] == frames.tick {
            still.append(entity)
        } else {
            known.set_at(entity, 0)
            write_removal(entity)
        }
        index = index + 1
    }
    kept.clear()
    index = 0
    while index < still.count() {
        kept.append(still[index])
        index = index + 1
    }
}

func write_removal(entity: Integer) {
    removals.write_integer(8)
    removals.write_integer(-3)
    var remote = entity
    if entity == world.entity {
        remote = -1
    }
    removals.write_integer(remote)
}
