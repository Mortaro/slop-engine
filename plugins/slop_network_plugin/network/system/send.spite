type Peer {
    entity: Entity
    connection: Network.Component.Connection
}

type Observation {
    parent: Component.Parent
    observer: Network.Component.Observer
}

var world = World()
var build = Build()
var clock = Clock()
var schema = Network.Schema()
var datagrams = Network.Datagrams()
var hello = Asset.Bytes()
var control = Asset.Bytes()
var datagram = Asset.Bytes()
var datagram_limit = 1200
var ping_ticks = 60
var hurrying = false
var drops = Lookup<Network.Component.DropDatagrams>()
var drop_count = 0
var columns = Columns()
var since = -1
var frames = Network.Frames()
var messages = Asset.Bytes()
var letters = Network.Letters()
var removals = Asset.Bytes()
var everyone = List<Integer>()
var still = List<Integer>()
var knowledge = Dictionary<String, Network.Known>()
var peer_of = List<Integer>()
var visible_counts = List<Integer>()
var visible_starts = List<Integer>()
var visible = List<Integer>()

func last_all(peers: List<Peer>, observations: List<Observation>) {
    messages.clear()
    letters.begin()
    frames.begin()
    encode_components()
    strip_components()
    frames.finish()
    since = columns.stage_counter - 1
    letters.gather(messages)
    forget_sent()
    find_everyone()
    group_visible(peers, observations)
    var index = 0
    while index < peers.count() {
        deliver(peers[index], index)
        index = index + 1
    }
    forget_peers(peers)
}

func encode_component(component: Symbol<Component>) {
    var codec = Network.Codec<component.class>()
    codec.mirror(frames, since)
    codec.send(letters)
}

func strip_component(component: Symbol<Component>) {
    var codec = Network.Codec<component.class>()
    codec.strip(frames, since)
}

func forget_sent() {
    letters.entities.each(world.despawn)
}

func find_everyone() {
    everyone.clear()
    var observed = Lookup<Network.Component.Observed>()
    var index = 0
    while index < frames.touched.count() {
        var entity = frames.touched[index]
        if not observed.has(entity) {
            everyone.append(entity)
        }
        index = index + 1
    }
}

func group_visible(peers: List<Peer>, observations: List<Observation>) {
    visible_counts.clear()
    visible_starts.clear()
    var index = 0
    while index < peers.count() {
        var connection = peers[index].entity.id
        while peer_of.count() <= connection {
            peer_of.append(0)
        }
        peer_of[connection] = index + 1
        visible_counts.append(0)
        visible_starts.append(0)
        index = index + 1
    }
    index = 0
    while index < observations.count() {
        count_visible(observations[index])
        index = index + 1
    }
    var start = 0
    index = 0
    while index < peers.count() {
        visible_starts[index] = start
        crash visible_counts[index]
        start = start + visible_counts[index]
        visible_counts[index] = 0
        index = index + 1
    }
    visible.clear()
    while visible.count() < start {
        visible.append(0)
    }
    index = 0
    while index < observations.count() {
        place_visible(observations[index])
        index = index + 1
    }
}

func peer_index(observation: Observation): Integer {
    var connection = observation.observer.entity.id
    if connection >= peer_of.count() {
        return -1
    }
    return peer_of[connection] - 1
}

func count_visible(observation: Observation) {
    var peer = peer_index(observation)
    assert peer >= 0
    crash visible_counts[peer]
    visible_counts[peer] = visible_counts[peer] + 1
}

func place_visible(observation: Observation) {
    var peer = peer_index(observation)
    assert peer >= 0
    crash visible_starts[peer]
    crash visible_counts[peer]
    var at = visible_starts[peer] + visible_counts[peer]
    visible[at] = observation.parent.entity.id
    visible_counts[peer] = visible_counts[peer] + 1
}

func forget_peers(peers: List<Peer>) {
    var index = 0
    while index < peers.count() {
        var gone_peer = peers[index].entity.id
        peer_of[gone_peer] = 0
        index = index + 1
    }
}

func known_of(peer: Entity): Network.Known {
    var key: String = peer.id
    var found = knowledge[key]
    if found {
        return found
    }
    var made = Network.Known()
    knowledge[key] = made
    return made
}

func deliver(peer: Peer, place: Integer) {
    var connection = peer.connection
    var stream = connection.stream
    if not stream.hello_sent {
        stream.hello_sent = true
        queue_hello(stream)
    }
    if stream.greeted {
        deliver_state(peer, stream, place)
    }
    stream.flush()
    if stream.closed {
        stream.close()
        world.despawn(peer.entity.id)
        var key: String = peer.entity.id
        knowledge.remove(key)
    }
}

func queue_hello(stream: Network.Channel) {
    hello.clear()
    hello.write_integer(0)
    hello.write_integer(-5)
    hello.write_integer(0)
    schema.ensure()
    hello.write_integer(schema.protocol)
    hello.write_long(schema.hash)
    hello.write_integer(stream.token)
    var port = 0
    if datagrams.opened and not stream.dialed {
        port = datagrams.port
    }
    hello.write_integer(port)
    hello.write_text(build.environment)
    var size = hello.length - 4
    hello.set_integer(0, size)
    stream.queue(hello)
}

func deliver_state(peer: Peer, stream: Network.Channel, place: Integer) {
    var known = known_of(peer.entity)
    removals.clear()
    hurrying = datagrams_ready(stream) and stream.heard_by_peer
    knock(stream)
    ping(stream)
    if hurrying {
        queue_tick(stream)
        begin_datagram(stream)
    }
    var everyone_count = everyone.count()
    send_all(stream, known, everyone, 0, everyone_count)
    crash visible_starts[place]
    crash visible_counts[place]
    var first = visible_starts[place]
    send_all(stream, known, visible, first, first + visible_counts[place])
    forget_hidden(known)
    stream.queue(removals)
    stream.queue(messages)
    if hurrying {
        send_datagram(stream)
    }
}

func datagrams_ready(stream: Network.Channel): Boolean {
    return datagrams.opened and stream.datagram_port > 0 and stream.datagram_host != "" and schema.uses_datagrams()
}

func knock(stream: Network.Channel) {
    assert datagrams_ready(stream) and not stream.heard_by_peer and frames.tick % 10 == 0
    begin_datagram(stream)
    send_datagram_always(stream)
}

func ping(stream: Network.Channel) {
    assert stream.dialed
    if stream.ping_wait > 0 {
        stream.ping_wait = stream.ping_wait - 1
        return
    }
    stream.ping_wait = ping_ticks
    control.clear()
    control.write_integer(16)
    control.write_integer(-8)
    control.write_integer(0)
    var now = clock.elapsed_milliseconds()
    control.write_long(now)
    stream.queue(control)
}

func queue_tick(stream: Network.Channel) {
    control.clear()
    control.write_integer(12)
    control.write_integer(-6)
    control.write_integer(0)
    control.write_integer(frames.tick)
    stream.queue(control)
}

func begin_datagram(stream: Network.Channel) {
    datagram.clear()
    datagram.write_integer(stream.token)
    datagram.write_integer(frames.tick)
}

func send_datagram(stream: Network.Channel) {
    assert datagram.length > 8
    send_datagram_always(stream)
}

func send_datagram_always(stream: Network.Channel) {
    if not dropped() {
        datagrams.send(stream.datagram_host, stream.datagram_port, datagram)
    }
    begin_datagram(stream)
}

func dropped(): Boolean {
    if datagram.length <= 8 or not drops.has(world.entity) {
        return false
    }
    var drop = drops.of(world.entity)
    crash drop
    drop_count = drop_count + 1
    return drop.every > 0 and drop_count % drop.every == 0
}

func hurry(stream: Network.Channel, hurried: Asset.Bytes) {
    var at = 0
    while at < hurried.length {
        var size = hurried.integer_at(at) + 4
        if datagram.length + size > datagram_limit and datagram.length > 8 {
            send_datagram(stream)
        }
        datagram.write_bytes(hurried, at, size)
        at = at + size
    }
}

func send_all(stream: Network.Channel, known: Network.Known, entities: List<Integer>, first: Integer, end: Integer) {
    var index = first
    while index < end {
        crash entities[index]
        send_entity(stream, known, entities[index])
        index = index + 1
    }
}

func send_entity(stream: Network.Channel, known: Network.Known, entity: Integer) {
    assert frames.encoded(entity)
    var ticks = known.ticks
    while ticks.count() <= entity {
        ticks.append(-1)
    }
    assert ticks[entity] != frames.tick
    if ticks[entity] == frames.tick - 1 {
        var changed = frames.changed(entity)
        stream.queue(changed)
        send_hurried(stream, entity)
    } else {
        var full = frames.full_of(entity)
        stream.queue(full)
        known.entities.append(entity)
    }
    ticks[entity] = frames.tick
}

func send_hurried(stream: Network.Channel, entity: Integer) {
    var hurried = frames.hurried(entity)
    assert hurried.length > 0
    if hurrying {
        hurry(stream, hurried)
    } else {
        stream.queue(hurried)
    }
}

func forget_hidden(known: Network.Known) {
    var ticks = known.ticks
    var kept = known.entities
    still.clear()
    var index = 0
    while index < kept.count() {
        var entity = kept[index]
        if ticks[entity] == frames.tick {
            still.append(entity)
        } else {
            ticks[entity] = -1
            write_removal(entity)
        }
        index = index + 1
    }
    kept.clear()
    index = 0
    while index < still.count() {
        kept.append(still[index])
        index = index + 1
    }
}

func write_removal(entity: Integer) {
    removals.write_integer(8)
    removals.write_integer(-3)
    var remote = entity
    if entity == world.entity {
        remote = -1
    }
    removals.write_integer(remote)
}
