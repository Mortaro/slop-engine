type Joining {
    entity: Entity
    connect: Network.Component.Connect
    unconnected: Without<Network.Component.Connected>
    welcome: Without<Network.Component.Refused>
}

var world = World()
var dials = Network.Dials()
var dialing = Lookup<Network.Component.Dialing>()
var retry_ticks = 60

func input_each(joining: Joining) {
    var connect = joining.connect
    var dialer = joining.entity
    if dialing.has(dialer.id) {
        take_socket(dialer, connect)
    } else {
        dial(dialer, connect)
    }
}

func take_socket(dialer: Entity, connect: Network.Component.Connect) {
    assert dials.finished(dialer.id)
    dialer.remove_component(Network.Component.Dialing)
    var socket = dials.take(dialer.id)
    if socket {
        var connection = Network.Component.Connection()
        connection.stream.adopt(socket)
        connection.stream.dialed = true
        connection.stream.datagram_host = connect.host
        var peer = world.create_entity()
        peer.add_component(connection)
        var connected = Network.Component.Connected()
        connected.entity = peer
        dialer.add_component(connected)
        connect.wait_ticks = 1
    } else {
        connect.wait_ticks = retry_ticks
    }
}

func dial(dialer: Entity, connect: Network.Component.Connect) {
    if connect.wait_ticks > 0 {
        connect.wait_ticks = connect.wait_ticks - 1
        return
    }
    dials.start(dialer.id, connect.host, connect.port)
    var marker = Network.Component.Dialing()
    dialer.add_component(marker)
}
