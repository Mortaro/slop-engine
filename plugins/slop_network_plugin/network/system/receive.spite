type Peer {
    entity: Entity
    connection: Network.Component.Connection
}

var world = World()
var mirrors = Mirrors()
var console = Console()
var clock = Clock()
var schema = Network.Schema()
var datagrams = Network.Datagrams()
var server_clocks = Lookup<Network.Component.ServerClock>()
var frame = Asset.Bytes()
var reply = Asset.Bytes()
var understood = false
var letter_keys = List<Integer>()
var letter_entities = List<Integer>()
var letter_dropped = List<Boolean>()
var datagram_limit = 1400

func after_input_each(peer: Peer) {
    var stream = peer.connection.stream
    stream.receive_all()
    while not stream.closed and stream.next_frame(frame) {
        var message = frame.read_integer()
        var remote = frame.read_integer()
        understood = false
        if not stream.greeted {
            greet(peer, message)
        } else if message == -3 {
            forget_mirror(remote)
        } else if message == -4 {
            strip_mirror(remote)
        } else if message < -4 {
            control(stream, message)
        } else {
            decode_components(message, remote, peer.entity.id)
        }
        if not understood {
            stream.closed = true
        }
    }
    stream.end_if_ended()
    read_datagrams(peer)
    mark_mirrors()
}

func greet(peer: Peer, message: Integer) {
    var stream = peer.connection.stream
    assert message == -5
    var protocol = frame.read_integer()
    var hash = frame.read_long()
    var token = frame.read_integer()
    var port = frame.read_integer()
    var environment = frame.read_text()
    assert not frame.failed and frame.remaining() == 0
    understood = true
    schema.ensure()
    if not schema.matches(protocol, hash) {
        refuse(peer, protocol, hash, environment)
        return
    }
    stream.greeted = true
    var marker = Network.Component.Greeted()
    peer.entity.add_component(marker)
    if stream.dialed {
        stream.token = token
        stream.datagram_port = port
        open_datagrams(port)
    }
}

func open_datagrams(port: Integer) {
    assert port > 0 and schema.uses_datagrams() and not datagrams.opened
    datagrams.open_any()
}

func refuse(peer: Peer, protocol: Integer, hash: Long, environment: String) {
    var stream = peer.connection.stream
    console.error(
        "refusing connection {peer.entity.id}: the peer ({environment}) speaks protocol {protocol} with components hashing to {hash}, this build protocol {schema.protocol} with {schema.hash}: build both from the same source",
    )
    stream.closed = true
    assert stream.dialed
    var refused = Network.Component.Refused()
    refused.protocol = protocol
    refused.schema = hash
    refused.environment = environment
    world.as_entity().add_component(refused)
}

func control(stream: Network.Channel, message: Integer) {
    if message == -6 {
        var tick = frame.read_integer()
        if tick > stream.highest_tick {
            stream.highest_tick = tick
        }
    } else if message == -7 {
        stream.heard_by_peer = true
    } else if message == -8 {
        answer_ping(stream)
    } else if message == -9 {
        note_pong()
    }
    understood = not frame.failed and frame.remaining() == 0 and message >= -9
}

func answer_ping(stream: Network.Channel) {
    var sent_at = frame.read_long()
    var now = world.now()
    reply.clear()
    reply.write_integer(24)
    reply.write_integer(-9)
    reply.write_integer(0)
    reply.write_long(sent_at)
    reply.write_long(now)
    stream.queue(reply)
}

func note_pong() {
    var sent_at = frame.read_long()
    var server_now = frame.read_long()
    assert not frame.failed
    var round_trip = clock.elapsed_milliseconds() - sent_at
    var local_now = world.now()
    var sample = server_now + round_trip / 2 - local_now
    var narrow_trip: Integer = round_trip
    if not server_clocks.has(world.entity) {
        var made = Network.Component.ServerClock()
        made.offset = sample
        made.round_trip = narrow_trip
        made.samples = 1
        world.as_entity().add_component(made)
        return
    }
    var known = server_clocks.of(world.entity)
    crash known
    known.offset = known.offset + (sample - known.offset) / 2
    known.round_trip = narrow_trip
    known.samples = known.samples + 1
}

func read_datagrams(peer: Peer) {
    var stream = peer.connection.stream
    var inbox = stream.datagrams_in
    assert inbox.length > 0
    inbox.position = 0
    while not stream.closed and inbox.remaining() >= 4 {
        var size = inbox.read_integer()
        var start = inbox.position
        read_datagram(peer, inbox, start, size)
        inbox.position = start + size
    }
    inbox.clear()
}

func read_datagram(peer: Peer, inbox: Asset.Bytes, start: Integer, size: Integer) {
    var stream = peer.connection.stream
    assert size >= 8 and size <= inbox.length - start and stream.greeted
    var tick = inbox.integer_at(start + 4)
    if tick < stream.highest_tick {
        stream.stale_datagrams = stream.stale_datagrams + 1
        return
    }
    stream.highest_tick = tick
    stream.datagrams_read = stream.datagrams_read + 1
    if not stream.hears_peer {
        stream.hears_peer = true
        stream.queue_control(-7)
    }
    var at = start + 8
    var end = start + size
    understood = true
    while understood and at + 12 <= end {
        var frame_size = inbox.integer_at(at)
        understood = frame_size >= 8 and at + 4 + frame_size <= end
        if understood {
            decode_datagram_frame(peer, inbox, at + 4, frame_size)
        }
        at = at + 4 + frame_size
    }
}

func decode_datagram_frame(peer: Peer, source: Asset.Bytes, start: Integer, frame_size: Integer) {
    frame.clear()
    frame.untrusted = true
    frame.write_bytes(source, start, frame_size)
    var message = frame.read_integer()
    var remote = frame.read_integer()
    understood = false
    assert remote > -2 and message >= 0
    decode_components(message, remote, peer.entity.id)
}

func decode_component(component: Symbol<Component>, message: Integer, remote: Integer, connection: Integer) {
    var codec = Network.Codec<component.class>()
    if codec.replicated() and codec.id() == message {
        var value = codec.read(frame)
        if value {
            understood = true
            var link = Link<component.class>()
            var living = link.names_living(value, world.next_entity)
            if remote > -2 {
                assert living
                var mirror = local_entity(remote)
                mirror.add_component(value)
                return
            }
            var letter = letter_entity(-2 - remote, connection, message)
            assert letter_open(connection)
            if not living {
                drop_letter(connection)
                return
            }
            letter.add_component(value)
        }
    }
}

func letter_entity(key: Integer, connection: Integer, message: Integer): Entity {
    while letter_keys.count() <= connection {
        letter_keys.append(-1)
        letter_entities.append(-1)
        letter_dropped.append(false)
    }
    crash letter_keys[connection]
    crash letter_entities[connection]
    if key > 0 and letter_keys[connection] == key {
        return world.entity_of(letter_entities[connection])
    }
    var arrived = world.create_entity()
    var sender = Network.Component.Sender()
    sender.entity = world.entity_of(connection)
    arrived.add_component(sender)
    var marker = Network.Component.Arrived()
    marker.message = message
    arrived.add_component(marker)
    letter_keys[connection] = key
    letter_entities[connection] = arrived.id
    letter_dropped[connection] = false
    return arrived
}

func letter_open(connection: Integer): Boolean {
    crash connection < letter_dropped.count()
    return not letter_dropped[connection]
}

func drop_letter(connection: Integer) {
    letter_dropped[connection] = true
    crash letter_entities[connection]
    world.despawn(letter_entities[connection])
}

func strip_mirror(remote: Integer) {
    var removed = frame.read_integer()
    understood = frame.remaining() == 0 and not frame.failed
    assert understood
    var target = local_entity(remote)
    strip_components(target, removed)
}

func strip_component(component: Symbol<Component>, target: Entity, removed: Integer) {
    var codec = Network.Codec<component.class>()
    if codec.replicated() and codec.id() == removed {
        target.remove_component(component.class)
    }
}

func forget_mirror(remote: Integer) {
    understood = frame.remaining() == 0
    assert remote >= 0
    mirrors.forget(remote)
}

func local_entity(remote: Integer): Entity {
    var local = mirrors.local_of(remote)
    return world.entity_of(local)
}

func mark_mirrors() {
    var index = 0
    while index < mirrors.created.count() {
        var mirrored = Network.Component.Mirrored()
        crash mirrors.created_remotes[index]
        mirrored.remote = mirrors.created_remotes[index]
        var made = world.entity_of(mirrors.created[index])
        made.add_component(mirrored)
        index = index + 1
    }
    mirrors.created.clear()
    mirrors.created_remotes.clear()
}
