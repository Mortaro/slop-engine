var raw = Raw()
var socket = Socket()
var inbound = Asset.Bytes()
var outbound = Asset.Bytes()
var closed = false
var ended = false
var sent_bytes: Long = 0
var hello_sent = false
var greeted = false
var dialed = false
var token = 0
var datagram_host = ""
var datagram_port = 0
var hears_peer = false
var heard_by_peer = false
var highest_tick = -1
var ping_wait = 0
var datagrams_in = Asset.Bytes()
var datagrams_read = 0
var stale_datagrams = 0
var chunk = 4096
var inbound_limit = 1048576
var frame_limit = 65536

func adopt(opened: Socket) {
    socket = opened
}

func receive_all() {
    var reading = true
    while reading and inbound.length < inbound_limit {
        inbound.reserve(inbound.length + chunk)
        var free_at = inbound.address + inbound.length
        var received = socket.read_bytes_now(free_at, chunk)
        inbound.length = inbound.length + received
        reading = received > 0
    }
    if socket.closed {
        ended = true
    }
}

func end_if_ended() {
    if ended {
        closed = true
    }
}

func next_frame(frame: Asset.Bytes): Boolean {
    var available = inbound.remaining()
    if available < 4 {
        keep_partial()
        return false
    }
    var size = raw.read_integer(inbound.address, inbound.position)
    if size < 8 or size > frame_limit {
        closed = true
        return false
    }
    if available < size + 4 {
        keep_partial()
        return false
    }
    frame.clear()
    frame.untrusted = true
    var start = inbound.address + inbound.position + 4
    frame.write_bytes(start, size)
    inbound.position = inbound.position + 4 + size
    return true
}

func keep_partial() {
    assert inbound.position != 0
    var rest = Asset.Bytes()
    var left = inbound.remaining()
    if left > 0 {
        var start = inbound.address + inbound.position
        rest.write_bytes(start, left)
    }
    inbound = rest
}

func queue_control(message: Integer) {
    outbound.write_integer(8)
    outbound.write_integer(message)
    outbound.write_integer(0)
}

func take_datagram(bytes: List<Byte>) {
    var count = bytes.count()
    datagrams_in.write_integer(count)
    bytes.each(take_byte)
}

func take_byte(value: Byte) {
    var widened: Integer = value
    datagrams_in.write_byte(widened)
}

func queue(frames: Asset.Bytes) {
    if frames.length > 0 {
        outbound.write_bytes(frames.address, frames.length)
    }
}

func flush() {
    var left = outbound.remaining()
    assert left != 0
    var start = outbound.address + outbound.position
    var sent = socket.write_bytes_now(start, left)
    outbound.position = outbound.position + sent
    sent_bytes = sent_bytes + sent
    if outbound.remaining() == 0 {
        outbound.clear()
    }
    if socket.closed {
        closed = true
    }
}

func close() {
    socket.close()
}
