type Device {
    entity: Entity
    mouse: Component.Mouse
    keyboard: Component.Keyboard
}

type Arrived {
    entity: Entity
    event: Component.Event
    parent: Component.Parent
}

type HeldKey {
    entity: Entity
    key: Component.Key
    parent: Component.Parent
}

var world = World()
var down = false
var pressed = false
var released = false
var right_down = false
var right_pressed = false
var right_released = false
var middle_down = false
var middle_pressed = false
var middle_released = false
var double_clicked = false
var device_events = List<Integer>()
var key_codes = List<Integer>()
var key_entities = List<Integer>()
var doubles = Lookup<Component.DoubleClick>()
var just_pressed = Lookup<Component.JustPressed>()
var just_released = Lookup<Component.JustReleased>()

func after_input_all(devices: List<Device>, events: List<Arrived>, keys: List<HeldKey>) {
    var index = 0
    while index < devices.count() {
        apply_device(devices[index], events, keys)
        index = index + 1
    }
}

func apply_device(device: Device, events: List<Arrived>, keys: List<HeldKey>) {
    var mouse = device.mouse
    var owner = device.entity
    read_held(owner.id)
    pressed = false
    released = false
    right_pressed = false
    right_released = false
    middle_pressed = false
    middle_released = false
    double_clicked = false
    mouse.wheel = 0
    settle_keys(owner.id, keys)
    order_events(owner.id, events)
    var index = 0
    while index < device_events.count() {
        var listed = device_events[index]
        crash events[listed]
        apply(events[listed], mouse, owner)
        index = index + 1
    }
    sync_left_down(owner)
    sync_left_pressed(owner)
    sync_left_released(owner)
    sync_right_down(owner)
    sync_right_pressed(owner)
    sync_right_released(owner)
    sync_middle_down(owner)
    sync_middle_pressed(owner)
    sync_middle_released(owner)
    sync_double_clicked(owner)
}

func settle_keys(device: Integer, keys: List<HeldKey>) {
    key_codes.clear()
    key_entities.clear()
    var index = 0
    while index < keys.count() {
        settle_key(device, keys[index])
        index = index + 1
    }
}

func settle_key(device: Integer, held: HeldKey) {
    assert held.parent.entity.id == device
    var key = held.entity
    if just_released.has(key.id) {
        key.remove()
        return
    }
    if just_pressed.has(key.id) {
        key.remove_component(Component.JustPressed)
    }
    key_codes.append(held.key.code)
    key_entities.append(key.id)
}

func order_events(device: Integer, events: List<Arrived>) {
    device_events.clear()
    var index = 0
    while index < events.count() {
        if events[index].parent.entity.id == device {
            insert_in_order(events, index)
        }
        index = index + 1
    }
}

func insert_in_order(events: List<Arrived>, index: Integer) {
    crash events[index]
    var entity = events[index].entity.id
    device_events.append(index)
    var at = device_events.count() - 1
    while at > 0 and earlier(events, entity, at - 1) {
        crash device_events[at - 1]
        device_events.set_at(at, device_events[at - 1])
        at = at - 1
    }
    device_events.set_at(at, index)
}

func earlier(events: List<Arrived>, entity: Integer, at: Integer): Boolean {
    crash device_events[at]
    var listed = device_events[at]
    crash events[listed]
    return entity < events[listed].entity.id
}

func apply(arrived: Arrived, mouse: Component.Mouse, device: Entity) {
    var event = arrived.event
    if event.kind == 'pointer_moved' {
        mouse.left = event.left
        mouse.top = event.top
    } else if event.kind == 'button_pressed' {
        mouse.left = event.left
        mouse.top = event.top
        var double = doubles.has(arrived.entity.id)
        press_button(event, double)
    } else if event.kind == 'button_released' {
        mouse.left = event.left
        mouse.top = event.top
        release_button(event.button)
    } else if event.kind == 'wheel_turned' {
        mouse.wheel = mouse.wheel + event.wheel
    } else if event.kind == 'key_pressed' {
        press_key(device, event.key)
    } else if event.kind == 'key_released' {
        release_key(event.key)
    }
}

func press_button(event: Component.Event, double: Boolean) {
    if event.button == 1 {
        right_down = true
        right_pressed = true
    } else if event.button == 2 {
        middle_down = true
        middle_pressed = true
    } else {
        down = true
        pressed = true
        double_clicked = double
    }
}

func release_button(button: Integer) {
    if button == 1 {
        right_down = false
        right_released = true
    } else if button == 2 {
        middle_down = false
        middle_released = true
    } else {
        down = false
        released = true
    }
}

func press_key(device: Entity, code: Integer) {
    var place = key_place(code)
    if place >= 0 {
        crash key_entities[place]
        var existing = key_entities[place]
        var again = Component.JustPressed()
        world.entity_of(existing).add_component(again)
        return
    }
    var key = device.spawn_entity()
    var held = Component.Key()
    held.code = code
    key.add_component(held)
    var marker = Component.JustPressed()
    key.add_component(marker)
    key_codes.append(code)
    key_entities.append(key.id)
}

func release_key(code: Integer) {
    var place = key_place(code)
    assert place >= 0
    crash key_entities[place]
    var released_key = world.entity_of(key_entities[place])
    var marker = Component.JustReleased()
    released_key.add_component(marker)
    key_codes.remove_at(place)
    key_entities.remove_at(place)
}

func key_place(code: Integer): Integer {
    var index = 0
    while index < key_codes.count() {
        if key_codes[index] == code {
            return index
        }
        index = index + 1
    }
    return -1
}

func read_held(entity: Integer) {
    down = Lookup<Component.LeftDown>().has(entity)
    right_down = Lookup<Component.RightDown>().has(entity)
    middle_down = Lookup<Component.MiddleDown>().has(entity)
}

func sync_left_down(owner: Entity) {
    var present = Lookup<Component.LeftDown>().has(owner.id)
    if down and not present {
        var marker = Component.LeftDown()
        owner.add_component(marker)
    } else if present and not down {
        owner.remove_component(Component.LeftDown)
    }
}

func sync_left_pressed(owner: Entity) {
    var present = Lookup<Component.LeftPressed>().has(owner.id)
    if pressed and not present {
        var marker = Component.LeftPressed()
        owner.add_component(marker)
    } else if present and not pressed {
        owner.remove_component(Component.LeftPressed)
    }
}

func sync_left_released(owner: Entity) {
    var present = Lookup<Component.LeftReleased>().has(owner.id)
    if released and not present {
        var marker = Component.LeftReleased()
        owner.add_component(marker)
    } else if present and not released {
        owner.remove_component(Component.LeftReleased)
    }
}

