func sync_middle_pressed(owner: Entity) {
    var present = Lookup<Component.MiddlePressed>().has(owner.id)
    if middle_pressed and not present {
        var marker = Component.MiddlePressed()
        owner.add_component(marker)
    } else if present and not middle_pressed {
        owner.remove_component(Component.MiddlePressed)
    }
