func sync_double_clicked(owner: Entity) {
    var present = Lookup<Component.DoubleClicked>().has(owner.id)
    if double_clicked and not present {
        var marker = Component.DoubleClicked()
        owner.add_component(marker)
    } else if present and not double_clicked {
