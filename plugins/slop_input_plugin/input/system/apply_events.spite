func sync_middle_down(owner: Entity) {
    var present = Lookup<Component.MiddleDown>().has(owner.id)
    if middle_down and not present {
        var marker = Component.MiddleDown()
        owner.add_component(marker)
    } else if present and not middle_down {
        owner.remove_component(Component.MiddleDown)
    }
