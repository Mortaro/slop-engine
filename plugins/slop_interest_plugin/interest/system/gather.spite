type Viewing {
    entity: Entity
    viewer: Interest.Component.Viewer
    watching: Interest.Component.Watching
}

var grid = Spatial.Grid()
var world = World()
var found = List<Integer>()
var stamps = List<Integer>()
var kept_subjects = List<Integer>()
var kept_links = List<Integer>()
var pass = 0
var center_x: Float = 0.0
var center_z: Float = 0.0
var center_space = 0
var keep_reach: Float = 0.0
var positions = Lookup<Transform.Component.Transform>()
var spaces = Lookup<Spatial.Component.Indexed>()

func prepare_each(viewing: Viewing) {
    pass = pass + 1
    found.clear()
    var transforms = Lookup<Transform.Component.Transform>()
    var placed = transforms.of(viewing.viewer.entity)
    assert placed
    var indexes = Lookup<Spatial.Component.Indexed>()
    var index = indexes.of(viewing.viewer.entity)
    var space = 0
    if index {
        space = index.space
    }
    grid.within(space, placed.position_x, placed.position_z, viewing.viewer.radius, found)
    found.append(viewing.viewer.entity)
    center_x = placed.position_x
    center_z = placed.position_z
    center_space = space
    var keep_radius = viewing.viewer.radius * 1.25
    keep_reach = keep_radius * keep_radius
    stamp_found()
    kept_subjects.clear()
    kept_links.clear()
    keep_or_drop(viewing.watching)
    link_new(viewing.entity.id)
    copy(kept_subjects, viewing.watching.subjects)
    copy(kept_links, viewing.watching.links)
}

func stamp_found() {
    var index = 0
    while index < found.count() {
        var entity = found[index]
        while stamps.count() <= entity {
            stamps.append(0)
        }
        stamps.set_at(entity, pass)
        index = index + 1
    }
}

func keep_or_drop(watching: Interest.Component.Watching) {
    var index = 0
    while index < watching.subjects.count() {
        var subject = watching.subjects[index]
        crash watching.links[index]
        var link = watching.links[index]
        var found_now = subject < stamps.count() and stamps[subject] == pass
        if found_now or still_near(subject) {
            stamps.set_at(subject, 0 - pass)
            kept_subjects.append(subject)
            kept_links.append(link)
        } else {
            world.despawn(link)
        }
        index = index + 1
    }
}

func link_new(connection: Integer) {
    var index = 0
    while index < found.count() {
        var subject = found[index]
        if stamps[subject] == pass {
            stamps.set_at(subject, 0 - pass)
            var link = world.create_entity()
            var observer = Network.Component.Observer()
            observer.subject = subject
            observer.observer = connection
            link.add_component(observer)
            kept_subjects.append(subject)
            kept_links.append(link.id)
        }
        index = index + 1
    }
}

func copy(from: List<Integer>, into: List<Integer>) {
    into.clear()
    var index = 0
    while index < from.count() {
        into.append(from[index])
        index = index + 1
    }
}

func still_near(subject: Integer): Boolean {
    var placed = positions.of(subject)
    if not placed {
        return false
    }
    var index = spaces.of(subject)
    var space = 0
    if index {
        space = index.space
    }
    var across = placed.position_x - center_x
    var down = placed.position_z - center_z
    return space == center_space and across * across + down * down <= keep_reach
}
