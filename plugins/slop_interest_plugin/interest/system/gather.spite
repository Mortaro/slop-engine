type Viewing {
    entity: Entity
    viewer: Interest.Component.Viewer
    viewpoint: Interest.Component.Viewpoint
}

type Observation {
    entity: Entity
    parent: Component.Parent
    observer: Network.Component.Observer
    in_sight: Interest.Component.InSight
}

var grid = Spatial.Grid()
var world = World()
var found = List<Integer>()
var stamps = List<Integer>()
var viewer_of = List<Integer>()
var observed_counts = List<Integer>()
var observed_starts = List<Integer>()
var observed_order = List<Integer>()
var pass = 0
var center_x: Float = 0.0
var center_z: Float = 0.0
var center_space = 0
var keep_reach: Float = 0.0
var positions = Lookup<Transform.Component.Transform>()
var spaces = Lookup<Spatial.Component.Indexed>()

func prepare_all(viewing: List<Viewing>, observations: List<Observation>) {
    group_observations(viewing, observations)
    var index = 0
    while index < viewing.count() {
        gather_viewer(viewing[index], index, observations)
        index = index + 1
    }
    forget_viewers(viewing)
}

func group_observations(viewing: List<Viewing>, observations: List<Observation>) {
    observed_counts.clear()
    observed_starts.clear()
    var index = 0
    while index < viewing.count() {
        var connection = viewing[index].entity.id
        while viewer_of.count() <= connection {
            viewer_of.append(0)
        }
        viewer_of[connection] = index + 1
        observed_counts.append(0)
        observed_starts.append(0)
        index = index + 1
    }
    index = 0
    while index < observations.count() {
        count_observation(observations[index])
        index = index + 1
    }
    var start = 0
    index = 0
    while index < viewing.count() {
        observed_starts[index] = start
        crash observed_counts[index]
        start = start + observed_counts[index]
        observed_counts[index] = 0
        index = index + 1
    }
    observed_order.clear()
    while observed_order.count() < start {
        observed_order.append(0)
    }
    index = 0
    while index < observations.count() {
        place_observation(observations[index], index)
        index = index + 1
    }
}

func count_observation(observation: Observation) {
    var viewer = viewer_index(observation)
    assert viewer >= 0
    crash observed_counts[viewer]
    observed_counts[viewer] = observed_counts[viewer] + 1
}

func place_observation(observation: Observation, index: Integer) {
    var viewer = viewer_index(observation)
    assert viewer >= 0
    crash observed_starts[viewer]
    crash observed_counts[viewer]
    var at = observed_starts[viewer] + observed_counts[viewer]
    observed_order[at] = index
    observed_counts[viewer] = observed_counts[viewer] + 1
}

func viewer_index(observation: Observation): Integer {
    var connection = observation.observer.entity.id
    if connection >= viewer_of.count() {
        return -1
    }
    return viewer_of[connection] - 1
}

func forget_viewers(viewing: List<Viewing>) {
    var index = 0
    while index < viewing.count() {
        var gone_viewer = viewing[index].entity.id
        viewer_of[gone_viewer] = 0
        index = index + 1
    }
}

func gather_viewer(viewing: Viewing, viewer: Integer, observations: List<Observation>) {
    var eye = viewing.viewpoint.entity.id
    var placed = positions.of(eye)
    assert placed
    pass = pass + 1
    found.clear()
    var index = spaces.of(eye)
    var space = 0
    if index {
        space = index.space
    }
    grid.within(space, placed.position_x, placed.position_z, viewing.viewer.radius, found)
    found.append(eye)
    center_x = placed.position_x
    center_z = placed.position_z
    center_space = space
    var keep_radius = viewing.viewer.radius * 1.25
    keep_reach = keep_radius * keep_radius
    stamp_found()
    keep_or_drop(viewer, observations)
    observe_new(viewing.entity.id)
}

func stamp_found() {
    var index = 0
    while index < found.count() {
        var entity = found[index]
        while stamps.count() <= entity {
            stamps.append(0)
        }
        stamps[entity] = pass
        index = index + 1
    }
}

func keep_or_drop(viewer: Integer, observations: List<Observation>) {
    crash observed_starts[viewer]
    crash observed_counts[viewer]
    var first = observed_starts[viewer]
    var end = first + observed_counts[viewer]
    var at = first
    while at < end {
        crash observed_order[at]
        var listed = observed_order[at]
        crash observations[listed]
        keep_or_drop_one(observations[listed])
        at = at + 1
    }
}

func keep_or_drop_one(observation: Observation) {
    var subject = observation.parent.entity.id
    var found_now = subject < stamps.count() and stamps[subject] == pass
    if found_now or still_near(subject) {
        while stamps.count() <= subject {
            stamps.append(0)
        }
        stamps[subject] = 0 - pass
    } else {
        world.despawn(observation.entity.id)
    }
}

func observe_new(connection: Integer) {
    var index = 0
    while index < found.count() {
        var subject = found[index]
        if stamps[subject] == pass and positions.has(subject) {
            stamps[subject] = 0 - pass
            var observation = world.entity_of(subject).create_entity()
            var observer = Network.Component.Observer()
            observer.entity = world.entity_of(connection)
            observation.add_component(observer)
            var in_sight = Interest.Component.InSight()
            observation.add_component(in_sight)
        }
        index = index + 1
    }
}

func still_near(subject: Integer): Boolean {
    var placed = positions.of(subject)
    if not placed {
        return false
    }
    var index = spaces.of(subject)
    var space = 0
    if index {
        space = index.space
    }
    var across = placed.position_x - center_x
    var down = placed.position_z - center_z
    return space == center_space and across * across + down * down <= keep_reach
}
