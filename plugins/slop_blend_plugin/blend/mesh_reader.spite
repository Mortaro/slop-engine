var space = Blend.Space()
var file = Blend.Document()
var mesh = Asset.Mesh()
var placement = Matrix4()
var attribute_names = List<String>()
var attribute_offsets = List<Integer>()
var single_names = List<String>()
var single_offsets = List<Integer>()
var sharp_constant = false
var material_constant = 0
var positions = 0
var corner_vertices = 0
var coordinates = -1
var sharp_faces = -1
var face_offsets = 0
var deform_vertices = 0
var attribute_kinds = List<Integer>()
var attribute_domains = List<Integer>()
var corner_normals = Blend.CornerNormals()
var polygon = Blend.PolygonFill()
var normal_matrix = Matrix4()
var projection_across = Vector3(0.0, 0.0, 0.0)
var projection_up = Vector3(0.0, 0.0, 0.0)
var group_bones = List<Integer>()
var welded = Dictionary<Integer>()
var direction = Vector3(0.0, 0.0, 0.0)
var material_faces = -1
var images = List<String>()
var image_bytes = List<Asset.Bytes>()
var image_paths = List<String>()
var map_images = List<String>()
var map_image_bytes = List<Asset.Bytes>()
var map_image_paths = List<String>()
var material_view = Blend.View()
var tree_links = List<Blend.View>()
var found_channel = 0

func read(source: Blend.Document, object: Blend.View, bone_names: List<String>): Asset.Mesh {
    file = source
    var world = space.object_world(file, object)
    var target = space.to_target()
    placement = target * world
    var inverted_placement = placement.inverse()
    crash inverted_placement
    normal_matrix = inverted_placement
    var data_address_2 = object.pointer("data")
    var data = file.view_at(data_address_2)
    crash data
    file.enter(data)
    read_attributes(data)
    positions = attribute_offset("position")
    corner_vertices = attribute_offset(".corner_vert")
    coordinates = uv_offset(data)
    sharp_faces = attribute_offset("sharp_face")
    material_faces = attribute_offset("material_index")
    var sharp_single = single_offset("sharp_face")
    if sharp_single >= 0 {
        sharp_constant = file.bytes.byte_at(sharp_single) != 0
    }
    var material_single = single_offset("material_index")
    if material_single >= 0 {
        material_constant = file.integer_at(material_single)
    }
    var poly_offset_indices_address = data.pointer("poly_offset_indices")
    var offsets_block = file.block_at(poly_offset_indices_address)
    crash offsets_block
    face_offsets = offsets_block.offset
    deform_vertices = deform_layer(data)
    map_groups(data, bone_names)
    var face_count = data.integer("totpoly")
    compute_normals(data, face_count)
    var material_count = data.short_integer("totcol")
    if material_count < 1 {
        material_count = 1
    }
    var material = 0
    while material < material_count {
        emit_section(material, face_count)
        material = material + 1
    }
    read_materials(data, material_count)
    mesh.compute_tangents()
    return mesh
}

func emit_section(material: Integer, face_count: Integer) {
    var first = mesh.indices.count()
    var face = 0
    while face < face_count {
        if material_of(face) == material {
            emit_face(face)
        }
        face = face + 1
    }
    var count = mesh.indices.count() - first
    assert count > 0
    mesh.sections.append(first)
    mesh.sections.append(count)
    mesh.sections.append(material)
}

func material_of(face: Integer): Integer {
    var material = material_constant
    if material_faces >= 0 {
        material = file.integer_at(material_faces + face * 4)
    }
    return material
}

func single_offset(name: String): Integer {
    var index = 0
    var found = -2
    while index < single_names.count() {
        if single_names[index] == name {
            crash single_offsets[index]
            found = single_offsets[index]
        }
        index = index + 1
    }
    var value_is_in_the_file = found != -1
    crash value_is_in_the_file
    return found
}

func read_attributes(data: Blend.View) {
    var storage = data.inner("attribute_storage")
    var count = storage.integer("dna_attributes_num")
    var dna_attributes_address = storage.pointer("dna_attributes")
    var first = file.view_at(dna_attributes_address)
    crash first
    var index = 0
    while index < count {
        var attribute = first.element(index)
        var name_address = attribute.pointer("name")
        var name_block = file.block_at(name_address)
        crash name_block
        var name = file.text_at(name_block.offset, name_block.length - 1)
        var wrapper_address = attribute.pointer("data")
        var wrapper = file.view_at(wrapper_address)
        crash wrapper
        var values_address = wrapper.pointer("data")
        if wrapper.shape.name == "AttributeSingle" {
            single_names.append(name)
            var found = file.by_address.has(values_address)
            var value_offset = -1
            if found {
                value_offset = block_offset(values_address)
            }
            single_offsets.append(value_offset)
        } else {
            attribute_names.append(name)
            var offset = block_offset(values_address)
            attribute_offsets.append(offset)
            var kind = attribute.short_integer("data_type")
            var domain = attribute.small_integer("domain")
            attribute_kinds.append(kind)
            attribute_domains.append(domain)
        }
        index = index + 1
    }
}

func deform_layer(data: Blend.View): Integer {
    var vertex_data = data.inner("vdata")
    var count = vertex_data.integer("totlayer")
    var layers_address = vertex_data.pointer("layers")
    if count == 0 or layers_address == 0 {
        return -1
    }
    var first = file.view_at(layers_address)
    crash first
    var index = 0
    while index < count {
        var layer = first.element(index)
        if layer.integer("type") == 2 {
            var layer_data = layer.pointer("data")
            return block_offset(layer_data)
        }
        index = index + 1
    }
    return -1
}

func block_offset(address: Long): Integer {
    if address == 0 {
        return -1
    }
    var block = file.block_at(address)
    crash block
    return block.offset
}

func attribute_index(name: String): Integer {
    var index = 0
    while index < attribute_names.count() {
        if attribute_names[index] == name {
            return index
        }
        index = index + 1
    }
    return -1
}

func attribute_offset(name: String): Integer {
    var index = 0
    while index < attribute_names.count() {
        if attribute_names[index] == name {
            crash attribute_offsets[index]
            return attribute_offsets[index]
        }
        index = index + 1
    }
    return -1
}

func uv_offset(data: Blend.View): Integer {
    var active = data.pointer("active_uv_map_attribute")
    if active != 0 {
        var name_block = file.block_at(active)
        crash name_block
        var name = file.text_at(name_block.offset, name_block.length - 1)
        return attribute_offset(name)
    }
    return attribute_offset("UVMap")
}

func map_groups(data: Blend.View, bone_names: List<String>) {
    var groups = data.inner("vertex_group_names")
    var views = file.list_views(groups)
    var index = 0
    while index < views.count() {
        var name = views[index].text("name")
        var bone = index_of_name(bone_names, name)
        group_bones.append(bone)
        index = index + 1
    }
}

func index_of_name(names: List<String>, name: String): Integer {
    var index = 0
    while index < names.count() {
        if names[index] == name {
            return index
        }
        index = index + 1
    }
    return -1
}

func face_start(face: Integer): Integer {
    return file.integer_at(face_offsets + face * 4)
}

func corner_vertex(corner: Integer): Integer {
    return file.integer_at(corner_vertices + corner * 4)
}

func position(vertex: Integer, axis: Integer): Float {
    return file.float_at(positions + vertex * 12 + axis * 4)
}

func compute_normals(data: Blend.View, face_count: Integer) {
    corner_normals.file = file
    corner_normals.positions = positions
    corner_normals.corner_vertices = corner_vertices
    corner_normals.corner_edges = attribute_offset(".corner_edge")
    corner_normals.face_offsets = face_offsets
    corner_normals.sharp_faces = sharp_faces
    corner_normals.sharp_face_constant = sharp_constant
    corner_normals.sharp_edges = attribute_offset("sharp_edge")
    var sharp_edge_single = single_offset("sharp_edge")
    if sharp_edge_single >= 0 {
        corner_normals.sharp_edge_constant = file.bytes.byte_at(sharp_edge_single) != 0
    }
    var custom = attribute_index("custom_normal")
    if custom >= 0 {
        crash attribute_offsets[custom]
        crash attribute_kinds[custom]
        crash attribute_domains[custom]
        corner_normals.custom = attribute_offsets[custom]
        corner_normals.custom_kind = attribute_kinds[custom]
        corner_normals.custom_domain = attribute_domains[custom]
    }
    corner_normals.vertex_count = data.integer("totvert")
    corner_normals.edge_count = data.integer("totedge")
    corner_normals.face_count = face_count
    corner_normals.compute()
}

func emit_face(face: Integer) {
    var first = face_start(face)
    var last = face_start(face + 1)
    var size = last - first
    if size == 3 {
        emit_triangle(first, first + 1, first + 2)
    } else if size == 4 {
        emit_quad(first)
    } else if size > 4 {
        emit_polygon(face, first, last)
    }
}

func emit_triangle(first: Integer, second: Integer, third: Integer) {
    emit_corner(first)
    emit_corner(second)
    emit_corner(third)
}

func emit_quad(first: Integer) {
    var one = corner_vertex(first)
    var two = corner_vertex(first + 1)
    var three = corner_vertex(first + 2)
    var four = corner_vertex(first + 3)
    var to_two_x = position(two, 0) - position(one, 0)
    var to_two_y = position(two, 1) - position(one, 1)
    var to_two_z = position(two, 2) - position(one, 2)
    var to_three_x = position(three, 0) - position(one, 0)
    var to_three_y = position(three, 1) - position(one, 1)
    var to_three_z = position(three, 2) - position(one, 2)
    var to_four_x = position(four, 0) - position(one, 0)
    var to_four_y = position(four, 1) - position(one, 1)
    var to_four_z = position(four, 2) - position(one, 2)
    var first_x = to_two_y * to_three_z - to_two_z * to_three_y
    var first_y = to_two_z * to_three_x - to_two_x * to_three_z
    var first_z = to_two_x * to_three_y - to_two_y * to_three_x
    var second_x = to_four_y * to_three_z - to_four_z * to_three_y
    var second_y = to_four_z * to_three_x - to_four_x * to_three_z
    var second_z = to_four_x * to_three_y - to_four_y * to_three_x
    var folded = first_x * second_x + first_y * second_y + first_z * second_z > 0.0
    if folded {
        emit_triangle(first, first + 1, first + 3)
        emit_triangle(first + 1, first + 2, first + 3)
        return
    }
    emit_triangle(first, first + 1, first + 2)
    emit_triangle(first, first + 2, first + 3)
}

func emit_polygon(face: Integer, first: Integer, last: Integer) {
    project_onto_face(face)
    polygon.clear()
    var corner = first
    while corner < last {
        var vertex = corner_vertex(corner)
        var vertex_x = position(vertex, 0)
        var vertex_y = position(vertex, 1)
        var vertex_z = position(vertex, 2)
        var along = projection_across.x * vertex_x + projection_across.y * vertex_y
        along = along + projection_across.z * vertex_z
        var upward = projection_up.x * vertex_x + projection_up.y * vertex_y
        upward = upward + projection_up.z * vertex_z
        polygon.add(along, upward)
        corner = corner + 1
    }
    polygon.fill()
    var index = 0
    while index + 2 < polygon.triangles.count() {
        var one = first + polygon.triangles[index]
        var two = first + polygon.triangles[index + 1]
        var three = first + polygon.triangles[index + 2]
        emit_triangle(one, two, three)
        index = index + 3
    }
}

func project_onto_face(face: Integer) {
    var away_x = 0.0 - corner_normals.face_normal(face, 0)
    var away_y = 0.0 - corner_normals.face_normal(face, 1)
    var away_z = 0.0 - corner_normals.face_normal(face, 2)
    var flat = away_x * away_x + away_y * away_y
    if flat > 0.00000011920929 {
        var inverse = 1.0 / flat.square_root()
        projection_across.x = away_y * inverse
        projection_across.y = 0.0 - away_x * inverse
        projection_across.z = 0.0
        projection_up.x = 0.0 - away_z * projection_across.y
        projection_up.y = away_z * projection_across.x
        var up_z = away_x * projection_across.y - away_y * projection_across.x
        projection_up.z = up_z
        return
    }
    projection_across.x = 1.0
    if away_z < 0.0 {
        projection_across.x = -1.0
    }
    projection_across.y = 0.0
    projection_across.z = 0.0
    projection_up.x = 0.0
    projection_up.y = 1.0
    projection_up.z = 0.0
}

func emit_corner(corner: Integer) {
    var vertex = corner_vertex(corner)
    transform_normal(corner)
    var across: Float = 0.0
    var down: Float = 0.0
    if coordinates >= 0 {
        across = file.float_at(coordinates + corner * 8)
        var up = file.float_at(coordinates + corner * 8 + 4)
        down = 1.0 - up
    }
    var key = weld_key(vertex, across, down)
    var known = welded[key]
    if known {
        mesh.indices.append(known)
        return
    }
    var index = mesh.vertices.count() / 8
    welded[key] = index
    mesh.indices.append(index)
    var position_x = position(vertex, 0)
    var position_y = position(vertex, 1)
    var position_z = position(vertex, 2)
    var source = Vector3(position_x, position_y, position_z)
    var point = placement.transform_point(source)
    mesh.vertices.append(point.x)
    mesh.vertices.append(point.y)
    mesh.vertices.append(point.z)
    mesh.vertices.append(direction.x)
    mesh.vertices.append(direction.y)
    mesh.vertices.append(direction.z)
    mesh.vertices.append(across)
    mesh.vertices.append(down)
    append_skin(vertex)
}

func transform_normal(corner: Integer) {
    var normals = corner_normals.normals
    crash normals[corner * 3]
    crash normals[corner * 3 + 1]
    crash normals[corner * 3 + 2]
    var normal_x = normals[corner * 3]
    var normal_y = normals[corner * 3 + 1]
    var normal_z = normals[corner * 3 + 2]
    var along_x = normal_matrix.column_0_row_0 * normal_x + normal_matrix.column_0_row_1 * normal_y + normal_matrix.column_0_row_2 * normal_z
    var along_y = normal_matrix.column_1_row_0 * normal_x + normal_matrix.column_1_row_1 * normal_y + normal_matrix.column_1_row_2 * normal_z
    var along_z = normal_matrix.column_2_row_0 * normal_x + normal_matrix.column_2_row_1 * normal_y + normal_matrix.column_2_row_2 * normal_z
    var squared = along_x * along_x + along_y * along_y + along_z * along_z
    var length = squared.square_root()
    direction.x = along_x / length
    direction.y = along_y / length
    direction.z = along_z / length
}

func weld_key(vertex: Integer, across: Float, down: Float): String {
    var normal_x: Integer = direction.x * 10000.0
    var normal_y: Integer = direction.y * 10000.0
    var normal_z: Integer = direction.z * 10000.0
    var coordinate_across: Integer = across * 100000.0
    var coordinate_down: Integer = down * 100000.0
    return "{vertex} {normal_x} {normal_y} {normal_z} {coordinate_across} {coordinate_down}"
}

func append_skin(vertex: Integer) {
    assert deform_vertices >= 0
    var bones = List<Integer>()
    var weights = List<Float>()
    collect_weights(vertex, bones, weights)
    if bones.count() == 0 {
        bones.append(0)
        weights.append(1.0)
    }
    var total: Float = 0.0
    var slot = 0
    while slot < weights.count() {
        total = total + weights[slot]
        slot = slot + 1
    }
    var packed = 0
    slot = 3
    while slot >= 0 {
        var bone = 0
        var weight: Float = 0.0
        if slot < bones.count() {
            crash weights[slot]
            bone = bones[slot]
            weight = weights[slot] / total
        }
        packed = packed.shifted_left(8).bits_or(bone)
        mesh.weights.append(weight)
        slot = slot - 1
    }
    reverse_last_weights()
    mesh.joints.append(packed)
}

func reverse_last_weights() {
    var end = mesh.weights.count()
    crash mesh.weights[end - 4]
    crash mesh.weights[end - 3]
    crash mesh.weights[end - 2]
    crash mesh.weights[end - 1]
    var first = mesh.weights[end - 4]
    var second = mesh.weights[end - 3]
    mesh.weights[end - 4] = mesh.weights[end - 1]
    mesh.weights[end - 3] = mesh.weights[end - 2]
    mesh.weights[end - 2] = second
    mesh.weights[end - 1] = first
}

func collect_weights(vertex: Integer, bones: List<Integer>, weights: List<Float>) {
    var record = deform_vertices + vertex * 16
    var list_address = file.long_at(record)
    var count = file.integer_at(record + 8)
    assert list_address != 0 and count > 0
    var entries = block_offset(list_address)
    var entry = 0
    while entry < count {
        var group = file.integer_at(entries + entry * 8)
        var weight = file.float_at(entries + entry * 8 + 4)
        keep_heaviest(group, weight, bones, weights)
        entry = entry + 1
    }
}

func keep_heaviest(group: Integer, weight: Float, bones: List<Integer>, weights: List<Float>) {
    assert group >= 0 and group < group_bones.count() and weight > 0.0
    var bone = group_bones[group]
    assert bone >= 0
    var at = 0
    while at < weights.count() and at < 4 {
        if weight > weights[at] {
            bones.insert(at, bone)
            weights.insert(at, weight)
            trim(bones, weights)
            return
        }
        at = at + 1
    }
    if weights.count() < 4 {
        bones.append(bone)
        weights.append(weight)
    }
}

func trim(bones: List<Integer>, weights: List<Float>) {
    while weights.count() > 4 {
        bones.remove_last()
        weights.remove_last()
    }
}

func read_materials(data: Blend.View, material_count: Integer) {
    var materials_address = data.pointer("mat")
    var materials_offset = -1
    if materials_address != 0 {
        materials_offset = block_offset(materials_address)
    }
    var material = 0
    while material < material_count {
        images.append("")
        var empty = Asset.Bytes()
        image_bytes.append(empty)
        image_paths.append("")
        mesh.textures.append("")
        var painted = Asset.Material()
        mesh.materials.append(painted)
        read_material(materials_offset, material)
        material = material + 1
    }
}

func read_material(materials_offset: Integer, material: Integer) {
    assert materials_offset >= 0
    var material_address = file.long_at(materials_offset + material * 8)
    assert material_address != 0
    var found = file.view_at(material_address)
    crash found
    material_view = found
    file.enter(found)
    crash mesh.materials[material]
    var settings = mesh.materials[material]
    var flags = found.small_integer("blend_flag")
    settings.two_sided = flags.bits_and(4) == 0
    settings.translucent = found.small_integer("surface_render_method") == 1
    var tree_address = found.pointer("nodetree")
    assert tree_address != 0
    var tree = file.view_at(tree_address)
    crash tree
    var links_list = tree.inner("links")
    tree_links = file.list_views(links_list)
    var surface_address = surface_node()
    assert surface_address != 0
    var surface = file.view_at(surface_address)
    crash surface
    if surface.text("idname") == "ShaderNodeMixShader" {
        read_transparent_mix(surface_address, surface, material, settings)
        return
    }
    read_surface(surface_address, surface, material, settings)
}

func read_surface(address: Long, surface: Blend.View, material: Integer, settings: Asset.Material) {
    var kind = surface.text("idname")
    if kind == "ShaderNodeEmission" {
        read_emission(address, surface, material, settings)
        return
    }
    var surface_is_a_principled_bsdf_an_emission_or_a_transparent_mix = kind == "ShaderNodeBsdfPrincipled"
    crash surface_is_a_principled_bsdf_an_emission_or_a_transparent_mix
    read_principled(address, surface, material, settings)
}

func read_transparent_mix(address: Long, mix: Blend.View, material: Integer, settings: Asset.Material) {
    var clear = link_into(address, "Shader")
    var shaded = link_into(address, "Shader_001")
    crash clear
    crash shaded
    var clear_node = clear.follow("fromnode")
    var shaded_node = shaded.follow("fromnode")
    crash clear_node
    crash shaded_node
    var mix_is_a_transparent_bsdf_then_a_surface = clear_node.text("idname") == "ShaderNodeBsdfTransparent"
    crash mix_is_a_transparent_bsdf_then_a_surface
    var shaded_address = shaded.pointer("fromnode")
    read_surface(shaded_address, shaded_node, material, settings)
    var factor = link_into(address, "Fac")
    if factor {
        read_opacity_link(factor, material, settings)
        return
    }
    settings.opacity = settings.opacity * socket_value(mix, "Fac", 0)
}

func surface_node(): Long {
    var index = 0
    while index < tree_links.count() {
        var link = tree_links[index]
        var to = link.follow("tonode")
        var socket = link.follow("tosock")
        crash to
        crash socket
        if to.text("idname") == "ShaderNodeOutputMaterial" and socket.text("identifier") == "Surface" {
            return link.pointer("fromnode")
        }
        index = index + 1
    }
    index = 0
    while index < tree_links.count() {
        var into = tree_links[index].follow("tonode")
        crash into
        if into.text("idname") == "ShaderNodeBsdfPrincipled" {
            return tree_links[index].pointer("tonode")
        }
        index = index + 1
    }
    return 0
}

func link_into(node_address: Long, identifier: String): Blend.View? {
    var index = 0
    while index < tree_links.count() {
        var link = tree_links[index]
        if link.pointer("tonode") == node_address {
            var socket = link.follow("tosock")
            crash socket
            if socket.text("identifier") == identifier {
                return link
            }
        }
        index = index + 1
    }
    return null
}

func socket_value(node: Blend.View, identifier: String, component: Integer): Float {
    var inputs = node.inner("inputs")
    var sockets = file.list_views(inputs)
    var index = 0
    while index < sockets.count() {
        var socket = sockets[index]
        if socket.text("identifier") == identifier {
            var value = socket.follow("default_value")
            crash value
            return value.float_at("value", component)
        }
        index = index + 1
    }
    var socket_is_on_the_node = identifier == ""
    crash socket_is_on_the_node
    return 0.0
}

func read_principled(address: Long, node: Blend.View, material: Integer, settings: Asset.Material) {
    var base = link_into(address, "Base Color")
    if base {
        var from = base.follow("fromnode")
        crash from
        var base_color_is_an_image = from.text("idname") == "ShaderNodeTexImage"
        crash base_color_is_an_image
        read_image_node(from, material)
    } else {
        settings.base_red = socket_value(node, "Base Color", 0)
        settings.base_green = socket_value(node, "Base Color", 1)
        settings.base_blue = socket_value(node, "Base Color", 2)
    }
    read_alpha(address, node, material, settings)
    var roughness = link_into(address, "Roughness")
    if roughness {
        settings.roughness_map = map_source(roughness)
        settings.roughness_channel = found_channel
    } else {
        settings.roughness = socket_value(node, "Roughness", 0)
    }
    var metallic = link_into(address, "Metallic")
    if metallic {
        settings.metallic_map = map_source(metallic)
        settings.metallic_channel = found_channel
    } else {
        settings.metallic = socket_value(node, "Metallic", 0)
    }
    settings.specular = socket_value(node, "Specular IOR Level", 0)
    read_normal(address, settings)
    read_emission_color(address, node, settings)
}

func read_alpha(address: Long, node: Blend.View, material: Integer, settings: Asset.Material) {
    var alpha = link_into(address, "Alpha")
    if not alpha {
        settings.opacity = socket_value(node, "Alpha", 0)
        return
    }
    read_opacity_link(alpha, material, settings)
}

func read_opacity_link(alpha: Blend.View, material: Integer, settings: Asset.Material) {
    if not settings.translucent {
        mesh.masked_materials.append(material)
    }
    var from = alpha.follow("fromnode")
    crash from
    crash images[material]
    var base_name = images[material]
    var from_image = from.text("idname") == "ShaderNodeTexImage"
    if from_image {
        var name = image_name(from)
        if name == base_name {
            settings.opacity_from_base = true
            settings.opacity_channel = channel_of_image_output(alpha)
            return
        }
    }
    settings.opacity_map = map_source(alpha)
    settings.opacity_channel = found_channel
}

func read_normal(address: Long, settings: Asset.Material) {
    var normal = link_into(address, "Normal")
    assert normal
    var from = normal.follow("fromnode")
    crash from
    var normal_is_a_normal_map_node = from.text("idname") == "ShaderNodeNormalMap"
    crash normal_is_a_normal_map_node
    var storage = from.follow("storage")
    crash storage
    var normal_map_is_in_tangent_space = storage.integer("space") == 0
    crash normal_map_is_in_tangent_space
    settings.normal_strength = socket_value(from, "Strength", 0)
    var mapping_address = normal.pointer("fromnode")
    var color = link_into(mapping_address, "Color")
    crash color
    settings.normal = map_source(color)
}

func read_emission_color(address: Long, node: Blend.View, settings: Asset.Material) {
    var strength = socket_value(node, "Emission Strength", 0)
    var color = link_into(address, "Emission Color")
    if color {
        settings.emissive_map = map_source(color)
        settings.emissive_red = strength
        settings.emissive_green = strength
        settings.emissive_blue = strength
        return
    }
    settings.emissive_red = socket_value(node, "Emission Color", 0) * strength
    settings.emissive_green = socket_value(node, "Emission Color", 1) * strength
    settings.emissive_blue = socket_value(node, "Emission Color", 2) * strength
}

func read_emission(address: Long, node: Blend.View, material: Integer, settings: Asset.Material) {
    settings.unlit = true
    var strength = socket_value(node, "Strength", 0)
    settings.emissive_red = strength
    settings.emissive_green = strength
    settings.emissive_blue = strength
    var color = link_into(address, "Color")
    if color {
        var from = color.follow("fromnode")
        crash from
        var emission_color_is_an_image = from.text("idname") == "ShaderNodeTexImage"
        crash emission_color_is_an_image
        read_image_node(from, material)
        return
    }
    settings.base_red = socket_value(node, "Color", 0)
    settings.base_green = socket_value(node, "Color", 1)
    settings.base_blue = socket_value(node, "Color", 2)
}

func channel_of_image_output(link: Blend.View): Integer {
    var socket = link.follow("fromsock")
    crash socket
    if socket.text("identifier") == "Alpha" {
        return 3
    }
    return 0
}

func map_source(link: Blend.View): String {
    var from = link.follow("fromnode")
    crash from
    var kind = from.text("idname")
    if kind == "ShaderNodeTexImage" {
        found_channel = channel_of_image_output(link)
        return map_image(from)
    }
    var socket = link.follow("fromsock")
    crash socket
    var output = socket.text("identifier")
    var map_is_an_image_or_a_separated_channel = kind == "ShaderNodeSeparateColor" or kind == "ShaderNodeSeparateRGB"
    crash map_is_an_image_or_a_separated_channel
    var channel = 0
    if output == "Green" or output == "G" {
        channel = 1
    }
    if output == "Blue" or output == "B" {
        channel = 2
    }
    var input = "Color"
    if kind == "ShaderNodeSeparateRGB" {
        input = "Image"
    }
    var separator_address = link.pointer("fromnode")
    var source = link_into(separator_address, input)
    crash source
    var image = source.follow("fromnode")
    crash image
    var separated_channel_is_of_an_image = image.text("idname") == "ShaderNodeTexImage"
    crash separated_channel_is_of_an_image
    found_channel = channel
    return map_image(image)
}

func image_name(node: Blend.View): String {
    var image_address = node.pointer("id")
    var image_node_has_an_image = image_address != 0
    crash image_node_has_an_image
    var image = file.view_at(image_address)
    crash image
    var name = file.id_name(image)
    return name
}

func map_image(node: Blend.View): String {
    var name = image_name(node)
    if map_images.contains(name) {
        return name
    }
    map_images.append(name)
    var bytes = Asset.Bytes()
    var path = copy_image(node, bytes)
    map_image_bytes.append(bytes)
    map_image_paths.append(path)
    return name
}

func copy_image(node: Blend.View, bytes: Asset.Bytes): String {
    var image_address = node.pointer("id")
    var image = file.view_at(image_address)
    crash image
    file.enter(image)
    var packed_address = image.pointer("packedfile")
    if packed_address == 0 {
        var external = image.text("name")
        file.enter(material_view)
        return external
    }
    var packed = file.view_at(packed_address)
    crash packed
    var size = packed.integer("size")
    var data_address = packed.pointer("data")
    var data_offset = block_offset(data_address)
    var packed_data_is_in_the_file = data_offset >= 0
    crash packed_data_is_in_the_file
    bytes.write_bytes(file.bytes.address + data_offset, size)
    file.enter(material_view)
    return ""
}

func read_image_node(node: Blend.View, material: Integer) {
    crash images[material]
    var one_base_color = images[material].is_empty()
    crash one_base_color
    images[material] = image_name(node)
    crash image_bytes[material]
    image_paths[material] = copy_image(node, image_bytes[material])
}
