type Spotted {
    entity: Entity
    light: Lighting.Component.SpotLight
    transform: Transform.Component.Transform
}

var light = Scene.Light()
var lights = Scene.Lights()
var shadowing = Lookup<Lighting.Component.CastsShadows>()

func render_each(spotted: Spotted) {
    var spot = spotted.light
    var at = spotted.transform
    light.position_x = at.position_x
    light.position_y = at.position_y
    light.position_z = at.position_z
    light.range = spot.range
    var rotation = at.matrix()
    var forward = Vector3(0.0, 0.0, -1.0)
    var turned = rotation.transform_direction(forward)
    var axis = turned.normalized()
    light.toward_x = axis.x
    light.toward_y = axis.y
    light.toward_z = axis.z
    light.red = spot.red
    light.green = spot.green
    light.blue = spot.blue
    light.intensity = spot.intensity
    light.owner = spotted.entity.id
    light.casts_shadows = shadowing.has(spotted.entity.id)
    var cosine_inner = spot.inner_angle.cosine()
    var cosine_outer = spot.outer_angle.cosine()
    var spread = cosine_inner - cosine_outer
    if spread < 0.001 {
        spread = 0.001
    }
    light.cone_scale = 1.0 / spread
    light.cone_offset = 0.0 - cosine_outer * light.cone_scale
    lights.add(light)
}
