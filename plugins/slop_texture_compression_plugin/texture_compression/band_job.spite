var format = ""
var kind = 7
var width = 0
var rows = 0
var source_address: Long = 0

func BandJob(band_format: String, band_width: Integer, band_rows: Integer) {
    format = band_format
    width = band_width
    rows = band_rows
    if format == "bc1" {
        kind = 1
    } else if format == "bc3" {
        kind = 3
    } else if format == "bc4" {
        kind = 4
    } else if format == "bc5" {
        kind = 5
    }
}

func run(): Asset.Bytes {
    var encoder = TextureCompression.BlockEncoder()
    encoder.prepare()
    var across = (width + 3) / 4
    var down = (rows + 3) / 4
    var out = Asset.Bytes()
    var block_bytes = 16
    if kind == 1 or kind == 4 {
        block_bytes = 8
    }
    out.reserve(across * down * block_bytes + 16)
    var block_y = 0
    while block_y < down {
        var block_x = 0
        while block_x < across {
            encoder.gather(source_address, width, rows, block_x, block_y)
            encode_block(encoder, out)
            block_x = block_x + 1
        }
        block_y = block_y + 1
    }
    return out
}

func encode_block(encoder: TextureCompression.BlockEncoder, out: Asset.Bytes) {
    if kind == 1 {
        encoder.encode_color(out)
    } else if kind == 3 {
        encoder.encode_single(out, 3)
        encoder.encode_color(out)
    } else if kind == 4 {
        encoder.encode_single(out, 0)
    } else if kind == 5 {
        encoder.encode_single(out, 0)
        encoder.encode_single(out, 1)
    } else {
        encoder.encode_bc7(out)
    }
}
