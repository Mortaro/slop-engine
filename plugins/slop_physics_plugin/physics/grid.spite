var cell_size: Float = 4.0
var largest_cells = 256
var mask: UnsignedInteger = 15
var buckets = List<List<Physics.Collider>>()
var large = List<Physics.Collider>()
var total = 0
var first_column = 0
var last_column = 0
var first_row = 0
var last_row = 0

func cell_of(value: Float): Integer {
    var scaled = value / cell_size
    if scaled < -1000000.0 {
        return -1000000
    }
    if scaled > 1000000.0 {
        return 1000000
    }
    var whole: Integer = scaled
    if scaled < whole {
        return whole - 1
    }
    return whole
}

func bucket(column: Integer, row: Integer): Integer {
    var hashed_column = column.bits_as_unsigned()
    var hashed_row = row.bits_as_unsigned()
    var column_part = hashed_column.wrapping_multiply(73856093)
    var row_part = hashed_row.wrapping_multiply(19349663)
    var mixed = column_part.bits_exclusive_or(row_part)
    return mixed.bits_and(mask)
}

func span(lowest_x: Float, lowest_z: Float, highest_x: Float, highest_z: Float): Integer {
    first_column = cell_of(lowest_x)
    last_column = cell_of(highest_x)
    first_row = cell_of(lowest_z)
    last_row = cell_of(highest_z)
    var columns = last_column - first_column + 1
    var rows = last_row - first_row + 1
    if columns > 4096 or rows > 4096 {
        return 2000000000
    }
    return columns * rows
}

func span_of(collider: Physics.Collider): Integer {
    return span(collider.lowest_x, collider.lowest_z, collider.highest_x, collider.highest_z)
}

func build(colliders: List<Physics.Collider>) {
    large.clear()
    total = 0
    var index = 0
    while index < colliders.count() {
        var collider = colliders[index]
        var covered = span_of(collider)
        if covered > largest_cells {
            large.append(collider)
        } else {
            total = total + covered
        }
        index = index + 1
    }
    var size = 16
    while size < total * 2 {
        size = size * 2
    }
    mask = size - 1
    buckets.clear()
    var made = 0
    while made < size {
        var bucket_list = List<Physics.Collider>()
        buckets.append(bucket_list)
        made = made + 1
    }
    index = 0
    while index < colliders.count() {
        var collider = colliders[index]
        var covered = span_of(collider)
        if covered <= largest_cells {
            var row = first_row
            while row <= last_row {
                var column = first_column
                while column <= last_column {
                    var filled = bucket(column, row)
                    crash buckets[filled]
                    buckets[filled].append(collider)
                    column = column + 1
                }
                row = row + 1
            }
        }
        index = index + 1
    }
}

func gather(lowest_x: Float, lowest_z: Float, highest_x: Float, highest_z: Float, found: List<Physics.Collider>) {
    var large_index = 0
    while large_index < large.count() {
        note(large[large_index], found)
        large_index = large_index + 1
    }
    assert total != 0
    var covered = span(lowest_x, lowest_z, highest_x, highest_z)
    if covered > total {
        var every_bucket = 0
        while every_bucket < buckets.count() {
            var every = buckets[every_bucket]
            var each = 0
            while each < every.count() {
                note(every[each], found)
                each = each + 1
            }
            every_bucket = every_bucket + 1
        }
        return
    }
    var row = first_row
    while row <= last_row {
        var column = first_column
        while column <= last_column {
            var looked = bucket(column, row)
            crash buckets[looked]
            var entries = buckets[looked]
            var at = 0
            while at < entries.count() {
                note(entries[at], found)
                at = at + 1
            }
            column = column + 1
        }
        row = row + 1
    }
}

func note(collider: Physics.Collider, found: List<Physics.Collider>) {
    if not collider.gathered {
        collider.gathered = true
        found.append(collider)
    }
}
