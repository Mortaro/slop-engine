singleton

var solid = 1
var trigger = 2
var character = 4
var moving = 8
var all = List<Physics.Collider>()
var owned = List<List<Physics.Collider>>()
var characters = List<Physics.Collider?>()
var statics = List<Physics.Collider>()
var movers = List<Physics.Collider>()
var walkers = List<Physics.Collider>()
var triggers = List<Physics.Collider>()
var static_grid = Physics.Grid()
var moving_grid = Physics.Grid()
var character_grid = Physics.Grid()
var membership_changed = true
var statics_changed = true
var brute_force = false
var geometry = Physics.Geometry()
var candidates = List<Physics.Collider>()
var visited = List<Physics.Collider>()
var world = World()
var hit_owner = -1
var hit_fraction: Float = 0.0
var hit_normal_x: Float = 0.0
var hit_normal_y: Float = 0.0
var hit_normal_z: Float = 0.0
var hit_point_x: Float = 0.0
var hit_point_y: Float = 0.0
var hit_point_z: Float = 0.0
var penetration_depth: Float = 0.0
var penetration_x: Float = 0.0
var penetration_y: Float = 0.0
var penetration_z: Float = 0.0
var pair_triggers = List<Integer>()
var pair_visitors = List<Integer>()
var narrow_tests = 0

func configure(cell_size: Float) {
    static_grid.cell_size = cell_size
    moving_grid.cell_size = cell_size
    character_grid.cell_size = cell_size
    statics_changed = true
}

func flag_for(is_trigger: Boolean, is_kinematic: Boolean): Integer {
    var flag = solid
    if is_trigger {
        flag = trigger
    }
    if is_kinematic {
        flag = flag + moving
    }
    return flag
}

func count(): Integer {
    return all.count_alive()
}

func add(owner: Integer, flag: Integer): Physics.Collider {
    var made = Physics.Collider(owner, flag)
    all.append(made)
    membership_changed = true
    if made.has_flag(solid) and not made.has_flag(moving) {
        statics_changed = true
    }
    return made
}

func ensure_entity(entity: Integer) {
    while owned.count() <= entity {
        var held = List<Physics.Collider>()
        owned.append(held)
        characters.append(null)
    }
}

func own(entity: Integer, collider: Physics.Collider) {
    crash owned[entity]
    owned[entity].append(collider)
}

func build_primitive(
    built: Physics.Shape,
    transform: Transform.Component.Transform,
    box: Boolean,
    half_x: Float,
    half_y: Float,
    half_z: Float,
    radius: Float,
    length: Float,
) {
    if box {
        built.set_box_center(transform.position_x, transform.position_y, transform.position_z, half_x, half_y, half_z)
        built.set_rotation(transform.rotation_x, transform.rotation_y, transform.rotation_z, transform.rotation_w)
        return
    }
    built.set_rotation(transform.rotation_x, transform.rotation_y, transform.rotation_z, transform.rotation_w)
    var up_x = built.axis_y_x * length
    var up_y = built.axis_y_y * length
    var up_z = built.axis_y_z * length
    built.set_capsule(
        transform.position_x - up_x,
        transform.position_y - up_y,
        transform.position_z - up_z,
        transform.position_x + up_x,
        transform.position_y + up_y,
        transform.position_z + up_z,
        radius,
    )
}

func place_primitive(
    entity: Integer,
    transform: Transform.Component.Transform,
    box: Boolean,
    half_x: Float,
    half_y: Float,
    half_z: Float,
    radius: Float,
    length: Float,
    flag: Integer,
) {
    forget(entity)
    ensure_entity(entity)
    var collider = add(entity, flag)
    own(entity, collider)
    var built = Physics.Shape()
    build_primitive(built, transform, box, half_x, half_y, half_z, radius, length)
    collider.store(built, length, 0.0)
}

func place_box(
    entity: Integer,
    transform: Transform.Component.Transform,
    half_x: Float,
    half_y: Float,
    half_z: Float,
    flag: Integer,
) {
    place_primitive(entity, transform, true, half_x, half_y, half_z, 0.0, 0.0, flag)
}

func place_sphere(entity: Integer, transform: Transform.Component.Transform, radius: Float, flag: Integer) {
    place_primitive(entity, transform, false, 0.0, 0.0, 0.0, radius, 0.0, flag)
}

func place_capsule(
    entity: Integer,
    transform: Transform.Component.Transform,
    radius: Float,
    half_height: Float,
    flag: Integer,
) {
    place_primitive(entity, transform, false, 0.0, 0.0, 0.0, radius, half_height, flag)
}

func place_mesh(entity: Integer, transform: Transform.Component.Transform, mesh: Physics.TriangleMesh) {
    forget(entity)
    ensure_entity(entity)
    var matrix = transform.matrix()
    var triangle = 0
    var corners = mesh.indices.count() / 3
    while triangle < corners {
        var base = triangle * 3
        crash base + 2 < mesh.indices.count()
        var first_corner = mesh.indices[base] * 3
        var second_corner = mesh.indices[base + 1] * 3
        var third_corner = mesh.indices[base + 2] * 3
        crash first_corner + 2 < mesh.positions.count()
        crash second_corner + 2 < mesh.positions.count()
        crash third_corner + 2 < mesh.positions.count()
        var source_a = Vector3(
            mesh.positions[first_corner],
            mesh.positions[first_corner + 1],
            mesh.positions[first_corner + 2],
        )
        var corner_a = matrix.transform_point(source_a)
        var source_b = Vector3(
            mesh.positions[second_corner],
            mesh.positions[second_corner + 1],
            mesh.positions[second_corner + 2],
        )
        var corner_b = matrix.transform_point(source_b)
        var source_c = Vector3(
            mesh.positions[third_corner],
            mesh.positions[third_corner + 1],
            mesh.positions[third_corner + 2],
        )
        var corner_c = matrix.transform_point(source_c)
        var built = Physics.Shape()
        built.set_triangle(
            corner_a.x,
            corner_a.y,
            corner_a.z,
            corner_b.x,
            corner_b.y,
            corner_b.z,
            corner_c.x,
            corner_c.y,
            corner_c.z,
        )
        var collider = add(entity, solid)
        own(entity, collider)
        collider.store(built, 0.0, 0.0)
        triangle = triangle + 1
    }
}

func build_character(built: Physics.Shape, transform: Transform.Component.Transform, radius: Float, height: Float) {
    var top = transform.position_y + height - radius
    var bottom = transform.position_y + radius
    if top < bottom {
        top = bottom
    }
    built.set_capsule(
        transform.position_x,
        bottom,
        transform.position_z,
        transform.position_x,
        top,
        transform.position_z,
        radius,
    )
}

func place_character(entity: Integer, transform: Transform.Component.Transform, radius: Float, height: Float) {
    forget_character(entity)
    ensure_entity(entity)
    var collider = add(entity, character + moving)
    characters[entity] = collider
    var built = Physics.Shape()
    build_character(built, transform, radius, height)
    collider.store(built, 0.0, height)
}

func forget(entity: Integer) {
    assert entity < owned.count()
    var colliders = owned[entity]
    assert colliders.count() > 0
    colliders.each(kill)
    colliders.clear()
}

func forget_character(entity: Integer) {
    assert entity < characters.count()
    var collider = characters[entity]
    assert collider
    kill(collider)
    characters[entity] = null
}

func kill(collider: Physics.Collider) {
    if collider.has_flag(solid) and not collider.has_flag(moving) {
        statics_changed = true
    }
    collider.alive = false
    collider.flag = 0
    membership_changed = true
}

func move(entity: Integer, transform: Transform.Component.Transform) {
    assert entity < owned.count()
    var colliders = owned[entity]
    assert colliders.count() > 0
    var collider = colliders[0]
    var shape = collider.shape
    assert shape.kind != 2
    var built = Physics.Shape()
    build_primitive(
        built,
        transform,
        shape.kind == 1,
        shape.half_x,
        shape.half_y,
        shape.half_z,
        shape.radius,
        collider.length,
    )
    collider.store(built, collider.length, 0.0)
    if not collider.has_flag(moving) {
        statics_changed = true
    }
}

func move_character(entity: Integer, transform: Transform.Component.Transform) {
    assert entity < characters.count()
    var collider = characters[entity]
    assert collider
    var shape = collider.shape
    var radius = shape.radius
    var height = collider.height
    var bottom = transform.position_y + radius
    var top = greater(transform.position_y + height - radius, bottom)
    shape.first_x = transform.position_x
    shape.first_y = bottom
    shape.first_z = transform.position_z
    shape.second_x = transform.position_x
    shape.second_y = top
    shape.second_z = transform.position_z
    collider.lowest_x = transform.position_x - radius
    collider.lowest_y = bottom - radius
    collider.lowest_z = transform.position_z - radius
    collider.highest_x = transform.position_x + radius
    collider.highest_y = top + radius
    collider.highest_z = transform.position_z + radius
}

func prepare() {
    if membership_changed {
        sort_membership()
    }
    if statics_changed {
        static_grid.build(statics)
        statics_changed = false
    }
    moving_grid.build(movers)
    if triggers.count() > 0 {
        character_grid.build(walkers)
    }
}

func ensure_prepared() {
    if membership_changed or statics_changed {
        prepare()
    }
}

func sort_membership() {
    var living = List<Physics.Collider>()
    statics.clear()
    movers.clear()
    walkers.clear()
    triggers.clear()
    var index = 0
    while index < all.count() {
        var collider = all[index]
        if collider.alive {
            living.append(collider)
            if collider.has_flag(trigger) {
                triggers.append(collider)
            } else if collider.has_flag(character) {
                walkers.append(collider)
            } else if collider.has_flag(moving) {
                movers.append(collider)
            } else if collider.has_flag(solid) {
                statics.append(collider)
            }
        }
        index = index + 1
    }
    all = living
    membership_changed = false
}

func collect(lowest_x: Float, lowest_z: Float, highest_x: Float, highest_z: Float) {
    if brute_force {
        var index = 0
        while index < all.count() {
            var collider = all[index]
            if collider.alive and not collider.gathered {
                collider.gathered = true
                candidates.append(collider)
            }
            index = index + 1
        }
        return
    }
    static_grid.gather(lowest_x, lowest_z, highest_x, highest_z, candidates)
    moving_grid.gather(lowest_x, lowest_z, highest_x, highest_z, candidates)
}

func set_aside_candidates() {
    var index = 0
    while index < candidates.count() {
        visited.append(candidates[index])
        index = index + 1
    }
    candidates.clear()
}

func forget_candidates() {
    set_aside_candidates()
    var index = 0
    while index < visited.count() {
        visited[index].gathered = false
        index = index + 1
    }
    visited.clear()
}

func nearest(
    start_x: Float,
    start_y: Float,
    start_z: Float,
    end_x: Float,
    end_y: Float,
    end_z: Float,
    radius: Float,
    motion_x: Float,
    motion_y: Float,
    motion_z: Float,
    ignored: Integer,
): Boolean {
    ensure_prepared()
    var length_squared = motion_x * motion_x + motion_y * motion_y + motion_z * motion_z
    var length = length_squared.square_root()
    var pieces: Integer = clamped(length / static_grid.cell_size, 0.0, 100000.0)
    pieces = pieces + 1
    if brute_force {
        pieces = 1
    }
    var best: Float = 1.0
    var found = false
    var local_end_x = end_x - start_x
    var local_end_y = end_y - start_y
    var local_end_z = end_z - start_z
    var reach = radius + geometry.tolerance
    var whole_lowest_x = lesser(start_x, end_x) + lesser(motion_x, 0.0) - reach
    var whole_lowest_y = lesser(start_y, end_y) + lesser(motion_y, 0.0) - reach
    var whole_lowest_z = lesser(start_z, end_z) + lesser(motion_z, 0.0) - reach
    var whole_highest_x = greater(start_x, end_x) + greater(motion_x, 0.0) + reach
    var whole_highest_y = greater(start_y, end_y) + greater(motion_y, 0.0) + reach
    var whole_highest_z = greater(start_z, end_z) + greater(motion_z, 0.0) + reach
    var piece = 0
    while piece < pieces {
        var from: Float = piece
        from = from / pieces
        var to: Float = piece + 1
        to = to / pieces
        if found and best < from {
            forget_candidates()
            return true
        }
        var lowest_x = lesser(start_x, end_x) + lesser(motion_x, 0.0) * to + greater(motion_x, 0.0) * from - reach
        var lowest_z = lesser(start_z, end_z) + lesser(motion_z, 0.0) * to + greater(motion_z, 0.0) * from - reach
        var highest_x = greater(start_x, end_x) + greater(motion_x, 0.0) * to + lesser(motion_x, 0.0) * from + reach
        var highest_z = greater(start_z, end_z) + greater(motion_z, 0.0) * to + lesser(motion_z, 0.0) * from + reach
        set_aside_candidates()
        collect(lowest_x, lowest_z, highest_x, highest_z)
        var index = 0
        while index < candidates.count() {
            var collider = candidates[index]
            var touches = collider.touches(
                whole_lowest_x,
                whole_lowest_y,
                whole_lowest_z,
                whole_highest_x,
                whole_highest_y,
                whole_highest_z,
            )
            if touches and collider.has_flag(solid) and collider.owner != ignored {
                var target = collider.seen_from(start_x, start_y, start_z)
                narrow_tests = narrow_tests + 1
                var hit = geometry.sweep(
                    target,
                    0.0,
                    0.0,
                    0.0,
                    local_end_x,
                    local_end_y,
                    local_end_z,
                    radius,
                    motion_x,
                    motion_y,
                    motion_z,
                    best,
                )
                if hit and (not found or geometry.fraction < best) {
                    found = true
                    best = geometry.fraction
                    keep_hit(collider, start_x, start_y, start_z)
                }
            }
            index = index + 1
        }
        piece = piece + 1
    }
    forget_candidates()
    return found
}

func keep_hit(collider: Physics.Collider, origin_x: Float, origin_y: Float, origin_z: Float) {
    hit_owner = collider.owner
    hit_fraction = geometry.fraction
    hit_normal_x = geometry.normal_x
    hit_normal_y = geometry.normal_y
    hit_normal_z = geometry.normal_z
    hit_point_x = geometry.point_x + origin_x
    hit_point_y = geometry.point_y + origin_y
    hit_point_z = geometry.point_z + origin_z
}

func fill_hit(hit: Physics.Hit, length: Float) {
    hit.entity = world.entity_of(hit_owner)
    hit.distance = hit_fraction * length
    hit.point_x = hit_point_x
    hit.point_y = hit_point_y
    hit.point_z = hit_point_z
    hit.normal_x = hit_normal_x
    hit.normal_y = hit_normal_y
    hit.normal_z = hit_normal_z
}

func raycast(
    origin_x: Float,
    origin_y: Float,
    origin_z: Float,
    direction_x: Float,
    direction_y: Float,
    direction_z: Float,
    maximum_distance: Float,
    hit: Physics.Hit,
): Boolean {
    return sweep_capsule(
        origin_x,
        origin_y,
        origin_z,
        origin_x,
        origin_y,
        origin_z,
        0.0,
        direction_x,
        direction_y,
        direction_z,
        maximum_distance,
        hit,
    )
}

func sweep_sphere(
    center_x: Float,
    center_y: Float,
    center_z: Float,
    radius: Float,
    direction_x: Float,
    direction_y: Float,
    direction_z: Float,
    maximum_distance: Float,
    hit: Physics.Hit,
): Boolean {
    return sweep_capsule(
        center_x,
        center_y,
        center_z,
        center_x,
        center_y,
        center_z,
        radius,
        direction_x,
        direction_y,
        direction_z,
        maximum_distance,
        hit,
    )
}

func sweep_capsule(
    start_x: Float,
    start_y: Float,
    start_z: Float,
    end_x: Float,
    end_y: Float,
    end_z: Float,
    radius: Float,
    direction_x: Float,
    direction_y: Float,
    direction_z: Float,
    maximum_distance: Float,
    hit: Physics.Hit,
): Boolean {
    var length_squared_2 = direction_x * direction_x + direction_y * direction_y + direction_z * direction_z
    var length = length_squared_2.square_root()
    if length <= 0.0 or maximum_distance <= 0.0 {
        return false
    }
    var scale = maximum_distance / length
    var found = nearest(
        start_x,
        start_y,
        start_z,
        end_x,
        end_y,
        end_z,
        radius,
        direction_x * scale,
        direction_y * scale,
        direction_z * scale,
        -1,
    )
    if found {
        fill_hit(hit, maximum_distance)
    }
    return found
}

func deepest_overlap(
    start_x: Float,
    start_y: Float,
    start_z: Float,
    end_x: Float,
    end_y: Float,
    end_z: Float,
    radius: Float,
    ignored: Integer,
): Boolean {
    ensure_prepared()
    var lowest_x = lesser(start_x, end_x) - radius
    var lowest_y = lesser(start_y, end_y) - radius
    var lowest_z = lesser(start_z, end_z) - radius
    var highest_x = greater(start_x, end_x) + radius
    var highest_y = greater(start_y, end_y) + radius
    var highest_z = greater(start_z, end_z) + radius
    forget_candidates()
    collect(lowest_x, lowest_z, highest_x, highest_z)
    penetration_depth = 0.0
    var found = false
    var index = 0
    while index < candidates.count() {
        var collider = candidates[index]
        var touches = collider.touches(lowest_x, lowest_y, lowest_z, highest_x, highest_y, highest_z)
        if touches and collider.has_flag(solid) and collider.owner != ignored {
            var target = collider.seen_from(start_x, start_y, start_z)
            var squared = geometry.squared_distance_to(
                target,
                0.0,
                0.0,
                0.0,
                end_x - start_x,
                end_y - start_y,
                end_z - start_z,
            )
            var distance = squared.square_root()
            var depth = radius + target.radius - distance
            if depth > penetration_depth and distance > 0.000001 {
                found = true
                penetration_depth = depth
                penetration_x = (geometry.on_query_x - geometry.on_target_x) / distance
                penetration_y = (geometry.on_query_y - geometry.on_target_y) / distance
                penetration_z = (geometry.on_query_z - geometry.on_target_z) / distance
            }
        }
        index = index + 1
    }
    forget_candidates()
    return found
}

func find_trigger_overlaps() {
    ensure_prepared()
    pair_triggers.clear()
    pair_visitors.clear()
    triggers.each(overlaps_of_trigger)
}

func overlaps_of_trigger(collider: Physics.Collider) {
    var lowest_x = collider.lowest_x
    var lowest_y = collider.lowest_y
    var lowest_z = collider.lowest_z
    var highest_x = collider.highest_x
    var highest_y = collider.highest_y
    var highest_z = collider.highest_z
    var probe = collider.seen_from(lowest_x, lowest_y, lowest_z)
    var owner = collider.owner
    forget_candidates()
    if brute_force {
        collect(lowest_x, lowest_z, highest_x, highest_z)
    } else {
        moving_grid.gather(lowest_x, lowest_z, highest_x, highest_z, candidates)
        character_grid.gather(lowest_x, lowest_z, highest_x, highest_z, candidates)
    }
    var index = 0
    while index < candidates.count() {
        var visitor = candidates[index]
        var touches = visitor.touches(lowest_x, lowest_y, lowest_z, highest_x, highest_y, highest_z)
        if touches and visitor.has_flag(moving) and not visitor.has_flag(trigger) and visitor.owner != owner {
            var target = visitor.seen_from(lowest_x, lowest_y, lowest_z)
            if geometry.overlaps(probe, target) {
                pair_triggers.append(owner)
                pair_visitors.append(visitor.owner)
            }
        }
        index = index + 1
    }
    forget_candidates()
}

func lesser(first: Float, second: Float): Float {
    if second < first {
        return second
    }
    return first
}

func greater(first: Float, second: Float): Float {
    if second > first {
        return second
    }
    return first
}

func clamped(value: Float, low: Float, high: Float): Float {
    if value < low {
        return low
    }
    if value > high {
        return high
    }
    return value
}
