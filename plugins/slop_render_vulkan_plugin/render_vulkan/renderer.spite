    creation.append_integer(0)
    creation.append_long(0)
    var created = Structure(8)
    var no_allocator: Long = 0
    var result = vulkan.vkCreateBuffer(device, creation.address, no_allocator, created.address)
    crash result == 0
    return created.read_long(0)
}

func device_memory_for(buffer: Long): Long {
    var requirements = Structure(24)
    vulkan.vkGetBufferMemoryRequirements(device, buffer, requirements.address)
    var device_local = 1
    var buffer_memory = allocate_memory(requirements, device_local)
    var no_offset: Long = 0
    var result = vulkan.vkBindBufferMemory(device, buffer, buffer_memory, no_offset)
    crash result == 0
    return buffer_memory
}

func staging_room(): Integer {
    return upload_budget_bytes - frame_staged
}

func stage(source: Long, count: Integer): Integer {
    var fits = count > 0 and count <= staging_room()
    crash fits
    var offset = frame_staged
    raw.copy(source, frame.staging_mapped + offset, count)
    frame_staged = frame_staged + count
    return offset
}

func release_later(buffer: Long, buffer_memory: Long) {
    frame.in_flight_stagings.append(buffer)
    frame.in_flight_staging_memories.append(buffer_memory)
}

func host_memory_for(buffer: Long): Long {
    var requirements = Structure(24)
    vulkan.vkGetBufferMemoryRequirements(device, buffer, requirements.address)
    var host_visible_and_coherent = 6
    var buffer_memory = allocate_memory(requirements, host_visible_and_coherent)
    var no_offset: Long = 0
    var result = vulkan.vkBindBufferMemory(device, buffer, buffer_memory, no_offset)
    crash result == 0
    return buffer_memory
}

func map(buffer_memory: Long, bytes: Integer): Long {
    var mapped = Structure(8)
    var no_offset: Long = 0
    var size: Long = bytes
    var result = vulkan.vkMapMemory(device, buffer_memory, no_offset, size, 0, mapped.address)
    crash result == 0
    return mapped.read_long(0)
}

func ensure_rectangle_capacity(count: Integer, stride: Integer) {
    assert count >= frame.rectangle_capacity
    release_rectangle_buffer()
    frame.rectangle_capacity = count * 2
    if frame.rectangle_capacity < 1024 {
        frame.rectangle_capacity = 1024
    }
    var bytes = frame.rectangle_capacity * stride
    var vertex_buffer_usage = 128
    frame.rectangle_buffer = create_buffer(bytes, vertex_buffer_usage)
    frame.rectangle_memory = host_memory_for(frame.rectangle_buffer)
    frame.rectangle_mapped = map(frame.rectangle_memory, bytes)
}

func release_rectangle_buffer() {
    var no_allocator: Long = 0
    assert frame.rectangle_buffer != 0
    vulkan.vkDestroyBuffer(device, frame.rectangle_buffer, no_allocator)
    vulkan.vkFreeMemory(device, frame.rectangle_memory, no_allocator)
    frame.rectangle_buffer = 0
}

