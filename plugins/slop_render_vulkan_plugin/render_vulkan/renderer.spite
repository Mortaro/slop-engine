    return created.read_long(0)
}

func level_barrier(
    image: Long,
    source_access: Integer,
    destination_access: Integer,
    old_layout: Integer,
    new_layout: Integer,
    source_stage: Integer,
    destination_stage: Integer,
    first_level: Integer,
    level_count: Integer,
) {
    var description = Structure(72)
    description.append_integer(45)
    description.append_long(0)
    description.append_integer(source_access)
    description.append_integer(destination_access)
    description.append_integer(old_layout)
    description.append_integer(new_layout)
    description.append_integer(-1)
    description.append_integer(-1)
    description.append_long(image)
    description.append_integer(1)
    description.append_integer(first_level)
    description.append_integer(level_count)
    description.append_integer(0)
    description.append_integer(1)
    var no_barriers: Long = 0
    vulkan.vkCmdPipelineBarrier(
        frame.command_buffer,
        source_stage,
        destination_stage,
        0,
        0,
        no_barriers,
        0,
        no_barriers,
        1,
        description.address,
    )
}

func append_color_range(structure: RenderVulkan.Structure) {
    structure.append_integer(1)
    structure.append_integer(0)
    structure.append_integer(1)
    structure.append_integer(0)
    structure.append_integer(1)
}

func create_readback() {
    frame.readback_bytes = frame.target_width * frame.target_height * 4
    var transfer_destination = 2
    frame.readback_buffer = create_buffer(frame.readback_bytes, transfer_destination)
    frame.readback_memory = host_memory_for(frame.readback_buffer)
    frame.readback_mapped = map(frame.readback_memory, frame.readback_bytes)
}

func release_target() {
    var no_allocator: Long = 0
    assert frame.target_image != 0
    vulkan.vkDestroyImageView(device, frame.target_view, no_allocator)
    vulkan.vkDestroyImage(device, frame.target_image, no_allocator)
    vulkan.vkFreeMemory(device, frame.target_memory, no_allocator)
    vulkan.vkDestroyBuffer(device, frame.readback_buffer, no_allocator)
    vulkan.vkFreeMemory(device, frame.readback_memory, no_allocator)
    frame.target_image = 0
}

func barrier(
    image: Long,
    source_access: Integer,
    destination_access: Integer,
    old_layout: Integer,
    new_layout: Integer,
    source_stage: Integer,
    destination_stage: Integer,
) {
    var description = Structure(72)
    description.append_integer(45)
    description.append_long(0)
    description.append_integer(source_access)
    description.append_integer(destination_access)
    description.append_integer(old_layout)
    description.append_integer(new_layout)
    description.append_integer(-1)
    description.append_integer(-1)
    description.append_long(image)
    append_color_range(description)
    var no_barriers: Long = 0
    vulkan.vkCmdPipelineBarrier(
        frame.command_buffer,
        source_stage,
        destination_stage,
        0,
        0,
        no_barriers,
        0,
        no_barriers,
        1,
        description.address,
    )
}

func record_rectangles(draw_list: Render.Component.DrawList) {
    ensure_target(draw_list.width, draw_list.height)
    var stride = draw_list.stride()
    ensure_rectangle_capacity(draw_list.count, stride)
    var bytes = draw_list.count * stride
    var rectangles_fit = draw_list.count <= frame.rectangle_capacity
    crash rectangles_fit
    raw.copy(draw_list.rectangles, frame.rectangle_mapped, bytes)
    var timing = gpu_timings.begin("ui")
    var load_operation = 0
    if not frame.scene_drawn {
        barrier(frame.target_image, 0, 256, 0, 2, 1, 1024)
        load_operation = 1
    }
    var attachment = Structure(72)
    attachment.append_integer(1000044001)
    attachment.append_long(0)
    attachment.append_long(frame.target_view)
    attachment.append_integer(2)
    attachment.append_integer(0)
    attachment.append_long(0)
    attachment.append_integer(0)
    attachment.append_integer(load_operation)
    attachment.append_integer(0)
    append_clear_color(attachment, draw_list.clear_color)
    var rendering = Structure(80)
    rendering.append_integer(1000044000)
    rendering.append_long(0)
    rendering.append_integer(0)
    rendering.append_integer(0)
    rendering.append_integer(0)
    rendering.append_integer(frame.target_width)
    rendering.append_integer(frame.target_height)
    rendering.append_integer(1)
    rendering.append_integer(0)
    rendering.append_integer(1)
    rendering.append_pointer(attachment)
    rendering.append_long(0)
    rendering.append_long(0)
    vulkan.vkCmdBeginRendering(frame.command_buffer, rendering.address)
    vulkan.vkCmdBindPipeline(frame.command_buffer, 0, pipeline)
    record_viewport()
    var buffers = Structure(8)
    buffers.append_long(frame.rectangle_buffer)
    var offsets = Structure(8)
    offsets.append_long(0)
    vulkan.vkCmdBindVertexBuffers(frame.command_buffer, 0, 1, buffers.address, offsets.address)
    var first = 0
    while first < draw_list.count {
        first = record_run(draw_list, first)
    }
    vulkan.vkCmdEndRendering(frame.command_buffer)
    gpu_timings.end(timing)
    barrier(frame.target_image, 256, 2048, 2, 6, 1024, 4096)
}

func record_run(draw_list: Render.Component.DrawList, first: Integer): Integer {
    var texture = draw_list.texture_at(first)
    var last = first + 1
    while last < draw_list.count and draw_list.texture_at(last) == texture {
        last = last + 1
    }
    var set = texture_set(texture)
    if set == 0 {
        return last
    }
    var sets = Structure(8)
    sets.append_long(set)
    var no_offsets: Long = 0
    vulkan.vkCmdBindDescriptorSets(frame.command_buffer, 0, pipeline_layout, 0, 1, sets.address, 0, no_offsets)
    var count = last - first
    vulkan.vkCmdDraw(frame.command_buffer, 6, count, 0, first)
    return last
}

func append_clear_color(structure: RenderVulkan.Structure, color: Integer) {
    var red: Float = color / 65536 % 256
    var green: Float = color / 256 % 256
    var blue: Float = color % 256
    structure.append_float(red / 255.0)
    structure.append_float(green / 255.0)
    structure.append_float(blue / 255.0)
    structure.append_float(1.0)
}

func record_viewport() {
    var viewport = Structure(24)
    viewport.append_float(0.0)
    viewport.append_float(0.0)
    viewport.append_float(frame.target_width)
    viewport.append_float(frame.target_height)
    viewport.append_float(0.0)
    viewport.append_float(1.0)
    vulkan.vkCmdSetViewport(frame.command_buffer, 0, 1, viewport.address)
    var scissor = Structure(16)
    scissor.append_integer(0)
    scissor.append_integer(0)
    scissor.append_integer(frame.target_width)
    scissor.append_integer(frame.target_height)
    vulkan.vkCmdSetScissor(frame.command_buffer, 0, 1, scissor.address)
    var size = Structure(8)
    size.append_float(frame.target_width)
    size.append_float(frame.target_height)
    vulkan.vkCmdPushConstants(frame.command_buffer, pipeline_layout, 1, 0, 8, size.address)
}

func begin_commands() {
    vulkan.vkResetCommandBuffer(frame.command_buffer, 0)
    var begin = Structure(32)
    begin.append_integer(42)
    begin.append_long(0)
    begin.append_integer(1)
    begin.append_long(0)
    var result = vulkan.vkBeginCommandBuffer(frame.command_buffer, begin.address)
    crash result == 0
    var slot = (frame_number - 1) % frames_in_flight
    gpu_timings.start(frame.command_buffer, slot)
    frame_timing = gpu_timings.begin("frame")
}

func submit(wait_for_image: Boolean, frame_done: Long) {
    gpu_timings.end(frame_timing)
    frame_timing = -1
    var end_result = vulkan.vkEndCommandBuffer(frame.command_buffer)
    crash end_result == 0
    var buffers = Structure(8)
    buffers.append_long(frame.command_buffer)
    var waits = Structure(8)
    waits.append_long(frame.image_ready)
    var wait_stages = Structure(4)
    wait_stages.append_integer(4096)
    var signals = Structure(8)
    signals.append_long(frame_done)
    var semaphore_count = 0
    if wait_for_image {
        semaphore_count = 1
    }
    var submission = Structure(80)
    submission.append_integer(4)
    submission.append_long(0)
    submission.append_integer(semaphore_count)
    submission.append_pointer(waits)
    submission.append_pointer(wait_stages)
    submission.append_integer(1)
    submission.append_pointer(buffers)
    submission.append_integer(semaphore_count)
    submission.append_pointer(signals)
    var result = vulkan.vkQueueSubmit(queue, 1, submission.address, frame.fence)
    crash result == 0
}

func draw_offscreen(draw_list: Render.Component.DrawList, textures: Render.Textures) {
    while not pipeline_ready() {
        offscreen_program.sleep(1)
    }
    while uploads_pending(textures) {
        upload_only_frame(textures)
    }
    begin_frame()
    begin_commands()
    record_uploads()
    record_rectangles(draw_list)
    record_capture()
    var no_semaphore: Long = 0
    submit(false, no_semaphore)
    wait_frame()
}

func upload_only_frame(textures: Render.Textures) {
    begin_frame()
    begin_commands()
    record_uploads()
    stream_textures(textures)
    var no_semaphore: Long = 0
    submit(false, no_semaphore)
    wait_frame()
}

func record_capture() {
    var region = Structure(56)
    region.append_long(0)
    region.append_integer(0)
    region.append_integer(0)
    region.append_integer(1)
    region.append_integer(0)
    region.append_integer(0)
    region.append_integer(1)
    region.append_integer(0)
    region.append_integer(0)
    region.append_integer(0)
    region.append_integer(frame.target_width)
    region.append_integer(frame.target_height)
    region.append_integer(1)
    vulkan.vkCmdCopyImageToBuffer(frame.command_buffer, frame.target_image, 6, frame.readback_buffer, 1, region.address)
}

func pixel_at(left: Integer, top: Integer): Integer {
    if left < 0 or top < 0 or left >= frame.target_width or top >= frame.target_height {
        return 0
    }
    var offset = (top * frame.target_width + left) * 4
    var pixel: Long = raw.read_integer(frame.readback_mapped, offset)
    if pixel < 0 {
        pixel = pixel + 4294967296
    }
    return pixel % 16777216
}

func create_swapchain(window: Window.Component.Window, handle: Long, swapchain: RenderVulkan.Component.Swapchain) {
    var no_allocator: Long = 0
    var no_module: Long = 0
    var module_handle = kernel.GetModuleHandleA_as_long(no_module)
    var surface_creation = Structure(40)
    surface_creation.append_integer(1000009000)
    surface_creation.append_long(0)
    surface_creation.append_integer(0)
    surface_creation.append_long(module_handle)
    surface_creation.append_long(handle)
    var created = Structure(8)
    var surface_result = vulkan.vkCreateWin32SurfaceKHR(
        instance,
        surface_creation.address,
        no_allocator,
        created.address,
    )
    crash surface_result == 0
    swapchain.surface = created.read_long(0)
    var presented = RenderVulkan.Presentation()
    presented.surface = swapchain.surface
    presentations.append(presented)
    var supported = Structure(8)
    vulkan.vkGetPhysicalDeviceSurfaceSupportKHR(physical_device, queue_family, swapchain.surface, supported.address)
    crash supported.read_integer(0) == 1
    var no_old: Long = 0
    build_swapchain(swapchain, window.width, window.height, no_old)
}

func build_swapchain(swapchain: RenderVulkan.Component.Swapchain, width: Integer, height: Integer, old: Long) {
    var no_allocator: Long = 0
    var created = Structure(8)
    swapchain.width = width
    swapchain.height = height
    var mode = present_mode(swapchain.surface)
    var capabilities = Structure(56)
    vulkan.vkGetPhysicalDeviceSurfaceCapabilitiesKHR(physical_device, swapchain.surface, capabilities.address)
    var image_count = capabilities.read_integer(0) + 1
    var current_transform = capabilities.read_integer(40)
    var creation = Structure(112)
    creation.append_integer(1000001000)
    creation.append_long(0)
    creation.append_integer(0)
    creation.append_long(swapchain.surface)
    creation.append_integer(image_count)
    creation.append_integer(44)
    creation.append_integer(0)
    creation.append_integer(swapchain.width)
    creation.append_integer(swapchain.height)
    creation.append_integer(1)
    creation.append_integer(18)
    creation.append_integer(0)
    creation.append_integer(0)
    creation.append_long(0)
    creation.append_integer(current_transform)
    creation.append_integer(1)
    creation.append_integer(mode)
    creation.append_integer(1)
    creation.append_long(old)
    var result = vulkan.vkCreateSwapchainKHR(device, creation.address, no_allocator, created.address)
    crash result == 0
    swapchain.handle = created.read_long(0)
    var presented = presentation_of(swapchain)
    presented.swapchain = swapchain.handle
    read_swapchain_images(swapchain, presented)
}

func present_mode(surface: Long): Integer {
    var count = Structure(8)
    var no_modes: Long = 0
    vulkan.vkGetPhysicalDeviceSurfacePresentModesKHR(physical_device, surface, count.address, no_modes)
    var mode_count = count.read_integer(0)
    var modes = Structure(mode_count * 4 + 4)
    vulkan.vkGetPhysicalDeviceSurfacePresentModesKHR(physical_device, surface, count.address, modes.address)
    var index = 0
    var mailbox = 1
    var chosen = 2
    while index < mode_count {
        if modes.read_integer(index * 4) == mailbox {
            chosen = mailbox
        }
        index = index + 1
    }
    return chosen
}

func read_swapchain_images(swapchain: RenderVulkan.Component.Swapchain, presented: RenderVulkan.Presentation) {
    var count = Structure(8)
    var no_images: Long = 0
    vulkan.vkGetSwapchainImagesKHR(device, swapchain.handle, count.address, no_images)
    var image_count = count.read_integer(0)
    var images = Structure(image_count * 8)
    vulkan.vkGetSwapchainImagesKHR(device, swapchain.handle, count.address, images.address)
    presented.images.clear()
    var index = 0
    while index < image_count {
        var image = images.read_long(index * 8)
        presented.images.append(image)
        if index >= presented.frames_done.count() {
            var frame_done = create_semaphore()
            presented.frames_done.append(frame_done)
        }
        index = index + 1
    }
}

func presentation_of(swapchain: RenderVulkan.Component.Swapchain): RenderVulkan.Presentation {
    var index = 0
    while index < presentations.count() {
        var presented = presentations[index]
        if presented.surface == swapchain.surface {
            return presented
        }
        index = index + 1
    }
    var a_swapchain_is_built_on_a_surface_this_renderer_made = false
    crash a_swapchain_is_built_on_a_surface_this_renderer_made
    return RenderVulkan.Presentation()
}

func refresh_swapchain(window: Window.Component.Window, swapchain: RenderVulkan.Component.Swapchain) {
    vulkan.vkDeviceWaitIdle(device)
    var old = swapchain.handle
    build_swapchain(swapchain, window.width, window.height, old)
    var no_allocator: Long = 0
    vulkan.vkDestroySwapchainKHR(device, old, no_allocator)
}

func signal_skipped_frame() {
    var no_submits: Long = 0
    var submitted = vulkan.vkQueueSubmit(queue, 0, no_submits, frame.fence)
    crash submitted == 0
}

func begin_window_frame(
    draw_list: Render.Component.DrawList,
    textures: Render.Textures,
    swapchain: RenderVulkan.Component.Swapchain,
): Boolean {
    begin_frame()
    var chosen = Structure(8)
    var forever: Long = -1
    var no_fence: Long = 0
    var acquired = vulkan.vkAcquireNextImageKHR(
        device,
        swapchain.handle,
        forever,
        frame.image_ready,
        no_fence,
        chosen.address,
    )
    if acquired == -1000001004 {
        signal_skipped_frame()
        return false
    }
    crash acquired == 0 or acquired == 1000001003
    swapchain.acquired = chosen.read_integer(0)
    begin_commands()
    record_uploads()
    stream_textures(textures)
    ensure_target(draw_list.width, draw_list.height)
    frame.scene_drawn = false
    return true
}

func finish_window_frame(
    draw_list: Render.Component.DrawList,
    swapchain: RenderVulkan.Component.Swapchain,
    capture: Boolean,
): Boolean {
    var image_index = swapchain.acquired
    swapchain.acquired = -1
    var presented = presentation_of(swapchain)
    crash presented.images[image_index]
    var image = presented.images[image_index]
    crash presented.frames_done[image_index]
    var frame_done = presented.frames_done[image_index]
    record_rectangles(draw_list)
    if capture {
        record_capture()
    }
    barrier(image, 0, 4096, 0, 7, 4096, 4096)
    record_blit(image, swapchain)
    barrier(image, 4096, 0, 7, 1000001002, 4096, 8192)
    submit(true, frame_done)
    var waits = Structure(8)
    waits.append_long(frame_done)
    var handles = Structure(8)
    handles.append_long(swapchain.handle)
    var indices = Structure(4)
    indices.append_integer(image_index)
    var presentation = Structure(64)
    presentation.append_integer(1000001001)
    presentation.append_long(0)
    presentation.append_integer(1)
    presentation.append_pointer(waits)
    presentation.append_integer(1)
    presentation.append_pointer(handles)
    presentation.append_pointer(indices)
    presentation.append_long(0)
    var presented = vulkan.vkQueuePresentKHR(queue, presentation.address)
    var stale = presented == -1000001004 or presented == 1000001003
    crash presented == 0 or stale
    if capture {
        wait_frame()
    }
    return stale
}

func record_blit(image: Long, swapchain: RenderVulkan.Component.Swapchain) {
    var region = Structure(80)
    region.append_integer(1)
    region.append_integer(0)
    region.append_integer(0)
    region.append_integer(1)
    append_corners(region, frame.target_width, frame.target_height)
    region.append_integer(1)
    region.append_integer(0)
    region.append_integer(0)
    region.append_integer(1)
    append_corners(region, swapchain.width, swapchain.height)
    vulkan.vkCmdBlitImage(frame.command_buffer, frame.target_image, 6, image, 7, 1, region.address, 0)
}

func append_corners(structure: RenderVulkan.Structure, width: Integer, height: Integer) {
    structure.append_integer(0)
    structure.append_integer(0)
    structure.append_integer(0)
    structure.append_integer(width)
    structure.append_integer(height)
    structure.append_integer(1)
}

func drop() {
    release_device()
}

func release_device() {
    var no_allocator: Long = 0
    assert device != 0
    vulkan.vkDeviceWaitIdle(device)
    release_parts()
    release_frames()
    release_presentation()
    release_textures()
    gpu_timings.release(device)
    vulkan.vkDestroyPipeline(device, pipeline, no_allocator)
    vulkan.vkDestroyPipelineLayout(device, pipeline_layout, no_allocator)
    vulkan.vkDestroyShaderModule(device, shader_vertex, no_allocator)
    vulkan.vkDestroyShaderModule(device, shader_fragment, no_allocator)
    vulkan.vkDestroyCommandPool(device, command_pool, no_allocator)
    vulkan.vkDestroyDevice(device, no_allocator)
    vulkan.vkDestroyInstance(instance, no_allocator)
    device = 0
    instance = 0
    frames.clear()
    pipeline = 0
    stream_index = -1
    stream_cursor = 0
}

func release_parts() {
    var index = 0
    while index < parts.count() {
        parts[index].release_part(this)
        index = index + 1
    }
    parts.clear()
}

func release_frames() {
    var no_allocator: Long = 0
    var index = 0
    while index < frames.count() {
        frame = frames[index]
        release_target()
        release_rectangle_buffer()
        release_in_flight(frame)
        release_staging(frame)
        vulkan.vkDestroySemaphore(device, frame.image_ready, no_allocator)
        vulkan.vkDestroyFence(device, frame.fence, no_allocator)
        index = index + 1
    }
    release_unrecorded_uploads()
    release_stream()
}

func release_staging(finished: RenderVulkan.Frame) {
    var no_allocator: Long = 0
    assert finished.staging_buffer != 0
    vulkan.vkDestroyBuffer(device, finished.staging_buffer, no_allocator)
    vulkan.vkFreeMemory(device, finished.staging_memory, no_allocator)
    finished.staging_buffer = 0
}

func release_stream() {
    var no_allocator: Long = 0
    assert stream_image != 0
    vulkan.vkDestroyImage(device, stream_image, no_allocator)
    vulkan.vkFreeMemory(device, stream_memory, no_allocator)
    stream_image = 0
}

func release_unrecorded_uploads() {
    var no_allocator: Long = 0
    var index = 0
    while index < pending_stagings.count() {
        crash pending_staging_memories[index]
        vulkan.vkDestroyBuffer(device, pending_stagings[index], no_allocator)
        vulkan.vkFreeMemory(device, pending_staging_memories[index], no_allocator)
        index = index + 1
    }
    pending_stagings.clear()
    pending_staging_memories.clear()
}

func release_textures() {
    var no_allocator: Long = 0
    var slot = 0
    while slot < textures.count() {
        release_gpu_texture(slot)
        slot = slot + 1
    }
    if white_set != 0 {
        vulkan.vkDestroyImageView(device, white_view, no_allocator)
        vulkan.vkDestroyImage(device, white_image, no_allocator)
        vulkan.vkFreeMemory(device, white_memory, no_allocator)
        white_set = 0
    }
    vulkan.vkDestroySampler(device, sampler, no_allocator)
    vulkan.vkDestroySampler(device, scene_sampler, no_allocator)
    vulkan.vkDestroyDescriptorPool(device, descriptor_pool, no_allocator)
    vulkan.vkDestroyDescriptorSetLayout(device, descriptor_layout, no_allocator)
}

func release_gpu_texture(slot: Integer) {
    var no_allocator: Long = 0
    var gpu = gpu_of(slot)
    assert gpu
    if gpu.set != 0 {
        vulkan.vkDestroyImageView(device, gpu.view, no_allocator)
        vulkan.vkDestroyImage(device, gpu.image, no_allocator)
        vulkan.vkFreeMemory(device, gpu.image_memory, no_allocator)
    }
    gpu.set = 0
    gpu.image = 0
    gpu.image_memory = 0
    gpu.view = 0
    gpu.generation = 0
}

func release_presentation() {
    var no_allocator: Long = 0
    var index = 0
    while index < presentations.count() {
        var presented = presentations[index]
        vulkan.vkDestroySwapchainKHR(device, presented.swapchain, no_allocator)
        var done = 0
        while done < presented.frames_done.count() {
            vulkan.vkDestroySemaphore(device, presented.frames_done[done], no_allocator)
            done = done + 1
        }
        vulkan.vkDestroySurfaceKHR(instance, presented.surface, no_allocator)
        index = index + 1
    }
    presentations.clear()
}
