    crash result == 0
    var set = created.read_long(0)
    var image_information = Structure(24)
    image_information.append_long(sampler)
    image_information.append_long(view)
    image_information.append_integer(5)
    var write = Structure(64)
    write.append_integer(35)
    write.append_long(0)
    write.append_long(set)
    write.append_integer(0)
    write.append_integer(0)
    write.append_integer(1)
    write.append_integer(1)
    write.append_pointer(image_information)
    write.append_long(0)
    write.append_long(0)
    var no_copies: Long = 0
    vulkan.vkUpdateDescriptorSets(device, 1, write.address, 0, no_copies)
