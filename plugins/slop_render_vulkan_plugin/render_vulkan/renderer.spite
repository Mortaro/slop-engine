func memory_type(bits: Integer, wanted: Integer): Integer {
    var properties = Structure(528)
    vulkan.vkGetPhysicalDeviceMemoryProperties(physical_device, properties.address)
    var count = properties.read_integer(0)
    var index = 0
    var found = -1
    var remaining_bits: Long = bits
    if remaining_bits < 0 {
        remaining_bits = remaining_bits + 4294967296
    }
    while found < 0 and index < count {
        var flags = properties.read_integer(4 + index * 8)
        var allowed = remaining_bits % 2 == 1
        if allowed and has_flags(flags, wanted) {
            found = index
        }
        remaining_bits = remaining_bits / 2
        index = index + 1
    }
    crash found >= 0
    return found
}

func has_flags(flags: Integer, wanted: Integer): Boolean {
    var bit = 1
    var all = true
    while bit <= wanted {
        var wanted_bit = wanted / bit % 2 == 1
        var present_bit = flags / bit % 2 == 1
        all = all and (present_bit or not wanted_bit)
        bit = bit * 2
    }
    return all
}

func allocate_memory(requirements: RenderVulkan.Structure, wanted: Integer): Long {
    var size = requirements.read_long(0)
    var bits = requirements.read_integer(16)
    var type_index = memory_type(bits, wanted)
    var allocation = Structure(32)
    allocation.append_integer(5)
    allocation.append_long(0)
    allocation.append_long(size)
    allocation.append_integer(type_index)
    var created = Structure(8)
    var no_allocator: Long = 0
    var result = vulkan.vkAllocateMemory(device, allocation.address, no_allocator, created.address)
    crash result == 0
    return created.read_long(0)
}

func create_buffer(bytes: Integer, usage: Integer): Long {
    var creation = Structure(56)
