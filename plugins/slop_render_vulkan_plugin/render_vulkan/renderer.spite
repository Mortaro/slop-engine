func create_swizzled_view(image: Long, format: Integer, levels: Integer, grey: Boolean): Long {
    var no_allocator: Long = 0
    var creation = Structure(80)
    creation.append_integer(15)
    creation.append_long(0)
    creation.append_integer(0)
    creation.append_long(image)
    creation.append_integer(1)
    creation.append_integer(format)
    var red_everywhere = 3
    var one = 2
    var identity = 0
    if grey {
        creation.append_integer(red_everywhere)
        creation.append_integer(red_everywhere)
        creation.append_integer(red_everywhere)
        creation.append_integer(one)
    } else {
        var field = 0
        while field < 4 {
            creation.append_integer(identity)
            field = field + 1
        }
    }
    creation.append_integer(1)
    creation.append_integer(0)
    creation.append_integer(levels)
    creation.append_integer(0)
    creation.append_integer(1)
    var created = Structure(8)
    var result = vulkan.vkCreateImageView(device, creation.address, no_allocator, created.address)
    crash result == 0
    return created.read_long(0)
}

