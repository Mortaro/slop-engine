type Target {
    entity: Entity
    window: Window.Component.Window
    swapchain: Component.Swapchain
    draw_list: Render.Component.DrawList
}

var requests = Lookup<Component.CaptureRequested>()
var captures = Lookup<Component.Captured>()
var renderer = RenderVulkan.Renderer()
var stale_swapchains = Lookup<Component.SwapchainOutOfDate>()

func present_each(target: Target) {
    assert renderer.device != 0 and target.swapchain.acquired >= 0
    var owner = target.entity
    var capture = requests.has(owner.id)
    var stale = renderer.finish_window_frame(target.draw_list, target.swapchain, capture)
    if stale and not stale_swapchains.has(owner.id) {
        var marker = Component.SwapchainOutOfDate()
        owner.add_component(marker)
    }
    assert capture
    owner.remove_component(Component.CaptureRequested)
    if not captures.has(owner.id) {
        var captured = Component.Captured()
        owner.add_component(captured)
    }
}
