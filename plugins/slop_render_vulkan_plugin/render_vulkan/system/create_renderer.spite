type OpenedWindow {
    entity: Entity
    opened: Removed<Window.Component.Opening>
    window: Window.Component.Window
    handle: Window.Component.Handle
}

var renderer = RenderVulkan.Renderer()

func present_each(created: OpenedWindow) {
    var device = Component.Device()
    renderer.ensure(device)
    var swapchain = Component.Swapchain()
    renderer.create_swapchain(created.window, created.handle.value, swapchain)
    created.entity.add_component(device)
    created.entity.add_component(swapchain)
}
