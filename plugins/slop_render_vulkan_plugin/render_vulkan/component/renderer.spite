    var multisample = Structure(48)
    multisample.append_integer(24)
    multisample.append_long(0)
    multisample.append_integer(0)
    multisample.append_integer(1)
    multisample.append_integer(0)
    multisample.append_float(0.0)
    multisample.append_long(0)
    multisample.append_integer(0)
    multisample.append_integer(0)
    description.append_pointer(multisample)
    description.append_long(0)
    var blend = blend_state()
    description.append_pointer(blend)
    var dynamic_states = Structure(8)
    dynamic_states.append_integer(0)
    dynamic_states.append_integer(1)
    var dynamic = Structure(32)
    dynamic.append_integer(27)
    dynamic.append_long(0)
    dynamic.append_integer(0)
    dynamic.append_integer(2)
    dynamic.append_pointer(dynamic_states)
    description.append_pointer(dynamic)
    description.append_long(pipeline_layout)
    description.append_long(0)
    description.append_integer(0)
    description.append_long(0)
    description.append_integer(-1)
    return description
}

