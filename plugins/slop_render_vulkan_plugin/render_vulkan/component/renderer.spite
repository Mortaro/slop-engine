type Part {
    release_part(RenderVulkan.Component.Renderer)
}

var instance: Long = 0
var physical_device: Long = 0
var device: Long = 0
var queue: Long = 0
var queue_family = 0
var command_pool: Long = 0
var frames = List<RenderVulkan.Frame>()
var frame = RenderVulkan.Frame()
var frame_number = 0
var frames_in_flight = 2
var upload_budget_bytes = 8388608
var staged_bytes = 0
var presentation_semaphores = List<Long>()
var shader_vertex: Long = 0
var shader_fragment: Long = 0
var pipeline_layout: Long = 0
var pipeline: Long = 0
var descriptor_layout: Long = 0
var descriptor_pool: Long = 0
var sampler: Long = 0
var texture_images = List<Long>()
var texture_memories = List<Long>()
var texture_views = List<Long>()
var texture_sets = List<Long>()
var texture_generations = List<Integer>()
var created_memory: Long = 0
var pending_images = List<Long>()
var pending_stagings = List<Long>()
var pending_staging_memories = List<Long>()
var pending_widths = List<Integer>()
var pending_heights = List<Integer>()
var pending_mips = List<Integer>()
var anisotropy_supported = false
var scene_sampler: Long = 0
var surfaces = List<Long>()
var swapchains = List<Long>()
var device_name = ""
var validation = false
var parts = List<Part>()
var capture_requested = false
var captured = false
var raw = Raw()
var shaders = Recipes.Blobs()
var offscreen_program = Program()
var build = Build()
var console = Console()
var vulkan = DynamicLibrary("vulkan-1.dll", 'identity', "")
var kernel = DynamicLibrary("kernel32.dll", 'identity', "")

func ensure() {
    assert instance == 0
    create_instance()
    choose_physical_device()
    create_device()
    create_commands()
    create_descriptors()
    console.print("vulkan: {device_name}, validation {validation}")
}

func vulkan_version(): Integer {
    return 4194304 + 3 * 4096
}

func create_instance() {
    var application = Structure(64)
    application.append_integer(0)
    application.append_long(0)
    application.append_text("SlopEngine")
    application.append_integer(1)
    application.append_text("SlopEngine")
    application.append_integer(1)
    var version = vulkan_version()
    application.append_integer(version)
    var extensions = Structure(16)
    extensions.append_text("VK_KHR_surface")
    extensions.append_text("VK_KHR_win32_surface")
    var layers = Structure(8)
    layers.append_text("VK_LAYER_KHRONOS_validation")
    var layer_count = 1
    if build.optimized {
        layer_count = 0
    }
    var creation = Structure(64)
    creation.append_integer(1)
    creation.append_long(0)
    creation.append_integer(0)
    creation.append_pointer(application)
    creation.append_integer(layer_count)
    creation.append_pointer(layers)
    creation.append_integer(2)
    creation.append_pointer(extensions)
    var created = Structure(8)
    var no_allocator: Long = 0
    var result = vulkan.vkCreateInstance(creation.address, no_allocator, created.address)
    validation = result == 0 and layer_count == 1
    if result == -6 {
        raw.write_integer(creation.address, 32, 0)
        result = vulkan.vkCreateInstance(creation.address, no_allocator, created.address)
    }
    crash result == 0
    instance = created.read_long(0)
}

func choose_physical_device() {
    var count = Structure(8)
    var no_devices: Long = 0
    vulkan.vkEnumeratePhysicalDevices(instance, count.address, no_devices)
    var device_count = count.read_integer(0)
    crash device_count > 0
    var devices = Structure(device_count * 8)
    vulkan.vkEnumeratePhysicalDevices(instance, count.address, devices.address)
    var index = 0
    var best_score = -1
    while index < device_count {
        var candidate = devices.read_long(index * 8)
        var score = device_score(candidate)
        if score > best_score {
            best_score = score
            physical_device = candidate
        }
        index = index + 1
    }
    crash best_score >= 0
    var properties = Structure(1024)
    vulkan.vkGetPhysicalDeviceProperties(physical_device, properties.address)
    var name_address = properties.address + 20
    device_name = raw.terminated_text(name_address)
}

func device_score(candidate: Long): Integer {
    var properties = Structure(1024)
    vulkan.vkGetPhysicalDeviceProperties(candidate, properties.address)
    var api_version = properties.read_integer(0)
    if api_version < vulkan_version() {
        return 0
    }
    var family = graphics_family(candidate)
    if family < 0 {
        return 0
    }
    var device_type = properties.read_integer(16)
    if device_type == 2 {
        return 2
    } else if device_type == 1 {
        return 1
    }
    return 0
}

func graphics_family(candidate: Long): Integer {
    var count = Structure(8)
    var no_families: Long = 0
    vulkan.vkGetPhysicalDeviceQueueFamilyProperties(candidate, count.address, no_families)
    var family_count = count.read_integer(0)
    var families = Structure(family_count * 24 + 8)
    vulkan.vkGetPhysicalDeviceQueueFamilyProperties(candidate, count.address, families.address)
    var index = 0
    var found = -1
    while found < 0 and index < family_count {
        var flags = families.read_integer(index * 24)
        var presents = vulkan.vkGetPhysicalDeviceWin32PresentationSupportKHR(candidate, index)
        if flags % 2 == 1 and presents != 0 {
            found = index
        }
        index = index + 1
    }
    return found
}

func create_device() {
    queue_family = graphics_family(physical_device)
    var priorities = Structure(8)
    priorities.append_float(1.0)
    var queue_creation = Structure(48)
    queue_creation.append_integer(2)
    queue_creation.append_long(0)
    queue_creation.append_integer(0)
    queue_creation.append_integer(queue_family)
    queue_creation.append_integer(1)
    queue_creation.append_pointer(priorities)
    var dynamic_rendering = Structure(80)
    dynamic_rendering.append_integer(53)
    dynamic_rendering.append_long(0)
    var feature = 0
    while feature < 15 {
        var enabled = 0
        if feature == 5 or feature == 12 {
            enabled = 1
        }
        dynamic_rendering.append_integer(enabled)
        feature = feature + 1
    }
    var extensions = Structure(8)
    extensions.append_text("VK_KHR_swapchain")
    var available = Structure(224)
    var feature_index = 0
    while feature_index < 55 {
        available.append_integer(0)
        feature_index = feature_index + 1
    }
    vulkan.vkGetPhysicalDeviceFeatures(physical_device, available.address)
    anisotropy_supported = available.read_integer(76) == 1
    var wanted = Structure(224)
    feature_index = 0
    while feature_index < 55 {
        var wanted_flag = 0
        if feature_index == 19 and anisotropy_supported {
            wanted_flag = 1
        }
        wanted.append_integer(wanted_flag)
        feature_index = feature_index + 1
    }
    var creation = Structure(80)
    creation.append_integer(3)
    creation.append_pointer(dynamic_rendering)
    creation.append_integer(0)
    creation.append_integer(1)
    creation.append_pointer(queue_creation)
    creation.append_integer(0)
    creation.append_long(0)
    creation.append_integer(1)
    creation.append_pointer(extensions)
    creation.append_pointer(wanted)
    var created = Structure(8)
    var no_allocator: Long = 0
    var result = vulkan.vkCreateDevice(physical_device, creation.address, no_allocator, created.address)
    crash result == 0
    device = created.read_long(0)
    var queue_handle = Structure(8)
    vulkan.vkGetDeviceQueue(device, queue_family, 0, queue_handle.address)
    queue = queue_handle.read_long(0)
}

func create_commands() {
    var no_allocator: Long = 0
    var pool_creation = Structure(24)
    pool_creation.append_integer(39)
    pool_creation.append_long(0)
    pool_creation.append_integer(2)
    pool_creation.append_integer(queue_family)
    var created = Structure(8)
    var pool_result = vulkan.vkCreateCommandPool(device, pool_creation.address, no_allocator, created.address)
    crash pool_result == 0
    command_pool = created.read_long(0)
    var index = 0
    while index < frames_in_flight {
        var made = RenderVulkan.Frame()
        made.command_buffer = allocate_command_buffer()
        made.fence = create_fence()
        made.image_ready = create_semaphore()
        frames.append(made)
        index = index + 1
    }
    crash frames[0]
    frame = frames[0]
}

func allocate_command_buffer(): Long {
    var allocation = Structure(32)
    allocation.append_integer(40)
    allocation.append_long(0)
    allocation.append_long(command_pool)
    allocation.append_integer(0)
    allocation.append_integer(1)
    var created = Structure(8)
    var buffer_result = vulkan.vkAllocateCommandBuffers(device, allocation.address, created.address)
    crash buffer_result == 0
    return created.read_long(0)
}

func begin_frame() {
    var slot = frame_number % frames_in_flight
    frame_number = frame_number + 1
    crash frames[slot]
    frame = frames[slot]
    var fences = Structure(8)
    fences.append_long(frame.fence)
    var forever: Long = -1
    var wait_result = vulkan.vkWaitForFences(device, 1, fences.address, 1, forever)
    crash wait_result == 0
    vulkan.vkResetFences(device, 1, fences.address)
    release_in_flight(frame)
}

func wait_frame() {
    var fences = Structure(8)
    fences.append_long(frame.fence)
    var forever: Long = -1
    var wait_result = vulkan.vkWaitForFences(device, 1, fences.address, 1, forever)
    crash wait_result == 0
}

func create_fence(): Long {
    var no_allocator: Long = 0
    var creation = Structure(24)
    creation.append_integer(8)
    creation.append_long(0)
    var signalled = 1
    creation.append_integer(signalled)
    var created = Structure(8)
    var result = vulkan.vkCreateFence(device, creation.address, no_allocator, created.address)
    crash result == 0
    return created.read_long(0)
}

func create_semaphore(): Long {
    var no_allocator: Long = 0
    var creation = Structure(24)
    creation.append_integer(9)
    creation.append_long(0)
    creation.append_integer(0)
    var created = Structure(8)
    var result = vulkan.vkCreateSemaphore(device, creation.address, no_allocator, created.address)
    crash result == 0
    return created.read_long(0)
}

func shader_ready(id: String): Boolean {
    var code = shaders.bytes_of(id)
    if code {
        return true
    }
    return false
}

func pipeline_ready(): Boolean {
    if pipeline != 0 {
        return true
    }
    var vertex_ready = shader_ready("shader.rectangles.vertex")
    var fragment_ready = shader_ready("shader.rectangles.fragment")
    if not vertex_ready or not fragment_ready {
        return false
    }
    create_pipeline()
    return true
}

func create_shader(id: String): Long {
    var code = shaders.bytes_of(id)
    crash code
    var length = code.length
    crash length > 0 and length % 4 == 0
    var words = Structure(length)
    raw.copy(code.address, words.address, length)
    var creation = Structure(40)
    creation.append_integer(16)
    creation.append_long(0)
    creation.append_integer(0)
    creation.append_long(length)
    creation.append_pointer(words)
    var created = Structure(8)
    var no_allocator: Long = 0
    var result = vulkan.vkCreateShaderModule(device, creation.address, no_allocator, created.address)
    crash result == 0
    return created.read_long(0)
}

func create_pipeline() {
    var no_allocator: Long = 0
    shader_vertex = create_shader("shader.rectangles.vertex")
    shader_fragment = create_shader("shader.rectangles.fragment")
    var set_layouts = Structure(8)
    set_layouts.append_long(descriptor_layout)
    var push_range = Structure(12)
    push_range.append_integer(1)
    push_range.append_integer(0)
    push_range.append_integer(8)
    var layout_creation = Structure(48)
    layout_creation.append_integer(30)
    layout_creation.append_long(0)
    layout_creation.append_integer(0)
    layout_creation.append_integer(1)
    layout_creation.append_pointer(set_layouts)
    layout_creation.append_integer(1)
    layout_creation.append_pointer(push_range)
    var created = Structure(8)
    var layout_result = vulkan.vkCreatePipelineLayout(device, layout_creation.address, no_allocator, created.address)
    crash layout_result == 0
    pipeline_layout = created.read_long(0)
    var description = pipeline_description()
    var no_cache: Long = 0
    var result = vulkan.vkCreateGraphicsPipelines(
        device,
        no_cache,
        1,
        description.address,
        no_allocator,
        created.address,
    )
    crash result == 0
    pipeline = created.read_long(0)
    var white = Asset.Bytes()
    white.write_integer(-1)
    stage_pixels(0, 1, 1, white, 0)
}

func create_descriptors() {
    var no_allocator: Long = 0
    var binding = Structure(24)
    binding.append_integer(0)
    binding.append_integer(1)
    binding.append_integer(1)
    binding.append_integer(16)
    binding.append_long(0)
    var layout_creation = Structure(32)
    layout_creation.append_integer(32)
    layout_creation.append_long(0)
    layout_creation.append_integer(0)
    layout_creation.append_integer(1)
    layout_creation.append_pointer(binding)
    var created = Structure(8)
    var layout_result = vulkan.vkCreateDescriptorSetLayout(
        device,
        layout_creation.address,
        no_allocator,
        created.address,
    )
    crash layout_result == 0
    descriptor_layout = created.read_long(0)
    var pool_size = Structure(8)
    pool_size.append_integer(1)
    pool_size.append_integer(1024)
    var pool_creation = Structure(40)
    pool_creation.append_integer(33)
    pool_creation.append_long(0)
    var free_descriptor_set = 1
    pool_creation.append_integer(free_descriptor_set)
    pool_creation.append_integer(1024)
    pool_creation.append_integer(1)
    pool_creation.append_pointer(pool_size)
    var pool_result = vulkan.vkCreateDescriptorPool(device, pool_creation.address, no_allocator, created.address)
    crash pool_result == 0
    descriptor_pool = created.read_long(0)
    create_sampler()
}

func create_sampler() {
    var no_allocator: Long = 0
    var creation = Structure(80)
    creation.append_integer(31)
    creation.append_long(0)
    creation.append_integer(0)
    creation.append_integer(0)
    creation.append_integer(0)
    creation.append_integer(0)
    creation.append_integer(2)
    creation.append_integer(2)
    creation.append_integer(2)
    creation.append_float(0.0)
    creation.append_integer(0)
    creation.append_float(1.0)
    creation.append_integer(0)
    creation.append_integer(0)
    creation.append_float(0.0)
    creation.append_float(0.0)
    creation.append_integer(0)
    creation.append_integer(0)
    var created = Structure(8)
    var result = vulkan.vkCreateSampler(device, creation.address, no_allocator, created.address)
    crash result == 0
    sampler = created.read_long(0)
    scene_sampler = create_scene_sampler()
}

func create_scene_sampler(): Long {
    var no_allocator: Long = 0
    var anisotropy = 0
    if anisotropy_supported {
        anisotropy = 1
    }
    var creation = Structure(80)
    creation.append_integer(31)
    creation.append_long(0)
    creation.append_integer(0)
    creation.append_integer(1)
    creation.append_integer(1)
    creation.append_integer(1)
    creation.append_integer(0)
    creation.append_integer(0)
    creation.append_integer(0)
    creation.append_float(0.0)
    creation.append_integer(anisotropy)
    creation.append_float(16.0)
    creation.append_integer(0)
    creation.append_integer(0)
    creation.append_float(0.0)
    creation.append_float(1000.0)
    creation.append_integer(0)
    creation.append_integer(0)
    var created = Structure(8)
    var result = vulkan.vkCreateSampler(device, creation.address, no_allocator, created.address)
    crash result == 0
    return created.read_long(0)
}

func ensure_slots(count: Integer) {
    while texture_sets.count() < count {
        texture_sets.append(0)
        texture_images.append(0)
        texture_memories.append(0)
        texture_views.append(0)
        texture_generations.append(0)
    }
}

func ensure_textures(textures: Render.Component.Textures) {
    var wanted = textures.textures.count() + 1
    ensure_slots(wanted)
    staged_bytes = 0
    var slot = 0
    while slot < textures.textures.count() {
        upload_if_ready(textures, slot)
        slot = slot + 1
    }
}

func upload_if_ready(textures: Render.Component.Textures, slot: Integer) {
    crash texture_sets[slot + 1]
    crash texture_generations[slot + 1]
    var generation = textures.generation(slot)
    var outdated = texture_sets[slot + 1] == 0 or texture_generations[slot + 1] != generation
    assert outdated and textures.is_ready(slot)
    var texture = textures.texture(slot)
    var raw = textures.raw(slot)
    var within_budget = staged_bytes + raw.length <= upload_budget_bytes
    assert staged_bytes == 0 or within_budget
    staged_bytes = staged_bytes + raw.length
    stage_pixels(slot + 1, texture.width, texture.height, raw, generation)
}

func stage_pixels(index: Integer, width: Integer, height: Integer, pixels: Asset.Bytes, generation: Integer) {
    ensure_slots(index + 1)
    retire_slot(index)
    var bytes = width * height * 4
    crash pixels.length == bytes
    var transfer_source = 1
    var staging = create_buffer(bytes, transfer_source)
    var staging_memory = host_memory_for(staging)
    var mapped = map(staging_memory, bytes)
    raw.copy(pixels.address, mapped, bytes)
    var mips = mip_count_of(width, height)
    var image = create_texture_image(width, height, mips)
    pending_images.append(image)
    pending_mips.append(mips)
    pending_stagings.append(staging)
    pending_staging_memories.append(staging_memory)
    pending_widths.append(width)
    pending_heights.append(height)
    var view = create_view_levels(image, 37, mips)
    var set = allocate_texture_set(view)
    texture_images.set_at(index, image)
    texture_memories.set_at(index, created_memory)
    texture_views.set_at(index, view)
    texture_sets.set_at(index, set)
    texture_generations.set_at(index, generation)
}

func retire_slot(index: Integer) {
    crash texture_sets[index]
    crash texture_images[index]
    crash texture_memories[index]
    crash texture_views[index]
    assert texture_sets[index] != 0
    frame.retired_sets.append(texture_sets[index])
    frame.retired_images.append(texture_images[index])
    frame.retired_memories.append(texture_memories[index])
    frame.retired_views.append(texture_views[index])
    texture_sets.set_at(index, 0)
}

func record_uploads() {
    var index = 0
    while index < pending_images.count() {
        record_upload(index)
        index = index + 1
    }
    index = 0
    while index < pending_stagings.count() {
        crash pending_staging_memories[index]
        frame.in_flight_stagings.append(pending_stagings[index])
        frame.in_flight_staging_memories.append(pending_staging_memories[index])
        index = index + 1
    }
    pending_images.clear()
    pending_stagings.clear()
    pending_staging_memories.clear()
    pending_widths.clear()
    pending_heights.clear()
    pending_mips.clear()
}

func record_upload(index: Integer) {
    var image = pending_images.get_at(index)
    var staging = pending_stagings.get_at(index)
    var width = pending_widths.get_at(index)
    var height = pending_heights.get_at(index)
    var mips = pending_mips.get_at(index)
    level_barrier(image, 0, 4096, 0, 7, 1, 4096, 0, mips)
    var region = Structure(56)
    region.append_long(0)
    region.append_integer(0)
    region.append_integer(0)
    append_color_layers(region)
    region.append_integer(0)
    region.append_integer(0)
    region.append_integer(0)
    region.append_integer(width)
    region.append_integer(height)
    region.append_integer(1)
    vulkan.vkCmdCopyBufferToImage(frame.command_buffer, staging, image, 7, 1, region.address)
    var level = 1
    while level < mips {
        level_barrier(image, 4096, 2048, 7, 6, 4096, 4096, level - 1, 1)
        var next_width = half_of(width)
        var next_height = half_of(height)
        blit_level(image, level, width, height, next_width, next_height)
        width = next_width
        height = next_height
        level = level + 1
    }
    if mips > 1 {
        level_barrier(image, 2048, 32, 6, 5, 4096, 128, 0, mips - 1)
    }
    level_barrier(image, 4096, 32, 7, 5, 4096, 128, mips - 1, 1)
}

func half_of(size: Integer): Integer {
    if size > 1 {
        return size / 2
    }
    return 1
}

func blit_level(
    image: Long,
    level: Integer,
    width: Integer,
    height: Integer,
    next_width: Integer,
    next_height: Integer,
) {
    var region = Structure(80)
    region.append_integer(1)
    region.append_integer(level - 1)
    region.append_integer(0)
    region.append_integer(1)
    region.append_integer(0)
    region.append_integer(0)
    region.append_integer(0)
    region.append_integer(width)
    region.append_integer(height)
    region.append_integer(1)
    region.append_integer(1)
    region.append_integer(level)
    region.append_integer(0)
    region.append_integer(1)
    region.append_integer(0)
    region.append_integer(0)
    region.append_integer(0)
    region.append_integer(next_width)
    region.append_integer(next_height)
    region.append_integer(1)
    vulkan.vkCmdBlitImage(frame.command_buffer, image, 6, image, 7, 1, region.address, 1)
}

func release_in_flight(finished: RenderVulkan.Frame) {
    var no_allocator: Long = 0
    var index = 0
    while index < finished.in_flight_stagings.count() {
        crash finished.in_flight_staging_memories[index]
        vulkan.vkDestroyBuffer(device, finished.in_flight_stagings[index], no_allocator)
        vulkan.vkFreeMemory(device, finished.in_flight_staging_memories[index], no_allocator)
        index = index + 1
    }
    finished.in_flight_stagings.clear()
    finished.in_flight_staging_memories.clear()
    release_retired(finished)
}

func release_retired(finished: RenderVulkan.Frame) {
    var no_allocator: Long = 0
    var index = 0
    while index < finished.retired_sets.count() {
        crash finished.retired_images[index]
        crash finished.retired_memories[index]
        crash finished.retired_views[index]
        var sets = Structure(8)
        sets.append_long(finished.retired_sets[index])
        vulkan.vkFreeDescriptorSets(device, descriptor_pool, 1, sets.address)
        vulkan.vkDestroyImageView(device, finished.retired_views[index], no_allocator)
        vulkan.vkDestroyImage(device, finished.retired_images[index], no_allocator)
        vulkan.vkFreeMemory(device, finished.retired_memories[index], no_allocator)
        index = index + 1
    }
    finished.retired_sets.clear()
    finished.retired_images.clear()
    finished.retired_memories.clear()
    finished.retired_views.clear()
}

func append_color_layers(structure: RenderVulkan.Structure) {
    structure.append_integer(1)
    structure.append_integer(0)
    structure.append_integer(0)
    structure.append_integer(1)
}

func mip_count_of(width: Integer, height: Integer): Integer {
    var largest = width
    if height > largest {
        largest = height
    }
    var count = 1
    while largest > 1 {
        largest = largest / 2
        count = count + 1
    }
    return count
}

func create_texture_image(width: Integer, height: Integer, mips: Integer): Long {
    var no_allocator: Long = 0
    var creation = Structure(96)
    creation.append_integer(14)
    creation.append_long(0)
    creation.append_integer(0)
    creation.append_integer(1)
    creation.append_integer(37)
    creation.append_integer(width)
    creation.append_integer(height)
    creation.append_integer(1)
    creation.append_integer(mips)
    creation.append_integer(1)
    creation.append_integer(1)
    creation.append_integer(0)
    creation.append_integer(7)
    creation.append_integer(0)
    creation.append_integer(0)
    creation.append_long(0)
    creation.append_integer(0)
    var created = Structure(8)
    var result = vulkan.vkCreateImage(device, creation.address, no_allocator, created.address)
    crash result == 0
    var image = created.read_long(0)
    var requirements = Structure(24)
    vulkan.vkGetImageMemoryRequirements(device, image, requirements.address)
    var device_local = 1
    var image_memory = allocate_memory(requirements, device_local)
    var no_offset: Long = 0
    var bind_result = vulkan.vkBindImageMemory(device, image, image_memory, no_offset)
    crash bind_result == 0
    created_memory = image_memory
    return image
}

func allocate_texture_set(view: Long): Long {
    var layouts = Structure(8)
