var vulkan = DynamicLibrary("vulkan-1.dll", 'identity', "")
var raw = Raw()
var meshes = Scene.Meshes()
var gpu_meshes = Column<SceneVulkan.Component.GpuMesh>()
var pipeline: Long = 0
var order = List<Integer>()
var distances = List<Float>()

func sort_back_to_front(drawn: Scene.DrawSet, camera: Scene.Component.ViewCamera) {
    order.clear()
    distances.clear()
    var index = 0
    while index < drawn.translucent_draws.count() {
        var model = drawn.translucent_draws[index].model
        var along_x = model.m12 - camera.eye_x
        var along_y = model.m13 - camera.eye_y
        var along_z = model.m14 - camera.eye_z
        var distance = along_x * along_x + along_y * along_y + along_z * along_z
        var at = order.count()
        while at > 0 and farther(distance, at - 1) {
            at = at - 1
        }
        order.insert(at, index)
        distances.insert(at, distance)
        index = index + 1
    }
}

func farther(distance: Float, at: Integer): Boolean {
    crash distances[at]
    return distance > distances[at]
}

func gpu_mesh_of(slot: Integer): SceneVulkan.Component.GpuMesh? {
    var owner = meshes.entity_of(slot)
    var row = gpu_meshes.row_of_entity(owner)
    assert row >= 0
    return gpu_meshes.values[row]
}

func record(
    renderer: RenderVulkan.Renderer,
    materials: SceneVulkan.Materials,
    drawn: Scene.DrawSet,
    camera: Scene.Component.ViewCamera,
    first_record: Integer,
    storage_set: Long,
    pipeline_layout: Long,
    view_projection: Math.Matrix4,
    target_view: Long,
    depth_view: Long,
) {
    assert drawn.translucent_draws.count() > 0
    sort_back_to_front(drawn, camera)
    var command_buffer = renderer.frame.command_buffer
    begin_rendering(renderer, target_view, depth_view)
    vulkan.vkCmdBindPipeline(command_buffer, 0, pipeline)
    set_viewport(renderer)
    var sets = RenderVulkan.Structure(8)
    sets.append_long(storage_set)
    var no_offsets: Long = 0
    vulkan.vkCmdBindDescriptorSets(command_buffer, 0, pipeline_layout, 1, 1, sets.address, 0, no_offsets)
    var place = 0
    while place < order.count() {
        var index = order[place]
        var draw = drawn.translucent_draws[index]
        crash draw
        draw_one(renderer, materials, drawn, draw, first_record + index, pipeline_layout, view_projection)
        place = place + 1
    }
    vulkan.vkCmdEndRendering(command_buffer)
}

func draw_one(
    renderer: RenderVulkan.Renderer,
    materials: SceneVulkan.Materials,
    drawn: Scene.DrawSet,
    draw: Scene.Draw,
    record_index: Integer,
    pipeline_layout: Long,
    view_projection: Math.Matrix4,
) {
    var gpu = gpu_mesh_of(draw.mesh_slot)
    assert gpu
    assert gpu.vertex_buffer != 0
    var command_buffer = renderer.frame.command_buffer
    materials.bind(renderer, pipeline_layout, draw, drawn.seconds, true)
    var push = RenderVulkan.Structure(68)
    view_projection.write_to(push.address)
    raw.write_integer(push.address, 64, record_index)
    var vertex_stage = 1
    vulkan.vkCmdPushConstants(command_buffer, pipeline_layout, vertex_stage, 0, 68, push.address)
    var buffers = RenderVulkan.Structure(8)
    buffers.append_long(gpu.vertex_buffer)
    var offsets = RenderVulkan.Structure(8)
    offsets.append_long(0)
    vulkan.vkCmdBindVertexBuffers(command_buffer, 0, 1, buffers.address, offsets.address)
    var no_offset: Long = 0
    vulkan.vkCmdBindIndexBuffer(command_buffer, gpu.index_buffer, no_offset, 1)
    vulkan.vkCmdDrawIndexed(command_buffer, draw.index_count, 1, draw.first_index, 0, 0)
}

func begin_rendering(renderer: RenderVulkan.Renderer, target_view: Long, depth_view: Long) {
    var frame = renderer.frame
    var color = RenderVulkan.Structure(72)
    color.append_integer(1000044001)
    color.append_long(0)
    color.append_long(target_view)
    color.append_integer(2)
    color.append_integer(0)
    color.append_long(0)
    color.append_integer(0)
    var load_existing = 0
    color.append_integer(load_existing)
    color.append_integer(0)
    color.append_float(0.0)
    color.append_float(0.0)
    color.append_float(0.0)
    color.append_float(0.0)
    var depth = RenderVulkan.Structure(72)
    depth.append_integer(1000044001)
    depth.append_long(0)
    depth.append_long(depth_view)
    var depth_read_only = 4
    depth.append_integer(depth_read_only)
    depth.append_integer(0)
    depth.append_long(0)
    depth.append_integer(0)
    depth.append_integer(load_existing)
    var store_nothing = 1000301000
    depth.append_integer(store_nothing)
    depth.append_float(0.0)
    depth.append_integer(0)
    depth.append_integer(0)
    depth.append_integer(0)
    var rendering = RenderVulkan.Structure(80)
    rendering.append_integer(1000044000)
    rendering.append_long(0)
    rendering.append_integer(0)
    rendering.append_integer(0)
    rendering.append_integer(0)
    rendering.append_integer(frame.target_width)
    rendering.append_integer(frame.target_height)
    rendering.append_integer(1)
    rendering.append_integer(0)
    rendering.append_integer(1)
    rendering.append_pointer(color)
    rendering.append_pointer(depth)
    rendering.append_long(0)
    vulkan.vkCmdBeginRendering(frame.command_buffer, rendering.address)
}

func set_viewport(renderer: RenderVulkan.Renderer) {
    var frame = renderer.frame
    var viewport = RenderVulkan.Structure(24)
    viewport.append_float(0.0)
    viewport.append_float(0.0)
    viewport.append_float(frame.target_width)
    viewport.append_float(frame.target_height)
    viewport.append_float(0.0)
    viewport.append_float(1.0)
    vulkan.vkCmdSetViewport(frame.command_buffer, 0, 1, viewport.address)
    var scissor = RenderVulkan.Structure(16)
    scissor.append_integer(0)
    scissor.append_integer(0)
    scissor.append_integer(frame.target_width)
    scissor.append_integer(frame.target_height)
    vulkan.vkCmdSetScissor(frame.command_buffer, 0, 1, scissor.address)
}

func release(renderer: RenderVulkan.Renderer) {
    var no_allocator: Long = 0
    vulkan.vkDestroyPipeline(renderer.device, pipeline, no_allocator)
}
