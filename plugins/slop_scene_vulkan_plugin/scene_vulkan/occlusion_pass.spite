var vulkan = DynamicLibrary("vulkan-1.dll", 'identity', "")
var raw = Raw()
var floats = TypedMemory<Float>()
var block = 16
var push_bytes = 20
var shader: Long = 0
var set_layout: Long = 0
var pipeline_layout: Long = 0
var pipeline: Long = 0
var pool: Long = 0
var sampler: Long = 0
var sets = List<Long>()
var set_views = List<Long>()
var set_buffers = List<Long>()
var buffers = List<Long>()
var memories = List<Long>()
var mapped = List<Long>()
var capacities = List<Integer>()
var built = List<Boolean>()
var published = List<Boolean>()
var built_frames = List<Integer>()
var pending = List<Scene.OcclusionMap>()
var owners = List<Scene.DrawSet>()

func create(renderer: RenderVulkan.Renderer) {
    shader = renderer.create_shader("shader.occlusion.compute")
    create_set_layout(renderer)
    create_pool(renderer)
    create_sampler(renderer)
    create_pipeline(renderer)
    var slot = 0
    while slot < renderer.frames_in_flight {
        add_slot(renderer)
        slot = slot + 1
    }
}

func create_set_layout(renderer: RenderVulkan.Renderer) {
    var no_allocator: Long = 0
    var compute_stage = 32
    var bindings = RenderVulkan.Structure(48)
    bindings.append_integer(0)
    bindings.append_integer(1)
    bindings.append_integer(1)
    bindings.append_integer(compute_stage)
    bindings.append_long(0)
    bindings.append_integer(1)
    bindings.append_integer(7)
    bindings.append_integer(1)
    bindings.append_integer(compute_stage)
    bindings.append_long(0)
    var creation = RenderVulkan.Structure(32)
    creation.append_integer(32)
    creation.append_long(0)
    creation.append_integer(0)
    creation.append_integer(2)
    creation.append_pointer(bindings)
    var made = RenderVulkan.Structure(8)
    var result = vulkan.vkCreateDescriptorSetLayout(renderer.device, creation.address, no_allocator, made.address)
    crash result == 0
    set_layout = made.read_long(0)
}

func create_pool(renderer: RenderVulkan.Renderer) {
    var no_allocator: Long = 0
    var frames = renderer.frames_in_flight
    var sizes = RenderVulkan.Structure(16)
    sizes.append_integer(1)
    sizes.append_integer(frames)
    sizes.append_integer(7)
    sizes.append_integer(frames)
    var creation = RenderVulkan.Structure(40)
    creation.append_integer(33)
    creation.append_long(0)
    creation.append_integer(0)
    creation.append_integer(frames)
    creation.append_integer(2)
    creation.append_pointer(sizes)
    var made = RenderVulkan.Structure(8)
    var result = vulkan.vkCreateDescriptorPool(renderer.device, creation.address, no_allocator, made.address)
    crash result == 0
    pool = made.read_long(0)
}

func create_sampler(renderer: RenderVulkan.Renderer) {
    var no_allocator: Long = 0
    var nearest = 0
    var clamp_to_edge = 2
    var creation = RenderVulkan.Structure(80)
    creation.append_integer(31)
    creation.append_long(0)
    creation.append_integer(0)
    creation.append_integer(nearest)
    creation.append_integer(nearest)
    creation.append_integer(0)
    creation.append_integer(clamp_to_edge)
    creation.append_integer(clamp_to_edge)
    creation.append_integer(clamp_to_edge)
    creation.append_float(0.0)
    creation.append_integer(0)
    creation.append_float(1.0)
    creation.append_integer(0)
    creation.append_integer(0)
    creation.append_float(0.0)
    creation.append_float(0.0)
    creation.append_integer(0)
    creation.append_integer(0)
    var made = RenderVulkan.Structure(8)
    var result = vulkan.vkCreateSampler(renderer.device, creation.address, no_allocator, made.address)
    crash result == 0
    sampler = made.read_long(0)
}

func create_pipeline(renderer: RenderVulkan.Renderer) {
    var no_allocator: Long = 0
    var compute_stage = 32
    var set_layouts = RenderVulkan.Structure(8)
    set_layouts.append_long(set_layout)
    var push_range = RenderVulkan.Structure(12)
    push_range.append_integer(compute_stage)
    push_range.append_integer(0)
    push_range.append_integer(push_bytes)
    var layout_creation = RenderVulkan.Structure(48)
    layout_creation.append_integer(30)
    layout_creation.append_long(0)
    layout_creation.append_integer(0)
    layout_creation.append_integer(1)
    layout_creation.append_pointer(set_layouts)
    layout_creation.append_integer(1)
    layout_creation.append_pointer(push_range)
    var made = RenderVulkan.Structure(8)
    var layout_result = vulkan.vkCreatePipelineLayout(
        renderer.device,
        layout_creation.address,
        no_allocator,
        made.address,
    )
    crash layout_result == 0
    pipeline_layout = made.read_long(0)
    var creation = RenderVulkan.Structure(96)
    creation.append_integer(29)
    creation.append_long(0)
    creation.append_integer(0)
    creation.append_integer(0)
    creation.append_integer(18)
    creation.append_long(0)
    creation.append_integer(0)
    creation.append_integer(compute_stage)
    creation.append_long(shader)
    creation.append_text("main")
    creation.append_long(0)
    creation.append_long(pipeline_layout)
    creation.append_long(0)
    creation.append_integer(-1)
    var no_cache: Long = 0
    var result = vulkan.vkCreateComputePipelines(
        renderer.device,
        no_cache,
        1,
        creation.address,
        no_allocator,
        made.address,
    )
    crash result == 0
    pipeline = made.read_long(0)
}

func add_slot(renderer: RenderVulkan.Renderer) {
    var layouts = RenderVulkan.Structure(8)
    layouts.append_long(set_layout)
    var allocation = RenderVulkan.Structure(40)
    allocation.append_integer(34)
    allocation.append_long(0)
    allocation.append_long(pool)
    allocation.append_integer(1)
    allocation.append_pointer(layouts)
    var made = RenderVulkan.Structure(8)
    var result = vulkan.vkAllocateDescriptorSets(renderer.device, allocation.address, made.address)
    crash result == 0
    var set = made.read_long(0)
    sets.append(set)
    set_views.append(0)
    set_buffers.append(0)
    buffers.append(0)
    memories.append(0)
    mapped.append(0)
    capacities.append(0)
    built.append(false)
    published.append(false)
    built_frames.append(0)
    var map = Scene.OcclusionMap()
    pending.append(map)
    var nobody = Scene.DrawSet()
    owners.append(nobody)
}

func publish(renderer: RenderVulkan.Renderer, slot: Integer) {
    var previous = (slot + renderer.frames_in_flight - 1) % renderer.frames_in_flight
    var newer = ready_to_publish(previous) and fence_signalled(renderer, previous)
    if ready_to_publish(slot) {
        var superseded = newer and owners[slot] == owners[previous]
        if superseded {
            published[slot] = true
        } else {
            publish_slot(slot)
        }
    }
    if newer {
        publish_slot(previous)
    }
}

func publish_finished(renderer: RenderVulkan.Renderer) {
    var slot = 0
    while slot < built.count() {
        if ready_to_publish(slot) and fence_signalled(renderer, slot) {
            publish_unless_superseded(renderer, slot)
        }
        slot = slot + 1
    }
}

func publish_unless_superseded(renderer: RenderVulkan.Renderer, slot: Integer) {
    var other = 0
    var superseded = false
    crash built_frames[slot]
    var built_at = built_frames[slot]
    while other < built_frames.count() {
        var newer = built_frames[other] > built_at and owners[other] == owners[slot]
        if other != slot and newer and ready_to_publish(other) and fence_signalled(renderer, other) {
            superseded = true
        }
        other = other + 1
    }
    if superseded {
        published[slot] = true
    } else {
        publish_slot(slot)
    }
}

func ready_to_publish(slot: Integer): Boolean {
    return built[slot] == true and published[slot] == false
}

func fence_signalled(renderer: RenderVulkan.Renderer, slot: Integer): Boolean {
    crash renderer.frames[slot]
    var frame = renderer.frames[slot]
    var signalled = vulkan.vkGetFenceStatus(renderer.device, frame.fence)
    return signalled == 0
}

func publish_slot(slot: Integer) {
    crash pending[slot]
    crash owners[slot]
    crash mapped[slot]
    var map = pending[slot]
    var owner = owners[slot]
    var at = mapped[slot]
    var count = map.columns() * map.rows()
    var index = 0
    while index < count {
        var depth = floats.read_value(at, index)
        map.depths.append(depth)
        index = index + 1
    }
    map.build_pyramid()
    var shown = owner.occlusion
    owner.occlusion = map
    shown.ready = false
    pending[slot] = shown
    published[slot] = true
}

func record(
    renderer: RenderVulkan.Renderer,
    drawn: Scene.DrawSet,
    camera: Scene.Component.ViewCamera,
    depth_image: Long,
    depth_view: Long,
    width: Integer,
    height: Integer,
    slot: Integer,
) {
    built[slot] = false
    if not drawn.culls_occluded {
        drawn.occlusion.ready = false
    }
    assert drawn.culls_occluded
    crash pending[slot]
    var map = pending[slot]
    map.begin(camera, width, height, block)
    var columns = map.columns()
    var rows = map.rows()
    ensure_buffer(renderer, slot, columns * rows * 4)
    write_set(renderer, slot, depth_view)
    var command_buffer = renderer.frame.command_buffer
    depth_to_read(renderer, depth_image)
    var timing = renderer.gpu_timings.begin("occlusion depth")
    var compute_bind_point = 1
    vulkan.vkCmdBindPipeline(command_buffer, compute_bind_point, pipeline)
    var bound = RenderVulkan.Structure(8)
    crash sets[slot]
    bound.append_long(sets[slot])
    var no_offsets: Long = 0
    vulkan.vkCmdBindDescriptorSets(
        command_buffer,
        compute_bind_point,
        pipeline_layout,
        0,
        1,
        bound.address,
        0,
        no_offsets,
    )
    var push = RenderVulkan.Structure(push_bytes)
    push.append_integer(width)
    push.append_integer(height)
    push.append_integer(columns)
    push.append_integer(rows)
    push.append_integer(block)
    var compute_stage = 32
    vulkan.vkCmdPushConstants(command_buffer, pipeline_layout, compute_stage, 0, push_bytes, push.address)
    var groups_across = (columns + 1) / 2
    var groups_down = (rows + 1) / 2
    vulkan.vkCmdDispatch(command_buffer, groups_across, groups_down, 1)
    renderer.gpu_timings.end(timing)
    results_to_host(renderer)
    owners[slot] = drawn
    built[slot] = true
    published[slot] = false
    built_frames[slot] = renderer.frame_number
}

func depth_to_read(renderer: RenderVulkan.Renderer, depth_image: Long) {
    var description = RenderVulkan.Structure(72)
    description.append_integer(45)
    description.append_long(0)
    var shader_read = 32
    description.append_integer(shader_read)
    description.append_integer(shader_read)
    var read_layout = 4
    description.append_integer(read_layout)
    description.append_integer(read_layout)
    description.append_integer(-1)
    description.append_integer(-1)
    description.append_long(depth_image)
    var depth_aspect = 2
    description.append_integer(depth_aspect)
    description.append_integer(0)
    description.append_integer(1)
    description.append_integer(0)
    description.append_integer(1)
    var fragment_shader = 128
    var compute_stage = 2048
    var no_barriers: Long = 0
    vulkan.vkCmdPipelineBarrier(
        renderer.frame.command_buffer,
        fragment_shader,
        compute_stage,
        0,
        0,
        no_barriers,
        0,
        no_barriers,
        1,
        description.address,
    )
}

func results_to_host(renderer: RenderVulkan.Renderer) {
    var memory_barrier = RenderVulkan.Structure(24)
    memory_barrier.append_integer(46)
    memory_barrier.append_long(0)
    var shader_write = 64
    var host_read = 8192
    memory_barrier.append_integer(shader_write)
    memory_barrier.append_integer(host_read)
    var compute_stage = 2048
    var host_stage = 16384
    var no_barriers: Long = 0
    vulkan.vkCmdPipelineBarrier(
        renderer.frame.command_buffer,
        compute_stage,
        host_stage,
        0,
        1,
        memory_barrier.address,
        0,
        no_barriers,
        0,
        no_barriers,
    )
}

func ensure_buffer(renderer: RenderVulkan.Renderer, slot: Integer, bytes: Integer) {
    crash capacities[slot]
    assert bytes > capacities[slot]
    release_buffer(renderer, slot)
    var storage_usage = 32
    var buffer = renderer.create_buffer(bytes, storage_usage)
    var memory = host_cached_memory_for(renderer, buffer)
    buffers[slot] = buffer
    memories[slot] = memory
    mapped[slot] = renderer.map(memory, bytes)
    capacities[slot] = bytes
}

func host_cached_memory_for(renderer: RenderVulkan.Renderer, buffer: Long): Long {
    var requirements = RenderVulkan.Structure(24)
    vulkan.vkGetBufferMemoryRequirements(renderer.device, buffer, requirements.address)
    var host_visible_coherent_cached = 14
    var host_visible_coherent = 6
    var wanted = host_visible_coherent
    var bits = requirements.read_integer(16)
    if has_memory_type(renderer, bits, host_visible_coherent_cached) {
        wanted = host_visible_coherent_cached
    }
    var memory = renderer.allocate_memory(requirements, wanted)
    var no_offset: Long = 0
    var result = vulkan.vkBindBufferMemory(renderer.device, buffer, memory, no_offset)
    crash result == 0
    return memory
}

func has_memory_type(renderer: RenderVulkan.Renderer, bits: Integer, wanted: Integer): Boolean {
    var properties = RenderVulkan.Structure(528)
    vulkan.vkGetPhysicalDeviceMemoryProperties(renderer.physical_device, properties.address)
    var count = properties.read_integer(0)
    var index = 0
    while index < count {
        var flags = properties.read_integer(4 + index * 8)
        var allowed = bits.shifted_right(index).bits_and(1) == 1
        if allowed and flags.bits_and(wanted) == wanted {
            return true
        }
        index = index + 1
    }
    return false
}

func write_set(renderer: RenderVulkan.Renderer, slot: Integer, depth_view: Long) {
    crash set_views[slot]
    crash set_buffers[slot]
    crash buffers[slot]
    crash sets[slot]
    assert set_views[slot] != depth_view or set_buffers[slot] != buffers[slot]
    set_views[slot] = depth_view
    set_buffers[slot] = buffers[slot]
    var image_information = RenderVulkan.Structure(24)
    image_information.append_long(sampler)
    image_information.append_long(depth_view)
    var read_layout = 4
    image_information.append_integer(read_layout)
    var whole: Long = -1
    var buffer_information = RenderVulkan.Structure(24)
    buffer_information.append_long(buffers[slot])
    buffer_information.append_long(0)
    buffer_information.append_long(whole)
    var writes = RenderVulkan.Structure(128)
    writes.append_integer(35)
    writes.append_long(0)
    writes.append_long(sets[slot])
    writes.append_integer(0)
    writes.append_integer(0)
    writes.append_integer(1)
    writes.append_integer(1)
    writes.append_pointer(image_information)
    writes.append_long(0)
    writes.append_long(0)
    writes.append_integer(35)
    writes.append_long(0)
    writes.append_long(sets[slot])
    writes.append_integer(1)
    writes.append_integer(0)
    writes.append_integer(1)
    writes.append_integer(7)
    writes.append_long(0)
    writes.append_pointer(buffer_information)
    writes.append_long(0)
    var no_copies: Long = 0
    vulkan.vkUpdateDescriptorSets(renderer.device, 2, writes.address, 0, no_copies)
}

func release_buffer(renderer: RenderVulkan.Renderer, slot: Integer) {
    crash buffers[slot]
    crash memories[slot]
    assert buffers[slot] != 0
    var no_allocator: Long = 0
    vulkan.vkDestroyBuffer(renderer.device, buffers[slot], no_allocator)
    vulkan.vkFreeMemory(renderer.device, memories[slot], no_allocator)
    buffers[slot] = 0
    memories[slot] = 0
    mapped[slot] = 0
    capacities[slot] = 0
}

func release(renderer: RenderVulkan.Renderer) {
    var no_allocator: Long = 0
    var slot = 0
    while slot < buffers.count() {
        release_buffer(renderer, slot)
        slot = slot + 1
    }
    vulkan.vkDestroyPipeline(renderer.device, pipeline, no_allocator)
    vulkan.vkDestroyPipelineLayout(renderer.device, pipeline_layout, no_allocator)
    vulkan.vkDestroyDescriptorPool(renderer.device, pool, no_allocator)
    vulkan.vkDestroyDescriptorSetLayout(renderer.device, set_layout, no_allocator)
    vulkan.vkDestroySampler(renderer.device, sampler, no_allocator)
    vulkan.vkDestroyShaderModule(renderer.device, shader, no_allocator)
    sets.clear()
    buffers.clear()
}
