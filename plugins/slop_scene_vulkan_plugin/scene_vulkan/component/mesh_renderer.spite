var cluster_memories = List<Long>()
var cluster_mapped = List<Long>()
var light_index_buffers = List<Long>()
var light_index_memories = List<Long>()
var light_index_mapped = List<Long>()
var light_index_capacities = List<Integer>()
var light_stride = 64
var shadow_pipeline: Long = 0
var shader_shadow_fragment: Long = 0
var shadow_image: Long = 0
var shadow_memory: Long = 0
var shadow_view: Long = 0
var shadow_sampler: Long = 0
var shadow_size = 2048
var light_view_projection = Math.Matrix4()
var floats = TypedMemory<Float>()
var scalar = Math.Scalar()
var depth_image: Long = 0
var depth_memory: Long = 0
var depth_view: Long = 0
var depth_width = 0
var depth_height = 0
var storage_sets = List<Long>()
