var vulkan = DynamicLibrary("vulkan-1.dll", 'identity', "")
var raw = Raw()
var floats = TypedMemory<Float>()
var builder = SceneVulkan.PipelineBuilder()
var grass = Scene.Grass()
var meshes = Scene.Meshes()
var created = false
var ground_size = 1024
var ground_format = 109
var ground_image: Long = 0
var ground_memory: Long = 0
var ground_view: Long = 0
var ground_depth_image: Long = 0
var ground_depth_memory: Long = 0
var ground_depth_view: Long = 0
var nearest_sampler: Long = 0
var linear_sampler: Long = 0
var shader_capture: Long = 0
var shader_scatter: Long = 0
var shader_vertex: Long = 0
var capture_pipeline: Long = 0
var scatter_set_layout: Long = 0
var scatter_layout: Long = 0
var scatter_pipeline: Long = 0
var draw_set_layout: Long = 0
var draw_layout: Long = 0
var draw_pipeline: Long = 0
var pool: Long = 0
var storage_usage = 32
var transfer_target = 2
var indirect_usage = 256
var kinds_buffer = SceneVulkan.GpuBuffer(34)
var instances_buffer = SceneVulkan.GpuBuffer(32)
var commands_buffer = SceneVulkan.GpuBuffer(290)
var frame_buffer = SceneVulkan.GpuBuffer(34)
var kind_bytes = 96
var instance_bytes = 32
var command_bytes = 20
var frame_bytes = 96
var scatter_sets = List<Long>()
var scatter_views = List<Long>()
var scatter_generations = List<Integer>()
var draw_set: Long = 0
var draw_generation = -1
var retired_sets = List<Long>()
var retired_at = List<Integer>()
var active = List<Integer>()
var active_columns = List<Integer>()
var active_first_command = List<Integer>()
var command_total = 0
var ground_center_x: Float = 0.0
var ground_center_z: Float = 0.0
var ground_half: Float = 16.0

func create(renderer: RenderVulkan.Renderer, mesh_renderer: SceneVulkan.MeshRenderer) {
    assert not created
    created = true
    shader_capture = renderer.create_shader("shader.grass.capture")
    shader_scatter = renderer.create_shader("shader.grass.scatter")
    shader_vertex = renderer.create_shader("shader.grass.vertex")
    nearest_sampler = builder.sampler(renderer, 0)
    linear_sampler = builder.sampler(renderer, 1)
    create_ground(renderer)
    var compute_stage = 32
    var scatter_kinds = List<Integer>()
    scatter_kinds.append(1)
    scatter_kinds.append(1)
    scatter_kinds.append(7)
    scatter_kinds.append(7)
    scatter_kinds.append(7)
    scatter_kinds.append(7)
    scatter_set_layout = builder.set_layout(renderer, scatter_kinds, compute_stage)
    var scatter_layouts = List<Long>()
    scatter_layouts.append(scatter_set_layout)
    scatter_layout = builder.pipeline_layout(renderer, scatter_layouts, 4, compute_stage)
    scatter_pipeline = builder.compute(renderer, shader_scatter, scatter_layout)
    var vertex_stage = 1
    var draw_kinds = List<Integer>()
    draw_kinds.append(7)
    draw_kinds.append(7)
    draw_kinds.append(7)
    draw_set_layout = builder.set_layout(renderer, draw_kinds, vertex_stage)
    var draw_layouts = List<Long>()
    draw_layouts.append(renderer.descriptor_layout)
    draw_layouts.append(mesh_renderer.storage_layout)
    draw_layouts.append(draw_set_layout)
    draw_layout = builder.pipeline_layout(renderer, draw_layouts, 72, vertex_stage)
    builder.color_format = 97
    builder.cull_mode = 0
    builder.mesh_vertices = true
    builder.depth_compare = 4
    builder.depth_write = 1
    builder.second_color_format = mesh_renderer.post.ambient_format
    draw_pipeline = builder.graphics(renderer, mesh_renderer, shader_vertex, mesh_renderer.shader_fragment, draw_layout)
    builder.second_color_format = 0
    builder.color_format = ground_format
    builder.depth_compare = 1
    capture_pipeline = builder.graphics(
        renderer,
        mesh_renderer,
        mesh_renderer.shader_vertex,
        shader_capture,
        mesh_renderer.pipeline_layout,
    )
    pool = builder.pool(renderer, 256)
}

func create_ground(renderer: RenderVulkan.Renderer) {
    var color_attachment_and_sampled = 20
    ground_image = builder.create_image(renderer, ground_size, ground_size, ground_format, color_attachment_and_sampled)
    ground_memory = builder.bind_image_memory(renderer, ground_image)
    var color_aspect = 1
    ground_view = builder.create_view(renderer, ground_image, ground_format, color_aspect)
    var depth_attachment = 32
    var depth_format = 126
    ground_depth_image = builder.create_image(renderer, ground_size, ground_size, depth_format, depth_attachment)
    ground_depth_memory = builder.bind_image_memory(renderer, ground_depth_image)
    var depth_aspect = 2
    ground_depth_view = builder.create_view(renderer, ground_depth_image, depth_format, depth_aspect)
}

func shaders_ready(renderer: RenderVulkan.Renderer): Boolean {
    var capture_ready = renderer.shader_ready("shader.grass.capture")
    var scatter_ready = renderer.shader_ready("shader.grass.scatter")
    var vertex_ready = renderer.shader_ready("shader.grass.vertex")
    return capture_ready and scatter_ready and vertex_ready
}

func prepare(
    renderer: RenderVulkan.Renderer,
    mesh_renderer: SceneVulkan.MeshRenderer,
    drawn: Scene.DrawSet,
    camera: Scene.Component.ViewCamera,
    view_projection: Matrix4,
    storage: RenderVulkan.Structure,
) {
    active.clear()
    release_retired(renderer)
    assert grass.count > 0 and drawn.terrain_draws.count() > 0
    var kinds = plan_kinds(renderer, mesh_renderer, camera)
    assert active.count() > 0
    ensure_buffers(renderer)
    var everything_before = 65536
    var transfer_stage = 4096
    var transfer_write = 4096
    builder.memory_barrier(renderer, everything_before, 0, transfer_stage, transfer_write)
    var active_count = active.count()
    kinds_buffer.update(renderer, kinds, active_count * kind_bytes)
    var commands = command_data(mesh_renderer)
    commands_buffer.update(renderer, commands, command_total * command_bytes)
    var frame = frame_data(camera, view_projection)
    frame_buffer.update(renderer, frame, frame_bytes)
    capture_ground(renderer, mesh_renderer, drawn, storage)
    var compute_stage = 2048
    var compute_vertex_and_indirect_stages = 2058
    var shader_and_indirect_access = 97
    builder.memory_barrier(
        renderer,
        transfer_stage,
        transfer_write,
        compute_vertex_and_indirect_stages,
        shader_and_indirect_access,
    )
    scatter(renderer)
    var indirect_and_vertex_stages = 10
    var indirect_and_shader_read = 33
    var shader_write = 64
    builder.memory_barrier(renderer, compute_stage, shader_write, indirect_and_vertex_stages, indirect_and_shader_read)
}

func plan_kinds(
    renderer: RenderVulkan.Renderer,
    mesh_renderer: SceneVulkan.MeshRenderer,
    camera: Scene.Component.ViewCamera,
): RenderVulkan.Structure {
    var data = RenderVulkan.Structure(grass.count * kind_bytes + 4)
    active_columns.clear()
    active_first_command.clear()
    var first_instance = 0
    var first_command = 0
    var farthest: Float = 16.0
    var index = 0
    while index < grass.count {
        var kind = grass.kinds[index]
        crash kind
        if kind_ready(renderer, mesh_renderer, kind) {
            var loaded = meshes.mesh_at(kind.mesh_slot)
            var density = kind.density.maximum(0.0001)
            var spacing = 1.0 / density.square_root()
            var end = kind.end_cull_distance
            var first_column: Integer = ((camera.eye_x - end) / spacing).floor()
            var first_row: Integer = ((camera.eye_z - end) / spacing).floor()
            var span: Integer = 2.0 * end / spacing
            var columns = span + 3
            var capacity = columns * columns
            var sections = loaded.sections.count() / 3
            var at = active.count() * kind_bytes
            raw.write_integer(data.address, at, first_column)
            raw.write_integer(data.address, at + 4, first_row)
            raw.write_integer(data.address, at + 8, columns)
            raw.write_integer(data.address, at + 12, kind.seed)
            var flags: Float = 0.0
            if kind.align_to_surface {
                flags = flags + 1.0
            }
            if kind.random_yaw {
                flags = flags + 2.0
            }
            var has_map: Float = 0.0
            if kind.density_texture >= 0 {
                has_map = 1.0
            }
            var channel: Float = kind.density_channel
            var mesh_height = loaded.bound_y + loaded.bound_radius
            write_floats(data, at + 16, spacing, kind.placement_jitter, kind.scale_minimum, kind.scale_maximum)
            write_floats(data, at + 32, kind.start_cull_distance, end, loaded.bound_radius, flags)
            write_floats(data, at + 48, kind.map_width, kind.map_depth, channel, has_map)
            raw.write_integer(data.address, at + 64, first_instance)
            raw.write_integer(data.address, at + 68, capacity)
            raw.write_integer(data.address, at + 72, first_command)
            raw.write_integer(data.address, at + 76, sections)
            write_floats(data, at + 80, kind.wind_strength, kind.wind_speed, mesh_height, loaded.bound_y)
            active.append(index)
            active_columns.append(columns)
            active_first_command.append(first_command)
            first_instance = first_instance + capacity
            first_command = first_command + sections
            if end > farthest {
                farthest = end
            }
        }
        index = index + 1
    }
    command_total = first_command
    var instances_wanted = first_instance * instance_bytes + 64
    if instances_wanted > instances_buffer.capacity {
        instances_buffer.ensure(renderer, instances_wanted)
    }
    var texel = 2.0 * (farthest + 4.0) / 1024.0
    ground_half = farthest + 4.0
    ground_center_x = (camera.eye_x / texel).floor() * texel
    ground_center_z = (camera.eye_z / texel).floor() * texel
    return data
}

func kind_ready(
    renderer: RenderVulkan.Renderer,
    mesh_renderer: SceneVulkan.MeshRenderer,
    kind: Scene.GrassKind,
): Boolean {
    if not meshes.is_ready(kind.mesh_slot) or not mesh_renderer.mesh_uploaded(kind.mesh_slot) {
        return false
    }
    if kind.density_texture >= 0 and renderer.texture_view(kind.density_texture) == 0 {
        return false
    }
    return kind.density > 0.0 and kind.end_cull_distance > 0.0
}

func write_floats(data: RenderVulkan.Structure, at: Integer, first: Float, second: Float, third: Float, fourth: Float) {
    floats.write_value(data.address + at, 0, first)
    floats.write_value(data.address + at, 1, second)
    floats.write_value(data.address + at, 2, third)
    floats.write_value(data.address + at, 3, fourth)
}

func ensure_buffers(renderer: RenderVulkan.Renderer) {
    var kinds_wanted = active.count() * kind_bytes
    if kinds_wanted > kinds_buffer.capacity {
        kinds_buffer.ensure(renderer, kinds_wanted)
    }
    var commands_wanted = command_total * command_bytes + 64
    if commands_wanted > commands_buffer.capacity {
        commands_buffer.ensure(renderer, commands_wanted)
    }
    if frame_buffer.capacity < frame_bytes {
        frame_buffer.ensure(renderer, frame_bytes)
    }
}

func generation(): Integer {
    return kinds_buffer.generation + instances_buffer.generation * 1000 + commands_buffer.generation * 1000000
}

func command_data(mesh_renderer: SceneVulkan.MeshRenderer): RenderVulkan.Structure {
    var data = RenderVulkan.Structure(command_total * command_bytes + 4)
    var place = 0
    while place < active.count() {
        crash active_first_command[place]
        var kind_index = active[place]
        var kind = grass.kinds[kind_index]
        crash kind
        var loaded = meshes.mesh_at(kind.mesh_slot)
        var section = 0
        while section * 3 + 2 < loaded.sections.count() {
            var at = (active_first_command[place] + section) * command_bytes
            raw.write_integer(data.address, at, loaded.sections[section * 3 + 1])
            raw.write_integer(data.address, at + 4, 0)
            raw.write_integer(data.address, at + 8, loaded.sections[section * 3])
            raw.write_integer(data.address, at + 12, 0)
            raw.write_integer(data.address, at + 16, 0)
            section = section + 1
        }
        place = place + 1
    }
    return data
}

func frame_data(camera: Scene.Component.ViewCamera, view_projection: Matrix4): RenderVulkan.Structure {
    var data = RenderVulkan.Structure(frame_bytes)
    var matrix = view_projection
    write_plane(
        data,
        0,
        matrix.column_0_row_3 + matrix.column_0_row_0,
        matrix.column_1_row_3 + matrix.column_1_row_0,
        matrix.column_2_row_3 + matrix.column_2_row_0,
        matrix.column_3_row_3 + matrix.column_3_row_0,
    )
    write_plane(
        data,
        16,
        matrix.column_0_row_3 - matrix.column_0_row_0,
        matrix.column_1_row_3 - matrix.column_1_row_0,
        matrix.column_2_row_3 - matrix.column_2_row_0,
        matrix.column_3_row_3 - matrix.column_3_row_0,
    )
    write_plane(
        data,
        32,
        matrix.column_0_row_3 + matrix.column_0_row_1,
        matrix.column_1_row_3 + matrix.column_1_row_1,
        matrix.column_2_row_3 + matrix.column_2_row_1,
        matrix.column_3_row_3 + matrix.column_3_row_1,
    )
    write_plane(
        data,
        48,
        matrix.column_0_row_3 - matrix.column_0_row_1,
        matrix.column_1_row_3 - matrix.column_1_row_1,
        matrix.column_2_row_3 - matrix.column_2_row_1,
        matrix.column_3_row_3 - matrix.column_3_row_1,
    )
    write_floats(data, 64, camera.eye_x, camera.eye_y, camera.eye_z, grass.time_seconds)
    var texels: Float = ground_size
    write_floats(data, 80, ground_center_x, ground_center_z, ground_half, texels)
    return data
}

func write_plane(
    data: RenderVulkan.Structure,
    at: Integer,
    normal_x: Float,
    normal_y: Float,
    normal_z: Float,
    offset: Float,
) {
    var length = (normal_x * normal_x + normal_y * normal_y + normal_z * normal_z).square_root()
    write_floats(data, at, normal_x / length, normal_y / length, normal_z / length, offset / length)
}

func capture_ground(
    renderer: RenderVulkan.Renderer,
    mesh_renderer: SceneVulkan.MeshRenderer,
    drawn: Scene.DrawSet,
    storage: RenderVulkan.Structure,
) {
    var command_buffer = renderer.frame.command_buffer
    var compute_stage = 2048
    var color_output_stage = 1024
    var color_write = 256
    var color_aspect = 1
    var undefined_layout = 0
    var color_layout = 2
    builder.image_barrier(
        renderer,
        ground_image,
        color_aspect,
        undefined_layout,
        color_layout,
        compute_stage,
        0,
        color_output_stage,
        color_write,
    )
    var depth_aspect = 2
    var depth_layout = 3
    var depth_tests = 768
    var depth_write = 1536
    builder.image_barrier(
        renderer,
        ground_depth_image,
        depth_aspect,
        undefined_layout,
        depth_layout,
        depth_tests,
        0,
        depth_tests,
        depth_write,
    )
    var color = builder.attachment(ground_view, color_layout, 1, 0)
    floats.write_value(color.address + 52, 0, -1000000000.0)
    floats.write_value(color.address + 52, 2, 1.0)
    var depth = builder.attachment(ground_depth_view, depth_layout, 1, 1)
    floats.write_value(depth.address + 52, 0, 1.0)
    builder.begin_rendering(renderer, ground_size, ground_size, color, depth)
    vulkan.vkCmdBindPipeline(command_buffer, 0, capture_pipeline)
    set_viewport(renderer, ground_size, ground_size)
    var no_offsets: Long = 0
    vulkan.vkCmdBindDescriptorSets(
        command_buffer,
        0,
        mesh_renderer.pipeline_layout,
        1,
        1,
        storage.address,
        0,
        no_offsets,
    )
    var from_above = ground_view_projection()
    var first_terrain = drawn.draws.count()
    var index = 0
    while index < drawn.terrain_draws.count() {
        var cell = drawn.terrain_draws[index]
        if mesh_renderer.mesh_uploaded(cell.mesh_slot) {
            mesh_renderer.push_and_draw(
                renderer,
                cell.mesh_slot,
                cell.first_index,
                cell.index_count,
                first_terrain + index,
                1,
                from_above,
                mesh_renderer.pipeline_layout,
            )
        }
        index = index + 1
    }
    vulkan.vkCmdEndRendering(command_buffer)
    var shader_read_layout = 5
    var shader_read = 32
    builder.image_barrier(
        renderer,
        ground_image,
        color_aspect,
        color_layout,
        shader_read_layout,
        color_output_stage,
        color_write,
        compute_stage,
        shader_read,
    )
}

func ground_view_projection(): Matrix4 {
    var matrix = Matrix4()
    var top: Float = 5000.0
    var depth_range: Float = 10000.0
    matrix.column_0_row_0 = 1.0 / ground_half
    matrix.column_1_row_1 = 0.0
    matrix.column_2_row_2 = 0.0
    matrix.column_3_row_0 = 0.0 - ground_center_x / ground_half
    matrix.column_2_row_1 = 1.0 / ground_half
    matrix.column_3_row_1 = 0.0 - ground_center_z / ground_half
    matrix.column_1_row_2 = -1.0 / depth_range
    matrix.column_3_row_2 = top / depth_range
    matrix.column_3_row_3 = 1.0
    return matrix
}

func scatter(renderer: RenderVulkan.Renderer) {
    var command_buffer = renderer.frame.command_buffer
    vulkan.vkCmdBindPipeline(command_buffer, 1, scatter_pipeline)
    var place = 0
    while place < active.count() {
        crash active_columns[place]
        var kind_index = active[place]
        var kind = grass.kinds[kind_index]
        crash kind
        var set = scatter_set_for(renderer, place, kind)
        var sets = RenderVulkan.Structure(8)
        sets.append_long(set)
        var no_offsets: Long = 0
        vulkan.vkCmdBindDescriptorSets(command_buffer, 1, scatter_layout, 0, 1, sets.address, 0, no_offsets)
        var push = RenderVulkan.Structure(4)
        push.append_integer(place)
        var compute_stage = 32
        vulkan.vkCmdPushConstants(command_buffer, scatter_layout, compute_stage, 0, 4, push.address)
        var groups = (active_columns[place] + 7) / 8
        vulkan.vkCmdDispatch(command_buffer, groups, groups, 1)
        place = place + 1
    }
}

func scatter_set_for(renderer: RenderVulkan.Renderer, place: Integer, kind: Scene.GrassKind): Long {
    while scatter_sets.count() <= place {
        scatter_sets.append(0)
        scatter_views.append(0)
        scatter_generations.append(-1)
    }
    var view = renderer.white_view
    if kind.density_texture >= 0 {
        view = renderer.texture_view(kind.density_texture)
    }
    var current = generation()
    crash scatter_sets[place]
    crash scatter_views[place]
    crash scatter_generations[place]
    var existing = scatter_sets[place]
    if existing != 0 and scatter_views[place] == view and scatter_generations[place] == current {
        return existing
    }
    if existing != 0 {
        retire(renderer, existing)
    }
    var set = builder.allocate_set(renderer, pool, scatter_set_layout)
    var ground_information = builder.image_information(nearest_sampler, ground_view, 5)
    var density_information = builder.image_information(linear_sampler, view, 5)
    var kinds_information = kinds_buffer.describe()
    var instances_information = instances_buffer.describe()
    var commands_information = commands_buffer.describe()
    var frame_information = frame_buffer.describe()
    var writes = RenderVulkan.Structure(384)
    builder.append_image_write(writes, set, 0, ground_information)
    builder.append_image_write(writes, set, 1, density_information)
    builder.append_buffer_write(writes, set, 2, kinds_information)
    builder.append_buffer_write(writes, set, 3, instances_information)
    builder.append_buffer_write(writes, set, 4, commands_information)
    builder.append_buffer_write(writes, set, 5, frame_information)
    var no_copies: Long = 0
    vulkan.vkUpdateDescriptorSets(renderer.device, 6, writes.address, 0, no_copies)
    scatter_sets[place] = set
    scatter_views[place] = view
    scatter_generations[place] = current
    return set
}

func draw_set_now(renderer: RenderVulkan.Renderer): Long {
    var current = generation()
    if draw_set != 0 and draw_generation == current {
        return draw_set
    }
    if draw_set != 0 {
        retire(renderer, draw_set)
    }
    draw_set = builder.allocate_set(renderer, pool, draw_set_layout)
    var kinds_information = kinds_buffer.describe()
    var instances_information = instances_buffer.describe()
    var frame_information = frame_buffer.describe()
    var writes = RenderVulkan.Structure(192)
    builder.append_buffer_write(writes, draw_set, 0, kinds_information)
    builder.append_buffer_write(writes, draw_set, 1, instances_information)
    builder.append_buffer_write(writes, draw_set, 2, frame_information)
    var no_copies: Long = 0
    vulkan.vkUpdateDescriptorSets(renderer.device, 3, writes.address, 0, no_copies)
    draw_generation = current
    return draw_set
}

func draw(
    renderer: RenderVulkan.Renderer,
    mesh_renderer: SceneVulkan.MeshRenderer,
    storage: RenderVulkan.Structure,
    view_projection: Matrix4,
) {
    assert active.count() > 0
    var command_buffer = renderer.frame.command_buffer
    vulkan.vkCmdBindPipeline(command_buffer, 0, draw_pipeline)
    var no_offsets: Long = 0
    vulkan.vkCmdBindDescriptorSets(command_buffer, 0, draw_layout, 1, 1, storage.address, 0, no_offsets)
    var set = draw_set_now(renderer)
    var sets = RenderVulkan.Structure(8)
    sets.append_long(set)
    vulkan.vkCmdBindDescriptorSets(command_buffer, 0, draw_layout, 2, 1, sets.address, 0, no_offsets)
    var place = 0
    while place < active.count() {
        crash active_first_command[place]
        var kind_index = active[place]
        var kind = grass.kinds[kind_index]
        crash kind
        draw_kind(renderer, mesh_renderer, kind, place, active_first_command[place], view_projection)
        place = place + 1
    }
}

func draw_kind(
    renderer: RenderVulkan.Renderer,
    mesh_renderer: SceneVulkan.MeshRenderer,
    kind: Scene.GrassKind,
    place: Integer,
    first_command: Integer,
    view_projection: Matrix4,
) {
    var command_buffer = renderer.frame.command_buffer
    var loaded = meshes.mesh_at(kind.mesh_slot)
    var gpu = mesh_renderer.gpu_mesh_of(kind.mesh_slot)
    crash gpu
    var buffers = RenderVulkan.Structure(8)
    buffers.append_long(gpu.vertex_buffer)
    var offsets = RenderVulkan.Structure(8)
    offsets.append_long(0)
    vulkan.vkCmdBindVertexBuffers(command_buffer, 0, 1, buffers.address, offsets.address)
    var no_offset: Long = 0
    vulkan.vkCmdBindIndexBuffer(command_buffer, gpu.index_buffer, no_offset, 1)
    var no_offsets: Long = 0
    var section = 0
    while section * 3 + 2 < loaded.sections.count() {
        var texture_slot = -1
        if section < kind.section_textures.count() {
            texture_slot = kind.section_textures[section]
        }
        var texture_set = mesh_renderer.scene_set(renderer, texture_slot)
        var sets = RenderVulkan.Structure(8)
        sets.append_long(texture_set)
        vulkan.vkCmdBindDescriptorSets(command_buffer, 0, draw_layout, 0, 1, sets.address, 0, no_offsets)
        var material = loaded.sections[section * 3 + 2]
        var masked = 0
        if loaded.masked_materials.contains(material) {
            masked = 1
        }
        var push = RenderVulkan.Structure(72)
        view_projection.write_to(floats, push.address)
        raw.write_integer(push.address, 64, place)
        raw.write_integer(push.address, 68, masked)
        var vertex_stage = 1
        vulkan.vkCmdPushConstants(command_buffer, draw_layout, vertex_stage, 0, 72, push.address)
        var offset: Long = (first_command + section) * command_bytes
        vulkan.vkCmdDrawIndexedIndirect(command_buffer, commands_buffer.buffer, offset, 1, command_bytes)
        section = section + 1
    }
}

func retire(renderer: RenderVulkan.Renderer, set: Long) {
    retired_sets.append(set)
    retired_at.append(renderer.frame_number)
}

func release_retired(renderer: RenderVulkan.Renderer) {
    var index = retired_sets.count() - 1
    while index >= 0 {
        crash retired_at[index]
        if retired_at[index] + renderer.frames_in_flight < renderer.frame_number {
            crash retired_sets[index]
            var freed = RenderVulkan.Structure(8)
            freed.append_long(retired_sets[index])
            vulkan.vkFreeDescriptorSets(renderer.device, pool, 1, freed.address)
            retired_sets.remove_at(index)
            retired_at.remove_at(index)
        }
        index = index - 1
    }
}

func release(renderer: RenderVulkan.Renderer) {
    assert created
    var no_allocator: Long = 0
    if kinds_buffer.buffer != 0 {
        kinds_buffer.release(renderer)
    }
    if instances_buffer.buffer != 0 {
        instances_buffer.release(renderer)
    }
    if commands_buffer.buffer != 0 {
        commands_buffer.release(renderer)
    }
    if frame_buffer.buffer != 0 {
        frame_buffer.release(renderer)
    }
    vulkan.vkDestroyDescriptorPool(renderer.device, pool, no_allocator)
    vulkan.vkDestroyPipeline(renderer.device, capture_pipeline, no_allocator)
    vulkan.vkDestroyPipeline(renderer.device, scatter_pipeline, no_allocator)
    vulkan.vkDestroyPipeline(renderer.device, draw_pipeline, no_allocator)
    vulkan.vkDestroyPipelineLayout(renderer.device, scatter_layout, no_allocator)
    vulkan.vkDestroyPipelineLayout(renderer.device, draw_layout, no_allocator)
    vulkan.vkDestroyDescriptorSetLayout(renderer.device, scatter_set_layout, no_allocator)
    vulkan.vkDestroyDescriptorSetLayout(renderer.device, draw_set_layout, no_allocator)
    vulkan.vkDestroySampler(renderer.device, nearest_sampler, no_allocator)
    vulkan.vkDestroySampler(renderer.device, linear_sampler, no_allocator)
    vulkan.vkDestroyImageView(renderer.device, ground_view, no_allocator)
    vulkan.vkDestroyImage(renderer.device, ground_image, no_allocator)
    vulkan.vkFreeMemory(renderer.device, ground_memory, no_allocator)
    vulkan.vkDestroyImageView(renderer.device, ground_depth_view, no_allocator)
    vulkan.vkDestroyImage(renderer.device, ground_depth_image, no_allocator)
    vulkan.vkFreeMemory(renderer.device, ground_depth_memory, no_allocator)
    vulkan.vkDestroyShaderModule(renderer.device, shader_capture, no_allocator)
    vulkan.vkDestroyShaderModule(renderer.device, shader_scatter, no_allocator)
    vulkan.vkDestroyShaderModule(renderer.device, shader_vertex, no_allocator)
}

func set_viewport(renderer: RenderVulkan.Renderer, width: Integer, height: Integer) {
    var command_buffer = renderer.frame.command_buffer
    var viewport = RenderVulkan.Structure(24)
    viewport.append_float(0.0)
    viewport.append_float(0.0)
    viewport.append_float(width)
    viewport.append_float(height)
    viewport.append_float(0.0)
    viewport.append_float(1.0)
    vulkan.vkCmdSetViewport(command_buffer, 0, 1, viewport.address)
    var scissor = RenderVulkan.Structure(16)
    scissor.append_integer(0)
    scissor.append_integer(0)
    scissor.append_integer(width)
    scissor.append_integer(height)
    vulkan.vkCmdSetScissor(command_buffer, 0, 1, scissor.address)
}
