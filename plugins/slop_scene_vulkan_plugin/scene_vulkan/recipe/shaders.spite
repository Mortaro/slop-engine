var glsl = Recipes.Glsl()

func build() {
    var recipe_folder = class.source_folder()
    var root = "{recipe_folder}/.."
    glsl.compile(root, "shader.scene.vertex", "vert")
    glsl.compile(root, "shader.scene.fragment", "frag")
    glsl.compile(root, "shader.scene.terrain", "frag")
    glsl.compile(root, "shader.shadow.fragment", "frag")
    glsl.compile(root, "shader.tone_map.vertex", "vert")
    glsl.compile(root, "shader.tone_map.fragment", "frag")
}
