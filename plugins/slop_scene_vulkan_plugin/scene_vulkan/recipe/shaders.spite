var glsl = Recipes.Glsl()

func build() {
    var recipe_folder = class.source_folder()
    var root = "{recipe_folder}/.."
    glsl.compile(root, "shader.scene.vertex", "vert")
    glsl.compile(root, "shader.scene.fragment", "frag")
    glsl.compile(root, "shader.scene.terrain", "frag")
    glsl.compile(root, "shader.shadow.fragment", "frag")
    glsl.compile(root, "shader.tone_map.vertex", "vert")
    glsl.compile(root, "shader.tone_map.fragment", "frag")
    glsl.compile(root, "shader.grass.capture", "frag")
    glsl.compile(root, "shader.grass.scatter", "comp")
    glsl.compile(root, "shader.grass.vertex", "vert")
    glsl.compile(root, "shader.water.vertex", "vert")
    glsl.compile(root, "shader.water.fragment", "frag")
    glsl.compile(root, "shader.post.ambient_occlusion", "frag")
    glsl.compile(root, "shader.post.temporal", "frag")
    glsl.compile(root, "shader.post.histogram", "comp")
    glsl.compile(root, "shader.post.adapt", "comp")
    glsl.compile(root, "shader.post.bloom_down", "frag")
    glsl.compile(root, "shader.post.bloom_blur", "frag")
    glsl.compile(root, "shader.occlusion.compute", "comp")
}
