singleton

var raw = Raw()
var heap = Memory.Heap()
var shared: Long = 0
var thread: Parallel<Nothing>? = null
var request_slots = 16
var request_bytes = 64
var event_capacity = 4096
var event_bytes = 32
var kernel = DynamicLibrary("kernel32.dll", 'identity', "")

func requests_at(): Long {
    return shared + 32
}

func events_at(): Long {
    var request_area = request_slots * request_bytes
    return shared + 32 + request_area
}

func start() {
    assert shared == 0
    var event_area = event_capacity * event_bytes
    var request_area = request_slots * request_bytes
    var bytes = 32 + request_area + event_area
    shared = heap.allocate(bytes)
    var offset = 0
    while offset < bytes {
        raw.write_long(shared, offset, 0)
        offset = offset + 8
    }
    var pump = Windows.Pump(shared)
    var started = Parallel(pump.run)
    thread = started
}

func lock() {
    kernel.AcquireSRWLockExclusive(shared)
}

func unlock() {
    kernel.ReleaseSRWLockExclusive(shared)
}

func request(window: Window.Component.Window): Integer {
    start()
    lock()
    var slot = free_slot()
    crash slot >= 0
    var at = requests_at() + slot * request_bytes
    var title_length = window.title.length()
    var title = heap.allocate(title_length + 1)
    var index = 0
    while index < title_length {
        var code = window.title.code_at(index)
        raw.write_byte(title, index, code)
        index = index + 1
    }
    raw.write_byte(title, title_length, 0)
    var width: Long = window.width
    var height: Long = window.height
    var visible: Long = 0
    if window.visible {
        visible = 1
    }
    var wide_length: Long = title_length
    raw.write_long(at, 8, width)
    raw.write_long(at, 16, height)
    raw.write_long(at, 24, visible)
    raw.write_long(at, 32, title)
    raw.write_long(at, 40, wide_length)
    raw.write_long(at, 48, 0)
    raw.write_long(at, 0, 1)
    unlock()
    return slot
}

func free_slot(): Integer {
    var slot = 0
    while slot < request_slots {
        var at = requests_at() + slot * request_bytes
        if raw.read_long(at, 0) == 0 {
            return slot
        }
        slot = slot + 1
    }
    return -1
}

func take_handle(slot: Integer): Long {
    lock()
    var at = requests_at() + slot * request_bytes
    var created = raw.read_long(at, 0) == 2
    var handle: Long = 0
    if created {
        handle = raw.read_long(at, 48)
        raw.write_long(at, 0, 0)
    }
    unlock()
    return handle
}

func take_events(): List<Long> {
    var taken = List<Long>()
    assert shared != 0
    lock()
    var count = raw.read_long(shared, 16)
    var events = events_at()
    var index = 0
    while count * 4 > index {
        var value = raw.read_long(events, index * 8)
        taken.append(value)
        index = index + 1
    }
    raw.write_long(shared, 16, 0)
    unlock()
    return taken
}

func stop() {
    assert thread
    lock()
    raw.write_long(shared, 8, 1)
    unlock()
    thread = null
}

func drop() {
    assert shared != 0
    heap.free(shared)
}
