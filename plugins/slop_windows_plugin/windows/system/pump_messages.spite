type OpenedWindow {
    entity: Entity
    window: Window.Component.Window
    handle: Window.Component.Handle
}

var user = DynamicLibrary("user32.dll", 'identity', "")
var heap = Memory.Heap()
var raw = Raw()

var world = World()
var double_click = false

func input_all(windows: List<OpenedWindow>) {
    var message = heap.allocate(48)
    var every_window: Long = 0
    var remove_from_queue = 1
    while user.PeekMessageA(message, every_window, 0, 0, remove_from_queue) != 0 {
        deliver(windows, message)
        user.TranslateMessage(message)
        user.DispatchMessageA(message)
    }
    heap.free(message)
    windows.each(notice_closed)
}

func deliver(windows: List<OpenedWindow>, message: Long) {
    var kind = raw.read_integer(message, 8)
    var mouse = kind >= 512 and kind <= 522
    var keys = kind == 256 or kind == 257 or kind == 258
    assert mouse or keys
    var target = raw.read_long(message, 0)
    var word = raw.read_long(message, 16)
    var position = raw.read_long(message, 24)
    double_click = false
    var event = translate(kind, word, position)
    assert event
    var index = 0
    while index < windows.count() {
        var opened = windows[index]
        if opened.handle.value == target {
            spawn_event(opened.entity, event)
        }
        index = index + 1
    }
}

func spawn_event(window: Entity, event: Input.Component.Event) {
    var arrived = window.create_entity()
    arrived.add_component(event)
    assert double_click
    var marker = Input.Component.DoubleClick()
    arrived.add_component(marker)
}

func translate(kind: Integer, word: Long, position: Long): Input.Component.Event? {
    var event = Input.Component.Event()
    event.left = position % 65536
    event.top = position / 65536 % 65536
    if kind == 512 {
        event.kind = 'pointer_moved'
    } else if kind >= 513 and kind <= 521 {
        press_or_release(event, kind)
    } else if kind == 522 {
        event.kind = 'wheel_turned'
        event.wheel = wheel_notches(word)
    } else if kind == 256 {
        event.kind = 'key_pressed'
        event.key = key_of(word)
    } else if kind == 257 {
        event.kind = 'key_released'
        event.key = key_of(word)
    } else if kind == 258 {
        return typed(word)
    } else {
        return null
    }
    return event
}

func press_or_release(event: Input.Component.Event, kind: Integer) {
    var offset = kind - 513
    event.button = offset / 3
    var step = offset % 3
    if step == 1 {
        event.kind = 'button_released'
    } else {
        event.kind = 'button_pressed'
        double_click = step == 2
    }
}

func key_of(word: Long): Integer {
    return word % 65536
}

func wheel_notches(word: Long): Integer {
    var delta: Integer = word / 65536 % 65536
    if delta >= 32768 {
        delta = delta - 65536
    }
    return delta / 120
}

func typed(word: Long): Input.Component.Event? {
    var code: Integer = word % 65536
    var printable = code >= 32 and code != 127 and code < 256
    assert printable
    var one = heap.allocate(1)
    raw.write_byte(one, 0, code)
    var event = Input.Component.Event()
    event.kind = 'character_typed'
    event.character = raw.text(one, 1)
    heap.free(one)
    return event
}

func notice_closed(opened: OpenedWindow) {
    var handle = opened.handle.value
    assert handle != 0 and user.IsWindow(handle) == 0
    opened.entity.remove()
    var quit = Component.Quit()
    var shelf = world.as_entity()
    shelf.add_component(quit)
}
