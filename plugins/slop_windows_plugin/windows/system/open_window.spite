type PendingWindow {
    entity: Entity
    window: Window.Component.Window
    requested: Window.Component.Requested
}

var owner = Windows.Owner()

func input_each(pending: PendingWindow) {
    var opening = Window.Component.Opening()
    var hidden = Lookup<Window.Component.Hidden>().has(pending.entity.id)
    opening.slot = owner.request(pending.window, hidden)
    pending.entity.add_component(opening)
    pending.entity.remove_component(Window.Component.Requested)
}
