type PendingWindow {
    entity: Entity
    window: Window.Component.Window
    unopened: Without<Window.Component.Handle>
}

var window_class = Windows.WindowClass()
var hiddens = Lookup<Window.Component.Hidden>()

func input_each(pending: PendingWindow) {
    var hidden = hiddens.has(pending.entity.id)
    var handle = Window.Component.Handle()
    handle.value = window_class.create(pending.window, hidden)
    pending.entity.add_component(handle)
}
