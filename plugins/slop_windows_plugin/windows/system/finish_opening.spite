type OpeningWindow {
    entity: Entity
    opening: Window.Component.Opening
    handle: Window.Component.Handle
}

var owner = Windows.Owner()

func after_input_each(opening: OpeningWindow) {
    var handle = owner.take_handle(opening.opening.slot)
    assert handle != 0
    opening.handle.value = handle
    opening.entity.remove_component(Window.Component.Opening)
}
