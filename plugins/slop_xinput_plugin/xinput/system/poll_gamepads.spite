type Pad {
    entity: Entity
    gamepad: Input.Component.Gamepad
}

type PadButton {
    entity: Entity
    button: Input.Component.GamepadButton
    parent: Component.Parent
}

var xinput = DynamicLibrary("xinput1_4.dll", 'identity', "")
var world = World()
var raw = Raw()
var heap = Memory.Heap()
var buttons = Input.Button()
var ticks = 0
var disconnected_every = 60
var slots = 4
var connected_pads = Lookup<Input.Component.GamepadConnected>()
var just_pressed = Lookup<Input.Component.JustPressed>()
var just_released = Lookup<Input.Component.JustReleased>()
var now = List<Integer>()
var held_codes = List<Integer>()

func input_all(pads: List<Pad>, buttons: List<PadButton>) {
    ticks = ticks + 1
    var state = heap.allocate(16)
    var slot = 0
    while slot < slots {
        poll_slot(pads, buttons, slot, state)
        slot = slot + 1
    }
    heap.free(state)
}

func poll_slot(pads: List<Pad>, buttons: List<PadButton>, slot: Integer, state: Long) {
    var pad = pad_of(pads, slot)
    var due = ticks % disconnected_every == 1
    if pad {
        if connected_pads.has(pad.entity.id) {
            due = true
        }
    }
    assert due
    var result = xinput.XInputGetState(slot, state)
    var connected = result == 0
    if pad {
        read_pad(pad.gamepad, connected, state)
        settle_buttons(pad.entity, buttons)
        mark_connected(pad.entity, connected)
    } else if connected {
        var gamepad = Input.Component.Gamepad()
        gamepad.slot = slot
        read_pad(gamepad, connected, state)
        var entity = world.create_entity()
        entity.add_component(gamepad)
        var marker = Input.Component.GamepadConnected()
        entity.add_component(marker)
        settle_buttons(entity, buttons)
    }
}

func mark_connected(owner: Entity, connected: Boolean) {
    var was = connected_pads.has(owner.id)
    if connected and not was {
        var marker = Input.Component.GamepadConnected()
        owner.add_component(marker)
    } else if was and not connected {
        owner.remove_component(Input.Component.GamepadConnected)
    }
}

func pad_of(pads: List<Pad>, slot: Integer): Pad? {
    var index = 0
    while index < pads.count() {
        if pads[index].gamepad.slot == slot {
            return pads[index]
        }
        index = index + 1
    }
    return null
}

func read_pad(gamepad: Input.Component.Gamepad, connected: Boolean, state: Long) {
    now.clear()
    if connected {
        var bits = unsigned_short(state, 4)
        collect_buttons(bits, now)
        gamepad.left_trigger = trigger(state, 6)
        gamepad.right_trigger = trigger(state, 7)
        gamepad.left_x = axis(state, 8, 7849.0)
        gamepad.left_y = axis(state, 10, 7849.0)
        gamepad.right_x = axis(state, 12, 8689.0)
        gamepad.right_y = axis(state, 14, 8689.0)
    }
}

func settle_buttons(pad: Entity, buttons: List<PadButton>) {
    held_codes.clear()
    var index = 0
    while index < buttons.count() {
        settle_button(pad.id, buttons[index])
        index = index + 1
    }
    index = 0
    while index < now.count() {
        press_new(pad, now[index])
        index = index + 1
    }
}

func settle_button(pad: Integer, held: PadButton) {
    assert held.parent.entity.id == pad
    var button = held.entity
    if just_released.has(button.id) {
        button.remove()
        return
    }
    if just_pressed.has(button.id) {
        button.remove_component(Input.Component.JustPressed)
    }
    var code = held.button.code
    if now.contains(code) {
        held_codes.append(code)
        return
    }
    var marker = Input.Component.JustReleased()
    button.add_component(marker)
}

func press_new(pad: Entity, code: Integer) {
    assert not held_codes.contains(code)
    var button = pad.create_entity()
    var held = Input.Component.GamepadButton()
    held.code = code
    button.add_component(held)
    var marker = Input.Component.JustPressed()
    button.add_component(marker)
}

func collect_buttons(bits: Integer, held_now: List<Integer>) {
    add_if(bits, 1, buttons.up, held_now)
    add_if(bits, 2, buttons.down, held_now)
    add_if(bits, 4, buttons.left, held_now)
    add_if(bits, 8, buttons.right, held_now)
    add_if(bits, 16, buttons.start, held_now)
    add_if(bits, 32, buttons.select, held_now)
    add_if(bits, 64, buttons.left_stick, held_now)
    add_if(bits, 128, buttons.right_stick, held_now)
    add_if(bits, 256, buttons.left_shoulder, held_now)
    add_if(bits, 512, buttons.right_shoulder, held_now)
    add_if(bits, 4096, buttons.south, held_now)
    add_if(bits, 8192, buttons.east, held_now)
    add_if(bits, 16384, buttons.west, held_now)
    add_if(bits, 32768, buttons.north, held_now)
}

func add_if(bits: Integer, mask: Integer, button: Integer, held_now: List<Integer>) {
    assert bits.bits_and(mask) != 0
    held_now.append(button)
}

func unsigned_short(address: Long, offset: Integer): Integer {
    var low = raw.read_byte(address, offset)
    var high = raw.read_byte(address, offset + 1)
    var low_value: Integer = low
    var high_value: Integer = high
    if low_value < 0 {
        low_value = low_value + 256
    }
    if high_value < 0 {
        high_value = high_value + 256
    }
    return high_value * 256 + low_value
}

func trigger(address: Long, offset: Integer): Float {
    var raw: Integer = raw.read_byte(address, offset)
    if raw < 0 {
        raw = raw + 256
    }
    var value: Float = raw
    return value / 255.0
}

func axis(address: Long, offset: Integer, dead_zone: Float): Float {
    var raw = unsigned_short(address, offset)
    if raw >= 32768 {
        raw = raw - 65536
    }
    var value: Float = raw
    var magnitude = value
    if magnitude < 0.0 {
        magnitude = 0.0 - magnitude
    }
    if magnitude < dead_zone {
        return 0.0
    }
    var span = 32767.0 - dead_zone
    var scaled = (magnitude - dead_zone) / span
    if scaled > 1.0 {
        scaled = 1.0
    }
    if value < 0.0 {
        return 0.0 - scaled
    }
    return scaled
}
