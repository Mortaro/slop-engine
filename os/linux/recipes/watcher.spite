var library = DynamicLibrary("libc.so.6", 'identity', "")
var buffer: Long = 0
var buffer_size = 4096

func start_watching(watched: List<String>) {
    var non_blocking = 2048
    var descriptor: Long = library.inotify_init1(non_blocking)
    crash descriptor >= 0
    handles = descriptor
    buffer = heap.allocate(buffer_size)
    var written_moved_created_deleted = 904
    var index = 0
    while index < count {
        crash watched[index]
        library.inotify_add_watch(handles, watched[index], written_moved_created_deleted)
        index = index + 1
    }
}

func take_signals(): Boolean {
    var any = false
    var read: Long = library.read(handles, buffer, buffer_size)
    while read > 0 {
        any = true
        read = library.read(handles, buffer, buffer_size)
    }
    return any
}

func stop_watching() {
    library.close(handles)
    heap.free(buffer)
}
