var kernel = DynamicLibrary("kernel32.dll", 'identity', "")

func start_watching(watched: List<String>) {
    handles = heap.allocate(count * 8)
    var index = 0
    while index < count {
        crash watched[index]
        var file_names_and_writes = 17
        var handle = kernel.FindFirstChangeNotificationA_as_long(watched[index], 0, file_names_and_writes)
        raw.write_long(handles, index * 8, handle)
        index = index + 1
    }
}

func take_signals(): Boolean {
    var any = false
    var no_wait = 0
    var signalled = kernel.WaitForMultipleObjects(count, handles, 0, no_wait)
    while signalled >= 0 and signalled < count {
        var handle = raw.read_long(handles, signalled * 8)
        kernel.FindNextChangeNotification(handle)
        any = true
        signalled = kernel.WaitForMultipleObjects(count, handles, 0, no_wait)
    }
    return any
}

func stop_watching() {
    var index = 0
    while index < count {
        var handle = raw.read_long(handles, index * 8)
        kernel.FindCloseChangeNotification(handle)
        index = index + 1
    }
    heap.free(handles)
}
